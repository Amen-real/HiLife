/* pages/advice/advice.wxss —— 对齐 07-diet.html（HiLiLife 饮食建议 · 浅色暖白底 + 荧光绿）
   覆盖旧版青绿→桃色渐变主题，统一为 HiLife 浅色设计系统。 */

.page {
  min-height: 100vh;
  background: var(--n-50);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== 顶部视图切换 ===== */
.topbar { padding: 16rpx 32rpx 8rpx; }
.seg-top {
  display: flex; height: 80rpx;
  background: var(--bg); border-radius: var(--r-pill); padding: 6rpx;
}
.seg-top-item {
  flex: 1; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; color: var(--n-600);
  border-radius: var(--r-pill);
  transition: background 200ms var(--ease-out), color 200ms var(--ease-out);
}
.seg-top-item.on {
  background: var(--primary); color: var(--n-900);
  box-shadow: var(--shadow-xs);
}

/* ===== Hero：今日目标 + 完成度环 ===== */
.goal-card {
  display: flex; align-items: center; gap: 32rpx;
  margin: 8rpx 32rpx 28rpx;
  padding: 32rpx 36rpx;
  background: var(--card); border: 1rpx solid var(--n-200);
  border-radius: var(--r-l); box-shadow: var(--shadow-card);
}
.goal-card .info { flex: 1; min-width: 0; }
.goal-card .label {
  font-size: 24rpx; font-weight: 700; color: var(--n-700); letter-spacing: 0.04em;
}
.goal-card .kcal {
  font-family: var(--f-en, sans-serif);
  font-size: 60rpx; font-weight: 800; color: var(--n-900);
  letter-spacing: -0.03em; line-height: 1.05;
  font-variant-numeric: tabular-nums;
  display: inline-flex; align-items: baseline; margin-top: 8rpx;
}
.goal-card .kcal .unit {
  font-size: 32rpx; font-weight: 700; color: var(--n-700); margin-left: 8rpx;
}
.goal-card .sub {
  margin-top: 8rpx; font-size: 24rpx; font-weight: 600; color: var(--n-500);
}
/* 小号完成度环（76px），复用全局 .ring 渐变，仅覆写尺寸 */
.goal-ring { --size: 152rpx; --w: 16rpx; }

/* 推荐依据说明 / 降级提示条 */
.goal-note {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  margin: -14rpx 32rpx 24rpx;
  font-size: 22rpx; color: var(--n-500); line-height: 1.4;
}
.goal-note .gn-text { flex: 1; min-width: 0; }
.goal-note .gn-fix {
  flex: none; font-weight: 700; color: var(--primary-text);
  padding: 8rpx 18rpx; border-radius: 999rpx;
  background: var(--primary-tint, rgba(124,184,0,.12));
}

/* T6：体重变化导致推荐更新提示条 */
.update-hint {
  display: flex; align-items: center; gap: 14rpx;
  margin: 0 32rpx 20rpx; padding: 18rpx 22rpx;
  background: var(--primary-tint, rgba(124,184,0,.12));
  border: 1rpx solid rgba(124,184,0,.30);
  border-radius: var(--r-m);
}
.update-hint .uh-ico {
  flex: none; width: 14rpx; height: 14rpx; border-radius: 50%;
  background: var(--primary-text);
}
.update-hint .uh-text {
  flex: 1; min-width: 0; font-size: 23rpx; font-weight: 600; color: var(--primary-text);
}
.update-hint .uh-close { flex: none; font-size: 24rpx; color: var(--primary-text); opacity: .7; }

/* T6：近 30 天趋势卡 */
.trend-card { margin: 0 32rpx 36rpx; padding: 28rpx 28rpx 24rpx; }
.tc-head { margin-bottom: 16rpx; }
.tc-title { font-size: 26rpx; font-weight: 800; color: var(--n-900); letter-spacing: 0.01em; }
.trend-empty {
  font-size: 23rpx; color: var(--n-500); line-height: 1.5;
  padding: 24rpx 4rpx 8rpx;
}
.trend-caption {
  display: flex; justify-content: space-between; gap: 16rpx;
  margin-bottom: 12rpx; font-size: 22rpx; font-weight: 600;
}
.trend-caption .tc-w { color: var(--n-600); }
.trend-caption .tc-k { color: var(--primary-text); }
.trend-wrap { position: relative; width: 100%; height: 360rpx; }
.trend-canvas { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; }
.trend-image { width: 100%; height: 100%; display: block; }
.trend-legend {
  display: flex; gap: 36rpx; margin-top: 12rpx;
  font-size: 21rpx; color: var(--n-600);
}
.trend-legend .lg { display: flex; align-items: center; gap: 10rpx; }
.trend-legend .lg-dot { width: 18rpx; height: 18rpx; border-radius: 50%; flex: none; }
.trend-legend .lg-dot.kcal { background: #C8FF00; border: 1rpx solid #A6C24A; }
.trend-legend .lg-dot.weight { background: transparent; border: 2rpx dashed #9AA0A6; }

/* T6：手动覆盖入口 + 目标卡「手动」标签 */
.goal-adjust {
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 32rpx 24rpx; padding: 20rpx 26rpx;
  background: var(--card); border: 1rpx solid var(--n-200);
  border-radius: var(--r-m); box-shadow: var(--shadow-card);
}
.goal-adjust .ga-text { font-size: 25rpx; font-weight: 700; color: var(--n-800); }
.goal-adjust .ga-caret { font-size: 30rpx; color: var(--n-400); }
.goal-card .kcal .kcal-tag,
.kcal-tag {
  margin-left: 12rpx; font-size: 20rpx; font-weight: 700; color: var(--primary-text);
  background: var(--primary-tint, rgba(124,184,0,.12));
  padding: 4rpx 12rpx; border-radius: 999rpx; vertical-align: middle;
}

/* T6：手动覆盖调整 sheet */
.ie-row {
  display: flex; align-items: center; gap: 18rpx;
  margin: 8rpx 4rpx 4rpx;
}
.ie-step {
  width: 76rpx; height: 76rpx; flex: none;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 700; color: var(--n-800);
  background: var(--card-gray, #F2F2EE); border-radius: var(--r-m);
}
.ie-input {
  flex: 1; min-width: 0; height: 76rpx; text-align: center;
  font-size: 38rpx; font-weight: 800; color: var(--n-900);
  background: var(--card-gray, #F2F2EE); border-radius: var(--r-m);
  font-variant-numeric: tabular-nums;
}
.ie-unit { flex: none; font-size: 24rpx; color: var(--n-500); }
.ie-hint { font-size: 22rpx; color: var(--n-500); margin: 14rpx 4rpx 4rpx; line-height: 1.4; }
.ie-actions { display: flex; gap: 18rpx; margin-top: 20rpx; }
.ie-actions .btn-reset {
  flex: 1; height: 84rpx; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; color: var(--n-700);
  background: var(--card-gray, #F2F2EE); border-radius: var(--r-m);
}
.ie-actions .btn-save {
  flex: 1; height: 84rpx; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 800; color: var(--ink, #0A0A0A);
  background: var(--primary); border-radius: var(--r-m);
}

/* ===== 营养概览（3 列） ===== */
.nutrition-overview {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 20rpx;
  margin: 0 32rpx 36rpx;
}
.nutrition-overview .item {
  background: var(--card); border: 1rpx solid var(--n-200);
  border-radius: var(--r-m); padding: 24rpx 24rpx 20rpx;
  display: flex; flex-direction: column; gap: 12rpx; box-shadow: var(--shadow-card);
}
.nutrition-overview .head {
  display: flex; align-items: center; gap: 12rpx;
  font-size: 24rpx; font-weight: 700; color: var(--n-700);
}
.nutrition-overview .swatch { width: 16rpx; height: 16rpx; border-radius: 50%; flex: none; }
.nutrition-overview .val {
  font-family: var(--f-en, sans-serif);
  font-size: 40rpx; font-weight: 800; color: var(--n-900);
  letter-spacing: -0.02em; font-variant-numeric: tabular-nums;
  display: inline-flex; align-items: baseline; line-height: 1;
}
.nutrition-overview .val .unit {
  font-size: 24rpx; font-weight: 700; color: var(--n-700); margin-left: 6rpx;
}

/* ===== 区块标题 ===== */
.section-label {
  font-size: 28rpx; font-weight: 800; color: var(--n-900);
  letter-spacing: 0.02em; margin: 12rpx 36rpx 20rpx;
}

/* ===== 推荐分类 pills ===== */
.cat-pills {
  display: flex; gap: 12rpx;
  margin: 0 32rpx 28rpx;
  white-space: nowrap;
}
.cat-pill {
  flex: none;
  padding: 14rpx 28rpx;
  border-radius: var(--r-pill);
  background: var(--card); border: 1rpx solid var(--n-200);
  font-size: 26rpx; font-weight: 700; color: var(--n-700);
  transition: background 200ms var(--ease-out), color 200ms var(--ease-out);
}
.cat-pill.on {
  background: var(--n-900); color: var(--white);
  border-color: var(--n-900);
}

/* ===== 推荐食物（垂直卡片列表） ===== */
.food-list {
  display: flex; flex-direction: column;
  margin: 0 32rpx 28rpx; gap: 20rpx;
}
.food-row {
  display: flex; gap: 20rpx;
  padding: 20rpx; border-radius: var(--r-l);
  /* 覆写全局 .card 的 margin: 24rpx 32rpx，避免食物卡被第二次右缩进；
     卡片宽度由 .food-list 的 32rpx 外边距统一控制，与 .goal-card 对齐 */
  margin: 0;
}
.food-thumb {
  flex: none; width: 180rpx; height: 180rpx;
  border-radius: var(--r-m); overflow: hidden;
  background: var(--card-gray);
}
.food-img { width: 100%; height: 100%; display: block; }
.food-info {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column; gap: 8rpx;
  padding: 4rpx 0;
}
.food-name {
  font-size: 28rpx; font-weight: 800; color: var(--n-900);
  letter-spacing: 0.02em; line-height: 1.2;
}
.food-kcal {
  font-size: 24rpx; font-weight: 700; color: var(--n-700);
  font-variant-numeric: tabular-nums;
}
.food-macros {
  font-size: 22rpx; color: var(--n-500);
  font-variant-numeric: tabular-nums; line-height: 1.4;
}
.food-desc {
  font-size: 22rpx; color: var(--n-500);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.food-add {
  flex: none;
  align-self: center;
  width: 56rpx; height: 56rpx;
  border-radius: var(--r-m);
  background: var(--primary);
  color: var(--n-900);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 800;
  line-height: 1;
}

/* ============================================================
   饮食记录视图
   ============================================================ */

/* 今日摄入 Hero（kcal + 三大营养素进度条） */
.rec-hero {
  margin: 8rpx 32rpx 24rpx;
  padding: 28rpx 32rpx 32rpx;
}
.rh-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 8rpx;
}
.rh-label {
  font-size: 24rpx; font-weight: 700; color: var(--n-700);
  letter-spacing: 0.04em;
}
.rh-date {
  font-family: var(--f-en, sans-serif);
  font-size: 22rpx; font-weight: 700; color: var(--n-900);
  background: var(--primary); border-radius: var(--r-pill);
  padding: 6rpx 18rpx; font-variant-numeric: tabular-nums;
  display: flex; align-items: center; gap: 6rpx;
}
.rh-date-hover { opacity: 0.6; }
.rh-caret {
  font-size: 18rpx; color: var(--n-900); line-height: 1;
  margin-left: 2rpx;
}
.rh-main {
  display: flex; align-items: baseline;
  margin-bottom: 20rpx;
}
.rh-val {
  font-family: var(--f-en, sans-serif);
  font-size: 64rpx; font-weight: 800; color: var(--n-900);
  letter-spacing: -0.03em; font-variant-numeric: tabular-nums; line-height: 1;
}
.rh-unit {
  font-size: 30rpx; font-weight: 700; color: var(--n-500);
  margin-left: 6rpx;
}
.macro-rows { display: flex; flex-direction: column; gap: 14rpx; }
.macro-row {
  display: flex; align-items: center; gap: 16rpx;
}
.mr-name {
  flex: none; width: 96rpx;
  font-size: 24rpx; font-weight: 700; color: var(--n-700);
}
.mr-bar {
  flex: 1; min-width: 0; height: 8rpx;
  background: var(--n-100); border-radius: var(--r-pill);
  overflow: hidden;
}
.mr-fill {
  height: 100%; background: var(--primary);
  border-radius: var(--r-pill);
}
.mr-val {
  flex: none;
  font-family: var(--f-en, sans-serif);
  font-size: 22rpx; font-weight: 700; color: var(--n-700);
  font-variant-numeric: tabular-nums; letter-spacing: 0.01em;
}
/* 三大营养素按语义着色（蛋白绿 / 碳水橙 / 脂肪琥珀），与营养概览 swatch 同色系 */
.mr-fill-0 { background: #6F9F00; }
.mr-fill-1 { background: #FF9500; }
.mr-fill-2 { background: #FFB020; }
.mr-name-0 { color: #6F9F00; }
.mr-name-1 { color: #FF9500; }
.mr-name-2 { color: #FFB020; }

.meal-group { padding: 28rpx 32rpx 32rpx; }
.meal-head {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-bottom: 16rpx;
}
.meal-name { font-size: 32rpx; font-weight: 800; color: var(--n-900); letter-spacing: 0.02em; }
.meal-meta {
  font-size: 24rpx; font-weight: 700; color: var(--n-500);
  font-variant-numeric: tabular-nums;
}
.meal-meta .unit { font-size: 22rpx; font-weight: 600; color: var(--n-500); margin-left: 2rpx; }
.meal-empty {
  font-size: 24rpx; color: var(--n-500);
  text-align: center; padding: 12rpx 0 8rpx;
}
.meal-item {
  display: flex; align-items: flex-start; gap: 16rpx;
  padding: 20rpx 0; border-bottom: 1rpx solid var(--n-100);
}
.meal-item:last-of-type { border-bottom: none; }
.mi-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.mi-name { font-size: 28rpx; font-weight: 700; color: var(--n-900); line-height: 1.3; }
.mi-portion {
  font-size: 22rpx; font-weight: 700; color: var(--n-500);
  font-variant-numeric: tabular-nums;
}
.mi-macros {
  font-size: 22rpx; color: var(--n-500);
  font-variant-numeric: tabular-nums; line-height: 1.4;
}
.mi-actions {
  flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx;
  align-self: center;
}
.mi-edit {
  font-size: 24rpx; font-weight: 700; color: var(--n-700);
  padding: 6rpx 12rpx;
}
.mi-del {
  font-size: 24rpx; font-weight: 700; color: #E54848;
  padding: 6rpx 12rpx;
}
.add-row {
  margin-top: 20rpx; height: 76rpx;
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  border: 2rpx solid var(--primary); border-radius: var(--r-m);
  font-size: 26rpx; font-weight: 700; color: var(--n-900);
  background: var(--primary);
}
/* 添加图标：用 CSS 画 +（plus 图标源文件 glyph 偏左上、aspectFit 后显示不全，故自绘保证居中完整） */
.add-ico {
  position: relative;
  width: 26rpx; height: 26rpx;
  flex: none;
}
.add-ico::before,
.add-ico::after {
  content: '';
  position: absolute;
  background: var(--n-900);
  border-radius: 2rpx;
}
.add-ico::before { left: 0; right: 0; top: 50%; height: 4rpx; transform: translateY(-50%); }
.add-ico::after { top: 0; bottom: 0; left: 50%; width: 4rpx; transform: translateX(-50%); }

/* ============================================================
   底部抽屉 sheet（添加方式 / 手动输入共用）
   ============================================================ */
.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(10, 10, 10, 0.45);
  display: flex; align-items: flex-end; z-index: 100;
}
.sheet {
  width: 100%;
  background: var(--card);
  border-radius: var(--r-l) var(--r-l) 0 0;
  padding: 16rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}
.sheet-title {
  text-align: center; font-size: 28rpx; font-weight: 700; color: var(--n-700);
  padding: 24rpx 0 16rpx;
}

/* 添加方式选项 */
.sheet-opt {
  display: flex; align-items: center; gap: 24rpx;
  padding: 28rpx 24rpx; margin: 12rpx 0;
  background: var(--n-50); border-radius: var(--r-m);
  box-shadow: var(--shadow-card);
}
.opt-ico {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  background: var(--white); display: flex; align-items: center; justify-content: center;
  flex: none; box-shadow: var(--shadow-xs);
}
.opt-main { flex: 1; min-width: 0; }
.opt-name { font-size: 30rpx; font-weight: 800; color: var(--n-900); }
.opt-desc { font-size: 24rpx; color: var(--n-500); margin-top: 4rpx; }
.opt-arrow { font-size: 40rpx; color: var(--n-400); }
.opt-hover { background: var(--n-100); }
.sheet-cancel {
  margin-top: 16rpx; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700; color: var(--n-700);
  background: var(--n-100); border-radius: var(--r-m);
}

/* 手动输入表单 */
.form { padding: 8rpx 0 12rpx; }
.f-row { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 0; }
.f-lab { width: 160rpx; flex: none; font-size: 26rpx; font-weight: 700; color: var(--n-700); }
.f-input {
  flex: 1; min-width: 0; height: 76rpx; padding: 0 24rpx;
  background: var(--n-50); border: 1rpx solid var(--n-200); border-radius: var(--r-m);
  font-size: 28rpx; color: var(--n-900);
}
.f-grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-top: 8rpx; }
.f-cell { display: flex; flex-direction: column; gap: 10rpx; }
.f-cell .f-lab { width: auto; font-size: 22rpx; color: var(--n-500); }
.f-input.sm { padding: 0 16rpx; font-size: 26rpx; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.btn-cancel, .btn-save {
  flex: 1; height: 88rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-m); font-size: 30rpx; font-weight: 800;
}
.btn-cancel { background: var(--n-100); color: var(--n-700); }
.btn-save { background: var(--primary); color: #0A0A0A; box-shadow: var(--shadow-mint); }

/* AI 识别中 */
.rec-loading { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 24rpx; }
.spinner {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  border: 6rpx solid var(--n-200); border-top-color: var(--primary);
  animation: spin 0.8s linear infinite;
}
.rec-loading-txt { font-size: 26rpx; color: var(--n-600); }
@keyframes spin { to { transform: rotate(360deg); } }

/* AI 识别结果 */
.mock-tip {
  font-size: 22rpx; color: var(--warning); background: var(--warning-tint);
  border-radius: var(--r-s); padding: 12rpx 16rpx; margin-bottom: 12rpx; line-height: 1.5;
}
.rec-total {
  display: flex; flex-direction: column; gap: 6rpx;
  background: var(--n-50); border-radius: var(--r-m); padding: 20rpx 24rpx; margin-bottom: 12rpx;
}
.rec-total .rt-k { font-size: 22rpx; font-weight: 700; color: var(--n-500); }
.rec-total .rt-v { font-size: 26rpx; font-weight: 700; color: var(--n-900); }
.note { font-size: 22rpx; color: var(--n-500); margin-top: 12rpx; line-height: 1.5; }
.rec-list { display: flex; flex-direction: column; }
.rec-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 0; border-bottom: 1rpx solid var(--n-100);
}
.rec-item:last-child { border-bottom: none; }
.rec-thumb {
  width: 64rpx; height: 64rpx; border-radius: 16rpx; flex: none;
  background: var(--card-gray); display: flex; align-items: center; justify-content: center; font-size: 36rpx;
}
.rec-body { flex: 1; min-width: 0; }
.rec-name { font-size: 28rpx; font-weight: 700; color: var(--n-900); }
.rec-meta { font-size: 22rpx; color: var(--n-500); margin-top: 4rpx; }
.rec-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; flex: none; }
.rec-cal {
  font-family: var(--f-en, sans-serif); font-size: 28rpx; font-weight: 800; color: var(--n-900);
  font-variant-numeric: tabular-nums;
}
.btn-record {
  font-size: 24rpx; font-weight: 800; color: #0A0A0A;
  background: var(--primary); border-radius: var(--r-pill);
  padding: 8rpx 24rpx; box-shadow: var(--shadow-mint);
}
.rec-record-all {
  margin-top: 16rpx; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 800; color: var(--n-900);
  background: var(--primary); border-radius: var(--r-m); box-shadow: var(--shadow-mint);
}

.bottom-gap { height: 20rpx; }

/* 尊重「减少动态效果」偏好 */
@media (prefers-reduced-motion: reduce) {
  .seg-top-item, .sheet-opt { transition: none; }
  .spinner { animation: none; }
}

/* ══════════════════════════════════════════════════════════════
   深色主题覆盖（.page.theme-dark）
   手法同 home.wxss：重定义 CSS 变量，整棵子树自动翻转；
   仅「硬编码颜色 / 回退写法 / 强调元素」需要单独覆盖。
   ══════════════════════════════════════════════════════════════ */
.page.theme-dark {
  /* —— 中性灰阶反转（暖白 → 暖黑）—— */
  --n-50:  #0A0A0A;
  --n-100: #1E1E1E;
  --n-200: rgba(255, 255, 255, 0.10);
  --n-300: rgba(255, 255, 255, 0.16);
  --n-400: rgba(255, 255, 255, 0.30);
  --n-500: rgba(255, 255, 255, 0.42);
  --n-600: rgba(255, 255, 255, 0.55);
  --n-700: rgba(255, 255, 255, 0.75);
  --n-800: rgba(255, 255, 255, 0.88);
  --n-900: #FFFFFF;

  /* —— 语义色 —— */
  --text:        #FFFFFF;
  --text-sub:    rgba(255, 255, 255, 0.70);
  --text-weak:   rgba(255, 255, 255, 0.45);
  --line:        rgba(255, 255, 255, 0.10);
  --line-strong: rgba(255, 255, 255, 0.20);

  /* —— 表面 —— */
  --card:      #161616;
  --white:     #161616;
  --card-gray: #1E1E1E;
  --bg:        rgba(255, 255, 255, 0.06);

  /* 本页 var(--ink, #0A0A0A) 回退写法的兜底：深色下翻白 */
  --ink: #FFFFFF;

  /* 成功色在暗底上提亮为品牌绿 */
  --success: #C8FF00;

  /* 绿色文字/浅绿底：深色下必须翻亮绿字 + 深底 tint（对比度铁律） */
  --primary-text: #C8FF00;
  --primary-tint: rgba(200, 255, 0, 0.12);

  background: var(--n-50);
  color: var(--text);
}

/* 图标 ink 变体（sheet 里的相机/碗图标）翻白 */
.page.theme-dark .ico--ink { background-color: #FFFFFF; }
/* 暗底上卡片阴影无意义，去掉 */
.page.theme-dark .card { box-shadow: none; }
