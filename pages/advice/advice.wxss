/* pages/advice/advice.wxss —— 对齐参考文件「建议页」排版（餐次块 + 菜式卡 + 环形汇总） */
/* 竖直渐变底（顶部青绿→底部桃色），与首页/我的/训练执行页统一；
   端点精确对齐 app.json 的 backgroundColorTop(#2ECFB0)/Bottom(#FFF1E8)，上拉/下拉无可见断缝；
   min-height:100vh 保证内容短时渐变仍铺满视口，底部桃色对齐视口底 */
.page { padding: 24rpx 0 calc(130rpx + env(safe-area-inset-bottom)); position: relative; min-height: 100vh; background: linear-gradient(180deg, var(--primary-deep) 0%, var(--primary) 14%, var(--primary-tint) 40%, #FFF1E8 100%); }

/* ===== 分段控件（吸顶药丸 + 滑动指示条） ===== */
.seg {
  display: flex; gap: 8rpx; margin: 20rpx 28rpx 0;
  padding: 8rpx; background: var(--card); border-radius: 999rpx;
  border: 1rpx solid var(--line); box-shadow: var(--shadow-sm);
  position: sticky; top: 0; z-index: 10;
}
/* 滑动药丸：绝对定位，根据选中态 translateX 平滑滑动 */
.seg-thumb {
  position: absolute; left: 8rpx; top: 8rpx; bottom: 8rpx;
  width: calc(50% - 12rpx);
  background: var(--primary); border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(46,207,176, 0.30);
  transform: translateX(0);
  transition: transform 0.28s var(--ease-out, ease);
  z-index: 0;
}
.seg-thumb.right { transform: translateX(calc(100% + 8rpx)); }
.seg-btn {
  flex: 1; text-align: center; font-size: 30rpx; color: var(--text-sub);
  font-weight: 700; padding: 18rpx 0; border-radius: 999rpx;
  position: relative; z-index: 1;
  transition: color 0.22s var(--ease-out, ease);
}
.seg-btn.on { color: #fff; }

/* 内容切换：淡入 + 轻微上滑 */
.tab-pane { animation: paneIn 0.30s var(--ease-out, ease); }
@keyframes paneIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 餐次 chips（横向滚动） ===== */
.chips { white-space: nowrap; padding: 22rpx 28rpx 6rpx; }
.chip {
  display: inline-block; font-size: 26rpx; color: var(--text-sub);
  background: var(--bg); border: 1rpx solid var(--line);
  border-radius: 999rpx; padding: 12rpx 30rpx; font-weight: 600;
  margin-right: 14rpx; transition: all 0.18s var(--ease-out, ease);
}
.chip:active { transform: scale(0.95); }
.chip.on {
  background: var(--primary); color: #fff; border-color: var(--primary);
  box-shadow: 0 4rpx 14rpx rgba(46,207,176, 0.28); font-weight: 700;
}

/* ===== 餐次推荐块（参考 .meal） ===== */
.meal { margin: 22rpx 28rpx 0; }
.meal .mh { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.meal .mi {
  width: 72rpx; height: 72rpx; border-radius: 22rpx; flex: 0 0 72rpx;
  display: flex; align-items: center; justify-content: center; font-size: 38rpx;
}
.meal .mtitle { flex: 1; font-size: 32rpx; font-weight: 800; color: var(--text); }
.meal .kc { font-size: 24rpx; font-weight: 700; color: #D9531F; }

/* ===== 菜式卡（参考 .dish） ===== */
.dish {
  display: flex; align-items: center; gap: 20rpx;
  background: var(--card); border: 1rpx solid var(--line);
  border-radius: 22rpx; padding: 20rpx 22rpx; margin-bottom: 14rpx;
  box-shadow: var(--shadow-sm); transition: transform 0.15s var(--ease-out, ease);
}
.dish:active { transform: scale(0.99); }
.dish .emo {
  width: 80rpx; height: 80rpx; flex: 0 0 80rpx; border-radius: 18rpx;
  background: var(--bg); display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; overflow: hidden;
}
.dish .emo.has-img { padding: 0; }
.dish .emo-img { width: 100%; height: 100%; }
.dish .dbody { flex: 1; min-width: 0; }
.dish .dn { font-size: 30rpx; font-weight: 700; color: var(--text); }
.dish .dd { font-size: 23rpx; color: var(--text-sub); margin-top: 4rpx; line-height: 1.5; }
.dish .dk { font-size: 26rpx; font-weight: 700; color: var(--text-sub); flex: 0 0 auto; font-feature-settings: "tnum" 1; }
.dish .dadd {
  flex: 0 0 auto; font-size: 24rpx; font-weight: 700;
  color: var(--primary-deep); background: var(--primary-light);
  border-radius: 999rpx; padding: 12rpx 26rpx; transition: opacity 0.15s;
}
.dish .dadd:active { opacity: 0.7; }
.dish .dacts { flex: 0 0 auto; display: flex; align-items: center; gap: 10rpx; }
.dact-edit {
  font-size: 22rpx; color: var(--primary-deep); background: var(--primary-light);
  border-radius: 999rpx; padding: 8rpx 18rpx; font-weight: 600; transition: opacity 0.15s;
}
.dact-edit:active { opacity: 0.7; }
.dact-del {
  flex: 0 0 auto; width: 44rpx; height: 44rpx; border-radius: 50%;
  background: var(--bg); color: var(--error); font-size: 28rpx;
  display: flex; align-items: center; justify-content: center; transition: opacity 0.15s;
}
.dact-del:active { opacity: 0.7; }
.dish .dnote { font-size: 22rpx; color: var(--text-weak); margin-top: 6rpx; }

.bottom-gap { height: 20rpx; }

/* ===== 饮食记录：日期筛选 ===== */
.date-filter {
  display: flex; align-items: center; gap: 12rpx;
  margin: 14rpx 28rpx 0; padding: 10rpx 18rpx;
  background: var(--bg); border-radius: 18rpx;
}
.df-picker {
  font-size: 24rpx; color: var(--text-weak);
  background: var(--card); border-radius: 12rpx;
  padding: 10rpx 22rpx; border: 1rpx solid var(--line);
  white-space: nowrap; font-weight: 500;
}
.df-picker.has-val { color: var(--text); font-weight: 600; }
.df-sep { font-size: 24rpx; color: var(--primary); font-weight: 600; padding: 10rpx 18rpx; margin-left: auto; }

/* ===== 摄入汇总：环形 + 文字（参考 .kcal-ring） ===== */
.kcal-ring {
  display: flex; align-items: center; gap: 28rpx;
  background: linear-gradient(135deg, #FFF4EE, #FFE9DF);
  border: 1rpx solid #FFD9C8; border-radius: 28rpx;
  padding: 28rpx 32rpx; margin: 16rpx 28rpx 0;
  box-shadow: var(--shadow-sm);
}
.kr { width: 168rpx; height: 168rpx; flex: 0 0 168rpx; border-radius: 50%; position: relative; }
.kr-donut {
  width: 100%; height: 100%; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.kr-hole {
  width: 124rpx; height: 124rpx; border-radius: 50%; background: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-shadow: var(--shadow-sm);
}
.kr-pct { font-size: 44rpx; font-weight: 800; color: #FF7A3D; line-height: 1; font-feature-settings: "tnum" 1; }
.kr-pct-u { font-size: 22rpx; font-weight: 700; }
.kr-lab { font-size: 20rpx; color: var(--text-sub); margin-top: 4rpx; }
.kt { flex: 1; min-width: 0; }
.kt-cap { font-size: 24rpx; color: var(--text-sub); font-weight: 600; }
.kt-big { font-size: 46rpx; font-weight: 800; color: #FF7A3D; font-feature-settings: "tnum" 1; margin: 6rpx 0; line-height: 1.1; }
.kt-u { font-size: 22rpx; color: var(--text-sub); font-weight: 600; }
.kt-sub { font-size: 22rpx; color: #B5613C; font-weight: 600; }

/* ===== 三大营养素（参考 .macros） ===== */
.macros { display: flex; gap: 16rpx; margin: 16rpx 28rpx 0; }
.macros .m {
  flex: 1; background: var(--card); border: 1rpx solid var(--line);
  border-radius: 20rpx; padding: 24rpx 12rpx; box-shadow: var(--shadow-sm); text-align: center;
}
.macros .dot { width: 18rpx; height: 18rpx; border-radius: 50%; margin: 0 auto 14rpx; }
.macros .v { font-size: 38rpx; font-weight: 800; line-height: 1; font-feature-settings: "tnum" 1; }
.macros .mu { font-size: 20rpx; color: var(--text-sub); font-weight: 600; }
.macros .l { font-size: 22rpx; color: var(--text-sub); margin-top: 8rpx; font-weight: 500; }

/* ===== 添加弹窗（底部 sheet，保持不变） ===== */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.50); display: flex; align-items: flex-end; z-index: 100; }
.modal {
  width: 100%; box-sizing: border-box;
  background: #fff; border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 28rpx;
  padding-bottom: calc(32rpx + 110rpx + env(safe-area-inset-bottom));
  animation: slideUp2 0.24s var(--ease-bounce, ease);
}
@keyframes slideUp2 { from { transform: translateY(100%); } to { transform: translateY(0); } }
.modal-title { font-size: 34rpx; font-weight: 800; text-align: center; margin-bottom: 22rpx; color: var(--text); }
.modal-input { width: 100%; box-sizing: border-box; height: 88rpx; background: var(--bg); border-radius: 18rpx; padding: 0 24rpx; font-size: 28rpx; margin-bottom: 12rpx; border: 1rpx solid var(--line); }
.modal-input:focus { border-color: var(--primary); }
.modal-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.modal-cancel, .modal-ok { flex: 1; height: 88rpx; font-size: 30rpx; font-weight: 700; border: none; display: flex; align-items: center; justify-content: center; text-align: center; border-radius: 18rpx; transition: opacity 0.15s; }
.modal-cancel { background: var(--bg); color: var(--text-sub); }
.modal-cancel::after, .modal-ok::after { border: none; }

.field-label { font-size: 24rpx; color: var(--text-sub); margin: 18rpx 0 10rpx; font-weight: 600; }
.field-label .opt { font-size: 20rpx; color: var(--text-weak); margin-left: 6rpx; font-weight: 400; }
.param-row { display: flex; gap: 14rpx; }
.param-cell { flex: 1; }
.name-cell { flex: 2; }
.portion-cell { flex: 1; }
.modal-input.sm { margin-bottom: 0; font-size: 26rpx; padding: 0 16rpx; text-align: center; }
.portion-cell .modal-input { text-align: left; }

/* AI 拍照识别 */
.rec-cam {
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx;
  height: 152rpx; background: var(--primary-light);
  border: 2rpx dashed var(--primary); border-radius: 20rpx;
  color: var(--primary); margin-bottom: 16rpx;
  transition: opacity 0.2s;
}
.rec-cam:active { opacity: 0.7; }
.rec-cam.loading { opacity: 0.55; }
.cam-ico { font-size: 52rpx; line-height: 1; }
.cam-tx { font-size: 28rpx; font-weight: 700; }
