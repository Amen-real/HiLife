<!-- pages/advice/advice.wxml —— 对齐 07-diet.html（HiLiLife 饮食建议 · 浅色 + 荧光绿） -->
<view class="page">
  <nav-bar show-back="{{true}}" />

  <!-- 顶部切换：饮食建议 | 饮食记录 -->
  <view class="topbar">
    <view class="seg-top">
      <view class="seg-top-item {{view==='advice'?'on':''}}" bindtap="switchView" data-view="advice" hover-class="btn-hover">饮食建议</view>
      <view class="seg-top-item {{view==='record'?'on':''}}" bindtap="switchView" data-view="record" hover-class="btn-hover">饮食记录</view>
    </view>
  </view>

  <!-- ============ 饮食建议视图 ============ -->
  <block wx:if="{{view==='advice'}}">

    <!-- 今日目标 + 完成度环 -->
    <view class="goal-card" aria-label="今日热量目标">
      <view class="info">
        <view class="label">今日目标</view>
        <view class="kcal">{{intakeTarget}}<text class="unit">kcal</text><text wx:if="{{overrideActive}}" class="kcal-tag">手动</text></view>
        <view class="sub">{{overrideActive ? '手动设定' : '建议摄入'}}</view>
      </view>
      <view class="ring goal-ring" style="{{ringStyle}}" role="img" aria-label="已完成 {{intakePct}}%">
        <text class="ring-span">{{intakePct}}%</text>
      </view>
    </view>

    <!-- 推荐依据 / 降级提示 -->
    <view class="goal-note" aria-label="推荐依据">
      <text class="gn-text">{{intakeNote}}</text>
      <view wx:if="{{showProfileTip}}" class="gn-fix" bindtap="goSettings" hover-class="btn-hover" role="button" aria-label="去完善健康数据">去完善 ›</view>
    </view>

    <!-- T6：体重变化导致推荐已更新提示（点击关闭） -->
    <view wx:if="{{intakeUpdated}}" class="update-hint" bindtap="dismissUpdateHint" role="button" aria-label="关闭提示">
      <view class="uh-ico"></view>
      <text class="uh-text">{{intakeUpdateMsg}}</text>
      <text class="uh-close">✕</text>
    </view>

    <!-- T6：手动覆盖入口 -->
    <view class="goal-adjust" bindtap="openIntakeEdit" role="button" aria-label="调整目标热量">
      <text class="ga-text">调整目标热量</text>
      <text class="ga-caret">›</text>
    </view>

    <!-- 营养概览（3 列） -->
    <view class="nutrition-overview" aria-label="营养概览">
      <view class="item" wx:for="{{nutrients}}" wx:key="key">
        <view class="head">
          <view class="swatch" style="{{item.swatchStyle}}"></view>
          <text>{{item.key}}</text>
        </view>
        <view class="val">{{item.goal}}<text class="unit">g</text></view>
      </view>
    </view>

    <!-- T6：近 30 天 · 目标热量随体重变化 趋势 -->
    <view class="trend-card card" aria-label="近30天趋势">
      <view class="tc-head">
        <text class="tc-title">近 30 天 · 目标热量随体重变化</text>
      </view>
      <view wx:if="{{trendEmpty}}" class="trend-empty">记录体重后，这里会显示目标热量随体重的自动调整趋势。</view>
      <block wx:else>
        <view class="trend-caption">
          <text class="tc-w">体重 {{trendSummary.w0}}→{{trendSummary.w1}}kg</text>
          <text class="tc-k">目标 {{trendSummary.k0}}→{{trendSummary.k1}} kcal</text>
        </view>
        <view class="trend-wrap">
          <canvas type="2d" id="kcalChart" class="trend-canvas"></canvas>
          <image wx:if="{{trendImage}}" class="trend-image" src="{{trendImage}}" mode="aspectFit"></image>
        </view>
        <view class="trend-legend">
          <view class="lg"><view class="lg-dot kcal"></view><text>目标热量</text></view>
          <view class="lg"><view class="lg-dot weight"></view><text>体重</text></view>
        </view>
      </block>
    </view>

    <!-- 推荐分类筛选（早/中/晚/加餐/蔬果） -->
    <view class="cat-pills" role="tablist" aria-label="推荐分类">
      <view wx:for="{{categoryKeys}}" wx:key="*this"
            class="cat-pill {{currentCategory===item?'on':''}}"
            bindtap="switchCategory" data-key="{{item}}"
            hover-class="btn-hover" role="tab"
            aria-selected="{{currentCategory===item}}"
            aria-label="{{item}}">{{item}}</view>
    </view>

    <!-- 推荐食物（垂直卡片列表） -->
    <view class="food-list" aria-label="{{currentCategory}}推荐食物">
      <view class="food-row card" wx:for="{{currentFoods}}" wx:key="id"
            aria-label="{{item.name}} · 约 {{item.calories}} kcal">
        <view class="food-thumb">
          <image class="food-img" src="{{item.img}}" mode="aspectFill" lazy-load></image>
        </view>
        <view class="food-info">
          <view class="food-name">{{item.name}}</view>
          <view class="food-kcal">约 {{item.calories}} kcal</view>
          <view class="food-macros">蛋白质 {{item.protein}}g  碳水 {{item.carb}}g  脂肪 {{item.fat}}g</view>
          <view class="food-desc">{{item.desc}}</view>
        </view>
        <view class="food-add" bindtap="addFood" data-id="{{item.id}}"
              hover-class="btn-hover" role="button" aria-label="添加{{item.name}}">+</view>
      </view>
    </view>
  </block>

  <!-- ============ 饮食记录视图 ============ -->
  <block wx:if="{{view==='record'}}">

    <!-- 今日摄入 Hero（日期可点击筛选） -->
    <view class="rec-hero card" aria-label="摄入">
      <view class="rh-row">
        <text class="rh-label">{{intakeLabel}}</text>
        <picker mode="date" value="{{selectedDate}}" end="{{todayDate}}" bindchange="onDateChange">
          <view class="rh-date" hover-class="rh-date-hover" role="button" aria-label="选择日期筛选">{{selectedDate}}<text class="rh-caret">▾</text></view>
        </picker>
      </view>
      <view class="rh-main">
        <text class="rh-val">{{intakeSum.cal}}</text>
        <text class="rh-unit"> / {{intakeTarget}} kcal</text>
      </view>
      <view class="macro-rows">
        <view class="macro-row" wx:for="{{macros}}" wx:key="key">
          <text class="mr-name mr-name-{{index}}">{{item.key}}</text>
          <view class="mr-bar"><view class="mr-fill mr-fill-{{index}}" style="{{item.fillStyle}}"></view></view>
          <text class="mr-val">{{item.val}} / {{item.goal}}g</text>
        </view>
      </view>
    </view>

    <view class="meal-group card" wx:for="{{mealGroups}}" wx:key="type">
      <view class="meal-head">
        <view class="meal-name">{{item.type}}</view>
        <view class="meal-meta">{{item.meals.length}}条 · {{item.total}}<text class="unit">kcal</text></view>
      </view>

      <view wx:if="{{item.meals.length === 0}}" class="meal-empty">暂无记录</view>
      <view wx:else>
        <view class="meal-item" wx:for="{{item.meals}}" wx:for-item="m" wx:key="id">
          <view class="mi-body">
            <view class="mi-name">{{m.name}}</view>
            <view class="mi-portion">{{m.portion}}份</view>
            <view class="mi-macros">{{m.calories}}kcal · 蛋白质{{m.protein}}g · 碳水{{m.carb}}g · 脂肪{{m.fat}}g</view>
          </view>
          <view class="mi-actions">
            <view class="mi-edit" bindtap="editMeal" data-id="{{m.id}}"
                  hover-class="btn-hover" role="button" aria-label="编辑{{m.name}}">修改</view>
            <view class="mi-del" bindtap="deleteMeal" data-id="{{m.id}}"
                  hover-class="btn-hover" role="button" aria-label="删除{{m.name}}">删除</view>
          </view>
        </view>
      </view>

      <view class="add-row" bindtap="openAdd" data-type="{{item.type}}"
            hover-class="btn-hover" role="button" aria-label="添加{{item.type}}食物">
        <view class="add-ico" aria-hidden="true"></view>
        <text>添加{{item.type}}</text>
      </view>
    </view>
  </block>

  <!-- ============ 添加方式选择 sheet ============ -->
  <view wx:if="{{showAddSheet}}" class="mask" bindtap="closeAdd">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">添加食物到「{{addType}}」</view>
      <view class="sheet-opt" bindtap="chooseAdd" data-way="ai" hover-class="opt-hover" role="button" aria-label="AI识别拍照">
        <view class="opt-ico"><view class="ico ico-camera ico--ink" style="width:40rpx;height:40rpx"></view></view>
        <view class="opt-main">
          <view class="opt-name">AI 识别拍照</view>
          <view class="opt-desc">拍照识别并记录到「{{addType}}」</view>
        </view>
        <text class="opt-arrow">›</text>
      </view>
      <view class="sheet-opt" bindtap="chooseAdd" data-way="manual" hover-class="opt-hover" role="button" aria-label="手动输入">
        <view class="opt-ico"><view class="ico ico-food-bowl ico--ink" style="width:40rpx;height:40rpx"></view></view>
        <view class="opt-main">
          <view class="opt-name">手动输入</view>
          <view class="opt-desc">填写食物、份量、营养数据</view>
        </view>
        <text class="opt-arrow">›</text>
      </view>
      <view class="sheet-cancel" bindtap="closeAdd" hover-class="btn-hover" role="button" aria-label="取消">取消</view>
    </view>
  </view>

  <!-- ============ 手动输入 modal ============ -->
  <view wx:if="{{showManual}}" class="mask" bindtap="closeManual">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{editingMealId ? '编辑' : '手动记录'}} · {{addType}}</view>
      <view class="form">
        <view class="f-row">
          <text class="f-lab">食物名称</text>
          <input class="f-input" placeholder="如：鸡胸肉" value="{{form.name}}" bindinput="onForm" data-field="name" />
        </view>
        <view class="f-row">
          <text class="f-lab">份数</text>
          <input class="f-input" type="number" placeholder="1" value="{{form.portion}}" bindinput="onForm" data-field="portion" />
        </view>
        <view class="f-row">
          <text class="f-lab">热量(kcal)</text>
          <input class="f-input" type="digit" placeholder="0" value="{{form.calories}}" bindinput="onForm" data-field="calories" />
        </view>
        <view class="f-grid3">
          <view class="f-cell">
            <text class="f-lab">蛋白(g)</text>
            <input class="f-input sm" type="digit" placeholder="0" value="{{form.protein}}" bindinput="onForm" data-field="protein" />
          </view>
          <view class="f-cell">
            <text class="f-lab">碳水(g)</text>
            <input class="f-input sm" type="digit" placeholder="0" value="{{form.carb}}" bindinput="onForm" data-field="carb" />
          </view>
          <view class="f-cell">
            <text class="f-lab">脂肪(g)</text>
            <input class="f-input sm" type="digit" placeholder="0" value="{{form.fat}}" bindinput="onForm" data-field="fat" />
          </view>
        </view>
      </view>
      <view class="modal-actions">
        <view class="btn-cancel" bindtap="closeManual" hover-class="btn-hover" role="button" aria-label="取消">取消</view>
        <view class="btn-save" bindtap="saveManual" hover-class="btn-hover" role="button" aria-label="保存">保存</view>
      </view>
    </view>
  </view>

  <!-- ============ 手动覆盖：调整目标热量 ============ -->
  <view wx:if="{{showIntakeEdit}}" class="mask" bindtap="closeIntakeEdit">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">调整每日目标热量</view>
      <view class="ie-row">
        <view class="ie-step" bindtap="stepIntake" data-d="-10" hover-class="opt-hover" role="button" aria-label="减少10">−</view>
        <input class="ie-input" type="number" value="{{intakeEditValue}}" bindinput="onIntakeEdit" />
        <view class="ie-step" bindtap="stepIntake" data-d="10" hover-class="opt-hover" role="button" aria-label="增加10">＋</view>
        <text class="ie-unit">kcal</text>
      </view>
      <view class="ie-hint">推荐值 {{intakeEditRecommended}} kcal，可上下微调（步长 10）。</view>
      <view class="ie-actions">
        <view wx:if="{{overrideActive}}" class="btn-reset" bindtap="resetIntakeOverride" hover-class="btn-hover" role="button" aria-label="恢复推荐">恢复推荐</view>
        <view class="btn-save" bindtap="saveIntakeOverride" hover-class="btn-hover" role="button" aria-label="保存">保存</view>
      </view>
    </view>
  </view>

  <!-- ============ AI 识别中 ============ -->
  <view wx:if="{{recognizing}}" class="mask">
    <view class="rec-loading">
      <view class="spinner"></view>
      <view class="rec-loading-txt">AI 识别中…</view>
    </view>
  </view>

  <!-- ============ AI 识别结果 ============ -->
  <view wx:if="{{recResult}}" class="mask" bindtap="closeRec">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">AI 识别结果 · {{addType}}</view>
      <view wx:if="{{recResult.mock}}" class="mock-tip">演示数据（未配置视觉模型 key），接入真实模型后即替换为估算结果。</view>

      <view class="rec-total" wx:if="{{recResult.total}}">
        <text class="rt-k">本餐合计</text>
        <text class="rt-v">{{recResult.total.calories}} 千卡 · 蛋白 {{recResult.total.protein}}g · 碳水 {{recResult.total.carb}}g · 脂肪 {{recResult.total.fat}}g</text>
      </view>

      <view wx:if="{{recResult.foods.length === 0}}" class="meal-empty">未能识别到食物，请换一张更清晰的图。</view>

      <view class="rec-list" wx:else>
        <view class="rec-item" wx:for="{{recResult.foods}}" wx:key="name">
          <view class="rec-thumb">{{item.emoji || '🍽️'}}</view>
          <view class="rec-body">
            <view class="rec-name">{{item.name}}</view>
            <view class="rec-meta">蛋白 {{item.protein}}g · 碳水 {{item.carb}}g · 脂肪 {{item.fat}}g</view>
          </view>
          <view class="rec-right">
            <view class="rec-cal">{{item.calories}}</view>
            <view class="btn-record" bindtap="recRecordOne" data-idx="{{index}}" hover-class="opt-hover" role="button" aria-label="记录{{item.name}}">记录</view>
          </view>
        </view>
      </view>

      <view wx:if="{{recResult.foods.length > 0}}" class="rec-record-all" bindtap="recRecordAll" hover-class="btn-hover" role="button" aria-label="全部记录">全部记录到{{addType}}</view>
      <view wx:if="{{recResult.note}}" class="note">{{recResult.note}}</view>
      <view class="sheet-cancel" bindtap="closeRec" hover-class="btn-hover" role="button" aria-label="关闭">关闭</view>
    </view>
  </view>

  <view class="bottom-gap"></view>
</view>
