/* pages/train-detail/train-detail.wxss —— 品牌焕新版 */
.page { padding: 8rpx 0 40rpx; }

.overview-card { padding: 28rpx 32rpx; }
.ov-date { font-size: var(--fs-title); font-weight: 800; color: var(--text); margin-bottom: 24rpx; }
.ov-session { font-size: var(--fs-label); font-weight: 700; color: var(--primary); }
.ov-grid { display: flex; }
.ov-item { flex: 1; text-align: center; position: relative; }
.ov-item + .ov-item::before { content: ''; position: absolute; left: 0; top: 10rpx; bottom: 10rpx; width: 1rpx; background: var(--line); }
.ov-num { font-size: var(--fs-title); font-weight: 800; color: var(--primary); font-feature-settings: "tnum" 1; }
.ov-num.accent { color: var(--accent); }
.ov-cap { font-size: var(--fs-caption); color: var(--text-sub); margin-top: 6rpx; font-weight: 500; }

.act-card { padding: 24rpx 28rpx; }
.act-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.act-name { font-size: var(--fs-head); font-weight: 700; color: var(--text); }
.act-sets { font-size: var(--fs-label); color: var(--primary-deep); font-weight: 700; background: var(--primary-light); border-radius: 10rpx; padding: 6rpx 16rpx; }

.set-row { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid var(--line); font-size: var(--fs-body); }
.set-row:last-child { border-bottom: none; }
.set-th { color: var(--text-weak); font-size: var(--fs-caption); font-weight: 600; border-bottom: 1rpx solid var(--line-strong); }
.col-idx { flex: 0 0 120rpx; color: var(--text-sub); font-weight: 500; }
.col-num { flex: 1; text-align: center; font-weight: 600; }
.col-time { flex: 1; text-align: center; color: var(--text-sub); font-weight: 500; }
.col-time.rest { color: var(--accent); font-weight: 600; }

.bottom-gap { height: 20rpx; }
