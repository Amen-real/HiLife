<!-- pages/workout/workout.wxml —— 训练执行页（全部动作可滚动列表 + 单卡展开，参考 ui-workout-redesign.html） -->
<view class="page {{theme}}" wx:if="{{!finished}}">
  <nav-bar title="训练中" show-back="{{true}}" />

  <!-- 顶部操作栏：计时器 + 播放/暂停 + 完成（sticky 偏移 navH，避让吸顶的自定义导航栏） -->
  <view class="wo-top" style="--nav-h: {{navH}}px">
    <view class="wo-timer-wrap">
      <text class="wo-timer">{{workoutClock}}</text>
      <view class="wo-clock-toggle" hover-class="press" bindtap="toggleClock">
        <text class="wo-clock-ico">{{clockRunning ? '❚❚' : '▶'}}</text>
      </view>
    </view>
    <view class="wo-done-btn" hover-class="press" bindtap="finishWorkout">完成训练</view>
    <view class="wo-min-btn" hover-class="press" bindtap="minimizePage"><view class="ico ico-minimize ico--ink" style="width:30rpx;height:30rpx"></view></view>
  </view>

  <!-- 训练信息头 -->
  <view class="wo-info">
    <view class="wo-title-row">
      <view class="wo-edit-ico" bindtap="editPlan">✎</view>
      <text class="wo-name">{{planName}}</text>
    </view>
    <view class="wo-stats">
      <view class="wo-stat">{{stats.doneSets}}/{{stats.totalSets}}组  {{stats.doneActions}}/{{stats.totalActions}}动作</view>
      <view class="wo-stat">{{stats.doneVol}}/{{stats.totalVol}}容量</view>
    </view>
  </view>

  <!-- 动作列表 -->
  <view class="wo-ex-list">

    <view class="wo-ex-card {{expandedId === item.id ? 'expanded' : 'collapsed'}}"
          wx:for="{{actions}}" wx:key="id" wx:for-item="item" wx:for-index="ai">

      <!-- 卡片头部 -->
      <view class="wo-ex-head" bindtap="toggleEx" data-id="{{item.id}}">
        <view class="wo-ex-thumb" catchtap="openHero" data-ai="{{ai}}">
          <image wx:if="{{item.video}}" class="wo-ex-thumb-img" src="{{item.video}}" mode="aspectFill" />
          <image wx:elif="{{item.image}}" class="wo-ex-thumb-img" src="{{item.image}}" mode="aspectFill" />
          <view wx:else class="ico ico-train ico--ink" style="width:56rpx;height:56rpx" />
        </view>
        <view class="wo-ex-body">
          <view class="wo-ex-name">{{item.nameZh || item.name}}</view>
          <view class="wo-ex-meta"><text class="wo-ex-vol">{{item.volText}}</text></view>
          <view class="wo-ex-sets-label">{{item.sets.length}}组</view>
          <view class="wo-dots">
            <view class="wo-dot {{set.done ? 'done' : ''}} {{set.current ? 'active' : ''}}"
                  wx:for="{{item.sets}}" wx:for-item="set" wx:for-index="si" wx:key="si"></view>
          </view>
        </view>
        <view class="wo-ex-gear" id="gear-{{item.id}}" catchtap="openActionMenu" data-ai="{{ai}}"><view class="ico ico-more ico--ink" style="width:30rpx;height:30rpx"></view></view>
      </view>

      <!-- 展开内容 -->
      <view class="wo-ex-expanded" wx:if="{{expandedId === item.id}}">
        <view class="wo-note-ph {{item.note ? 'filled' : ''}}" bindtap="editNote" data-ai="{{ai}}">{{item.note || '点击输入备注'}}</view>

        <view class="wo-timer-toggle-row">
          <view class="wo-timer-toggle" bindtap="togglePerSetTimer" data-ai="{{ai}}">
            <view class="wo-checkbox {{item.perSetTimer ? 'checked' : ''}}"></view>
            <text>每组计时</text>
          </view>
          <view class="wo-stopwatch-pill" wx:if="{{item.perSetTimer}}">
            <text class="wo-sw-ico">⏱</text>
            <text class="wo-sw-val">60</text>
          </view>
        </view>

        <!-- 组行 + 每组吃力程度录入（很轻松/有点累/很累/快力竭 4 档，内部映射 4/6/8/10） -->
        <block wx:for="{{item.sets}}" wx:for-item="set" wx:for-index="si" wx:key="si">
          <view class="wo-set-row {{set.done ? 'done' : ''}} {{set.current ? 'current' : ''}}">
            <view class="wo-set-no {{set.warmup ? 'warmup' : 'normal'}}">{{set.warmup ? '热' : (si + 1)}}</view>
            <view class="wo-input-wrap">
              <text class="wo-input-unit">kg</text>
              <input class="wo-set-input" type="digit" value="{{set.weight}}"
                data-ai="{{ai}}" data-si="{{si}}" bindinput="onInputWeight" disabled="{{set.done}}" />
            </view>
            <view class="wo-input-wrap">
              <text class="wo-input-unit">次</text>
              <input class="wo-set-input" type="digit" value="{{set.reps}}"
                data-ai="{{ai}}" data-si="{{si}}" bindinput="onInputReps" disabled="{{set.done}}" />
            </view>
            <!-- 每组计时开启时：⏱ 60 与 ✓ 合并在同一框内 + 已训练耗时 -->
            <block wx:if="{{item.perSetTimer}}">
              <view class="wo-set-check {{set.done ? 'checked' : ''}} wo-set-sw"
                    data-ai="{{ai}}" data-si="{{si}}" catchtap="completeSetTap">
                <block wx:if="{{!set.done}}">
                  <text class="wo-check-sw-ico">⏱</text>
                  <text class="wo-set-sw-sec">{{set.trainSec || 60}}</text>
                </block>
                <text wx:else>✓</text>
              </view>
              <text class="wo-set-rest" wx:if="{{set.restText}}">{{set.restText}}</text>
            </block>
            <!-- 未开启每组计时：原始 ✓ + ⋯ -->
            <block wx:else>
              <view class="wo-set-check {{set.done ? 'checked' : ''}}"
                    data-ai="{{ai}}" data-si="{{si}}" catchtap="completeSetTap">✓</view>
            </block>
            <!-- 删除本组：只剩 1 组时隐藏（此时应删整个动作），避免动作变成 0 组 -->
            <view class="wo-set-del" wx:if="{{item.sets.length > 1}}"
                  data-ai="{{ai}}" data-si="{{si}}" catchtap="deleteSet">✕</view>
          </view>

          <!-- 每组吃力程度：4 档点选（点一下即选，再点同档取消；已完成的组仍可补改） -->
          <view class="wo-rpe">
            <view class="wo-rpe-l">
              <text class="wo-rpe-label">吃力程度</text>
              <text class="wo-rpe-cap">第 {{si + 1}} 组做完的感觉</text>
            </view>
            <view class="wo-rpe-ctrl">
              <view class="wo-rpe-chip {{set.rpe === '4' ? 'on' : ''}}" data-ai="{{ai}}" data-si="{{si}}" data-v="4" catchtap="pickEffort">很轻松</view>
              <view class="wo-rpe-chip {{set.rpe === '6' ? 'on' : ''}}" data-ai="{{ai}}" data-si="{{si}}" data-v="6" catchtap="pickEffort">有点累</view>
              <view class="wo-rpe-chip {{set.rpe === '8' ? 'on' : ''}}" data-ai="{{ai}}" data-si="{{si}}" data-v="8" catchtap="pickEffort">很累</view>
              <view class="wo-rpe-chip {{set.rpe === '10' ? 'on' : ''}}" data-ai="{{ai}}" data-si="{{si}}" data-v="10" catchtap="pickEffort">快力竭</view>
            </view>
          </view>
        </block>

        <!-- 展开底部操作 -->
        <view class="wo-ex-actions">
          <view class="wo-ex-btn primary" bindtap="addSet" data-ai="{{ai}}">+ 新增一组</view>
          <view class="wo-ex-btn ghost" bindtap="openHistory" data-ai="{{ai}}">历史动作</view>
        </view>
      </view>
    </view>

  </view>

  <!-- 底部操作条：添加动作 / 删除训练 -->
  <view class="wo-page-actions">
    <view class="wo-add-btn" hover-class="press" bindtap="openAdd">＋ 添加动作</view>
    <view class="wo-del-btn" hover-class="press" bindtap="deleteWorkout">删除训练</view>
  </view>
  <view class="bottom-gap" />

  <!-- 放大覆盖层：点击缩略图弹出半透明全屏 GIF（gif 用 image 标签渲染，自动循环播放） -->
  <view class="video-mask" wx:if="{{showVideoOverlay}}" bindtap="closeVideoOverlay">
    <image class="video-mask-player" src="{{overlayVideo}}" mode="aspectFit" />
    <cover-view class="video-mask-close" bindtap="closeVideoOverlay">✕</cover-view>
  </view>
</view>

  <!-- 添加动作 overlay（从全量动作库选择动作，追加到当前训练计划） -->
  <view class="repl-mask {{theme}}" wx:if="{{showAdd}}" catchtouchmove="noop">
    <view class="repl-pop">
      <view class="repl-head">
        <text class="repl-title">添加动作</text>
        <text class="repl-sub">已选 {{actions.length}} 个动作</text>
        <view class="repl-close" bindtap="closeAdd">✕</view>
      </view>
      <view class="repl-search">
        <input class="repl-search-input" placeholder="搜索动作名称" value="{{replKeyword}}" bindinput="onReplSearch" confirm-type="search" />
      </view>
      <scroll-view class="repl-cats" scroll-x>
        <view class="repl-cat {{replCat === item ? 'on' : ''}}"
              wx:for="{{replCats}}" wx:key="*this" data-cat="{{item}}" bindtap="onReplCat">{{item}}</view>
      </scroll-view>
      <scroll-view class="repl-body" scroll-y bindscrolltolower="loadMoreRepl" style="{{replBodyH ? 'height:' + replBodyH + 'px' : ''}}">
        <view class="repl-empty" wx:if="{{addFiltered.length === 0}}">没有匹配的动作</view>
        <view class="repl-item"
              wx:for="{{addFiltered}}" wx:key="id" wx:for-item="item"
              bindtap="selectAdd" data-id="{{item.id}}">
          <image wx:if="{{item.video || item.image}}" class="repl-img" src="{{item.video || item.image}}" mode="aspectFill" />
          <view wx:else class="ico ico-train ico--ink" style="width:48rpx;height:48rpx" />
          <view class="repl-info">
            <text class="repl-name">{{item.nameZh || item.name}}</text>
            <text class="repl-cat">{{item.category}}</text>
          </view>
        </view>
        <view class="repl-foot" wx:if="{{addFiltered.length < addFullLen}}">上拉加载更多（{{addFiltered.length}}/{{addFullLen}}）</view>
        <view class="repl-foot done" wx:else>已加载全部</view>
      </scroll-view>
    </view>
  </view>

<!-- 训练计时 最小化悬浮球（fixed 自管拖拽贴边；进度环 + 深色圆心，参考图「计时最小化」方案） -->
<view wx:if="{{showTrain && trainMinimized}}"
      class="mini-float"
      style="{{trainBallStyle}}"
      data-key="train"
      bindtap="expandTrain"
      bindtouchstart="onBallTouchStart"
      catchtouchmove="onBallTouchMove"
      bindtouchend="onBallTouchEnd">
  <view class="mini-ring" style="{{trainBallRingStyle}}"></view>
  <view class="mini-core">
    <text class="mini-num">{{trainLeft}}</text>
    <text class="mini-total">{{trainTotal}}</text>
  </view>
</view>

<!-- 训练计时 overlay（5秒准备 + 60秒训练）—— 深色卡 + 大进度环，参考图「计时开始倒计时」方案 -->
<view class="rest-mask {{theme}}" wx:if="{{showTrain && !trainMinimized}}" catchtouchmove="noop">
  <view class="rest-pop dark">
    <view class="pop-head">
      <text class="pop-label">TRAINING TIMER</text>
      <view class="rest-pop-mini" hover-class="press" bindtap="minimizeTrain"></view>
    </view>
    <view class="pop-ring" style="{{trainRingStyle}}">
      <view class="pop-ring-core">
        <text class="pop-phase">{{trainPhase === 'ready' ? '准备' : '训练中'}}</text>
        <text class="pop-num">{{trainLeft}}</text>
        <view class="pop-total-pill"><text>总共 {{trainTotal}} 秒</text></view>
      </view>
    </view>
    <view class="pop-btns">
      <view wx:if="{{trainPhase === 'ready'}}" class="pop-btn ghost" hover-class="press" bindtap="cancelTrain">取消</view>
      <view class="pop-btn primary" hover-class="press" bindtap="{{trainPhase === 'ready' ? 'skipTrain' : 'cancelTrain'}}">{{trainPhase === 'ready' ? '跳过' : '结束训练'}}</view>
    </view>
  </view>
</view>

<!-- 组间休息 最小化悬浮球（fixed 自管拖拽贴边；进度环 + 深色圆心） -->
<view wx:if="{{showRest && restMinimized}}"
      class="mini-float"
      style="{{restBallStyle}}"
      data-key="rest"
      bindtap="expandRest"
      bindtouchstart="onBallTouchStart"
      catchtouchmove="onBallTouchMove"
      bindtouchend="onBallTouchEnd">
  <view class="mini-ring" style="{{restBallRingStyle}}"></view>
  <view class="mini-core">
    <text class="mini-num">{{restClock}}</text>
    <text class="mini-total">{{restTotal}}</text>
  </view>
</view>

<!-- 组间休息倒计时悬浮窗（±微调 + 震动开关 + 完成）；最后一组完成时切换为「训练完成」保存态。参考图「休息计时」方案 -->
<view class="rest-mask {{theme}}" wx:if="{{showRest && !restMinimized}}" catchtouchmove="noop">
  <view class="rest-pop dark">
    <view class="pop-head">
      <view wx:if="{{restKind !== 'done'}}" class="pop-pill {{vibrateOn ? 'on' : ''}}" hover-class="press" bindtap="toggleVibrate">手机震动</view>
      <view wx:else class="pop-pill-ghost"></view>
      <view class="pop-pill" hover-class="press" bindtap="minimizeRest">最小化</view>
    </view>
    <view class="pop-title">{{restKind === 'done' ? '训练完成' : '休息计时'}}</view>
    <view class="pop-sub" wx:if="{{restKind !== 'done'}}">{{restKind === 'action' ? '动作间休息' : (restKind === 'last' ? '最后一组完成' : '组间休息')}} · 第 {{actNo + 1}} 组完成</view>
    <view class="pop-sub" wx:else>全部动作完成 · 点击下方按钮保存</view>
    <view wx:if="{{restKind === 'done'}}" class="rest-pop-emoji solid"><view class="ico ico-trophy ico--ink" style="width:60rpx;height:60rpx" /></view>
    <view wx:else class="pop-ring" style="{{restRingStyle}}">
      <view class="pop-ring-core">
        <text class="pop-num big">{{restClock}}</text>
        <text class="pop-total">{{restTotal}}</text>
      </view>
    </view>
    <view class="pop-btns row" wx:if="{{restKind !== 'done'}}">
      <view class="pop-btn ghost sq" hover-class="press" bindtap="adjustRest" data-delta="-10">−10s</view>
      <view class="pop-btn ghost sq" hover-class="press" bindtap="adjustRest" data-delta="10">+10s</view>
      <view class="pop-btn primary" hover-class="press" bindtap="skipRest">完成</view>
    </view>
    <view class="pop-btns" wx:else>
      <view class="pop-btn primary" hover-class="press" bindtap="skipRest">保存训练</view>
    </view>
  </view>
</view>

<!-- 动作历史 overlay：本次明细 + 上次同动作每组对比（↑↓）+ 历史最佳重量/容量 -->
<view class="hist-mask {{theme}}" wx:if="{{showHistory}}" catchtouchmove="noop">
  <view class="hist-pop">
    <view class="hist-head">
      <text class="hist-title">动作历史</text>
      <view class="hist-close" bindtap="closeHistory">✕</view>
    </view>
    <scroll-view class="hist-body" scroll-y wx:if="{{histAction && hist}}">
      <view class="hist-act-name">{{histAction.nameZh || histAction.name}}</view>

      <!-- 概览：上次日期 / 最佳重量 / 最佳容量 / 历史场次 -->
      <view class="hist-summary">
        <view class="hs-item">
          <text class="hs-k">上次</text>
          <text class="hs-v">{{hist.prevDate || '暂无'}}</text>
        </view>
        <view class="hs-item">
          <text class="hs-k">最佳重量</text>
          <text class="hs-v">{{hist.bestWeight ? hist.bestWeight + 'kg' : '-'}}</text>
        </view>
        <view class="hs-item">
          <text class="hs-k">最佳容量</text>
          <text class="hs-v">{{hist.bestVolume ? hist.bestVolume + 'kg' : '-'}}</text>
        </view>
        <view class="hs-item">
          <text class="hs-k">历史场次</text>
          <text class="hs-v">{{hist.sessions}}</text>
        </view>
      </view>
      <view wx:if="{{!hist.hasHistory}}" class="hist-empty">保存本次训练后即可看到历史对比</view>

      <!-- 本次每组明细（含相对上次同组的变化） -->
      <view class="hist-sec-t">本次 · 每组明细</view>
      <view class="hist-set" wx:for="{{hist.sets}}" wx:for-item="s" wx:key="no">
        <view class="hist-set-line1">
          <text class="hist-set-no">第{{s.no}}组</text>
          <text class="hist-set-rep">{{s.reps}} 次 × {{s.weight}} kg</text>
          <text wx:if="{{s.hasDw}}" class="hist-delta {{s.dw > 0 ? 'up' : (s.dw < 0 ? 'down' : '')}}">{{s.dw > 0 ? '↑' : (s.dw < 0 ? '↓' : '=')}}{{s.dw !== 0 ? s.dwAbs + 'kg' : ''}}</text>
          <text wx:if="{{s.hasDr}}" class="hist-delta {{s.dr > 0 ? 'up' : 'down'}}">{{s.dr > 0 ? '↑' : '↓'}}{{s.drAbs}}次</text>
        </view>
        <view class="hist-set-line2">
          <text>训练 {{s.trainSec || '-'}}s</text>
          <text class="hist-dot">·</text>
          <text>休息 {{s.restSec || '-'}}s</text>
          <text wx:if="{{s.rpe}}" class="hist-dot">·</text>
          <text wx:if="{{s.rpe}}">吃力 {{s.rpe}}</text>
        </view>
      </view>

      <!-- 上次同动作每组数据 -->
      <block wx:if="{{hist.hasHistory}}">
        <view class="hist-sec-t">上次 {{hist.prevDate}} · 每组</view>
        <view class="hist-set hist-set-past" wx:for="{{hist.prevSets}}" wx:for-item="s" wx:key="no">
          <view class="hist-set-line1">
            <text class="hist-set-no">第{{s.no}}组</text>
            <text class="hist-set-rep">{{s.reps}} 次 × {{s.weight}} kg</text>
            <text wx:if="{{s.rpe}}" class="hist-dot">吃力 {{s.rpe}}</text>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
</view>

<!-- 替换动作 overlay（从动作库选择其他动作替换当前动作，保留已有组数据） -->
<view class="repl-mask {{theme}}" wx:if="{{showReplace}}" catchtouchmove="noop">
  <view class="repl-pop">
    <view class="repl-head">
      <text class="repl-title">替换动作</text>
      <text class="repl-sub">当前：{{replaceTargetName}}</text>
      <view class="repl-close" bindtap="closeReplace">✕</view>
    </view>
    <view class="repl-search">
      <input class="repl-search-input" placeholder="搜索动作名称" value="{{replKeyword}}" bindinput="onReplSearch" confirm-type="search" />
    </view>
    <scroll-view class="repl-cats" scroll-x>
      <view class="repl-cat {{replCat === item ? 'on' : ''}}"
            wx:for="{{replCats}}" wx:key="*this" data-cat="{{item}}" bindtap="onReplCat">{{item}}</view>
    </scroll-view>
      <scroll-view class="repl-body" scroll-y bindscrolltolower="loadMoreRepl" style="{{replBodyH ? 'height:' + replBodyH + 'px' : ''}}">
        <view class="repl-empty" wx:if="{{replaceFiltered.length === 0}}">没有匹配的动作</view>
        <view class="repl-item {{item.id === replaceTargetId ? 'current' : ''}}"
              wx:for="{{replaceFiltered}}" wx:key="id" wx:for-item="item"
              bindtap="selectReplacement" data-id="{{item.id}}">
        <image wx:if="{{item.video || item.image}}" class="repl-img" src="{{item.video || item.image}}" mode="aspectFill" />
        <view wx:else class="ico ico-train ico--ink" style="width:48rpx;height:48rpx" />
        <view class="repl-info">
          <text class="repl-name">{{item.nameZh || item.name}}</text>
          <text class="repl-cat">{{item.category}}</text>
        </view>
        <view class="repl-check" wx:if="{{item.id === replaceTargetId}}">✓</view>
      </view>
        <view class="repl-foot" wx:if="{{replaceFiltered.length < replaceFullLen}}">上拉加载更多（{{replaceFiltered.length}}/{{replaceFullLen}}）</view>
        <view class="repl-foot done" wx:else>已加载全部</view>
      </scroll-view>
  </view>
</view>

<!-- 单动作操作菜单（头部 ⋯）：锚定齿轮下方的悬浮小窗，点空白处关闭 -->
<view class="exmenu-mask {{theme}}" wx:if="{{showActionMenu}}" bindtap="closeActionMenu" catchtouchmove="noop">
  <view class="exmenu-pop" style="{{menuPosStyle}}" catchtap="noop">
    <view class="exmenu-title">{{menuActionName}}</view>
    <view class="exmenu-item" bindtap="menuGoDetail">
      <view class="exmenu-ic"><view class="ico ico-info ico--ink" style="width:30rpx;height:30rpx"></view></view>
      <text class="exmenu-t">动作详情</text>
    </view>
    <view class="exmenu-item" bindtap="menuReplaceAction">
      <view class="exmenu-ic"><view class="ico ico-swap ico--ink" style="width:30rpx;height:30rpx"></view></view>
      <text class="exmenu-t">替换动作</text>
    </view>
    <view class="exmenu-item danger" bindtap="menuDeleteAction">
      <view class="exmenu-ic danger-ic">✕</view>
      <text class="exmenu-t">删除动作</text>
    </view>
  </view>
</view>

<!-- 完成态 -->
<view class="page finished {{theme}}" wx:if="{{finished}}">
  <view class="done-emoji"><view class="ico ico-trophy ico--primary" style="width:120rpx;height:120rpx"></view></view>
  <view class="done-title">训练完成</view>
  <view class="done-sub">正在保存…</view>
</view>
