/* pages/workout/workout.wxss —— 训练执行页（全部动作可滚动列表 + 单卡展开） */
.page {
  min-height: 100vh;
  /* 背景色已去除：根 view 透明，直接沿用 app.wxss 的 page 底色 var(--n-50)（暖白），与全局页面统一 */
  padding: 0;
  box-sizing: border-box;
}

/* 按钮点击态 */
.press { opacity: 0.82; }
.bottom-gap { height: 48rpx; }

/* ==================== 训练中页面（对齐 ui-workout-redesign.html） ==================== */

/* ---- 顶部操作栏 ---- */
.wo-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx 16rpx;
  position: sticky;
  /* sticky 偏移：--nav-h 由 onLoad 实测注入（状态栏高 + 44px 导航栏），避免与吸顶的自定义导航栏重叠 */
  top: var(--nav-h, 0px);
  z-index: 50;
  /* 清除原深绿实底，改为透明、与页面柔和底色融为一体；下方细线作轻分隔 */
  background: transparent;
  border-bottom: 1rpx solid var(--line);
}
.wo-timer-wrap { flex: 1; display: flex; align-items: center; }
.wo-timer {
  font-size: var(--fs-hero);
  font-weight: 800;
  color: var(--text);
  letter-spacing: -1rpx;
  line-height: 1;
  font-feature-settings: "tnum";
}
/* 播放/暂停按钮（在倒计时后，手动控制全局计时） */
.wo-clock-toggle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: 24rpx;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease;
}
.wo-clock-toggle:active { background: rgba(0, 0, 0, 0.08); }
.wo-clock-ico {
  color: var(--text);
  font-size: var(--fs-head);
  line-height: 1;
  font-weight: 700;
}
.wo-done-btn {
  height: 72rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #0A0A0A;
  font-size: var(--fs-head);
  font-weight: 700;
  line-height: 72rpx;
  box-shadow: var(--shadow-mint);
  flex-shrink: 0;
}
.wo-done-btn::after { border: none; }

/* ---- 训练信息头 ---- */
.wo-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 0;
}
.wo-title-row { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.wo-edit-ico { font-size: var(--fs-head); color: var(--text-sub); flex-shrink: 0; }
.wo-name { font-size: var(--fs-title); font-weight: 700; color: var(--text); }
.wo-stats { text-align: right; flex-shrink: 0; }
.wo-stat { font-size: var(--fs-caption); color: var(--text-sub); line-height: 1.6; font-feature-settings: "tnum"; }

/* ---- 动作列表 ---- */
.wo-ex-list { padding: 16rpx 32rpx 0; }

.wo-ex-card {
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

/* 卡片头部 */
.wo-ex-head { display: flex; align-items: center; gap: 20rpx; }
.wo-ex-thumb {
  width: 92rpx;
  height: 92rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: linear-gradient(135deg, var(--primary-tint), rgba(124, 184, 0, 0.12));
  display: flex;
  align-items: center;
  justify-content: center;
}
.wo-ex-thumb-img { width: 100%; height: 100%; }
.wo-ex-body { flex: 1; min-width: 0; }
.wo-ex-name {
  font-size: var(--fs-head);
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.wo-ex-meta { display: flex; align-items: center; gap: 16rpx; margin-top: 6rpx; }
.wo-ex-vol { font-size: var(--fs-label); color: var(--text-weak); font-feature-settings: "tnum"; }
.wo-ex-sets-label { font-size: var(--fs-body); color: var(--text-sub); margin-top: 12rpx; }
.wo-ex-gear {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: 8rpx;
  background-color: rgba(124, 184, 0, 0.14);
  border: 2rpx solid rgba(124, 184, 0, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.15s ease, transform 0.12s ease;
}
/* 替换动作图标改用统一图标系统 <view class="ico ico-swap ico--ink">（见 styles/icons.wxss），旧 base64 背景图已移除 */
.wo-ex-gear:active { background-color: rgba(124, 184, 0, 0.28); transform: scale(0.92); }

/* 组数圆点指示器 */
.wo-dots { display: flex; gap: 10rpx; margin-top: 12rpx; }
.wo-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--line-strong); }
.wo-dot.done { background: var(--primary); }
.wo-dot.active { background: var(--primary-deep); box-shadow: 0 0 0 6rpx rgba(124, 184, 0, 0.25); }

/* ---- 展开态 ---- */
.wo-ex-expanded { margin-top: 20rpx; }
.wo-note-ph {
  font-size: var(--fs-body);
  color: var(--text-weak);
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.wo-note-ph.filled {
  color: var(--text);
  line-height: 1.6;
}
.wo-timer-toggle-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}
.wo-timer-toggle {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: var(--fs-body);
  color: var(--text-sub);
}
.wo-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 4rpx solid var(--line-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.wo-checkbox.checked { border-color: var(--primary); background: var(--primary); }
.wo-checkbox.checked::after { content: '✓'; color: #0A0A0A; font-size: var(--fs-body); font-weight: 700; line-height: 1; }

/* 每组计时开启后显示的秒表目标提示（⏱ 60，与开关同行） */
.wo-stopwatch-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--primary-tint);
  border: 1rpx solid rgba(124, 184, 0, 0.30);
}
.wo-sw-ico { font-size: var(--fs-label); line-height: 1; }
.wo-sw-val {
  font-size: var(--fs-label);
  font-weight: 700;
  color: var(--primary-text);
  font-feature-settings: "tnum";
}

/* 组行：[组号] [kg] [次] [✓] [⋯] */
.wo-set-row {
  display: flex;
  align-items: center;
  /* 组内 6 个参数（组号 / 重量 / 次数 / ⏱✓ / 休息 / 删除✕）分布：
     删除 ✕ 定宽 56rpx，休息列 flex:1 吸收剩余空间；gap 由 12 收窄到 8rpx 腾出位置 */
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 14rpx 20rpx;
  background: var(--bg);
  border: 1rpx solid transparent;
  border-radius: 22rpx;
}
.wo-set-row.current { border-color: var(--primary); background: var(--primary-tint); }
.wo-set-row.done { opacity: 0.55; }
.wo-set-no {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 800;
  line-height: 1;
}
.wo-set-no.warmup { background: rgba(255, 177, 153, 0.20); color: #E8743B; }
.wo-set-no.normal { background: var(--bg); color: var(--text-sub); border: 1rpx solid var(--line); }

.wo-input-wrap { position: relative; flex-shrink: 0; }
.wo-input-unit {
  position: absolute;
  top: 6rpx;
  left: 14rpx;
  font-size: var(--fs-caption);
  font-weight: 500;
  color: var(--text-weak);
  line-height: 1;
  pointer-events: none;
  z-index: 2;
}
.wo-set-input {
  width: 108rpx;
  height: 72rpx;
  border-radius: 16rpx;
  text-align: center;
  padding-top: 16rpx;
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--text);
  font-feature-settings: "tnum";
  background: var(--card);
  border: 1rpx solid var(--line);
}
.wo-set-check {
  min-width: 88rpx;
  height: 72rpx;
  padding: 0 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  border: 4rpx solid var(--line-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: var(--fs-title);
  color: var(--text-weak);
  position: relative;
  box-sizing: border-box;
}
.wo-set-check.checked { border-color: var(--primary); background: var(--primary); color: #0A0A0A; }

/* ⏱ 60 与 ✓ 合并在同一框内（未完成显示 ⏱ 60，完成后显示 ✓） */
.wo-check-sw-ico {
  font-size: var(--fs-caption);
  line-height: 1;
  color: var(--primary-text);
}
.wo-set-sw-sec {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--primary-text);
  font-feature-settings: "tnum";
}

/* 每组休息时长（✓ 右侧显示，如 00:10）。放大至 --fs-body 与行内重量/次数/训练秒对齐 */
.wo-set-rest {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--info);
  font-feature-settings: "tnum";
  flex: 1;
  min-width: 96rpx;
  text-align: center;
}

/* 删除本组：组行行尾 ✕（红色危险态；该动作只剩 1 组时由 wxml 隐藏） */
.wo-set-del {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #F2545B;
  background: rgba(242, 84, 91, 0.10);
  border: 1rpx solid rgba(242, 84, 91, 0.45);
  box-sizing: border-box;
}
.wo-set-del:active { background: rgba(242, 84, 91, 0.24); }
/* 触控热区扩到约 88rpx（视觉尺寸不变，满足 44px 最小触控目标），不影响行内布局 */
.wo-set-del::after {
  content: '';
  position: absolute;
  left: -16rpx;
  right: -16rpx;
  top: -16rpx;
  bottom: -16rpx;
}

/* 每组吃力程度录入行（4 档口语点选，内部映射 RPE 4/6/8/10，供复盘努力度维度） */
.wo-rpe {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(200, 255, 0, 0.06);
  border: 1rpx solid rgba(200, 255, 0, 0.16);
  border-radius: 16rpx;
}
.wo-rpe-l { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; flex-shrink: 0; }
.wo-rpe-label {
  font-size: var(--fs-body);
  font-weight: 800;
  color: var(--primary-text);
  line-height: 1;
}
.wo-rpe-cap {
  font-size: var(--fs-caption);
  color: var(--text-weak);
  line-height: 1;
  white-space: nowrap;
}
.wo-rpe-ctrl {
  flex: 1; min-width: 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}
.wo-rpe-chip {
  height: 56rpx;
  border-radius: var(--r-pill);
  background: var(--card);
  border: 1rpx solid var(--n-200);
  color: var(--n-600);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  transition: transform 0.12s ease, background 0.12s ease, color 0.12s ease;
}
.wo-rpe-chip:active { transform: scale(0.94); }
.wo-rpe-chip.on {
  background: var(--primary);
  border-color: var(--primary);
  color: #0A0A0A;
  font-weight: 800;
}

/* 展开底部操作按钮 */
.wo-ex-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.wo-ex-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 20rpx;
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}
.wo-ex-btn.primary { background: var(--primary); color: #0A0A0A; box-shadow: var(--shadow-mint); }
.wo-ex-btn.ghost { background: var(--bg); color: var(--primary-text); border: 1rpx solid var(--line); }

/* ==================== 训练计时 / 休息 / 历史 / 视频 浮层（沿用原 UI） ==================== */

/* ── 休息倒计时悬浮窗 ── */
.rest-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  animation: rest-fade 0.2s ease;
}
.rest-pop {
  position: relative;
  width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 56rpx 40rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.25);
  animation: rest-pop 0.26s cubic-bezier(0.34, 1.56, 0.64, 1);
}
/* —— 参考图方案：计时弹窗为固定深色卡（不随主题翻转），荧光绿 = 训练 / 能量橙 = 休息 —— */
.rest-pop.dark {
  background: #161616;
  padding: 32rpx 40rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.45);
}
/* 弹窗头：左标签（或胶囊）+ 右侧操作 */
.pop-head { width: 100%; display: flex; align-items: center; justify-content: space-between; }
.pop-label {
  font-family: var(--f-en, sans-serif);
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.45);
}
.pop-pill {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.65);
  font-size: 24rpx;
}
.pop-pill.on { background: rgba(200, 255, 0, 0.16); color: #C8FF00; font-weight: 600; }
/* done 态头部左侧占位，保持「最小化」靠右 */
.pop-pill-ghost { width: 100rpx; height: 52rpx; }
.pop-title { font-size: 36rpx; font-weight: 600; color: #FFFFFF; margin-top: 24rpx; }
.pop-sub { font-size: 24rpx; color: rgba(255, 255, 255, 0.5); margin-top: 8rpx; }
/* 完成态徽章：实心荧光绿底 + 深色图标（绿底配 #0A0A0A 铁律） */
.rest-pop-emoji {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin: 28rpx 0 8rpx;
  background: rgba(200, 255, 0, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}
.rest-pop-emoji.solid { background: #C8FF00; }
/* 大进度环：conic-gradient 扇形背景由 JS 内联注入；内芯深色圆盘留出环宽 */
.pop-ring { width: 320rpx; height: 320rpx; border-radius: 50%; margin: 32rpx 0 8rpx; position: relative; }
.pop-ring-core {
  position: absolute;
  left: 14rpx; top: 14rpx; right: 14rpx; bottom: 14rpx;
  border-radius: 50%;
  background: #161616;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.pop-phase { font-size: 26rpx; color: rgba(255, 255, 255, 0.6); }
.pop-num {
  font-size: 96rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.15;
  font-family: var(--f-en, sans-serif);
}
.pop-num.big { font-size: 72rpx; }
.pop-total-pill {
  margin-top: 4rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
}
.pop-total-pill text { font-size: 22rpx; color: rgba(255, 255, 255, 0.55); }
.pop-total { margin-top: 2rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.45); }
/* 底部按钮组：ghost 次操作 + primary 主操作（荧光绿底配深色字） */
.pop-btns { display: flex; gap: 20rpx; margin-top: 32rpx; width: 100%; }
.pop-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  transition: opacity 0.15s ease;
}
.pop-btn.ghost { background: rgba(255, 255, 255, 0.08); color: rgba(255, 255, 255, 0.85); }
.pop-btn.ghost.sq { flex: 0 0 auto; padding: 0 32rpx; }
.pop-btn.primary { background: #C8FF00; color: #0A0A0A; font-weight: 600; }

/* 弹窗头「最小化到悬浮窗」图标按钮（—） */
.rest-pop-mini {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease;
}
.rest-pop-mini::before {
  content: '';
  width: 26rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.6);
}

/* 最小化悬浮球：fixed 自管拖拽（left/top 由 JS 内联 style 注入，px）；
   结构 = conic 进度环(.mini-ring，JS 注入背景) + 深色圆心(.mini-core)，参考图「计时最小化」方案 */
.mini-float {
  position: fixed;
  left: 0;
  top: 0;
  /* 高于自定义导航栏（z-index 999），拖到顶部也不被盖住 */
  z-index: 1200;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}
.mini-ring { position: absolute; left: 0; top: 0; width: 100%; height: 100%; border-radius: 50%; }
.mini-core {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border-radius: 50%;
  background: #161616;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.mini-num {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.15;
  font-family: var(--f-en, sans-serif);
}
.mini-total { font-size: 18rpx; color: rgba(255, 255, 255, 0.45); line-height: 1.3; }

/* 无障碍：尊重系统「减少动态效果」设置，关闭弹窗入场动画 */
@media (prefers-reduced-motion: reduce) {
  .rest-mask, .rest-pop { animation: none !important; }
}

@keyframes rest-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes rest-pop { from { opacity: 0; transform: scale(0.85); } to { opacity: 1; transform: scale(1); } }

/* ── 动作历史 overlay（底部上滑） ── */
.hist-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 140;
  animation: rest-fade 0.2s ease;
}
.hist-pop {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -10rpx 40rpx rgba(15, 23, 42, 0.2);
  animation: hist-up 0.26s ease;
}
@keyframes hist-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
.hist-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx 16rpx;
}
.hist-title { font-size: var(--fs-title); font-weight: 600; color: var(--text); }
.hist-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  color: var(--text-weak);
  font-size: var(--fs-title);
}
.hist-body {
  flex: 1;
  padding: 0 40rpx 40rpx;
  box-sizing: border-box;
}
.hist-act-name {
  font-size: var(--fs-head);
  font-weight: 600;
  color: var(--text);
  margin: 24rpx 0 12rpx;
}
.hist-set {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}
.hist-set-line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
/* 组号原为 var(--primary)（#C8FF00 字压浅底≈1.1:1 隐形），按绿字铁律改 --primary-text */
.hist-set-no { font-size: var(--fs-body); font-weight: 600; color: var(--primary-text); }
.hist-set-rep { font-size: var(--fs-body); color: var(--text-sub); }
.hist-set-line2 {
  margin-top: 8rpx;
  font-size: var(--fs-label);
  color: var(--text-weak);
}
.hist-dot { margin: 0 12rpx; }

/* ── 历史面板：概览条 / 分段标题 / 升降标记 ── */
.hist-summary {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin: 16rpx 0 8rpx;
}
.hs-item {
  flex: 1;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 14rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hs-k { font-size: var(--fs-caption); color: var(--text-weak); line-height: 1.4; }
.hs-v { font-size: var(--fs-label); font-weight: 700; color: var(--text); line-height: 1.4; }
.hist-sec-t {
  margin: 24rpx 0 12rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-sub);
}
.hist-empty {
  margin-top: 8rpx;
  font-size: var(--fs-label);
  color: var(--text-weak);
  text-align: center;
}
/* 相对上次的变化：涨=红(#F2545B) / 跌=绿(深橄榄 --primary-text)，中国市场红涨绿跌 */
.hist-delta {
  margin-left: 12rpx;
  font-size: var(--fs-caption);
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--text-weak);
}
.hist-delta.up { color: #F2545B; background: rgba(242, 84, 91, 0.12); }
.hist-delta.down { color: var(--primary-text); background: var(--primary-tint); }
.hist-set-past { opacity: 0.85; }

/* ── 替换动作 overlay（底部上滑选择列表） ── */
.repl-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 145;
  animation: rest-fade 0.2s ease;
}
.repl-pop {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -10rpx 40rpx rgba(15, 23, 42, 0.2);
  animation: hist-up 0.26s ease;
}
.repl-head {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx 16rpx;
  position: relative;
}
.repl-title { font-size: var(--fs-title); font-weight: 600; color: var(--text); }
.repl-sub {
  font-size: var(--fs-label);
  color: var(--text-sub);
  margin-left: 16rpx;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.repl-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  color: var(--text-weak);
  font-size: var(--fs-title);
  flex-shrink: 0;
}
.repl-body {
  flex: 1;
  min-height: 0;
  padding: 0 40rpx 40rpx;
  box-sizing: border-box;
}
/* 双排网格（对齐训练页动作库卡片） */
.repl-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  background: var(--bg);
  border: 2rpx solid transparent;
  transition: border-color .15s;
}
.repl-item.current {
  border-color: var(--primary);
  background: var(--primary-tint);
}
.repl-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--primary-tint), rgba(124, 184, 0, 0.12));
}
.repl-info { flex: 1; min-width: 0; }
.repl-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text);
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.repl-cat {
  font-size: var(--fs-caption);
  color: var(--text-sub);
  margin-top: 4rpx;
  display: block;
}
.repl-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #0A0A0A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 700;
  flex-shrink: 0;
}

/* 浮层底部：上拉加载更多 / 已加载全部 提示 */
.repl-foot {
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--text-weak);
  padding: 24rpx 0 8rpx;
}
.repl-foot.done { color: var(--text-sub); }

/* 完成态 */
.page.finished {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}
.done-emoji { font-size: var(--fs-mega); margin-bottom: 24rpx; }
.done-title { font-size: var(--fs-section); font-weight: 500; color: var(--text); }
.done-sub { font-size: var(--fs-body); color: var(--text-weak); margin-top: 12rpx; }

/* 视频放大覆盖层 */
.video-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.video-mask-player {
  width: 92vw;
  height: 92vw;
  border-radius: 16rpx;
  background-color: #000;
}
.video-mask-close {
  position: absolute;
  right: 48rpx;
  top: 48rpx;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  color: #fff;
  font-size: var(--fs-page);
  background-color: rgba(255, 255, 255, 0.22);
  border-radius: 50%;
}

/* ==================== 训练中页：顶部最小化 / 底部添加动作 / 悬浮药丸 ==================== */

/* 顶部最小化按钮：CSS 绘制「缩到悬浮窗」图标（圆角方框 + 底部横条），替代原 ▭ 文本 */
.wo-min-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: 16rpx;
  /* 原用 --bg(#F1F1EE) 与页面底几乎同值导致圆底不可见；改 --card + 描边，双主题都清晰 */
  background: var(--card);
  border: 2rpx solid var(--line-strong);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.wo-min-btn:active { background: rgba(0, 0, 0, 0.08); }
/* 最小化图标改用统一图标系统 <view class="ico ico-minimize ico--ink">（见 styles/icons.wxss），旧 CSS 画法已移除 */

/* 底部操作条：添加动作（sticky 贴底，玻璃渐隐底） */
.wo-page-actions {
  position: sticky;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 247, 245, 0) 0%, rgba(247, 247, 245, 0.96) 50%, var(--n-50) 100%);
}
.wo-add-btn {
  flex: 1 1 auto;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--primary);
  color: #0A0A0A;
  font-size: var(--fs-head);
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
  box-shadow: var(--shadow-mint);
}
.wo-add-btn::after { border: none; }
.wo-del-btn {
  flex: 0 0 220rpx;
  height: 88rpx;
  margin-left: 20rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #F2545B;
  font-size: var(--fs-head);
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
  border: 2rpx solid rgba(242, 84, 91, 0.45);
}
.wo-del-btn::after { border: none; }

/* 浮层搜索框 + 分类筛选 */
.repl-search {
  padding: 8rpx 40rpx 4rpx;
}
.repl-search-input {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: var(--bg);
  border: 2rpx solid var(--line);
  font-size: var(--fs-body);
  color: var(--text);
  box-sizing: border-box;
}
.repl-cats {
  white-space: nowrap;
  padding: 16rpx 32rpx 8rpx;
  box-sizing: border-box;
}
.repl-cat {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: var(--bg);
  border: 2rpx solid var(--line);
  font-size: var(--fs-body);
  color: var(--text-sub);
  transition: all .15s;
}
.repl-cat.on {
  background: var(--primary);
  border-color: var(--primary);
  color: #0A0A0A;
  font-weight: 600;
}
.repl-empty {
  text-align: center;
  color: var(--text-weak);
  font-size: var(--fs-body);
  padding: 48rpx 0;
}


/* ============================================================
   深色主题（.page.theme-dark 重定义 token，向下继承自动翻转；
   页面外的浮层 mask 也挂了 .theme-dark 类，与 .page 共享同一套变量）
   ============================================================ */
.page.theme-dark,
.rest-mask.theme-dark,
.hist-mask.theme-dark,
.repl-mask.theme-dark {
  --n-950: #FFFFFF;
  --n-900: #FFFFFF;
  --n-700: rgba(255,255,255,.70);
  --n-600: rgba(255,255,255,.55);
  --n-500: rgba(255,255,255,.42);
  --n-400: rgba(255,255,255,.32);
  --n-300: rgba(255,255,255,.22);
  --n-200: rgba(255,255,255,.10);
  --n-100: #1E1E1E;
  --n-50: #0A0A0A;
  --white: #161616;
  --card-gray: #1E1E1E;

  --text: #FFFFFF;
  --text-sub: rgba(255,255,255,.70);
  --text-weak: rgba(255,255,255,.45);
  --line: rgba(255,255,255,.10);
  --line-strong: rgba(255,255,255,.20);

  --success: #C8FF00;

  --card: #161616;
  --bg: rgba(255,255,255,.06);
  --bg-muted: #1E1E1E;
  --glass: #161616;
  --glass-strong: #1E1E1E;
  --glass-border: rgba(255,255,255,.10);

  --primary-tint: rgba(200,255,0,.12);
  --accent-soft: rgba(255,149,0,.14);
  --accent-tint: rgba(255,149,0,.14);
  --info-tint: rgba(62,139,255,.14);

  /* 绿色文字：浅色的深橄榄绿在黑底上只有 3.8:1，翻成品牌亮绿 */
  --primary-text: #C8FF00;

  --shadow-card: 0 4rpx 16rpx rgba(0,0,0,.35);
  --shadow-sm: 0 4rpx 16rpx rgba(0,0,0,.30);
  --shadow-md: 0 10rpx 30rpx rgba(0,0,0,.40);
  --shadow-lg: 0 16rpx 44rpx rgba(0,0,0,.50);
  --shadow-xs: 0 2rpx 8rpx rgba(0,0,0,.30);
}

/* 页面底色：原生 page 元素吃不到 .page 上的变量重定义，必须在 .page 上显式铺深底 */
.page.theme-dark { background: var(--n-50); color: var(--text); }

/* 深色下的硬编码色单独覆盖 */
.page.theme-dark .wo-del-btn { background: #161616; }
.page.theme-dark .wo-page-actions { background: linear-gradient(180deg, rgba(10,10,10,0) 0%, rgba(10,10,10,0.96) 50%, #0A0A0A 100%); }
.page.theme-dark .wo-clock-toggle:active { background: rgba(255,255,255,0.10); }
.page.theme-dark .wo-min-btn:active { background: #1E1E1E; } /* 比 --card(#161616) 亮一档的按压态 */
.rest-mask.theme-dark .rest-pop,
.hist-mask.theme-dark .hist-pop,
.repl-mask.theme-dark .repl-pop { background: #161616; }

/* ═══════ 单动作操作菜单（头部 ⋯）：锚定齿轮下方的悬浮小窗 ═══════ */
.exmenu-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.20);
  z-index: 3200;
}
.exmenu-pop {
  position: fixed;
  min-width: 300rpx;
  max-width: 70vw;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.22);
  padding: 8rpx 0;
  z-index: 3201;
  transform-origin: top right;
  animation: exmenu-in .18s ease;
}
.exmenu-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-sub);
  padding: 14rpx 24rpx 10rpx;
  border-bottom: 1rpx solid var(--line);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.exmenu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
}
.exmenu-item:active { background: var(--bg); }
.exmenu-ic {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.exmenu-ic.danger-ic {
  font-size: 24rpx;
  font-weight: 700;
  color: #F2545B;
  background: rgba(242, 84, 91, 0.12);
}
.exmenu-t {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}
.exmenu-item.danger .exmenu-t { color: #F2545B; }
@keyframes exmenu-in {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

/* 深色：悬浮小窗底色 + 删除项可见度补偿（#F2545B 压 #161616 ≈ 5.4:1，达标） */
.exmenu-mask.theme-dark { background: rgba(0, 0, 0, 0.45); }
.exmenu-mask.theme-dark .exmenu-pop { background: #161616; }
.page.theme-dark .wo-set-del {
  background: rgba(242, 84, 91, 0.16);
  border-color: rgba(242, 84, 91, 0.60);
}
