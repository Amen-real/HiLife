/* pages/weight-record/weight-record.wxss —— 严格按 10-weight.html（暖白底 + 荧光绿） */
.page { width: 100vw; box-sizing: border-box; min-height: 100vh; padding-top: 112rpx; }

/* HEADER */
.header {
  position: fixed; left: 0; top: 0; right: 0;
  z-index: 20;
  height: 112rpx;
  padding: 0 40rpx;
  background: var(--n-50, #F7F7F5);
  border-bottom: 1rpx solid var(--n-200);
  display: flex; align-items: center; justify-content: space-between;
}
.header .h1 {
  font-size: 44rpx; font-weight: 800; letter-spacing: -0.02em;
  color: var(--n-900);
}

/* HERO */
.hero { width: calc(100vw - 80rpx); margin: 0 auto; padding: 8rpx 8rpx 16rpx; box-sizing: border-box; }
.hero .kg {
  font-family: var(--f-en);
  font-size: 112rpx; font-weight: 800;
  color: var(--n-900);
  letter-spacing: -0.04em; line-height: 1;
  font-variant-numeric: tabular-nums;
  display: inline-flex; align-items: baseline;
}
.hero .kg .unit {
  font-size: 52rpx; font-weight: 800; color: var(--n-700);
  margin-left: 12rpx; letter-spacing: -0.02em;
}
.hero .date {
  margin-top: 16rpx;
  font-family: var(--f-en); font-size: 26rpx; font-weight: 600;
  color: var(--n-500); font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
}
.hero .kg.editable { position: relative; }
.kg-hover { opacity: 0.6; }
.hero .edit-hint {
  margin-top: 14rpx; font-size: 22rpx; color: var(--n-400); letter-spacing: 0;
}

/* ===== 体重输入弹窗（用 wx:if 挂载/卸载，原生 input 隐藏即彻底移除，杜绝真机 placeholder 泄漏） ===== */
.modal-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex; align-items: flex-end;
  z-index: 100;
  animation: maskIn 240ms var(--ease-out, ease);
}
@keyframes maskIn { from { opacity: 0; } to { opacity: 1; } }
.modal {
  width: 100%; box-sizing: border-box;
  background: var(--card, #fff);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  animation: sheetUp 280ms var(--ease-out, ease);
}
@keyframes sheetUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.modal-head {
  display: flex; align-items: center; justify-content: space-between;
  height: 72rpx; margin-bottom: 20rpx;
}
.modal-title { font-size: 32rpx; font-weight: 800; color: var(--n-900); letter-spacing: -0.01em; }
.modal-save {
  font-size: 28rpx; font-weight: 700; color: var(--success, #6F9F00);
  padding: 12rpx 16rpx;
}
.modal-save-hover { opacity: 0.55; }
.input-row {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  padding: 16rpx 0 12rpx;
}
.weight-input {
  font-family: var(--f-en); font-size: 72rpx; font-weight: 800;
  line-height: 100rpx; height: 100rpx;
  color: var(--n-900); text-align: center; letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums; min-width: 220rpx;
}
.input-unit { font-size: 36rpx; font-weight: 800; color: var(--n-700); }
.modal-date {
  margin-top: 8rpx; text-align: center;
  font-size: 24rpx; color: var(--n-500);
  font-family: var(--f-en); font-variant-numeric: tabular-nums;
}

/* 通用卡片：左右边距与 .hero 严格一致 */
.card {
  width: calc(100vw - 80rpx);
  margin: 0 auto 28rpx;
  box-sizing: border-box;
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  padding: 32rpx 36rpx;
  box-shadow: var(--shadow-card);
}
.card .label {
  font-size: 24rpx; font-weight: 700; color: var(--n-900);
  letter-spacing: 0.04em; margin-bottom: 16rpx;
}

/* 体重变化 */
.change-row { display: flex; align-items: baseline; gap: 20rpx; }
.change-row .delta {
  font-family: var(--f-en); font-size: 52rpx; font-weight: 800;
  letter-spacing: -0.02em; font-variant-numeric: tabular-nums;
  color: #A6C24A; display: inline-flex; align-items: baseline;
}
.change-row .vs { font-size: 24rpx; font-weight: 600; color: var(--n-500); }

.bottom-gap { height: 40rpx; }

/* 空状态：无数据时不显示方框 */
.empty-state {
  width: calc(100vw - 80rpx);
  margin: 24rpx auto 0;
  padding: 64rpx 0 72rpx;
  box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center;
  gap: 14rpx; text-align: center;
}
.empty-state .empty-tip {
  font-size: 30rpx; font-weight: 800; color: var(--n-800);
  letter-spacing: -0.01em;
}
.empty-state .empty-sub {
  font-size: 24rpx; font-weight: 600; color: var(--n-400); letter-spacing: 0;
}

/* ===== 11-weight-trend.html 设计（下方） ===== */
/* 统一与 .card 等宽：左右各 40rpx */
.time-pills,
.stats-row,
.section-label,
.section-title {
  width: calc(100vw - 80rpx);
  margin-left: auto;
  margin-right: auto;
  box-sizing: border-box;
}

/* 区块标题：与 .header .h1 一致 */
.section-title {
  font-size: 44rpx; font-weight: 800; letter-spacing: -0.02em;
  color: var(--n-900);
  margin: 4rpx auto 24rpx;
}

/* 时间筛选 pills */
.time-pills {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.time-pills .pill {
  height: 72rpx;
  border-radius: var(--r-pill);
  background: var(--white);
  border: 1rpx solid var(--n-200);
  font-size: 28rpx; font-weight: 700;
  color: var(--n-700);
  display: flex; align-items: center; justify-content: center;
  transition: background 200ms, color 200ms, border-color 200ms, transform 150ms;
}
.time-pills .pill:active { transform: scale(0.97); }
.time-pills .pill.on {
  background: var(--primary);
  border-color: var(--primary);
  color: var(--n-900);
}

/* 三统计 */
.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.stats-row .stat {
  display: flex; flex-direction: column; gap: 12rpx;
  padding: 4rpx 8rpx;
  align-items: center;
  text-align: center;
}
.stats-row .stat .label {
  font-size: 24rpx; font-weight: 700; color: var(--n-700);
  letter-spacing: 0.04em;
}
.stats-row .stat .value {
  display: inline-flex; align-items: baseline;
  font-family: var(--f-en); font-size: 44rpx; font-weight: 800;
  color: var(--n-900); letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums; line-height: 1;
}
.stats-row .stat .value .unit {
  font-family: var(--f-en); font-size: 26rpx; font-weight: 700;
  color: var(--n-700); margin-left: 6rpx;
}

/* 趋势图 */
.chart-card { padding: 32rpx 36rpx 28rpx; }
.chart-wrap { position: relative; width: 100%; height: 360rpx; }
/* canvas 仅用于离屏绘制：隐形占位，真正展示用下方 <image>（可随 scroll-view 滚动） */
.chart-canvas { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; }
.chart-image { width: 100%; height: 100%; display: block; }
.empty-hint {
  margin-top: 16rpx; text-align: center;
  font-size: 24rpx; color: var(--n-500);
}

/* 体重记录列表 */
.section-label {
  font-size: 28rpx; font-weight: 800; color: var(--n-900);
  letter-spacing: 0.02em; margin: 8rpx auto 20rpx;
}
.records { display: flex; flex-direction: column; }
.records .row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--n-100);
}
.records .row:last-child { border-bottom: none; }
.records .row .date {
  font-family: var(--f-en); font-size: 28rpx; font-weight: 600;
  color: var(--n-700); font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
}
.records .row .kg {
  font-family: var(--f-en); font-size: 30rpx; font-weight: 800;
  color: var(--n-900); font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
  display: inline-flex; align-items: baseline;
}
.records .row .kg .unit {
  font-family: var(--f-en); font-size: 24rpx; font-weight: 700;
  color: var(--n-700); margin-left: 6rpx;
}

/* 查看更多 */
.more-link {
  display: flex; justify-content: center; align-items: center;
  width: calc(100vw - 80rpx); margin: 8rpx auto 4rpx;
  padding: 26rpx 0;
  border-radius: var(--r-pill);
  background: var(--primary);
  color: var(--n-900);
  font-size: 28rpx; font-weight: 700; letter-spacing: 0.06em;
  transition: opacity 200ms, transform 150ms;
}
.more-link:active { transform: scale(0.985); opacity: 0.9; }
