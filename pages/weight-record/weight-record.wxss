/* pages/weight-record/weight-record.wxss —— nav-bar 自带 .nb-wrap 静态占位，页面不再自留 padding */
.page { width: 100vw; box-sizing: border-box; min-height: 100vh; }

/* HERO 卡片：label + 日期 chip / 大数字 + 涨跌 chip / mini 统计行（.card.hero-card 双类覆盖 .card 的边距内边距） */
.card.hero-card {
  width: calc(100vw - 80rpx);
  margin: 12rpx auto 28rpx;
  padding: 32rpx 36rpx 24rpx;
}
.hero-top { display: flex; align-items: center; justify-content: space-between; }
.hero-label {
  font-size: 24rpx; font-weight: 700; color: var(--n-900);
  letter-spacing: 0.04em;
}
.date-chip {
  font-family: var(--f-en); font-size: 22rpx; font-weight: 600;
  color: var(--n-700); font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
  background: var(--n-100); border-radius: var(--r-pill);
  padding: 8rpx 20rpx;
}
.hero-main { display: flex; align-items: flex-end; gap: 20rpx; margin-top: 8rpx; }
.hero-main .kg {
  font-family: var(--f-en);
  font-size: 104rpx; font-weight: 800;
  color: var(--n-900);
  letter-spacing: -0.04em; line-height: 1;
  font-variant-numeric: tabular-nums;
  display: inline-flex; align-items: baseline;
}
.hero-main .kg .unit {
  font-size: 48rpx; font-weight: 800; color: var(--n-700);
  margin-left: 12rpx; letter-spacing: -0.02em;
}
.hero-main .kg.editable { position: relative; }
.kg-hover { opacity: 0.6; }
/* 涨跌 chip：跌=荧光绿语义（--primary-tint 底 + --primary-text 字）、涨=红、持平=中性灰 */
.change-chip {
  margin-bottom: 10rpx;
  display: inline-flex; align-items: baseline;
  font-family: var(--f-en); font-size: 26rpx; font-weight: 800;
  font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
  border-radius: var(--r-pill);
  padding: 10rpx 22rpx;
  background: var(--n-100); color: var(--n-700);
}
.change-chip .chip-vs {
  font-size: 20rpx; font-weight: 600; opacity: 0.75;
  margin-left: 8rpx;
}
.change-chip.down { background: var(--primary-tint, rgba(200, 255, 0, 0.16)); color: var(--primary-text); }
.change-chip.up { background: rgba(242, 84, 91, 0.12); color: var(--danger-text); }
/* mini 统计行：距目标 / BMI / 记录次数（wx:if 条件渲染，flex 等分自适应列数） */
.hero-meta {
  display: flex;
  margin-top: 28rpx; padding-top: 24rpx;
  border-top: 1rpx solid var(--n-100);
}
.hero-meta .meta-item { flex: 1; text-align: center; }
.hero-meta .meta-item + .meta-item { border-left: 1rpx solid var(--n-100); }
.hero-meta .meta-label {
  font-size: 22rpx; font-weight: 600; color: var(--n-500);
  margin-bottom: 8rpx; letter-spacing: 0.02em;
}
.hero-meta .meta-value {
  font-family: var(--f-en); font-size: 30rpx; font-weight: 800;
  color: var(--n-900); font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
  display: inline-flex; align-items: baseline;
}
.hero-meta .meta-unit {
  font-size: 22rpx; font-weight: 700; color: var(--n-500);
  margin-left: 4rpx;
}
.hero-card .edit-hint {
  margin-top: 20rpx; text-align: center;
  font-size: 22rpx; color: var(--n-400); letter-spacing: 0;
}

/* ===== 体重输入弹窗（用 wx:if 挂载/卸载，原生 input 隐藏即彻底移除，杜绝真机 placeholder 泄漏） ===== */
.modal-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex; align-items: flex-end;
  z-index: 100;
  animation: maskIn 240ms var(--ease-out, ease);
}
@keyframes maskIn { from { opacity: 0; } to { opacity: 1; } }
.modal {
  width: 100%; box-sizing: border-box;
  background: var(--card, #fff);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  animation: sheetUp 280ms var(--ease-out, ease);
}
@keyframes sheetUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.modal-head {
  display: flex; align-items: center; justify-content: space-between;
  height: 72rpx; margin-bottom: 20rpx;
}
.modal-title { font-size: 32rpx; font-weight: 800; color: var(--n-900); letter-spacing: -0.01em; }
.modal-save {
  font-size: 28rpx; font-weight: 700; color: var(--success, #6F9F00);
  padding: 12rpx 16rpx;
}
.modal-save-hover { opacity: 0.55; }
.input-row {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  padding: 16rpx 0 12rpx;
}
.weight-input {
  font-family: var(--f-en); font-size: 72rpx; font-weight: 800;
  line-height: 100rpx; height: 100rpx;
  color: var(--n-900); text-align: center; letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums; min-width: 220rpx;
}
.input-unit { font-size: 36rpx; font-weight: 800; color: var(--n-700); }
.modal-date {
  margin-top: 8rpx; text-align: center;
  font-size: 24rpx; color: var(--n-500);
  font-family: var(--f-en); font-variant-numeric: tabular-nums;
}

/* 通用卡片：左右边距与 .hero 严格一致 */
.card {
  width: calc(100vw - 80rpx);
  margin: 0 auto 28rpx;
  box-sizing: border-box;
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  padding: 32rpx 36rpx;
  box-shadow: var(--shadow-card);
}
.card .label {
  font-size: 24rpx; font-weight: 700; color: var(--n-900);
  letter-spacing: 0.04em; margin-bottom: 16rpx;
}

.bottom-gap { height: 40rpx; }

/* 空状态：无数据时不显示方框 */
.empty-state {
  width: calc(100vw - 80rpx);
  margin: 24rpx auto 0;
  padding: 64rpx 0 72rpx;
  box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center;
  gap: 14rpx; text-align: center;
}
.empty-state .empty-tip {
  font-size: 30rpx; font-weight: 800; color: var(--n-800);
  letter-spacing: -0.01em;
}
.empty-state .empty-sub {
  font-size: 24rpx; font-weight: 600; color: var(--n-400); letter-spacing: 0;
}

/* ===== 11-weight-trend.html 设计（下方） ===== */
/* 统一与 .card 等宽：左右各 40rpx */
.time-pills,
.stats-row,
.section-label,
.section-title {
  width: calc(100vw - 80rpx);
  margin-left: auto;
  margin-right: auto;
  box-sizing: border-box;
}

/* 区块标题：与 .header .h1 一致 */
.section-title {
  font-size: 44rpx; font-weight: 800; letter-spacing: -0.02em;
  color: var(--n-900);
  margin: 4rpx auto 24rpx;
}

/* 时间筛选 pills */
.time-pills {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.time-pills .pill {
  height: 72rpx;
  border-radius: var(--r-pill);
  background: var(--white);
  border: 1rpx solid var(--n-200);
  font-size: 28rpx; font-weight: 700;
  color: var(--n-700);
  display: flex; align-items: center; justify-content: center;
  transition: background 200ms, color 200ms, border-color 200ms, transform 150ms;
}
.time-pills .pill:active { transform: scale(0.97); }
.time-pills .pill.on {
  background: var(--primary);
  border-color: var(--primary);
  color: var(--n-900);
}

/* 三统计 */
.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.stats-row .stat {
  display: flex; flex-direction: column; gap: 12rpx;
  padding: 4rpx 8rpx;
  align-items: center;
  text-align: center;
}
.stats-row .stat .label {
  font-size: 24rpx; font-weight: 700; color: var(--n-700);
  letter-spacing: 0.04em;
}
.stats-row .stat .value {
  display: inline-flex; align-items: baseline;
  font-family: var(--f-en); font-size: 44rpx; font-weight: 800;
  color: var(--n-900); letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums; line-height: 1;
}
.stats-row .stat .value .unit {
  font-family: var(--f-en); font-size: 26rpx; font-weight: 700;
  color: var(--n-700); margin-left: 6rpx;
}

/* 趋势图 */
.chart-card { padding: 32rpx 36rpx 28rpx; }
.chart-wrap { position: relative; width: 100%; height: 360rpx; }
/* canvas 仅用于离屏绘制：隐形占位，真正展示用下方 <image>（可随 scroll-view 滚动） */
.chart-canvas { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; }
.chart-image { width: 100%; height: 100%; display: block; }
.empty-hint {
  margin-top: 16rpx; text-align: center;
  font-size: 24rpx; color: var(--n-500);
}

/* 体重记录列表 */
.section-label {
  font-size: 28rpx; font-weight: 800; color: var(--n-900);
  letter-spacing: 0.02em; margin: 8rpx auto 20rpx;
}
.records { display: flex; flex-direction: column; }
.records .row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--n-100);
}
.records .row:last-child { border-bottom: none; }
.records .row .date {
  font-family: var(--f-en); font-size: 28rpx; font-weight: 600;
  color: var(--n-700); font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
}
.records .row .kg {
  font-family: var(--f-en); font-size: 30rpx; font-weight: 800;
  color: var(--n-900); font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
  display: inline-flex; align-items: baseline;
}
.records .row .kg .unit {
  font-family: var(--f-en); font-size: 24rpx; font-weight: 700;
  color: var(--n-700); margin-left: 6rpx;
}

/* 查看更多 */
.more-link {
  display: flex; justify-content: center; align-items: center;
  width: calc(100vw - 80rpx); margin: 8rpx auto 4rpx;
  padding: 26rpx 0;
  border-radius: var(--r-pill);
  background: var(--primary);
  color: var(--n-900);
  font-size: 28rpx; font-weight: 700; letter-spacing: 0.06em;
  transition: opacity 200ms, transform 150ms;
}
.more-link:active { transform: scale(0.985); opacity: 0.9; }

/* ══════════════════════════════════════════════════════════════
   深色主题覆盖（.page.theme-dark）—— 手法同 home.wxss：重定义 CSS 变量
   ══════════════════════════════════════════════════════════════ */
.page.theme-dark {
  --n-50:  #0A0A0A;
  --n-100: #1E1E1E;
  --n-200: rgba(255, 255, 255, 0.10);
  --n-300: rgba(255, 255, 255, 0.16);
  --n-400: rgba(255, 255, 255, 0.30);
  --n-500: rgba(255, 255, 255, 0.42);
  --n-600: rgba(255, 255, 255, 0.55);
  --n-700: rgba(255, 255, 255, 0.75);
  --n-800: rgba(255, 255, 255, 0.88);
  --n-900: #FFFFFF;

  --text:        #FFFFFF;
  --text-sub:    rgba(255, 255, 255, 0.70);
  --text-weak:   rgba(255, 255, 255, 0.45);
  --line:        rgba(255, 255, 255, 0.10);
  --line-strong: rgba(255, 255, 255, 0.20);

  --card:      #161616;
  --white:     #161616;
  --card-gray: #1E1E1E;
  --bg:        rgba(255, 255, 255, 0.06);

  --success: #C8FF00;

  /* 红「文字」档：.change-chip.up 用 var(--danger-text)。
     根值 #C4363B 压在深色下的暗红淡底上只有 2.99:1，本页必须提亮 ——
     别页（list/review/training/workout）都已补，本页此前漏了。 */
  --danger-text: #FF6B70;

  --primary-text: #C8FF00;                  /* 绿底黑字铁律：深色下绿色文字翻亮绿 */
  --primary-tint: rgba(200, 255, 0, 0.12);  /* 同步翻 tint，避免亮绿字压浅绿底 */

  background: var(--n-50);
  color: var(--text);
}
.page.theme-dark .card { box-shadow: none; }
