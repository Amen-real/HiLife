<!-- pages/weight-record/weight-record.wxml -->
<view class="page">
  <view class="card">
    <view class="wr-title">记录今日体重</view>
    <view class="wr-row">
      <text class="wr-label">日期</text>
      <text class="wr-value">{{date}}</text>
    </view>
    <view class="wr-input-wrap">
      <input
        class="wr-input"
        type="digit"
        placeholder="请输入体重，如 68.5"
        value="{{weight}}"
        bindinput="onWeight"
        focus
      />
      <text class="wr-unit">kg</text>
    </view>
    <button class="btn-primary wr-save" bindtap="save">保存记录</button>
  </view>

  <view class="tip">记录体重后，首页与列表页会自动更新趋势与目标进度。</view>
</view>
