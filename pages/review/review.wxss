/* pages/review/review.wxss —— 样式已全部迁移至 components/training-review */

/* ══════════════════════════════════════════════════════════════
   深色主题覆盖（.page.theme-dark）—— 手法同 home.wxss：重定义 CSS 变量
   本页样式在 training-review 组件内；变量从页面根继承进组件使其自动跟随
   ══════════════════════════════════════════════════════════════ */
.page.theme-dark {

  /* 肌群三态色（组件 training-review 的「练完之后」区块消费，与 action-detail 同一组值）
     ⚠️ 必须在这里成对翻转 —— 组件样式有作用域，深色值只能由**宿主页**提供。
        组件里若不定义、宿主也不定义，就会退回 app.wxss 的**浅色**值 ⇒ 深色下浅底浅字。
     ⚠️ --st-trained-bg 例外：品牌亮绿是全库唯一不随主题翻转的颜色
        （绿底字恒 #0A0A0A），所以这一对**不翻**。
     实测深色侧：fatigued 8.33:1 · detrained 6.42:1（均 ≥4.5:1）。 */
  --st-fatigued-bg:  #5A2415;   --st-fatigued-ink:  #FFC8B0;
  --st-detrained-bg: #0C447C;   --st-detrained-ink: #B5D4F4;
  --n-50:  #0A0A0A;
  --n-100: #1E1E1E;
  --n-200: rgba(255, 255, 255, 0.10);
  --n-300: rgba(255, 255, 255, 0.16);
  --n-400: rgba(255, 255, 255, 0.30);
  --n-500: rgba(255, 255, 255, 0.42);
  --n-600: rgba(255, 255, 255, 0.55);
  --n-700: rgba(255, 255, 255, 0.75);
  --n-800: rgba(255, 255, 255, 0.88);
  --n-900: #FFFFFF;

  --text:        #FFFFFF;
  --text-sub:    rgba(255, 255, 255, 0.70);
  --text-weak:   rgba(255, 255, 255, 0.45);
  --line:        rgba(255, 255, 255, 0.10);
  --line-strong: rgba(255, 255, 255, 0.20);

  --card:      #161616;
  --white:     #161616;
  --card-gray: #1E1E1E;
  --bg:        rgba(255, 255, 255, 0.06);

  --success: #C8FF00;
  /* 语义绿「文字」档：本页内嵌 training-review 组件，其 .pa-chip.up 用 var(--success-text)。
     组件样式有作用域、选不中本页根节点 → 缺口只能在这里补（同 --danger-text 的做法）。 */
  --success-text: #C8FF00;

  --primary-text: #C8FF00;                  /* 绿底黑字铁律：深色下绿色文字翻亮绿 */
  --primary-tint: rgba(200, 255, 0, 0.12);  /* 与 primary-text 成对翻转 */
  --danger-text:  #FF6B70;                  /* 红字深底提亮：本页内嵌 training-review 组件，
                                               组件的 .pa-chip.down 用 var(--danger-text)，
                                               组件样式有作用域、选不中本页根节点，缺口只能在这里补 */
  --ink: #FFFFFF;                           /* 组件内 var(--ink) 深色兜底（同 advice 页） */

  background: var(--n-50);
  color: var(--text);
}
