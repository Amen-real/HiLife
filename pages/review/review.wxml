<!-- pages/review/review.wxml -->
<view class="page">
  <!-- 头部 -->
  <view class="rv-head">
    <view class="rv-title">训练复盘</view>
    <view class="rv-sub">{{modeDesc}}</view>
  </view>

  <!-- 模式切换（分段控件，复用全局 .segment/.seg） -->
  <view class="rv-seg">
    <view class="segment">
      <view class="seg {{mode==='single'?'on':''}}" data-mode="single" bindtap="switchMode">单次</view>
      <view class="seg {{mode==='rolling'?'on':''}}" data-mode="rolling" bindtap="switchMode">滚动</view>
      <view class="seg {{mode==='baseline'?'on':''}}" data-mode="baseline" bindtap="switchMode">基准</view>
      <view class="seg {{mode==='weekly'?'on':''}}" data-mode="weekly" bindtap="switchMode">周</view>
    </view>
  </view>

  <!-- 无任何记录：引导首练 -->
  <view wx:if="{{logsCount === 0}}" class="rv-empty">
    <view class="rv-empty-ico"><icon name="train" size="72"/></view>
    <view class="rv-empty-title">还没有训练记录</view>
    <view class="rv-empty-hint">完成一次训练后，这里会自动生成复盘</view>
    <view class="btn-primary rv-empty-btn" bindtap="goTrain">去训练</view>
  </view>

  <block wx:else>
    <!-- ================= 单次 ================= -->
    <block wx:if="{{mode==='single'}}">
      <scroll-view scroll-x class="sess-scroll" wx:if="{{sessions.length}}">
        <view class="sess-chip {{curSid===item.sid?'on':''}}" wx:for="{{sessions}}" wx:key="sid"
              data-sid="{{item.sid}}" bindtap="selectSession">
          <view class="sc-date">{{item.date}}</view>
          <view class="sc-wd">{{item.weekday}}</view>
          <view class="sc-cnt">{{item.actionCount}} 项 · {{item.totalSets}} 组</view>
        </view>
      </scroll-view>

      <view class="card" wx:if="{{session}}">
        <view class="rv-card-title">本次执行判断</view>
        <view class="verdict {{session.verdictClass}}">{{session.verdict}}</view>
        <view class="rv-actions">
          <view class="rv-act" wx:for="{{session.actions}}" wx:key="id">
            <view class="rv-act-top">
              <text class="rv-act-name">{{item.nameZh}}</text>
              <text class="rv-act-badge {{item.badgeClass}}">{{item.badge}}</text>
            </view>
            <view class="rv-act-sets">
              <text class="rv-set" wx:for="{{item.sets}}" wx:for-item="s" wx:key="index">
                {{s.weight}}kg×{{s.reps}}<text wx:if="{{s.rpe}}" class="rv-rpe">@{{s.rpe}}</text>
              </text>
            </view>
            <view class="rv-act-next" wx:if="{{item.next}}">下次：{{item.next}}</view>
          </view>
        </view>
      </view>
    </block>

    <!-- ================= 滚动 ================= -->
    <block wx:if="{{mode==='rolling'}}">
      <view class="rv-sub2">选择动作查看可比记录（需 ≥2 次同动作记录）</view>
      <view class="act-list" wx:if="{{rollableActions.length}}">
        <view class="act-chip {{curActionId===item.actionId?'on':''}}" wx:for="{{rollableActions}}" wx:key="actionId"
              data-id="{{item.actionId}}" bindtap="selectAction">
          {{item.nameZh}} · {{item.count}}次
        </view>
      </view>
      <view wx:if="{{!rollableActions.length}}" class="rv-tip">尚无动作达到 ≥2 次可比记录，先多练几次同一动作。</view>

      <view class="card" wx:if="{{roll}}">
        <view class="rv-card-title">{{roll.nameZh}} · 可比记录</view>
        <view class="rv-bars">
          <view class="rv-bar-col" wx:for="{{roll.records}}" wx:key="date">
            <view class="rv-bar" style="height:{{item.h}}%"></view>
            <view class="rv-bar-w">{{item.maxWeight}}</view>
            <view class="rv-bar-d">{{item.weekday}}</view>
          </view>
        </view>
        <view class="rv-note">努力度（RPE）趋势：{{roll.rpeTrend}}</view>
        <view class="rv-suggest {{roll.suggestClass}}">{{roll.suggest}}</view>
      </view>
    </block>

    <!-- ================= 基准 ================= -->
    <block wx:if="{{mode==='baseline'}}">
      <view class="card base-card">
        <view class="rv-card-title">基准态 · Baseline</view>
        <view class="base-status">{{baseline.status}}</view>
        <view class="base-desc">{{baseline.desc}}</view>
        <view wx:if="{{baseline.session}}" class="base-session">已记录：{{baseline.session.date}} · {{baseline.session.actionCount}} 项动作</view>
        <view class="btn-primary base-btn" bindtap="goTrain">去完成一次训练</view>
      </view>
      <view class="rv-tip">提示：完成 ≥2 次训练后，复盘会自动切换到「周」视图；单动作达 ≥2 次即可看「滚动」对比。</view>
    </block>

    <!-- ================= 周 ================= -->
    <block wx:if="{{mode==='weekly'}}">
      <scroll-view scroll-x class="wk-scroll" wx:if="{{weeks.length}}">
        <view class="wk-chip {{curWeek===item.key?'on':''}}" wx:for="{{weeks}}" wx:key="key"
              data-key="{{item.key}}" bindtap="selectWeek">
          <view class="wk-label">{{item.label}}</view>
          <view class="wk-pct">{{item.pct}}%</view>
        </view>
      </scroll-view>

      <view class="card" wx:if="{{week}}">
        <view class="rv-card-title">本周完成度</view>
        <view class="comp-bar"><view class="comp-fill" style="width:{{week.pct}}%"></view></view>
        <view class="comp-text">{{week.trainedDays}} / {{week.target}} 天 · {{week.pct}}%</view>
        <view wx:if="{{hasCycle}}" class="cycle-flag">🔁 周期计划 · {{cycleLabel}}</view>
      </view>

      <!-- 周期处方 vs 实际（Phase 2：按 cycle 周处方对比本周训练） -->
      <view class="card" wx:if="{{hasCycle && week.cycleRx}}">
        <view class="rv-card-title">周期处方 vs 实际 · 第 {{week.cycleRx.weekIdx}} 周</view>
        <view class="cyc-cmp">
          <view class="cyc-cmp-row">
            <text class="cyc-cmp-k">RPE</text>
            <text class="cyc-cmp-rx">处方 {{week.cycleRx.rpe != null ? week.cycleRx.rpe : '—'}}</text>
            <text class="cyc-cmp-vs">vs</text>
            <text class="cyc-cmp-act {{week.cycleActual.rpeMatch === 'high' ? 'high' : ''}} {{week.cycleActual.rpeMatch === 'low' ? 'low' : ''}}">实际 {{week.cycleActual.rpe != null ? week.cycleActual.rpe : '—'}}</text>
          </view>
          <view class="cyc-cmp-row">
            <text class="cyc-cmp-k">组数</text>
            <text class="cyc-cmp-rx">处方 {{week.cycleRx.sets != null ? week.cycleRx.sets : '—'}}</text>
            <text class="cyc-cmp-vs">vs</text>
            <text class="cyc-cmp-act {{week.cycleActual.setsMatch === 'low' ? 'low' : ''}}">实际 {{week.cycleActual.sets}}</text>
          </view>
        </view>
        <view wx:if="{{week.cycleRx.phaseLabel}}" class="cyc-cmp-phase">阶段：{{week.cycleRx.phaseLabel}}</view>
      </view>

      <view class="card" wx:if="{{week.strength.length}}">
        <view class="rv-card-title">力量进展（各动作周峰值）</view>
        <view class="spark" wx:for="{{week.strength}}" wx:key="actionId">
          <view class="spark-name">{{item.nameZh}}</view>
          <view class="spark-bars">
            <view class="spark-col" wx:for="{{item.points}}" wx:for-item="pt" wx:key="wk">
              <view class="spark-bar" style="height:{{pt.h}}%"></view>
            </view>
          </view>
          <view class="spark-delta {{item.deltaClass}}">{{item.delta}}</view>
        </view>
      </view>

      <view class="card" wx:if="{{week.rpe.length}}">
        <view class="rv-card-title">努力度趋势（RPE）</view>
        <view class="rpe-bars">
          <view class="rpe-col" wx:for="{{week.rpe}}" wx:key="wk">
            <view class="rpe-bar" style="height:{{item.h}}%"></view>
            <view class="rpe-val">{{item.val}}</view>
          </view>
        </view>
      </view>

      <view class="card decision {{week.decisionClass}}" wx:if="{{week}}">
        <view class="rv-card-title">系统建议</view>
        <view class="dec-verdict">{{week.decision}}</view>
        <view class="dec-reason">{{week.decisionReason}}</view>
        <view class="dec-flags">
          <view class="dec-flag">完成率 {{week.flags.completion}}</view>
          <view class="dec-flag">努力度 {{week.flags.effort}}</view>
          <view class="dec-flag">技术 {{week.flags.tech}}</view>
        </view>
      </view>
    </block>
  </block>

  <view class="bottom-gap" />
</view>
