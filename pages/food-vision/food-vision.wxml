<!-- pages/food-vision/food-vision.wxml -->
<view class="page">

  <!-- 记录这一餐：虚线扫描框（对齐预览） -->
  <view class="section-title">记录这一餐</view>
  <view class="scan" bindtap="chooseImage" data-source="camera">
    <view class="cam"><view class="ico ico-camera ico--ink" style="width:48rpx;height:48rpx"></view></view>
    <view class="stxt">拍照识别食物</view>
    <view class="ssub">AI 自动估算卡路里与营养</view>
  </view>
  <view class="scan-alt" bindtap="chooseImage" data-source="album"><view class="ico ico-album ico--ink" style="width:32rpx;height:32rpx"></view> 从相册选择图片</view>

  <view wx:if="{{loading}}" class="loading">识别中…</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <!-- 识别结果（本餐） -->
  <block wx:if="{{result}}">
    <view wx:if="{{result.mock}}" class="mock-tip">演示数据（未配置视觉模型 key），接入真实模型后即替换为估算结果。</view>

    <view class="section-title">识别结果</view>
    <view class="card total">
      <view class="section-title" style="margin:0 0 8rpx">本餐合计</view>
      <view class="macro-grid">
        <view class="macro"><view class="m-num">{{result.total.calories}}</view><view class="m-cap">千卡</view></view>
        <view class="macro"><view class="m-num">{{result.total.protein}}</view><view class="m-cap">蛋白 g</view></view>
        <view class="macro"><view class="m-num">{{result.total.carb}}</view><view class="m-cap">碳水 g</view></view>
        <view class="macro"><view class="m-num">{{result.total.fat}}</view><view class="m-cap">脂肪 g</view></view>
      </view>
    </view>

    <view wx:if="{{result.foods.length === 0}}" class="empty">未能识别到食物，请换一张更清晰的图。</view>

    <view wx:for="{{result.foods}}" wx:key="name" class="card food">
      <view class="f-thumb"><text wx:if="{{item.emoji}}">{{item.emoji}}</text><view wx:else class="ico ico-food-bowl ico--ink" style="width:52rpx;height:52rpx"></view></view>
      <view class="f-body">
        <view class="f-name">{{item.name}}</view>
        <view class="f-meta">蛋白 {{item.protein}}g · 碳水 {{item.carb}}g · 脂肪 {{item.fat}}g</view>
      </view>
      <view class="f-right">
        <view class="f-cal tnum">{{item.calories}}</view>
        <view class="btn-record" bindtap="recordOne" data-idx="{{index}}">记录</view>
      </view>
    </view>

    <view wx:if="{{result.foods.length > 0}}" class="record-bar">
      <view class="seg">
        <view wx:for="{{mealTypes}}" wx:key="*this"
              class="seg-item {{recordType === item ? 'on' : ''}}"
              bindtap="pickType" data-type="{{item}}">{{item}}</view>
      </view>
      <view class="btn-all" bindtap="recordAll">全部记录</view>
    </view>

    <view wx:if="{{result.note}}" class="note">{{result.note}}</view>
  </block>

  <!-- 今日饮食 -->
  <view class="section-title">今日饮食</view>
  <view wx:if="{{todayMeals.length === 0}}" class="empty">还没有记录，拍一张开始吧</view>
  <view wx:for="{{todayMeals}}" wx:key="id" class="card food">
    <view class="f-thumb">{{item.emoji || '🍽️'}}</view>
    <view class="f-body">
      <view class="f-name">{{item.name}}</view>
      <view class="f-meta">{{item.type}} · {{item.calories}} 千卡</view>
    </view>
    <view class="f-cal tnum">{{item.calories}}</view>
  </view>

  <!-- 今日合计 -->
  <view class="card total-card">
    <text class="tc-label">今日合计</text>
    <text class="tc-value tnum">{{todayCalories}} 千卡</text>
  </view>

  <view class="bottom-gap" />
</view>
