/* pages/privacy/privacy.wxss */
.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 80rpx;
  /* 与全局 page 渐变同款、端点对齐，避免内容短于视口或 overscroll 时出现接缝/断层 */
  background: linear-gradient(180deg, var(--primary-deep) 0%, var(--primary) 14%, var(--primary-tint) 40%, #FFF1E8 100%);
}
.sec { margin-bottom: 36rpx; }
.h { font-size: var(--fs-head); font-weight: 700; color: var(--text); margin-bottom: 14rpx; }
.p { font-size: var(--fs-body); line-height: 1.75; color: var(--text-sub); margin-bottom: 8rpx; }
.updated { font-size: var(--fs-caption); color: var(--text-weak); margin-top: 24rpx; }

/* ══════════════════════════════════════════════════════════════
   深色主题覆盖（.page.theme-dark）—— 手法同 home.wxss：重定义 CSS 变量
   ══════════════════════════════════════════════════════════════ */
.page.theme-dark {
  --n-50:  #0A0A0A;
  --n-100: #1E1E1E;
  --n-200: rgba(255, 255, 255, 0.10);
  --n-300: rgba(255, 255, 255, 0.16);
  --n-400: rgba(255, 255, 255, 0.30);
  --n-500: rgba(255, 255, 255, 0.42);
  --n-600: rgba(255, 255, 255, 0.55);
  --n-700: rgba(255, 255, 255, 0.75);
  --n-800: rgba(255, 255, 255, 0.88);
  --n-900: #FFFFFF;

  --text:        #FFFFFF;
  --text-sub:    rgba(255, 255, 255, 0.70);
  --text-weak:   rgba(255, 255, 255, 0.45);
  --line:        rgba(255, 255, 255, 0.10);
  --line-strong: rgba(255, 255, 255, 0.20);

  --card:      #161616;
  --white:     #161616;
  --card-gray: #1E1E1E;
  --bg:        rgba(255, 255, 255, 0.06);

  --success: #C8FF00;

  background: var(--n-50);
  color: var(--text);
}
.page.theme-dark .card { box-shadow: none; }
