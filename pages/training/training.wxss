/* pages/training/training.wxss —— 品牌焕新版 */
/* 竖直渐变底（顶部青绿→底部桃色），与首页/我的/记录/饮食/训练执行页统一；
   端点精确对齐 app.json 的 backgroundColorTop(#2ECFB0)/Bottom(#FFF1E8)，上拉/下拉无可见断缝；
   min-height:100vh 保证内容短时渐变仍铺满视口 */
.page { padding: 24rpx 0 230rpx; min-height: 100vh; background: linear-gradient(180deg, var(--primary-deep) 0%, var(--primary) 14%, var(--primary-tint) 40%, #FFF1E8 100%); }

/* ===== 标题 + 创建 ===== */
.lib-head { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 28rpx 18rpx; }
.lib-title { font-size: var(--fs-title); font-weight: 800; color: var(--text); }
.create-btn {
  background: var(--primary-light); color: var(--primary-deep);
  font-size: var(--fs-body); font-weight: 700;
  border-radius: 999rpx; padding: 12rpx 24rpx;
  transition: opacity 0.15s;
}
.create-btn:active { opacity: 0.7; }

/* ===== 分类胶囊 chips ===== */
.chips { white-space: nowrap; display: flex; padding: 2rpx 28rpx 20rpx; }
.chips::-webkit-scrollbar { display: none; }
.chip {
  flex: 0 0 auto; padding: 6rpx 22rpx; border-radius: 999rpx;
  background: rgba(255,255,255,.94);
  border: 1rpx solid var(--line);
  box-shadow: 0 3rpx 10rpx rgba(15,23,42,.10);
  font-size: var(--fs-body); line-height: 1; color: var(--text-sub); font-weight: 600;
  margin-right: 12rpx;
  display: inline-flex; align-items: center; justify-content: center;
  transition: all 0.18s var(--ease-out);
}
.chip:active { transform: scale(0.95); }
.chip.on { background: var(--primary); color: #fff; border-color: var(--primary); box-shadow: var(--shadow-brand); }
.chip-count { display: inline-block; margin-left: 6rpx; font-size: var(--fs-caption); font-weight: 600; opacity: 0.85; }

/* ===== 搜索 + 已选 ===== */
.search-bar { display: flex; align-items: center; gap: 14rpx; padding: 0 28rpx; margin-bottom: 20rpx; }
.search-input {
  flex: 1; display: flex; align-items: center;
  background: var(--bg); border-radius: 999rpx; padding: 0 24rpx; height: 78rpx;
  border: 1rpx solid var(--line);
  transition: border-color 0.2s, box-shadow 0.2s;
}
.search-input:focus-within { border-color: var(--primary); box-shadow: 0 0 0 4rpx var(--primary-light); }
.search-ico { font-size: var(--fs-body); margin-right: 10rpx; }
.search-field { flex: 1; font-size: var(--fs-body); }
.search-clear { color: var(--text-weak); margin-left: 12rpx; font-size: var(--fs-head); font-weight: 700; padding: 4rpx 8rpx; }
.sel-pill {
  flex: 0 0 auto; font-size: var(--fs-label); color: var(--primary-deep);
  background: var(--primary-light); border-radius: 999rpx;
  padding: 14rpx 24rpx; font-weight: 700;
  transition: opacity 0.15s;
}

/* ===== 动作双排网格 ===== */
.action-list { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; padding: 0 28rpx; }
.action-card {
  position: relative;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: var(--shadow-xs);
  transition: transform 0.18s var(--ease-out), box-shadow 0.18s var(--ease-out);
}
.ac-press { transform: scale(0.97); box-shadow: var(--shadow-md); }

.action-thumb {
  position: relative; width: 100%; aspect-ratio: 1 / 1;
  background: linear-gradient(135deg, var(--primary-light), rgba(255,255,255,0));
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.action-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.action-emoji { font-size: var(--fs-hero-lg); }
.play {
  position: absolute; right: 10rpx; bottom: 10rpx;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: rgba(0,0,0,0.5); color: #fff; font-size: var(--fs-mini);
  display: flex; align-items: center; justify-content: center;
}
.fav {
  position: absolute; top: 12rpx; right: 14rpx;
  color: #fff; font-size: var(--fs-title); line-height: 1;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.45);
  transition: transform 0.15s;
}
.fav.on { color: var(--error); }
.fav-press { transform: scale(0.8); }
.del-btn {
  position: absolute; top: 10rpx; left: 10rpx; z-index: 5;
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: rgba(0,0,0,0.45); color: #fff; font-size: var(--fs-head); font-weight: 700;
  display: flex; align-items: center; justify-content: center; line-height: 1;
  transition: transform 0.15s;
}
.del-press { transform: scale(0.85); }

.action-body { padding: 16rpx 18rpx 64rpx; }
.action-name { font-size: var(--fs-body); font-weight: 700; color: var(--text); }
.action-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.action-tags .tag { margin-right: 0; }

.add-btn {
  position: absolute; right: 14rpx; bottom: 14rpx; z-index: 2;
  width: 60rpx; height: 60rpx; border-radius: 50%;
  background: var(--primary); color: #fff; font-size: var(--fs-section);
  display: flex; align-items: center; justify-content: center;
  line-height: 1; box-shadow: 0 4rpx 16rpx rgba(46,207,176, 0.3);
  transition: transform 0.15s var(--ease-out), background 0.15s ease;
}
.add-btn.added { background: var(--primary-light); color: var(--primary); font-size: var(--fs-title); box-shadow: none; }
.add-press { transform: scale(0.84); }

/* 媒体署名 */
.attr { margin: 28rpx 28rpx 0; text-align: center; font-size: var(--fs-caption); color: var(--text-weak); }
.bottom-gap { height: 24rpx; }

/* ===== 底部固定行动栏 ===== */
.action-bar {
  position: fixed; left: 0; right: 0; bottom: 110rpx;
  display: flex; align-items: center; gap: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  z-index: 1000;
}
.ab-count { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.ab-num { font-size: var(--fs-section); font-weight: 800; color: var(--primary); font-feature-settings: "tnum"; }
.ab-label { font-size: var(--fs-caption); color: var(--text-sub); }
.ab-start {
  flex: 1;
  display: flex; align-items: center; justify-content: center;
  height: 80rpx;
  background: var(--primary); color: #fff;
  border-radius: 18rpx; font-size: var(--fs-head); font-weight: 700; line-height: 1; border: none;
  box-shadow: var(--shadow-brand);
  transition: opacity 0.15s;
}
.ab-start::after { border: none; }
.ab-start:active { opacity: 0.85; }
.ab-start.disabled { background: var(--line-strong); color: var(--text-weak); box-shadow: none; }

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed; inset: 0; background: rgba(15, 23, 42, 0.5);
  display: flex; align-items: center; justify-content: center; z-index: 2000;
}
.modal { width: 600rpx; background: #fff; border-radius: 28rpx; padding: 40rpx; box-shadow: var(--shadow-lg); animation: popIn 0.24s var(--ease-out); }
.modal-title { font-size: var(--fs-title); font-weight: 800; text-align: center; margin-bottom: 28rpx; color: var(--text); }
.modal-input {
  box-sizing: border-box; height: 88rpx; line-height: 88rpx;
  background: var(--bg); border-radius: 18rpx; padding: 0 24rpx;
  font-size: var(--fs-body); color: var(--text);
  border: 1rpx solid var(--line);
  transition: border-color 0.2s;
}
.modal-input:focus { border-color: var(--primary); }
.modal-input.sm { text-align: center; padding: 0 12rpx; }
.picker-display {
  box-sizing: border-box; height: 88rpx; line-height: 88rpx;
  background: var(--bg); border-radius: 18rpx; padding: 0 24rpx;
  font-size: var(--fs-body); color: var(--text);
  border: 1rpx solid var(--line);
}
.field-label { font-size: var(--fs-label); color: var(--text-sub); margin: 20rpx 0 10rpx; font-weight: 600; }
.param-row { display: flex; gap: 14rpx; }
.param-cell { flex: 1; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.modal-cancel, .modal-ok, .btn-use {
  height: 88rpx; line-height: 88rpx; padding: 0;
  border-radius: 18rpx; font-size: var(--fs-head); font-weight: 700; border: none;
  transition: opacity 0.15s;
}
.modal-cancel { flex: 1; background: var(--bg); color: var(--text-sub); }
.modal-ok { flex: 1; }
.btn-use { width: 100%; margin-top: 20rpx; background: var(--primary); color: #fff; box-shadow: var(--shadow-brand); }
.modal-cancel::after, .modal-ok::after, .btn-use::after { border: none; }

/* 空状态 */
.empty { grid-column: 1 / -1; width: 100%; text-align: center; color: var(--text-weak); font-size: var(--fs-body); padding: 60rpx 0; }

/* ===== 已选动作（本次训练） ===== */
.sel-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.sel-item:last-child { border-bottom: none; }
.sel-info { flex: 1; min-width: 0; }
.sel-name { font-size: var(--fs-body); font-weight: 700; }
.sel-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; margin-top: 8rpx; }
.sel-meta .tag { margin-right: 0; }
.sel-param { font-size: var(--fs-caption); color: var(--text-sub); }
.sel-ops { flex: 0 0 auto; display: flex; gap: 12rpx; }
.sel-op { font-size: var(--fs-label); padding: 10rpx 22rpx; border-radius: 999rpx; font-weight: 600; transition: opacity 0.15s; }
.op-press { transform: scale(0.92); }
.sel-op.edit { color: var(--primary); background: var(--primary-light); }
.sel-op.del { color: #fff; background: var(--error); }

/* ===== 已选动作总览弹窗 ===== */
.sel-edit-mask { z-index: 2100; }
.sel-panel { width: 640rpx; max-height: 82vh; display: flex; flex-direction: column; padding: 0; }
.sel-panel-head { display: flex; align-items: center; gap: 16rpx; padding: 28rpx 32rpx 20rpx; border-bottom: 1rpx solid var(--line); }
.sel-panel-title { flex: 1; font-size: var(--fs-title); font-weight: 800; }
.sel-panel-min, .sel-panel-close {
  flex: 0 0 auto; width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--bg); color: var(--text-sub); font-size: var(--fs-title); line-height: 1;
  display: flex; align-items: center; justify-content: center;
  transition: opacity 0.15s;
}
.sel-panel-close { color: var(--error); }
.sel-panel-list { flex: 1; max-height: 56vh; box-sizing: border-box; padding: 8rpx 32rpx; }
.sel-panel-add {
  margin: 8rpx 32rpx 32rpx; height: 88rpx; line-height: 88rpx; padding: 0; border: none;
  background: var(--primary-light); color: var(--primary-deep); border-radius: 18rpx;
  font-size: var(--fs-head); font-weight: 700;
  transition: opacity 0.15s;
}
.sel-panel-add:active { opacity: 0.75; }
.sel-panel-add::after { border: none; }

/* 最小化悬浮气泡 */
.sel-bubble {
  position: fixed; right: 24rpx; bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 1500; background: var(--primary); color: #fff;
  font-size: var(--fs-label); font-weight: 700; padding: 18rpx 28rpx; border-radius: 999rpx;
  box-shadow: 0 10rpx 28rpx rgba(46,207,176, 0.32);
}
.bubble-press { transform: scale(0.94); opacity: 0.9; }
