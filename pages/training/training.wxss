/* pages/training/training.wxss —— 对齐 02-train.html（HiLiLife 设计系统） */

/* --lime：下划线色，与计划页 .tab-bar 同款（深色模式在 .page.theme-dark 内覆盖为 #C8FF00） */
.page { padding: 0 0 230rpx; min-height: 100vh; background: var(--n-50); --lime: #B7E600; }

/* ============== HEADER：动作库 / 收藏 ============== */
.header {
  padding: 8rpx 31rpx 23rpx;
  display: flex; align-items: center; justify-content: space-between;
  gap: 23rpx;
}
.header .lead { display: flex; align-items: center; gap: 46rpx; }
/* .title 作为纵向容器：文字 .t-text + 独立下划线 .tab-bar（与计划页同款实现） */
.header .title { display: inline-flex; flex-direction: column; align-items: flex-start; }
.header .t-text {
  font-size: 42rpx; font-weight: 500;
  color: var(--n-500);
  letter-spacing: -0.01em;
  line-height: 1.2;
}
.header .title.active .t-text { color: var(--n-900); font-weight: 800; }
/* 下划线：与计划页 .tab-bar 完全一致（6rpx 高 / 圆角 / margin-top 10rpx / var(--lime)） */
.header .tab-bar {
  height: 6rpx; width: 100%; margin-top: 10rpx; border-radius: 999rpx;
  background: var(--lime); opacity: 0; transition: opacity .2s ease;
}
.header .title.active .tab-bar { opacity: 1; }

/* ============== SEARCH ============== */
.search {
  margin: 0 31rpx;
  padding: 0 27rpx;
  height: 85rpx;
  background: var(--n-100);
  border: 1rpx solid var(--n-200);
  border-radius: 23rpx;
  display: flex; align-items: center; gap: 19rpx;
}
.search-input {
  flex: 1 1 auto; min-width: 0;
  font-size: 27rpx; color: var(--n-900);
}
.search-clear { color: var(--n-500); font-size: 31rpx; font-weight: 700; padding: 4rpx 8rpx; }

/* ============== CATEGORIES（横向滚动行） ============== */
.categories {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  padding: 31rpx 23rpx 15rpx;
}
.cat {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  flex: 0 0 auto;
  margin-right: 27rpx;
}
.cat:last-child { margin-right: 0; }
.cat .ic {
  width: 92rpx; height: 92rpx;
  border-radius: 50%;
  background: var(--n-100);
  display: grid; place-items: center;
}
.cat.active .ic { background: var(--primary); }
.cat .name {
  font-size: 21rpx; font-weight: 600;
  color: var(--n-700);
  white-space: nowrap;
}
.cat.active .name { color: var(--n-900); font-weight: 700; }
/* 添加动作项：与分类同款圆形图标，虚线边框提示「新增」 */
.cat-add .ic {
  background: var(--white);
  border: 2rpx dashed #C9C9C2;
}

/* ============== 器械筛选条（与分类叠加） ==============
   放在分类栏正下方，与它视觉同族（都是横向滚动的胶囊），但更矮更素 ——
   分类是主维度、器械是辅助维度，层级要在视觉上体现出来。
   ⚠️ 对比度已逐项验算（浅色 / 深色）：
     未选 底 --n-100 / 字 --n-700 ⇒ 浅 6.49:1 · 深 9.07:1
     计数小字 --n-700 / 底 --n-100 ⇒ 浅 6.49:1 · 深 4.96:1（用 --n-700 不用更浅档，小字更易读）
     选中 底 --primary / 字 --primary-ink(#0A0A0A) ⇒ 16.74:1（两主题相同，亮绿不翻）
   ⚠️ 计数是 21rpx（≈10.5px）的小字，属于 WCAG「大字」以下，阈值按 4.5:1 算，故不用 --n-500/600。 */
.equip-bar {
  display: flex;
  white-space: nowrap;
  padding: 0 31rpx 21rpx;
}
.eq {
  display: inline-flex; align-items: center; gap: 8rpx;
  flex: 0 0 auto;
  height: 56rpx; padding: 0 21rpx;
  margin-right: 15rpx;
  border-radius: 28rpx;
  background: var(--n-100);
  border: 1rpx solid var(--n-200);
}
.eq:last-child { margin-right: 0; }
.eq .eq-name {
  font-size: 24rpx; font-weight: 600;
  color: var(--n-700);
  white-space: nowrap;
}
.eq .eq-count {
  font-size: 21rpx; font-weight: 500;
  color: var(--n-700);
  /* 计数与名字同色但略轻：靠字重而非对比度做层级，避免小字可读性掉到阈值下 */
  opacity: 0.75;
}
.eq.active {
  background: var(--primary);
  border-color: var(--primary);
}
.eq.active .eq-name { color: var(--primary-ink); font-weight: 700; }
.eq.active .eq-count { color: var(--primary-ink); opacity: 0.7; }

/* ============== SECTION ============== */
.section { padding: 15rpx 31rpx 31rpx; }
.section-label {
  font-size: 29rpx; font-weight: 800; letter-spacing: -0.01em;
  color: var(--n-900);
  margin: 0 8rpx 19rpx;
}

/* ============== EXERCISE CARD（竖向） ============== */
.exercise {
  padding: 23rpx;
  display: flex; align-items: center; gap: 23rpx;
  margin: 0 0 19rpx;
  background: var(--white);
  border: 1rpx solid var(--n-200);
  border-radius: 23rpx;
  box-shadow: var(--shadow-card);
}
.exercise:last-child { margin-bottom: 0; }
.ex-press { transform: scale(0.99); }

.exercise .photo {
  width: 138rpx; height: 138rpx;
  border-radius: 23rpx;
  flex: none;
  overflow: hidden;
  position: relative;
  background: linear-gradient(135deg, #2A2A2A 0%, #0A0A0A 100%);
  display: flex; align-items: center; justify-content: center;
}
.exercise .photo-img { width: 100%; height: 100%; display: block; }
.exercise .photo-emoji { font-size: 72rpx; line-height: 1; }

.exercise .body { flex: 1 1 auto; min-width: 0; }
.exercise .body .name {
  font-size: 29rpx; font-weight: 700; color: var(--n-900);
  letter-spacing: -0.01em;
}
.exercise .body .en {
  font-size: 21rpx; color: var(--n-600); font-weight: 500;
  margin-top: 4rpx;
  letter-spacing: 0.01em;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.exercise .body .tag {
  display: inline-flex; align-items: center;
  margin-top: 12rpx;
  padding: 4rpx 15rpx;
  background: #ECFFC2;
  color: var(--success-text);
  border-radius: 12rpx;
  font-size: 21rpx; font-weight: 700;
}

/* 右侧：星标 + 选择 */
.exercise .right {
  flex: none;
  display: flex; flex-direction: column; align-items: center; gap: 16rpx;
}
.exercise .star {
  width: 62rpx; height: 62rpx;
  display: grid; place-items: center;
  border-radius: 50%;
}
.exercise .add {
  width: 62rpx; height: 62rpx; border-radius: 50%;
  background: var(--primary); color: #0A0A0A;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 800; line-height: 1;
}
.exercise .add.added { background: var(--primary-deep); color: #0A0A0A; }
.exercise .del {
  width: 62rpx; height: 62rpx; border-radius: 50%;
  background: #FFE9E9; color: var(--danger-text);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; line-height: 1;
}
.exercise .del .del-glyph { line-height: 1; }

/* 空状态 / 署名 */
.empty { text-align: center; color: var(--text-weak); font-size: 27rpx; padding: 60rpx 0; }
.attr { margin: 28rpx 28rpx 0; text-align: center; font-size: 21rpx; color: var(--text-weak); }
.bottom-gap { height: 24rpx; }

/* ============== 底部固定行动栏 ============== */
.action-bar {
  position: fixed; left: 0; right: 0; bottom: 88rpx;
  display: flex; align-items: center; gap: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  z-index: 1000;
}
.ab-count { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.ab-num { font-size: 40rpx; font-weight: 800; color: var(--success); font-feature-settings: "tnum"; }
.ab-label { font-size: 20rpx; color: var(--text-sub); }
.ab-start {
  flex: 1;
  display: flex; align-items: center; justify-content: center;
  height: 80rpx;
  background: var(--primary); color: #0A0A0A;
  border-radius: 18rpx; font-size: 32rpx; font-weight: 700; line-height: 1; border: none;
  box-shadow: var(--shadow-mint);
}
.ab-start::after { border: none; }
.ab-start:active { opacity: 0.85; }
/* @contrast-ok: disabled 控件 —— WCAG 1.4.3 明确豁免失效控件，弱化字形是刻意的可用性信号。 */
.ab-start.disabled { background: var(--n-200); color: var(--n-500); box-shadow: none; }

/* ============== 弹窗 ============== */
.modal-mask {
  position: fixed; inset: 0; background: rgba(15, 23, 42, 0.5);
  display: flex; align-items: center; justify-content: center; z-index: 2000;
}
/* 弹层底走 var(--card)：硬编码 #fff 在深色模式下是白底配白字（--text:#FFFFFF）＝隐形 */
.modal { width: 600rpx; background: var(--card); border-radius: 28rpx; padding: 40rpx; box-shadow: var(--shadow-lg); animation: popIn 0.24s var(--ease-out); }
.modal-title { font-size: 36rpx; font-weight: 800; text-align: center; margin-bottom: 28rpx; color: var(--text); }
.modal-input {
  box-sizing: border-box; height: 88rpx; line-height: 88rpx;
  background: var(--bg); border-radius: 18rpx; padding: 0 24rpx;
  font-size: 28rpx; color: var(--text);
  border: 1rpx solid var(--line);
}
.modal-input:focus { border-color: var(--primary); }
.modal-input.sm { text-align: center; padding: 0 12rpx; }
.picker-display {
  box-sizing: border-box; height: 88rpx; line-height: 88rpx;
  background: var(--bg); border-radius: 18rpx; padding: 0 24rpx;
  font-size: 28rpx; color: var(--text);
  border: 1rpx solid var(--line);
}
.field-label { font-size: 24rpx; color: var(--text-sub); margin: 20rpx 0 10rpx; font-weight: 600; }
.param-row { display: flex; gap: 14rpx; }
.param-cell { flex: 1; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.modal-cancel, .modal-ok, .btn-use {
  height: 88rpx; line-height: 88rpx; padding: 0;
  border-radius: 18rpx; font-size: 32rpx; font-weight: 700; border: none;
}
.modal-cancel { flex: 1; background: var(--bg); color: var(--text-sub); }
.modal-ok { flex: 1; background: var(--primary); color: #0A0A0A; }
.btn-use { width: 100%; margin-top: 20rpx; background: var(--primary); color: #0A0A0A; box-shadow: var(--shadow-mint); }
.modal-cancel::after, .modal-ok::after, .btn-use::after { border: none; }

/* ============== 已选动作（本次训练） ============== */
.sel-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.sel-item:last-child { border-bottom: none; }
.sel-info { flex: 1; min-width: 0; }
.sel-name { font-size: 28rpx; font-weight: 700; }
.sel-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; margin-top: 8rpx; }
.sel-meta .tag { margin-right: 0; }
.sel-param { font-size: 20rpx; color: var(--text-sub); }
.sel-ops { flex: 0 0 auto; display: flex; gap: 12rpx; }
.sel-op { font-size: 24rpx; padding: 10rpx 22rpx; border-radius: 999rpx; font-weight: 600; }
.op-press { transform: scale(0.92); }
.sel-op.edit { color: #2a3d00; background: var(--primary); }
.sel-op.del { color: #fff; background: var(--danger-solid); }

/* ============== 已选动作总览弹窗 ============== */
.sel-edit-mask { z-index: 2100; }
.sel-panel { width: 640rpx; max-height: 82vh; display: flex; flex-direction: column; padding: 0; }
.sel-panel-head { display: flex; align-items: center; gap: 16rpx; padding: 28rpx 32rpx 20rpx; border-bottom: 1rpx solid var(--line); }
.sel-panel-title { flex: 1; font-size: 36rpx; font-weight: 800; }
.sel-panel-min, .sel-panel-close {
  flex: 0 0 auto; width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--bg); color: var(--text-sub); font-size: 36rpx; line-height: 1;
  display: flex; align-items: center; justify-content: center;
}
.sel-panel-close { color: var(--error); }
.sel-panel-list { flex: 1; max-height: 56vh; box-sizing: border-box; padding: 8rpx 32rpx; }
.sel-panel-add {
  margin: 8rpx 32rpx 32rpx; height: 88rpx; line-height: 88rpx; padding: 0; border: none;
  background: #E4FF6E; color: #2a3d00; border-radius: 18rpx;
  font-size: 32rpx; font-weight: 700;
}
.sel-panel-add::after { border: none; }

/* 最小化悬浮气泡 */
.sel-bubble {
  position: fixed; right: 24rpx; bottom: calc(128rpx + env(safe-area-inset-bottom));
  z-index: 1500; background: var(--primary); color: #0A0A0A;
  font-size: 24rpx; font-weight: 700; padding: 18rpx 28rpx; border-radius: 999rpx;
  box-shadow: 0 10rpx 28rpx rgba(124, 184, 0, 0.32);
}
.bubble-press { transform: scale(0.94); opacity: 0.9; }

@keyframes popIn {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}

/* ============================================================
   深色主题（.page.theme-dark 变量重定义，向下继承自动翻转）
   ============================================================ */
.page.theme-dark {
  --n-950: #FFFFFF;
  --n-900: #FFFFFF;
  --n-700: rgba(255,255,255,.70);
  --n-600: rgba(255,255,255,.55);
  --n-500: rgba(255,255,255,.42);
  --n-400: rgba(255,255,255,.32);
  --n-300: rgba(255,255,255,.22);
  --n-200: rgba(255,255,255,.10);
  --n-100: #1E1E1E;
  --n-50: #0A0A0A;
  --white: #161616;
  --card-gray: #1E1E1E;
  --lime: #C8FF00;        /* 深色下下划线提亮，与计划页深色变体一致 */

  --text: #FFFFFF;
  --text-sub: rgba(255,255,255,.70);
  --text-weak: rgba(255,255,255,.45);
  --line: rgba(255,255,255,.10);
  --line-strong: rgba(255,255,255,.20);

  --success: #C8FF00;
  /* 语义绿「文字」档：.exercise .body .tag 是绿字压绿淡底，
     浅色侧走 --success-text(#4C7300)，深色下必须同步提亮，
     否则退回根值压深绿底只有 2.85:1。 */
  --success-text: #C8FF00;

  /* 红字深底提亮：--danger-text 根值 #C4363B 压 rgba(242,84,91,.14) 的暗红底只有 3.91:1 */
  --danger-text: #FF6B70;

  --card: #161616;
  --bg: rgba(255,255,255,.06);
  --bg-muted: #1E1E1E;
  --glass: #161616;
  --glass-strong: #1E1E1E;
  --glass-border: rgba(255,255,255,.10);

  --primary-tint: rgba(200,255,0,.12);
  --accent-soft: rgba(255,149,0,.14);
  --accent-tint: rgba(255,149,0,.14);
  --info-tint: rgba(62,139,255,.14);
  --purple-tint: rgba(139,92,246,.16);
  --warning-tint: rgba(255,176,32,.14);

  --shadow-card: 0 4rpx 16rpx rgba(0,0,0,.35);
  --shadow-sm: 0 4rpx 16rpx rgba(0,0,0,.30);
  --shadow-md: 0 10rpx 30rpx rgba(0,0,0,.40);
  --shadow-lg: 0 16rpx 44rpx rgba(0,0,0,.50);
  --shadow-xs: 0 2rpx 8rpx rgba(0,0,0,.30);

  background: var(--n-50);
  color: var(--text);
}

/* 深色下的硬编码色单独覆盖 */
.page.theme-dark .action-bar { background: rgba(10,10,10,0.96); box-shadow: 0 -4rpx 24rpx rgba(0,0,0,.5); }
.page.theme-dark .modal { background: #161616; }
.page.theme-dark .exercise .body .tag { background: rgba(200,255,0,.12); }
.page.theme-dark .exercise .del { background: rgba(242,84,91,.14); }
.page.theme-dark .cat-add .ic { border-color: rgba(255,255,255,.25); }
.page.theme-dark .cat.active .ic .ico--ink { background-color: #0A0A0A; }
