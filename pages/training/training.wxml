<!-- pages/training/training.wxml —— 对齐 02-train.html（HiLiLife 设计系统） -->
<view class="page {{theme}}">
  <nav-bar title="训练" show-back="{{false}}" />

  <!-- 训练中挑选模式横幅（actionPick 交接）：亮绿实底 + 深字（对比度铁律），点取消退出挑选 -->
  <view wx:if="{{pickMode}}" class="pick-banner">
    <text class="pick-text">{{pickText}}</text>
    <view class="pick-cancel" hover-class="op-press" bindtap="cancelPick">取消</view>
  </view>

  <!-- ============== HEADER：动作库 / 收藏 ============== -->
  <view class="header">
    <view class="lead">
      <view class="title {{mode==='lib' ? 'active' : ''}}" bindtap="switchMode" data-mode="lib">
        <text class="t-text">动作库</text>
        <view class="tab-bar"></view>
      </view>
      <view class="title {{mode==='fav' ? 'active' : ''}}" bindtap="switchMode" data-mode="fav">
        <text class="t-text">收藏</text>
        <view class="tab-bar"></view>
      </view>
    </view>
  </view>

  <!-- ============== SEARCH ============== -->
  <view class="search">
    <view class="ico ico-search ico--ink" style="width:32rpx;height:32rpx"></view>
    <input class="search-input" placeholder="搜索动作名称" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">✕</text>
  </view>

  <!-- ============== CATEGORIES（仅动作库模式，横向滚动） ============== -->
  <scroll-view wx:if="{{mode==='lib'}}" class="categories" scroll-x enable-flex>
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="cat {{activeCat === item ? 'active' : ''}}"
      data-cat="{{item}}"
      bindtap="switchCat"
    >
      <view class="ic"><view class="ico ico-{{catIcons[item]}} ico--ink" style="width:48rpx;height:48rpx"></view></view>
      <text class="name">{{item}}</text>
    </view>
    <!-- 添加动作：分类行最末，匹配样式 -->
    <view class="cat cat-add" bindtap="openCreate" hover-class="op-press" aria-label="创建动作">
      <view class="ic"><view class="ico ico-plus ico--ink" style="width:48rpx;height:48rpx"></view></view>
      <text class="name">添加</text>
    </view>
  </scroll-view>

  <!-- ============== 器械筛选（与上方分类【叠加】） ==============
       为什么要这一行：动作库原本只有「身体部位」一个筛选维度，但 equip 是真实存在
       且信息量很大的一维 —— 实测「自重」有 304 条（23.5%，比哑铃还多），却完全不可见，
       用户搜得到、看不见入口。这一行把它暴露出来。
       ⚠️ 与分类是 AND：选「哑铃」+「胸部」= 只看哑铃练胸。
       ⚠️ 切换器械不清空分类（为了组合），但会清空搜索词。 -->
  <scroll-view wx:if="{{mode==='lib'}}" class="equip-bar" scroll-x enable-flex>
    <view
      wx:for="{{equips}}"
      wx:key="*this"
      class="eq {{activeEquip === item ? 'active' : ''}}"
      data-equip="{{item}}"
      bindtap="switchEquip"
      hover-class="op-press"
    >
      <text class="eq-name">{{item}}</text>
      <text class="eq-count" wx:if="{{item !== '全部' && equipCounts[item]}}">{{equipCounts[item]}}</text>
    </view>
  </scroll-view>

  <!-- ============== EXERCISE LIST（竖向卡片） ============== -->
  <view class="section">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="card exercise"
      hover-class="ex-press"
      data-id="{{item.id}}"
      bindtap="tapAction"
    >
      <view class="photo">
        <image wx:if="{{item.gif}}" class="photo-img" src="{{item.gif}}" mode="aspectFill" lazy-load />
        <text wx:else class="photo-emoji">{{item.emoji}}</text>
      </view>
      <view class="body">
        <view class="name">{{item.nameZh}}</view>
        <view wx:if="{{item.name && item.name !== item.nameZh}}" class="en">{{item.name}}</view>
        <view class="tag">{{item.part || item.category}}</view>
      </view>
      <view class="right">
        <view class="star {{favoriteIds[item.id] ? 'on' : ''}}" hover-class="op-press" catchtap="toggleFav" data-id="{{item.id}}">
          <view class="ico ico-{{favoriteIds[item.id] ? 'staron' : 'staroff'}} {{favoriteIds[item.id] ? 'ico--accent' : ''}}" style="width:40rpx;height:40rpx"></view>
        </view>
        <view class="add {{selectedIds[item.id] ? 'added' : ''}}" hover-class="op-press" catchtap="toggleSelect" data-id="{{item.id}}">
          <text>{{selectedIds[item.id] ? '✓' : '+'}}</text>
        </view>
        <view wx:if="{{item.custom}}" class="del" hover-class="op-press" catchtap="deleteCustom" data-id="{{item.id}}" aria-label="删除动作">
          <text class="del-glyph">🗑</text>
        </view>
      </view>
    </view>

    <view wx:if="{{list.length === 0}}" class="empty">{{mode==='fav' ? '还没有收藏动作，点卡片右侧星标收藏' : (activeCat==='我的动作' ? '还没有自建动作，点上方分类栏末尾的 + 添加' : '没有匹配的动作')}}</view>
  </view>

  <view class="attr">动作图片 © Gym visual</view>
  <view class="bottom-gap"></view>

<!-- ============== 底部固定行动栏（仅手动勾选动作后出现，selectedActions 只存手动添加；
     挑选模式下隐藏 ——「开始训练」会开新训练顶掉进行中的那场，语义冲突） ============== -->
<view wx:if="{{selectedCount > 0 && !pickMode}}" class="action-bar">
  <view class="ab-count" hover-class="op-press" bindtap="openSelPanel">
    <text class="ab-num">{{selectedCount}}</text>
    <text class="ab-label">已选动作</text>
  </view>
  <button class="ab-start {{selectedCount ? '' : 'disabled'}}" bindtap="startTraining">开始训练</button>
</view>

<!-- ============== 创建动作弹窗 ============== -->
<view wx:if="{{showCreate}}" class="modal-mask" bindtap="closeCreate">
  <view class="modal" catchtap="noop">
    <view class="modal-title">创建动作</view>
    <input class="modal-input" placeholder="动作名称，如：单臂哑铃划船" value="{{newName}}" bindinput="onName" />

    <view class="field-label">训练部位</view>
    <picker class="part-picker" mode="selector" range="{{parts}}" value="{{partIndex}}" bindchange="onPart">
      <view class="picker-display">{{parts[partIndex]}}</view>
    </picker>

    <view class="param-row">
      <view class="param-cell">
        <view class="field-label">重量(kg)</view>
        <input class="modal-input sm" type="digit" placeholder="如 20" value="{{newWeight}}" bindinput="onWeight" />
      </view>
      <view class="param-cell">
        <view class="field-label">次数</view>
        <input class="modal-input sm" type="number" placeholder="如 12" value="{{newReps}}" bindinput="onReps" />
      </view>
      <view class="param-cell">
        <view class="field-label">组数</view>
        <input class="modal-input sm" type="number" placeholder="如 4" value="{{newSets}}" bindinput="onSets" />
      </view>
    </view>

    <view class="modal-actions">
      <button class="btn-secondary modal-cancel" bindtap="closeCreate">取消</button>
      <button class="btn-primary modal-ok" bindtap="submitCreate">保存</button>
    </view>
    <button class="btn-use" bindtap="submitAndUse">保存并用于本次训练</button>
  </view>
</view>

<!-- ============== 已选动作编辑弹窗 ============== -->
<view wx:if="{{showSelEdit}}" class="modal-mask sel-edit-mask" bindtap="closeSelEdit">
  <view class="modal" catchtap="noop">
    <view class="modal-title">修改训练参数</view>
    <view class="param-row">
      <view class="param-cell">
        <view class="field-label">重量(kg)</view>
        <input class="modal-input sm" type="digit" placeholder="如 20" value="{{editWeight}}" bindinput="onEditWeight" />
      </view>
      <view class="param-cell">
        <view class="field-label">次数</view>
        <input class="modal-input sm" type="number" placeholder="如 12" value="{{editReps}}" bindinput="onEditReps" />
      </view>
      <view class="param-cell">
        <view class="field-label">组数</view>
        <input class="modal-input sm" type="number" placeholder="如 4" value="{{editSets}}" bindinput="onEditSets" />
      </view>
    </view>
    <view class="modal-actions">
      <button class="btn-secondary modal-cancel" bindtap="closeSelEdit">取消</button>
      <button class="btn-primary modal-ok" bindtap="saveSelEdit">保存</button>
    </view>
  </view>
</view>

<!-- ============== 已选动作总览弹窗 ============== -->
<view wx:if="{{showSelPanel}}" class="modal-mask sel-panel-mask" bindtap="closeSelPanel">
  <view class="modal sel-panel" catchtap="noop">
    <view class="sel-panel-head">
      <text class="sel-panel-title">已选动作 ({{selList.length}})</text>
      <view class="sel-panel-min" hover-class="op-press" catchtap="minimizeSelPanel">－</view>
      <view class="sel-panel-close" hover-class="op-press" catchtap="closeSelPanel">✕</view>
    </view>
    <scroll-view class="sel-panel-list" scroll-y>
      <view class="sel-item" wx:for="{{selList}}" wx:key="id">
        <view class="sel-info">
          <view class="sel-name ellipsis">{{item.name}}</view>
          <view class="sel-meta">
            <text class="tag tag-primary" wx:if="{{item.part}}">{{item.part}}</text>
            <text class="sel-param">重量 {{item.weight || '—'}}kg</text>
            <text class="sel-param">次数 {{item.reps || '—'}}</text>
            <text class="sel-param">组数 {{item.setsCount}}</text>
          </view>
        </view>
        <view class="sel-ops">
          <view class="sel-op edit" hover-class="op-press" catchtap="editSelected" data-id="{{item.id}}">修改</view>
          <view class="sel-op del" hover-class="op-press" catchtap="removeSelected" data-id="{{item.id}}">删除</view>
        </view>
      </view>
      <view wx:if="{{selList.length === 0}}" class="empty">还没有选择动作，去动作库勾选吧</view>
    </scroll-view>
    <button class="sel-panel-add" bindtap="minimizeSelPanel">继续选择动作</button>
  </view>
</view>

<!-- ============== 最小化悬浮气泡 ============== -->
<view wx:if="{{selMinimized}}" class="sel-bubble" hover-class="bubble-press" catchtap="restoreSelPanel">
  已选 {{selectedCount}} 个动作 ›
</view>

</view>
<!-- /.page（闭合于文件末尾：行动栏/弹窗/气泡是 fixed 元素，纳入 .page 内才能吃到 .page.theme-dark 的深色变量） -->
