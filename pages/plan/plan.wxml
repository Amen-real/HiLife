<!-- pages/plan/plan.wxml —— 训练计划卡片（按方案分组渲染，对齐 03-plan.html） -->
<view class="page {{theme}}">
  <!-- 顶部自定义状态栏：标题「训练计划」（原页面内 .header 标题块已移除） -->
  <nav-bar title="训练计划" show-back="{{false}}" />

  <!-- ============== 列表模式 ============== -->
  <block wx:if="{{mode === 'list'}}">

    <!-- TABS -->
    <view class="tabs">
      <view class="tab {{seg==='mine' ? 'on' : ''}}" data-seg="mine" bindtap="switchSeg">
        <text class="tab-t">我的计划</text>
        <view class="tab-bar"></view>
      </view>
      <view class="tab {{seg==='tpl' ? 'on' : ''}}" data-seg="tpl" bindtap="switchSeg">
        <text class="tab-t">模板推荐</text>
        <view class="tab-bar"></view>
      </view>
    </view>

    <!-- ============== 我的计划 ============== -->
    <scroll-view wx:if="{{seg==='mine'}}" class="scroll" scroll-y>
      <view class="section">

        <!-- 计划库：按「方案」分组（一套模板 = 一组；手动创建的计划归入「自定义计划」组） -->
        <view wx:if="{{groups.length}}" class="groups">
          <view class="group" wx:for="{{groups}}" wx:key="key" wx:for-item="g">

            <!-- 方案组头：名称 · 训练日数 · 本周进度 · [使用中 / 设为使用中] [移除] -->
            <view class="group-head">
              <view class="gh-l">
                <view class="gh-name">{{g.name}}</view>
                <view class="gh-sub">
                  <text>{{g.count}} 个{{g.isProgram ? '训练日' : '计划'}}</text>
                  <text wx:if="{{g.weekTarget}}" class="gh-week"> · 本周 {{g.weekDone}}/{{g.weekTarget}}</text>
                </view>
              </view>
              <view wx:if="{{g.isProgram}}" class="gh-r">
                <view wx:if="{{g.isActive}}" class="gh-badge">使用中</view>
                <view wx:else class="gh-btn" catchtap="useProgram" data-pid="{{g.pid}}">设为使用中</view>
                <view class="gh-btn gh-del" catchtap="removeProgram" data-pid="{{g.pid}}">移除</view>
              </view>
            </view>

            <!-- 组内：训练日卡片（A 日 / B 日 / C 日…） -->
            <view class="plans">
              <view class="plan {{item.featured ? 'featured' : ''}}" wx:for="{{g.plans}}" wx:key="id" data-id="{{item.id}}" bindtap="openPlanDetail">
                <view class="plan-body">
                  <view wx:if="{{item.todayTag}}" class="plan-tag tag-today tag-today-top">今日</view>
                  <view class="row-top">
                    <view class="title">{{item.cardTitle}}</view>
                    <view class="more" catchtap="openMenu" data-id="{{item.id}}"><view class="ico ico-more"></view></view>
                  </view>
                  <view wx:if="{{item.goal || item.level}}" class="plan-tags">
                    <text wx:if="{{item.goal}}" class="plan-tag">{{item.goal}}</text>
                    <text wx:if="{{item.level}}" class="plan-tag">{{item.level}}</text>
                  </view>
                  <view class="plan-data">
                    <view class="pd"><view class="ico ico-calendar pd-ico"></view><text>{{item.count}} 个动作</text></view>
                    <view class="pd"><view class="ico ico-clock pd-ico"></view><text>{{item.minutes}} 分钟</text></view>
                    <view class="pd"><view class="ico ico-flame pd-ico"></view><text>{{item.kcal}} kcal</text></view>
                  </view>
                  <view class="plan-bottom">
                    <view class="plan-status">
                      <view class="dot {{item.statusDot}}"></view>
                      <text class="ps-text {{item.statusCls}}">{{item.statusText}}</text>
                    </view>
                    <view class="plan-cta" catchtap="startPlan" data-id="{{item.id}}">开始训练<view class="ico ico-arrowright cta-ico"></view></view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 空态 -->
        <view wx:else class="empty">
          <view class="empty-ico"><view class="ico ico-plan ico--ink" style="width:72rpx;height:72rpx"></view></view>
          <view class="empty-title">还没有训练计划</view>
          <view class="empty-hint">新建一套，首页即可看到今天练什么</view>
          <view class="btn-add empty-btn" bindtap="goCreate"><view class="btn-add-left"><view class="add-ico"><view class="ico ico-plus"></view></view><text>新建训练计划</text></view><view class="btn-add-arrow"><view class="ico ico-arrowright"></view></view></view>
        </view>

        <!-- 常驻新建入口（次级白按钮） -->
        <view wx:if="{{groups.length}}" class="add-plan-row">
          <view class="btn-add" bindtap="goCreate"><view class="btn-add-left"><view class="add-ico"><view class="ico ico-plus"></view></view><text>新建训练计划</text></view><view class="btn-add-arrow"><view class="ico ico-arrowright"></view></view></view>
        </view>
      </view>
    </scroll-view>

    <!-- ============== 模板推荐 ============== -->
    <scroll-view wx:else class="scroll" scroll-y>
      <view class="section">
        <view class="section-label">推荐模板</view>
        <view class="recs">
          <view class="rec" wx:for="{{programs}}" wx:key="id" data-id="{{item.id}}" bindtap="openProgram" hover-class="rec-hover">
            <view class="photo" style="{{item.thumbStyle}}">
              <view class="ico ico-{{item.icon}}" style="{{item.icoStyle}}"></view>
              <view class="photo-accent" style="{{item.accentStyle}}"></view>
            </view>
            <view class="body">
              <view class="t">{{item.name}}</view>
              <view class="sub">{{item.sub}}</view>
            </view>
            <view class="chev-wrap">›</view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- ============== 更多菜单（⋯） ============== -->
    <view class="sheet-mask" wx:if="{{showMenu}}" bindtap="closeMenu">
      <view class="sheet sheet-menu" catchtap="noop">
        <view class="sm-title">{{menuName}}</view>
        <view class="sm-item" data-act="edit" bindtap="menuAction"><view class="ico ico-edit"></view><text>编辑计划</text></view>
        <view class="sm-item" data-act="use" bindtap="menuAction"><view class="ico ico-calendar"></view><text>设为今日计划</text></view>
        <view class="sm-item danger" data-act="delete" bindtap="menuAction"><view class="ico ico-delete"></view><text>删除计划</text></view>
        <view class="sm-cancel" bindtap="closeMenu">取消</view>
      </view>
    </view>

    <!-- ============== 计划详情（查看） ============== -->
    <view class="sheet-mask" wx:if="{{showPlanDetail}}" bindtap="closePlanDetail">
      <view class="sheet sheet-detail" catchtap="noop">
        <view class="pd-head">
          <view class="pd-title">{{planDetail.name}}</view>
          <view class="pd-close" bindtap="closePlanDetail">✕</view>
        </view>
        <view wx:if="{{planDetail.goal || planDetail.level}}" class="pd-tags">
          <text wx:if="{{planDetail.goal}}" class="plan-tag">{{planDetail.goal}}</text>
          <text wx:if="{{planDetail.level}}" class="plan-tag">{{planDetail.level}}</text>
        </view>
        <view class="pd-data">
          <view class="pd"><view class="ico ico-dumbbell pd-ico"></view><text>{{planDetail.count}} 个动作</text></view>
          <view class="pd"><view class="ico ico-clock pd-ico"></view><text>{{planDetail.minutes}} 分钟</text></view>
          <view class="pd"><view class="ico ico-flame pd-ico"></view><text>{{planDetail.kcal}} kcal</text></view>
        </view>
        <scroll-view class="pd-body" scroll-y>
          <view class="pd-act" wx:for="{{planDetail.actions}}" wx:key="name">
            <view class="pd-act-idx">{{index + 1}}</view>
            <view class="pd-act-name">{{item.name}}</view>
            <view class="pd-act-param">{{item.setsCount}} 组 · {{item.reps}}</view>
          </view>
        </scroll-view>
        <view class="pd-foot">
          <view class="pd-cta ghost" catchtap="useAsToday" data-id="{{planDetail.id}}">设为今日计划</view>
          <view class="pd-cta primary" catchtap="startPlan" data-id="{{planDetail.id}}">开始训练 →</view>
        </view>
      </view>
    </view>

    <!-- ============== 模板详情弹层 ============== -->
    <view class="tpl-mask" wx:if="{{showTpl}}" bindtap="closeTpl">
      <view class="tpl-sheet" catchtap="noop">
        <view class="tpl-head">
          <view class="tpl-thumb" style="{{tplDetail.thumbStyle}}">
            <view class="ico ico-{{tplDetail.icon}}" style="{{tplDetail.icoStyle}}"></view>
          </view>
          <view class="tpl-htext">
            <view class="tpl-name">{{tplDetail.name}}</view>
            <view class="tpl-tags">
              <text class="tpl-tag">{{tplDetail.level}}</text>
              <text class="tpl-tag">{{tplDetail.daysPerWeek}}天/周</text>
              <text class="tpl-tag">{{tplDetail.goal}}</text>
            </view>
          </view>
          <view class="tpl-close" bindtap="closeTpl">✕</view>
        </view>

        <scroll-view class="tpl-body" scroll-y>
          <!-- 主入口：一次导入整套（全部训练日 → 我的计划卡片；默认激活第一天，完成后自动轮换） -->
          <view class="tpl-import-all" data-pid="{{tplDetail.id}}" bindtap="importProgram" hover-class="tpl-import-hover">
            <view class="tia-main">导入整套计划</view>
            <view class="tia-sub">{{tplDetail.dayCount}} 个训练日 · 每周 {{tplDetail.daysPerWeek}} 次 · 完成后自动轮换</view>
          </view>

          <view class="tpl-desc">{{tplDetail.desc}}</view>

          <view wx:if="{{tplDetail.multiDay}}" class="tpl-days-label">训练日 · {{tplDetail.dayCount}} 天</view>

          <view class="tpl-day" wx:for="{{tplDetail.days}}" wx:key="idx">
            <view class="tpl-day-head">
              <view class="tpl-day-name">{{item.name}}</view>
              <view class="tpl-day-focus">{{item.focus}}</view>
            </view>
            <view class="tpl-act" wx:for="{{item.actions}}" wx:key="exerciseId">
              <view class="tpl-act-idx">{{index + 1}}</view>
              <view class="tpl-act-main">
                <view class="tpl-act-name">{{item.name}}</view>
                <view class="tpl-act-note" wx:if="{{item.note}}">{{item.note}}</view>
              </view>
              <view class="tpl-act-param">
                <text class="tpl-sets">{{item.setsCount}} 组</text>
                <text class="tpl-reps">× {{item.reps}}</text>
              </view>
            </view>
            <view class="tpl-day-import" data-pid="{{tplDetail.id}}" data-di="{{index}}" bindtap="importDay">{{tplDetail.multiDay ? '设为今日' : '导入此训练日'}}</view>
          </view>
        </scroll-view>
      </view>
    </view>
  </block>

  <!-- ============== 新建 / 编辑模式 ============== -->
  <block wx:else>
    <view class="topbar">
      <view class="tb-back" bindtap="backToList">‹ 返回</view>
      <view class="tb-title">{{isEdit ? '修改计划' : '新建计划'}}</view>
      <view class="tb-save" bindtap="savePlan">保存</view>
    </view>

    <view class="card">
      <view class="field-label">计划名称</view>
      <input class="name-input" placeholder="如：练胸日 / 全身循环" value="{{planName}}" bindinput="onPlanName" />
    </view>

    <view class="card">
      <view class="field-label">训练目标</view>
      <view class="chip-row">
        <view wx:for="{{goalOptions}}" wx:key="*this" class="chip {{goal===item ? 'on' : ''}}" data-v="{{item}}" bindtap="onGoal">{{item}}</view>
      </view>
      <view class="field-label" style="margin-top:20rpx">难度</view>
      <view class="chip-row">
        <view wx:for="{{levelOptions}}" wx:key="*this" class="chip {{level===item ? 'on' : ''}}" data-v="{{item}}" bindtap="onLevel">{{item}}</view>
      </view>
      <view class="field-label" style="margin-top:20rpx">每周训练天数</view>
      <input class="num-input" type="number" placeholder="如 3" value="{{daysPerWeek}}" bindinput="onDaysPerWeek" />
      <view class="field-label" style="margin-top:20rpx">计划说明</view>
      <textarea class="desc-input" placeholder="简单描述这套计划的安排与注意点" value="{{desc}}" bindinput="onDesc" maxlength="200" />
    </view>

    <view class="card">
      <view class="field-label">选择动作（{{pickedCount}}）</view>
      <scroll-view scroll-x class="cat-tabs">
        <view wx:for="{{catList}}" wx:key="*this"
              class="cat-tab {{activeCat === item ? 'on' : ''}}" data-cat="{{item}}" bindtap="switchCat">{{item}}</view>
      </scroll-view>
      <view class="search-box">
        <input class="search-input" placeholder="搜索动作" bindinput="onSearch" />
      </view>
      <view class="act-pool">
        <view class="pool-item {{pickedMap[item.id] ? 'picked' : ''}}" wx:for="{{actionPool}}" wx:key="id" data-id="{{item.id}}" bindtap="togglePick" hover-class="pool-hover">
          <view class="pool-main">
            <text class="pool-name">{{item.nameZh || item.name}}</text>
            <text class="pool-cat">{{item.part || item.category}}</text>
          </view>
          <view class="pool-check">{{pickedMap[item.id] ? '✓' : ''}}</view>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{pickedList.length}}">
      <view class="field-label">已选动作 · 组数/次数（{{pickedCount}}）</view>
      <view class="pick-row" wx:for="{{pickedList}}" wx:key="actionId">
        <view class="pick-name">{{item.nameZh || item.name}}</view>
        <view class="pick-params">
          <view class="pf"><text class="pf-l">组</text><input class="pf-i" type="number" value="{{item.setsCount}}" data-aid="{{item.actionId}}" bindinput="onActionSets" /></view>
          <view class="pf"><text class="pf-l">次</text><input class="pf-i" value="{{item.reps}}" data-aid="{{item.actionId}}" bindinput="onActionReps" /></view>
        </view>
      </view>
    </view>
  </block>
</view>
