<!-- pages/plan/plan.wxml —— 严格对齐 03-plan.html（HiLiLife 设计系统） -->
<view class="page {{theme}}">

  <!-- ============== 列表模式 ============== -->
  <block wx:if="{{mode === 'list'}}">

    <!-- HEADER：我的计划 / 模板推荐 双标题（对齐数据页 .header） -->
    <view class="header">
      <view class="lead">
        <view class="title {{seg==='mine' ? 'active' : ''}}" data-seg="mine" bindtap="switchSeg">我的计划</view>
        <view class="title {{seg==='tpl' ? 'active' : ''}}" data-seg="tpl" bindtap="switchSeg">模板推荐</view>
      </view>
    </view>

    <!-- ============== 我的计划 ============== -->
    <scroll-view wx:if="{{seg==='mine'}}" class="scroll" scroll-y>
      <view class="section">
        <view wx:if="{{plans.length}}" class="plans">
          <!-- 计划卡片：标题 + chev + meta + 进度条（对齐 03 .plan），整卡点击 = 开始训练 -->
          <view class="plan" wx:for="{{plans}}" wx:key="id" data-id="{{item.id}}" bindtap="startPlan" hover-class="plan-hover">
            <view class="row-top">
              <view class="title">{{item.name}}</view>
              <view class="chev" aria-hidden="true">›</view>
            </view>
            <view class="meta"><text class="label">{{item.count}} 个动作</text></view>
            <view class="progress-row">
              <text class="progress-label">{{item.isActive ? '已设为今日计划' : '未使用'}}</text>
              <text class="progress-pct">{{item.isActive ? '100%' : '0%'}}</text>
            </view>
            <view class="progress"><i class="{{item.isActive ? 'on' : ''}}"></i></view>
          </view>
        </view>

        <!-- 空态 -->
        <view wx:else class="empty">
          <view class="empty-ico"><view class="ico ico-plan ico--ink" style="width:72rpx;height:72rpx"></view></view>
          <view class="empty-title">还没有训练计划</view>
          <view class="empty-hint">新建一套，首页即可看到今天练什么</view>
          <view class="btn-primary empty-btn" bindtap="goCreate">新建计划</view>
        </view>
      </view>
    </scroll-view>

    <!-- ============== 模板推荐 ============== -->
    <scroll-view wx:else class="scroll" scroll-y>
      <view class="section">
        <view class="section-label">推荐模板</view>
        <view class="recs">
          <!-- 推荐卡片：缩略图 + 标题 + 副标题 + chev（对齐 03 .rec），点击展开详情 -->
          <view class="rec" wx:for="{{programs}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleProgram" hover-class="rec-hover">
            <view class="photo" style="background:{{item.thumbBg}}">
              <text class="photo-emoji">{{item.emoji}}</text>
              <view class="photo-accent" style="background:{{item.accent}}"></view>
            </view>
            <view class="body">
              <view class="t">{{item.name}}</view>
              <view class="sub">{{item.sub}}</view>
            </view>
            <view class="chev-wrap" aria-hidden="true">›</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </block>

  <!-- ============== 新建模式 ============== -->
  <block wx:else>
    <view class="topbar">
      <view class="tb-back" bindtap="backToList">‹ 返回</view>
      <view class="tb-title">{{isEdit ? '修改计划' : '新建计划'}}</view>
      <view class="tb-save" bindtap="savePlan">保存</view>
    </view>

    <view class="card">
      <view class="field-label">计划名称</view>
      <!-- 非受控输入：输入暂存实例变量，避免整页重渲染丢字 -->
      <input class="name-input" placeholder="如：练胸日 / 全身循环" value="{{planName}}" bindinput="onPlanName" />
    </view>

    <view class="card">
      <view class="field-label">选择动作（{{pickedCount}}）</view>
      <!-- 分类 tab（复用训练页模式，单分类渲染，不一次渲染千条） -->
      <scroll-view scroll-x class="cat-tabs">
        <view wx:for="{{catList}}" wx:key="*this"
              class="cat-tab {{activeCat === item ? 'on' : ''}}" data-cat="{{item}}" bindtap="switchCat">{{item}}</view>
      </scroll-view>
      <view class="search-box">
        <input class="search-input" placeholder="搜索动作" bindinput="onSearch" />
      </view>
      <view class="act-pool">
        <view class="pool-item {{pickedMap[item.id] ? 'picked' : ''}}" wx:for="{{actionPool}}" wx:key="id" data-id="{{item.id}}" bindtap="togglePick" hover-class="pool-hover">
          <view class="pool-main">
            <text class="pool-name">{{item.nameZh || item.name}}</text>
            <text class="pool-cat">{{item.part || item.category}}</text>
          </view>
          <view class="pool-check">{{pickedMap[item.id] ? '✓' : ''}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
