/* pages/list/list.wxss —— 严格对齐 06-records.html（HiLiLife 设计系统：暖白底 + 荧光绿） */
.page {
  width: 100vw; box-sizing: border-box;
  background: var(--n-50);
  display: flex; flex-direction: column;
  min-height: 100vh;
  --lime: #B7E600;        /* 下划线色，与计划页同款（深色模式在 .page.theme-dark 内覆盖为 #C8FF00） */
}

/* ============== HEADER：训练记录 / 训练复盘 + 更多/设置 ============== */
.header {
  flex: none;
  padding: 16rpx 32rpx 24rpx;
  display: flex; align-items: center; justify-content: space-between;
}
.header .lead { display: flex; align-items: center; gap: 48rpx; }
/* .title 作为纵向容器：文字 .t-text + 独立下划线 .tab-bar（与计划页同款实现）；字号保持本页原 44rpx */
.header .title { display: inline-flex; flex-direction: column; align-items: flex-start; }
.header .t-text {
  font-size: 42rpx; font-weight: 500;
  color: var(--n-500);
  letter-spacing: -0.01em;
  line-height: 1.2;
  transition: color 200ms var(--ease-out);
}
.header .title.active .t-text { color: var(--n-900); font-weight: 800; }
/* 下划线：与计划页 .tab-bar 完全一致（6rpx 高 / 圆角 / margin-top 10rpx / var(--lime)） */
.header .tab-bar {
  height: 6rpx; width: 100%; margin-top: 10rpx; border-radius: 999rpx;
  background: var(--lime); opacity: 0; transition: opacity .2s ease;
}
.header .title.active .tab-bar { opacity: 1; }

/* ============== SCROLL ============== */
.scroll {
  flex: 1 1 auto;
  width: 100%; box-sizing: border-box;
  padding: 0 32rpx 200rpx;
  overflow-x: hidden;
}

/* ============== MONTH ============== */
.month {
  display: inline-flex; align-items: center; gap: 12rpx;
  margin: 8rpx 0 28rpx;
  font-size: 30rpx; font-weight: 800;
  letter-spacing: -0.01em;
  color: var(--n-900);
  padding: 8rpx 0;
}
.month-hover { opacity: 0.6; }
.month .caret { font-size: 24rpx; color: var(--n-900); }

/* ============== WEEKDAYS ============== */
.weekdays {
  display: grid; grid-template-columns: repeat(7, 1fr);
  margin-bottom: 16rpx;
}
.weekday {
  text-align: center;
  font-size: 22rpx; font-weight: 600;
  color: var(--n-400);
  letter-spacing: 0.02em;
  padding: 12rpx 0;
}

/* ============== DATE ROW ============== */
.dates {
  display: grid; grid-template-columns: repeat(7, 1fr);
  margin-bottom: 36rpx;
}
.date {
  position: relative;
  height: 80rpx;
  display: grid; place-items: center;
  font-family: var(--f-en);
  font-size: 28rpx; font-weight: 500;
  color: var(--n-900);
  border-radius: 50%;
  font-variant-numeric: tabular-nums;
  transition: background 200ms;
  margin: 0 auto;
}
.date.muted { color: var(--n-300); }
.date:not(.active):not(.muted):active { background: var(--n-100); }
.date.active {
  width: 64rpx; height: 64rpx;
  /* 浅色：反白深底 + 橄榄绿数字（9.38:1）。深色下 --n-900 会翻成 #FFFFFF，
     橄榄绿压白只剩 2.01:1 —— 所以深色改用品牌亮绿底 + 墨字（见文件尾部深色段）。 */
  background: var(--n-900);
  color: #A6C24A;
  font-weight: 600;
}

.date.has-record::after {
  content: "";
  position: absolute; left: 50%; bottom: 8rpx;
  transform: translateX(-50%);
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  background: var(--primary);
}
.date.active.has-record::after { background: var(--primary); }

/* ============== RECORDS CARD ============== */
.records-card {
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  margin-bottom: 28rpx;
}

/* 灰底汇总 */
.day-card {
  background: var(--n-100);
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--n-200);
}
.day-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 24rpx;
}
.day-date {
  display: inline-flex; align-items: center;
  font-family: var(--f-en);
  font-size: 26rpx; font-weight: 700;
  color: var(--n-900);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}
.day-stats {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 0;
}
.day-stat {
  display: flex; flex-direction: column; align-items: center;
  padding: 0 8rpx;
  position: relative;
}
.day-stat + .day-stat::before {
  content: "";
  position: absolute; left: 0; top: 12rpx; bottom: 12rpx;
  width: 1rpx; background: var(--n-200);
}
.day-stat.first { align-items: flex-start; }
.day-stat .v {
  font-family: var(--f-en);
  font-size: 32rpx; font-weight: 600;
  color: var(--n-500);
  letter-spacing: -0.02em;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.day-stat .v.big {
  font-size: 32rpx; font-weight: 800;
  color: var(--n-900);
}
.day-stat .unit {
  font-family: var(--f-en);
  font-size: 22rpx; font-weight: 600;
  color: var(--n-400);
  margin-left: 4rpx;
}
.day-stat .lab {
  font-size: 24rpx; font-weight: 600;
  color: var(--n-500);
  margin-left: 4rpx;
  letter-spacing: -0.02em;
}

/* 动作列表（白底） */
.ex-list {
  display: flex; flex-direction: column;
  background: var(--card);
}
.ex-row {
  display: flex; align-items: center; gap: 24rpx;
  padding: 20rpx 28rpx;
  background: var(--card);
  transition: background 200ms;
  position: relative;
}
.ex-row + .ex-row { border-top: 1rpx solid var(--n-200); }
.ex-row-hover { background: var(--n-50); }

.ex-thumb {
  width: 104rpx; height: 104rpx;
  flex: none;
  background: linear-gradient(135deg, #2A2A2A 0%, #0A0A0A 100%);
  border-radius: var(--r-m);
  display: grid; place-items: center;
  position: relative;
  overflow: hidden;
}
.ex-thumb::after {
  content: "";
  position: absolute; inset: 0;
  background: radial-gradient(circle at 30% 25%, rgba(200, 255, 0, 0.18), transparent 60%);
}
.ex-thumb-emoji {
  font-size: 48rpx; line-height: 1;
  position: relative; z-index: 1;
}
.ex-thumb-img {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 2;            /* 覆盖 ::after 绿色径向叠层，显示真实动作演示 GIF */
  border-radius: var(--r-m);
  background: var(--n-100);
}

.ex-body { flex: 1 1 auto; min-width: 0; }
.ex-name {
  font-size: 28rpx; font-weight: 800;
  color: var(--n-900);
  letter-spacing: -0.01em;
  line-height: 1.2;
}
.ex-meta {
  font-size: 22rpx; font-weight: 600;
  color: var(--n-500);
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
}
.ex-right {
  flex: none;
  font-family: var(--f-en);
  font-size: 28rpx; font-weight: 600;
  color: var(--n-900);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}
.ex-right .unit {
  font-size: 22rpx; font-weight: 600;
  color: var(--n-400);
  margin-left: 4rpx;
}

/* ============== EMPTY ============== */
.empty-card {
  display: flex; flex-direction: column; align-items: center;
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  padding: 80rpx 32rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 28rpx;
}
.empty-ico { font-size: 80rpx; opacity: 0.7; }
.empty-title { font-size: 30rpx; font-weight: 700; margin-top: 20rpx; color: var(--n-900); }
.empty-hint { font-size: 24rpx; color: var(--n-500); margin-top: 8rpx; }

.bottom-gap { height: 40rpx; }

/* ============================================================
   动作历史抽屉 sheet：点按训练记录动作弹出（组数 / 重量等）
   ============================================================ */
.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(10, 10, 10, 0.45);
  display: flex; align-items: flex-end; z-index: 100;
}
.sheet {
  width: 100%;
  background: var(--card);
  border-radius: var(--r-l) var(--r-l) 0 0;
  /* 底部留出自定义 tabBar 高度(88rpx)+ 安全区，避免抽屉被最底全局 banner 遮挡 */
  padding: 8rpx 32rpx calc(88rpx + 24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.08);
}
.sheet-head {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx 0 16rpx;
}
.sheet-thumb {
  width: 88rpx; height: 88rpx; flex: none;
  border-radius: var(--r-m);
  overflow: hidden;
  position: relative;
  background: var(--n-100);
}
.sheet-thumb-img {
  width: 100%; height: 100%;
  display: block;
}
.sheet-title {
  flex: 1; min-width: 0;
  font-size: 30rpx; font-weight: 800; color: var(--n-900);
  letter-spacing: -0.01em;
  line-height: 1.3;
}

/* 汇总：记录 / 总组数 / 峰值kg 三列 */
.ex-summary {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin: 4rpx 0 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--n-200);
  border-bottom: 1rpx solid var(--n-200);
}
.ex-stat {
  display: flex; flex-direction: column; align-items: center;
  position: relative;
}
.ex-stat + .ex-stat::before {
  content: "";
  position: absolute; left: 0; top: 6rpx; bottom: 6rpx;
  width: 1rpx; background: var(--n-200);
}
.ex-stat .v {
  font-family: var(--f-en);
  font-size: 38rpx; font-weight: 800; color: var(--n-900);
  letter-spacing: -0.02em; line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.ex-stat .lab {
  font-size: 22rpx; font-weight: 600; color: var(--n-500);
  margin-top: 6rpx;
}

/* 历史明细列表（逐组：重量 × 次数 + RPE / 训练 / 休息） */
.ex-hist {
  max-height: 44vh;
  margin-bottom: 8rpx;
}
.ex-hist-row {
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid var(--n-100);
}
.ex-hist-row:last-of-type { border-bottom: none; }
.eh-line1 {
  display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx;
}
.eh-set {
  font-size: 26rpx; font-weight: 800; color: var(--n-900);
  letter-spacing: -0.01em; flex: none;
}
.eh-main {
  font-family: var(--f-en);
  font-size: 28rpx; font-weight: 700; color: var(--n-900);
  font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
}
.eh-line2 {
  display: flex; flex-wrap: wrap; gap: 12rpx;
  margin-top: 12rpx;
}
.eh-chip {
  font-family: var(--f-en);
  font-size: 22rpx; font-weight: 600; color: var(--n-600);
  background: var(--n-100);
  padding: 6rpx 14rpx; border-radius: 999rpx;
  font-variant-numeric: tabular-nums;
}

.meal-empty {
  font-size: 24rpx; color: var(--n-500);
  text-align: center; padding: 28rpx 0 12rpx;
}

/* ============================================================
   深色主题（.page.theme-dark 变量重定义，向下继承自动翻转）
   ============================================================ */
.page.theme-dark {
  --n-950: #FFFFFF;
  --n-900: #FFFFFF;
  --n-700: rgba(255,255,255,.70);
  --n-600: rgba(255,255,255,.55);
  --n-500: rgba(255,255,255,.42);
  --n-400: rgba(255,255,255,.32);
  --n-300: rgba(255,255,255,.22);
  --n-200: rgba(255,255,255,.10);
  --n-100: #1E1E1E;
  --n-50: #0A0A0A;
  --white: #161616;
  --card-gray: #1E1E1E;
  --lime: #C8FF00;        /* 深色下下划线提亮，与计划页深色变体一致 */

  --text: #FFFFFF;
  --text-sub: rgba(255,255,255,.70);
  --text-weak: rgba(255,255,255,.45);
  --line: rgba(255,255,255,.10);
  --line-strong: rgba(255,255,255,.20);

  --success: #C8FF00;

  --card: #161616;
  --bg: rgba(255,255,255,.06);
  --bg-muted: #1E1E1E;
  --glass: #161616;
  --glass-strong: #1E1E1E;
  --glass-border: rgba(255,255,255,.10);

  --primary-tint: rgba(200,255,0,.12);  /* 成对补上：本页内嵌 training-review 组件，组件里用 var(--primary-text, #4C7300)。
     组件**不能**自己写 .page.theme-dark（组件样式有作用域，选不中宿主页的根节点），
     所以这类缺口的正确修法在宿主页 —— 本页与 review 页都要有；review 页早就有了，本页漏了。
     不补的话深色下拿到的是根值 #4C7300（深橄榄），压在 rgba(200,255,0,.12) 的暗绿底上几乎看不见。 */
  --primary-text: #C8FF00;
  /* 同一条宿主页规则：本页内嵌的 training-review 组件里 .pa-chip.down 用 var(--danger-text)，
     组件自己写不了深色块 → 必须由宿主页把它翻亮，否则深底上拿到根值 #C4363B（3.88:1）。 */
  --danger-text: #FF6B70;
  --accent-soft: rgba(255,149,0,.14);
  --accent-tint: rgba(255,149,0,.14);
  --info-tint: rgba(62,139,255,.14);
  --purple-tint: rgba(139,92,246,.16);
  --warning-tint: rgba(255,176,32,.14);

  --shadow-card: 0 4rpx 16rpx rgba(0,0,0,.35);
  --shadow-sm: 0 4rpx 16rpx rgba(0,0,0,.30);
  --shadow-md: 0 10rpx 30rpx rgba(0,0,0,.40);
  --shadow-lg: 0 16rpx 44rpx rgba(0,0,0,.50);
  --shadow-xs: 0 2rpx 8rpx rgba(0,0,0,.30);

  background: var(--n-50);
  color: var(--text);
}

/* 深色下的硬编码色单独覆盖 */
.page.theme-dark .ex-row-hover { background: #1E1E1E; }

/* 选中日：浅色是「反白深底 + 橄榄绿字」，深色下 --n-900 翻成了白色，
   橄榄绿压白仅 2.01:1 → 改成品牌亮绿底 + 墨字（16.74:1，走「亮底深字」恒等豁免）。
   同时把小圆点翻成墨色，否则绿点压绿底看不见。 */
.page.theme-dark .date.active { background: var(--primary); color: var(--primary-ink); }
.page.theme-dark .date.active.has-record::after { background: var(--primary-ink); }
