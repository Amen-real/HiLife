/* pages/list/list.wxss —— 品牌焕新版 */
/* 竖直渐变底（顶部青绿→底部桃色），与首页/我的/训练执行页统一；
   端点精确对齐 app.json 的 backgroundColorTop(#2ECFB0)/Bottom(#FFF1E8)，上拉/下拉无可见断缝；
   min-height:100vh 保证内容短时渐变仍铺满视口，底部桃色对齐视口底 */
.page { padding: 24rpx 0 calc(130rpx + env(safe-area-inset-bottom)); min-height: 100vh; background: linear-gradient(180deg, var(--primary-deep) 0%, var(--primary) 14%, var(--primary-tint) 40%, #FFF1E8 100%); }

/* ===== 顶部标签（吸顶药丸 + 滑动指示条，与饮食建议一致） ===== */
.seg {
  display: flex; gap: 8rpx; margin: 20rpx 28rpx 0;
  padding: 8rpx; background: var(--card); border-radius: 999rpx;
  border: 1rpx solid var(--line); box-shadow: var(--shadow-sm);
  position: sticky; top: 0; z-index: 10;
}
/* 滑动药丸：绝对定位，根据选中态 translateX 平滑滑动 */
.seg-thumb {
  position: absolute; left: 8rpx; top: 8rpx; bottom: 8rpx;
  width: calc(50% - 12rpx);
  background: var(--primary); border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(46,207,176, 0.30);
  transform: translateX(0);
  transition: transform 0.28s var(--ease-out, ease);
  z-index: 0;
}
.seg-thumb.right { transform: translateX(calc(100% + 8rpx)); }
.seg-btn {
  flex: 1; text-align: center; font-size: 30rpx; color: var(--text-sub);
  font-weight: 700; padding: 18rpx 0; border-radius: 999rpx;
  position: relative; z-index: 1;
  transition: color 0.22s var(--ease-out, ease);
}
.seg-btn.on { color: #fff; }

/* 内容切换：淡入 + 轻微上滑（与饮食建议一致） */
.tab-pane { animation: paneIn 0.30s var(--ease-out, ease); }
@keyframes paneIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 记录按钮 + 概览 ===== */
.rec-btn { display: block; width: 100%; max-width: 100%; box-sizing: border-box; margin: 0 0 16rpx; padding: 14rpx 0; text-align: center; border-radius: 18rpx; box-shadow: var(--shadow-brand); }
.rec-btn:active { opacity: 0.85; }
.overview { display: flex; gap: 18rpx; }
.ov-item { flex: 1; text-align: center; background: var(--bg); border-radius: 18rpx; padding: 18rpx 8rpx; }
.ov-num { font-size: 40rpx; font-weight: 800; color: var(--text); font-feature-settings: "tnum" 1; }
.ov-num.down { color: var(--success); }
.ov-num.up { color: var(--warning); }
.ov-num.flat { color: var(--text-weak); }
.ov-trend { font-size: 26rpx; font-weight: 700; margin-right: 4rpx; }
.ov-unit { font-size: 22rpx; color: var(--text-sub); font-weight: 500; margin-left: 4rpx; }
.ov-cap { font-size: 22rpx; color: var(--text-sub); margin-top: 4rpx; font-weight: 500; }

/* ===== 趋势图 ===== */
.ranges { display: flex; gap: 10rpx; margin-bottom: 20rpx; }
.range {
  font-size: 24rpx; color: var(--text-sub); background: var(--bg);
  border-radius: 999rpx; padding: 10rpx 24rpx; font-weight: 600;
  transition: all 0.18s;
}
.range.active { background: var(--primary-light); color: var(--primary); font-weight: 700; }
.chart-wrap { width: 100%; height: 340rpx; background: var(--bg); border-radius: 16rpx; overflow: hidden; }
.wc { width: 100%; height: 100%; }

/* ===== 统计卡片 ===== */
.stats-row { display: flex; gap: 16rpx; padding: 0 28rpx; }
.stat-card {
  flex: 1; background: var(--card); border-radius: 22rpx;
  box-shadow: var(--shadow-xs); border: 1rpx solid var(--line);
  padding: 22rpx 0; text-align: center;
}
.stat-num { font-size: 36rpx; font-weight: 800; color: var(--text); font-feature-settings: "tnum" 1; }
.stat-cap { font-size: 22rpx; color: var(--text-sub); margin-top: 4rpx; font-weight: 500; }

/* ===== 历史记录 ===== */
.his-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 4rpx; border-bottom: 1rpx solid var(--line); font-size: 26rpx;
}
.his-row:last-child { border-bottom: none; }
.his-date { color: var(--text-sub); font-weight: 500; }
.his-weight { font-weight: 700; color: var(--text); font-feature-settings: "tnum" 1; }

/* ===== 日期筛选 ===== */
.date-filter {
  display: flex; align-items: center; gap: 10rpx;
  margin-bottom: 18rpx; padding: 12rpx 18rpx;
  background: var(--bg); border-radius: 18rpx;
}
.df-picker {
  font-size: 24rpx; color: var(--text-weak);
  background: var(--card); border-radius: 12rpx;
  padding: 10rpx 22rpx; border: 1rpx solid var(--line);
  white-space: nowrap; font-weight: 500;
  transition: border-color 0.15s;
}
.df-picker.has-val { color: var(--text); font-weight: 600; border-color: var(--primary); }
.df-sep { font-size: 24rpx; color: var(--text-weak); }
.qf {
  font-size: 24rpx; color: var(--text-sub); background: var(--bg);
  border-radius: 999rpx; padding: 12rpx 26rpx; white-space: nowrap; font-weight: 600;
  transition: all 0.18s;
}
.qf.active { color: var(--primary); font-weight: 700; background: var(--primary-light); }
.df-clear {
  font-size: 24rpx; color: var(--primary);
  padding: 10rpx 18rpx; font-weight: 600;
  margin-left: auto;
}

/* ===== 训练记录 - 折叠式分组 ===== */
.train-group { padding: 6rpx 0; border-bottom: 1rpx solid var(--line); }
.train-group:last-child { border-bottom: none; }
.tg-head { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; }
.tg-head:active { opacity: 0.6; }
.tg-date { font-size: 30rpx; font-weight: 800; color: var(--text); }
.tg-meta { display: flex; align-items: center; gap: 14rpx; }
.tg-count { font-size: 22rpx; color: var(--primary); background: var(--primary-light); border-radius: 999rpx; padding: 4rpx 16rpx; font-weight: 700; }
.tg-arrow { font-size: 28rpx; color: var(--text-weak); line-height: 1; }
.tg-sessions { padding: 2rpx 0 10rpx; }
.tg-session {
  display: flex; align-items: center; gap: 12rpx;
  padding: 14rpx 0 14rpx 16rpx;
  border-top: 1rpx dashed var(--line);
  border-radius: 12rpx;
  transition: background 0.15s;
}
.tg-session:first-child { border-top: none; }
.tg-session .tl-actions { flex: 1; }
.train-hover { background: var(--bg); }

.tl-session {
  flex-shrink: 0; font-size: 22rpx; color: #fff; background: var(--primary);
  border-radius: 999rpx; padding: 4rpx 16rpx; font-weight: 600;
}
.tl-actions { display: flex; flex-wrap: wrap; gap: 10rpx; }
.tl-act { font-size: 24rpx; background: var(--bg); border-radius: 10rpx; padding: 6rpx 16rpx; color: var(--text); font-weight: 500; }
.tl-arrow { flex-shrink: 0; font-size: 36rpx; color: var(--text-weak); line-height: 1; }

/* ===== 训练详细报表 ===== */
.report-card { margin-top: 28rpx; }
/* 报表分段（滑动指示条，与顶部 .seg 一致；青绿实色药丸平滑滑动，激活项白字） */
.rep-tabs {
  position: relative; display: flex; gap: 8rpx;
  background: var(--card); border-radius: 14rpx; padding: 6rpx; margin-bottom: 8rpx;
  border: 1rpx solid var(--line); box-shadow: var(--shadow-sm);
}
.rep-thumb {
  position: absolute; left: 6rpx; top: 6rpx; bottom: 6rpx;
  width: calc(50% - 10rpx);
  background: var(--primary); border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(46,207,176, 0.30);
  transform: translateX(0);
  transition: transform 0.28s var(--ease-out, ease);
  z-index: 0;
}
.rep-thumb.right { transform: translateX(calc(100% + 8rpx)); }
.rep-tab {
  flex: 1; text-align: center; font-size: 26rpx; color: var(--text-sub);
  padding: 16rpx 0; border-radius: 14rpx; font-weight: 600;
  position: relative; z-index: 1;
  transition: color 0.22s var(--ease-out, ease);
}
.rep-tab.active { color: #fff; font-weight: 700; }

/* 报表块通用 */
.rep-block { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); animation: paneIn 0.30s var(--ease-out, ease); }
.rep-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6rpx; }
.rep-title { font-size: 30rpx; font-weight: 800; color: var(--text); }
.rep-delta { font-size: 26rpx; font-weight: 700; }
.rep-delta.up { color: var(--primary); }
.rep-delta.down { color: var(--accent); }
.rep-sub { font-size: 22rpx; color: var(--text-weak); margin-bottom: 12rpx; line-height: 1.4; }

.rep-legend-inline {
  display: flex; gap: 24rpx; margin: 0 0 16rpx auto; width: fit-content;
  background: var(--bg); border-radius: 999rpx; padding: 10rpx 24rpx;
  border: 1rpx solid var(--line);
}
.rep-legend-inline .lg { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: var(--text-sub); font-weight: 500; }
.lg-dot { width: 20rpx; height: 20rpx; border-radius: 50%; flex-shrink: 0; display: inline-block; }
.lg-dot.prev { background: #c0c5cc; }
.lg-dot.cur { background: var(--primary); }
.lg-dot.cur.time-cur { background: #ee5a52; }

.rep-summary {
  margin-top: 18rpx; padding: 18rpx 22rpx;
  background: var(--bg); border-radius: 14rpx;
  display: flex; flex-wrap: wrap; align-items: center; gap: 4rpx;
}
.rep-sum-text { font-size: 24rpx; color: var(--text-sub); }
.rep-sum-hl { font-size: 26rpx; font-weight: 800; color: var(--primary); }
.rep-sum-emoji { font-size: 28rpx; margin-left: 4rpx; }

/* 柱状图 */
.sets-chart { height: 280rpx; }
.bar-chart { display: flex; align-items: flex-end; gap: 12rpx; height: 240rpx; padding: 4rpx 0; }
.bar-group { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.bars { display: flex; align-items: flex-end; gap: 4rpx; height: 200rpx; position: relative; }
.bar { width: 22rpx; border-radius: 6rpx 6rpx 0 0; position: relative; display: flex; flex-direction: column; align-items: center; }
.bar-cur { background: var(--primary); box-shadow: 0 2rpx 8rpx rgba(46,207,176, 0.25); }
.bar-prev { background: #c0c5cc; }
.bar-num { position: absolute; top: -24rpx; font-size: 18rpx; font-weight: 700; color: var(--text); white-space: nowrap; line-height: 1; }
.bar-num-sm { position: absolute; top: -20rpx; font-size: 17rpx; font-weight: 700; color: var(--text); white-space: nowrap; line-height: 1; }
.bar-name { font-size: 20rpx; color: var(--text-sub); margin-top: 8rpx; white-space: nowrap; font-weight: 500; }
.bar-val { font-size: 18rpx; color: var(--text-weak); margin-top: 2rpx; }

.daily-chart { height: 260rpx; }
.time-bar-cur { background: linear-gradient(180deg, #ff7171, #ee5a52); }
.time-cur { background: #ee5a52; }

.bottom-gap { height: 20rpx; }
