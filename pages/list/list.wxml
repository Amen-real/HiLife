<!-- pages/list/list.wxml —— 严格对齐 06-records.html（训练记录） -->
<view class="page {{theme}}">

  <!-- HEADER：训练记录 / 训练复盘 双标题 -->
  <view class="header">
    <view class="lead">
      <view class="title {{tab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="switchTitle">训练记录</view>
      <view class="title {{tab === 'review' ? 'active' : ''}}" data-tab="review" bindtap="switchTitle">训练复盘</view>
    </view>
  </view>

  <!-- 训练记录 -->
  <block wx:if="{{tab === 'records'}}">
    <scroll-view class="scroll" scroll-y>
      <!-- 月份选择（点击弹原生日期选择器） -->
      <picker mode="date" value="{{todayStr}}" fields="month" bindchange="onPickMonth">
        <view class="month" hover-class="month-hover">
          <text>{{monthLabel}}</text>
          <text class="caret">▾</text>
        </view>
      </picker>

      <!-- 星期行 -->
      <view class="weekdays">
        <view class="weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
      </view>

      <!-- 日期行：7 天单元格，支持左右滑动切周（绑 catchtouchstart/move/end） -->
      <view class="dates"
            bindtouchstart="onDateTouchStart"
            bindtouchend="onDateTouchEnd">
        <view wx:for="{{weekDates}}"
              wx:key="iso"
              class="date {{item.muted ? 'muted' : ''}} {{item.isActive ? 'active' : ''}} {{item.hasRecord ? 'has-record' : ''}}"
              data-iso="{{item.iso}}"
              bindtap="selectDate">
          {{item.day}}
        </view>
      </view>

      <!-- 训练记录卡（选中日期没有记录时显示空态） -->
      <block wx:if="{{record.hasData}}">
        <view class="records-card" aria-label="{{record.date}} 训练记录">

          <!-- 灰底汇总：日期 + 3 列统计（时长 / 卡路里 / 动作数） -->
          <view class="day-card">
            <view class="day-head">
              <text class="day-date">{{record.dateLabel}}</text>
            </view>
            <view class="day-stats">
              <view class="day-stat first">
                <view class="v big">{{record.duration}}</view>
              </view>
              <view class="day-stat">
                <view class="v">{{record.calories}}<text class="unit">kcal</text></view>
              </view>
              <view class="day-stat">
                <view class="v">{{record.actionCount}}<text class="lab">大动作</text></view>
              </view>
            </view>
          </view>

          <!-- 白底动作列表 -->
          <view class="ex-list">
            <view wx:for="{{record.actions}}"
                  wx:key="name"
                  class="ex-row"
                  hover-class="ex-row-hover"
                  data-name="{{item.name}}"
                  bindtap="openExercise">
              <view class="ex-thumb">
                <image wx:if="{{item.gif}}" class="ex-thumb-img" src="{{item.gif}}" mode="aspectFill" lazy-load></image>
                <text wx:else class="ex-thumb-emoji">{{item.thumbEmoji}}</text>
              </view>
              <view class="ex-body">
                <view class="ex-name">{{item.name}}</view>
                <view class="ex-meta">{{item.meta}}</view>
              </view>
              <view class="ex-right">{{item.value}}<text class="unit">{{item.unit}}</text></view>
            </view>
          </view>

        </view>
      </block>

      <view wx:else class="empty-card">
        <view class="empty-ico">📋</view>
        <view class="empty-title">这天还没有训练记录</view>
        <view class="empty-hint">去「训练」开始第一次吧</view>
      </view>

      <view class="bottom-gap" />
    </scroll-view>
  </block>

  <!-- 训练复盘（内嵌组件，当前页直接显示，不再跳独立页） -->
  <block wx:elif="{{tab === 'review'}}">
    <training-review />
  </block>

  <!-- 动作历史抽屉：点按训练记录动作弹出（组数 / 重量等） -->
  <view wx:if="{{showExSheet}}" class="mask" bindtap="closeExSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-thumb" wx:if="{{exSheet.gif}}">
          <image class="sheet-thumb-img" src="{{exSheet.gif}}" mode="aspectFill" lazy-load></image>
        </view>
        <view class="sheet-title">{{exSheet.name}} · 历史训练</view>
      </view>
      <view class="ex-summary">
        <view class="ex-stat"><view class="v">{{exSheet.totalSets}}</view><view class="lab">组数</view></view>
        <view class="ex-stat"><view class="v">{{exSheet.maxWeight}}</view><view class="lab">峰值kg</view></view>
        <view class="ex-stat"><view class="v">{{exSheet.avgRpe}}</view><view class="lab">平均RPE</view></view>
      </view>

      <scroll-view scroll-y class="ex-hist">
        <view class="ex-hist-row" wx:for="{{exSheet.history}}" wx:key="k">
          <view class="eh-line1">
            <text class="eh-set">第{{item.setNo}}组</text>
            <text class="eh-main">{{item.weight}}kg × {{item.reps}}次</text>
          </view>
          <view class="eh-line2">
            <text class="eh-chip">RPE {{item.rpeText}}</text>
            <text class="eh-chip">训练 {{item.train}}</text>
            <text class="eh-chip">休息 {{item.rest}}</text>
          </view>
        </view>
        <view wx:if="{{exSheet.count === 0}}" class="meal-empty">当天没有该动作的训练记录</view>
      </scroll-view>
    </view>
  </view>
</view>
