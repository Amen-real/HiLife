<!-- pages/profile/profile.wxml —— 对齐 ui-redesign-preview.html v2（渐变头 + pstats + 菜单） -->
<view class="page">

  <!-- 渐变头（对齐预览：头像 + 昵称 + 坚持天数；访客态加 guest 类切换居中竖向排版） -->
  <view class="profile-head {{loggedIn ? '' : 'guest'}}">
    <block wx:if="{{!loggedIn}}">
      <view class="av">{{avatarText}}</view>
      <view class="ph-text">
        <view class="pn">欢迎使用 衡砺健身记录</view>
        <view class="ps">登录后完善个人健康档案</view>
      </view>
      <button class="login-btn" bindtap="wechatLogin">登录</button>
    </block>
    <block wx:else>
      <view class="avatar-btn" bindtap="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar-img" mode="aspectFill" />
        <view wx:else class="av">{{avatarText}}</view>
      </view>
      <view class="ph-text">
        <input class="nick-input" type="nickname" placeholder="点击填写昵称" value="{{nickname}}" bindinput="onNicknameInput" bindblur="onNicknameBlur" />
        <view class="ps">已坚持 {{profile.fitnessDays}} 天 · 连续 {{streak}} 天</view>
      </view>
      <view class="logout-link" bindtap="logout">退出</view>
    </block>
  </view>

  <!-- 数据条（对齐预览 pstats：总训练 / 连续天 / 收藏） -->
  <view class="pstats">
    <view class="pv"><view class="pv-n tnum">{{profile.fitnessDays}}</view><view class="pv-k">总训练</view></view>
    <view class="pv"><view class="pv-n tnum">{{streak}}</view><view class="pv-k">连续天</view></view>
    <view class="pv pv-tap" hover-class="pv-press" bindtap="goFavorites"><view class="pv-n tnum">{{favCount}}</view><view class="pv-k">收藏 ›</view></view>
  </view>

  <!-- 健康概览（当前目标 / 体重 / 身高 / BMI） -->
  <view class="card health-card">
    <view class="section-title"><icon name="goal" size="32"/>健康概览</view>
    <view class="health-grid">
      <view class="hg-item">
        <view class="hg-ic hg-ic-goal"><icon name="goal" size="34"/></view>
        <view class="hg-body">
          <view class="hg-v">{{health.goal}}</view>
          <view class="hg-k">当前目标</view>
        </view>
      </view>
      <view class="hg-item">
        <view class="hg-ic hg-ic-scale"><icon name="scale" size="34"/></view>
        <view class="hg-body">
          <view class="hg-v">{{health.weight}}<text class="hg-u" wx:if="{{health.weight !== '未记录'}}">kg</text></view>
          <view class="hg-k">体重</view>
        </view>
      </view>
      <view class="hg-item">
        <view class="hg-ic hg-ic-user"><icon name="user" size="34"/></view>
        <view class="hg-body">
          <view class="hg-v">{{health.height}}<text class="hg-u" wx:if="{{health.height !== '未设置'}}">cm</text></view>
          <view class="hg-k">身高</view>
        </view>
      </view>
      <view class="hg-item">
        <view class="hg-ic hg-ic-bmi">BMI</view>
        <view class="hg-body">
          <view class="hg-v">{{health.bmi}}</view>
          <view class="hg-k">BMI 指数</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 菜单（我的计划 / 体重目标 / 关于） -->
  <view class="menu card">
    <view class="mi" bindtap="goPlan"><view class="mi-ic"><icon name="plan" size="40"/></view><view class="mi-t">我的计划</view><view class="mi-ar">›</view></view>
    <view class="mi" bindtap="goTrainRecords"><view class="mi-ic"><icon name="train" size="40"/></view><view class="mi-t">训练日报</view><view class="mi-ar">›</view></view>
    <view class="mi" bindtap="goReview"><view class="mi-ic"><icon name="idea" size="40"/></view><view class="mi-t">训练复盘</view><view class="mi-ar">›</view></view>
    <view class="mi" bindtap="goSettings"><view class="mi-ic"><icon name="goal" size="40"/></view><view class="mi-t">体重目标</view><view class="mi-ar">›</view></view>
    <view class="mi" bindtap="openDataMgr"><view class="mi-ic"><icon name="settings" size="40"/></view><view class="mi-t">数据管理</view><view class="mi-ar">›</view></view>
    <view class="mi" bindtap="goPrivacy"><view class="mi-ic"><icon name="info" size="40"/></view><view class="mi-t">隐私政策</view><view class="mi-ar">›</view></view>
  </view>

  <!-- 媒体署名 -->
  <view class="attribution">
    <text>动作演示媒体 © Gym visual</text>
    <text>https://gymvisual.com/</text>
  </view>

  <view class="bottom-gap" />

  <!-- 数据管理面板（底部弹出：导出 / 导入 / 清除，无图标） -->
  <view class="dm-mask" wx:if="{{showDataMgr}}" bindtap="closeDataMgr">
    <view class="dm-sheet" catchtap="stopTap">
      <view class="dm-head">
        <text class="dm-title">数据管理</text>
        <view class="dm-close" bindtap="closeDataMgr">✕</view>
      </view>
      <view class="dm-list">
        <view class="dm-item" bindtap="exportData"><text class="dm-t">导出训练数据</text><text class="dm-ar">›</text></view>
        <view class="dm-item" bindtap="importData"><text class="dm-t">导入训练数据</text><text class="dm-ar">›</text></view>
        <view class="dm-item danger" bindtap="clearLocalData"><text class="dm-t">清除本机数据</text><text class="dm-ar">›</text></view>
      </view>
      <view class="dm-hint">导出可生成备份文件，换设备后通过导入恢复全部数据</view>
    </view>
  </view>

  <!-- 导出：转发文件面板（shareFileMessage 必须在用户 TAP 回调中调用） -->
  <view class="dm-mask" wx:if="{{showExportShare}}" bindtap="closeExportShare">
    <view class="dm-sheet export-share-sheet" catchtap="stopTap">
      <view class="dm-head">
        <text class="dm-title">备份已生成</text>
        <view class="dm-close" bindtap="closeExportShare">✕</view>
      </view>
      <view class="export-share-body">
        <view class="export-share-icon">📦</view>
        <text class="export-share-name">hilife-backup.txt</text>
        <text class="export-share-hint">点击下方按钮将备份文件发送给好友或文件传输助手</text>
        <button class="export-share-btn" bindtap="doShareFile">转发文件</button>
      </view>
    </view>
  </view>
</view>
