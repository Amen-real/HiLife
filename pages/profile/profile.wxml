<!-- pages/profile/profile.wxml —— 对齐「我的」页设计稿
     结构：① Hero（背景图铺顶 + 悬浮标题 + 头像行 + 累计三连）
           ② 我的数据（四格 + BMI 解读 + 目标体重）
           ③ 我的训练（今日训练计划 + 训练维度小计）
           ④ 偏好  ⑤ 关于与数据
     根节点 theme-light / theme-dark 由本页「深色主题」开关控制（见 utils/theme.js）
     注意：wxml 行内 style 禁 Mustache 插值，故状态栏高度/进度条/刻度一律由 JS 拼好整串注入。 -->
<view class="page {{theme}}">

  <!-- ============== ① HERO：背景图铺顶，标题与头像浮在图上 ============== -->
  <view class="p-hero">
    <!-- 背景图：本地 static/ 随包发布（秒开）；加载失败记旗标后隐藏，露出页面底色，不留破图占位 -->
    <image wx:if="{{!bgFailed}}" class="p-hero-bg" src="{{bgUrl}}" mode="widthFix" binderror="onBgError" />
    <!-- 底部渐隐：背景图底色 #F5F6F3 与页面底色 --n-50 有几档色差，硬切会有可见接缝 -->
    <view class="p-hero-fade"></view>

    <view class="p-hero-body">
      <!-- 状态栏占位：navigationStyle=custom 后顶部交还 WebView，需手动补状态栏高度 -->
      <view class="p-sb" style="{{statusBarStyle}}"></view>

      <view class="p-title">我的</view>

      <view class="p-id">
        <!-- 未登录时头像圈本身就是登录入口（右上角加号角标提示可点），已登录则为「换头像」。
             注意：WXML 的 bindtap 不支持 Mustache 动态取事件名，故统一走 onIdTap 在 JS 内分支。 -->
        <view class="p-avatar" bindtap="onIdTap" aria-label="{{loggedIn ? '更换头像' : '登录'}}">
          <image wx:if="{{avatarUrl}}" class="p-avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
          <view wx:else class="p-avatar-txt">{{avatarText}}</view>
          <view wx:if="{{!loggedIn}}" class="p-avatar-add">
            <view class="ico ico-plus ico--ink p-avatar-add-i"></view>
          </view>
        </view>
        <view class="p-id-meta">
          <!-- 已登录：昵称可就地编辑（受控 input 的实时回显由 onNicknameInput 负责） -->
          <block wx:if="{{loggedIn}}">
            <view class="p-nick-row">
              <input class="p-nick" type="nickname" placeholder="点击填写昵称" value="{{nickname}}"
                     bindinput="onNicknameInput" bindblur="onNicknameBlur" />
              <view class="ico ico-edit ico--muted p-pen"></view>
            </view>
            <view class="p-sub">{{heroTitle}} · 已坚持 {{profile.fitnessDays}} 天</view>
          </block>
          <!-- 未登录：昵称位让给登录入口，副标题只讲真实能力（本机存储 + 导出换机），不承诺云同步 -->
          <block wx:else>
            <view class="p-nick-row" bindtap="wechatLogin" aria-label="登录">
              <view class="p-nick p-nick-guest">点击登录</view>
              <view class="ico ico-arrowright ico--muted p-id-ar"></view>
            </view>
            <view class="p-sub">数据只存本机 · 导出备份可换机恢复</view>
          </block>
        </view>
      </view>

      <!-- 累计三连：浮在背景图上（与下方卡片同宽，视觉上把 Hero 收住） -->
      <view class="p-stats">
        <view class="ps-item">
          <view class="ps-num-row">
            <text class="ps-v">{{totals.days}}</text>
            <view class="ico ico-flame ico--success ps-i"></view>
          </view>
          <view class="ps-k">训练天数</view>
        </view>
        <view class="ps-item">
          <view class="ps-num-row">
            <text class="ps-v">{{totals.streak}}</text>
            <view class="ico ico-pulse ico--success ps-i"></view>
          </view>
          <view class="ps-k">连续天数</view>
        </view>
        <view class="ps-item">
          <view class="ps-num-row">
            <text class="ps-v">{{totals.sessions}}</text>
            <view class="ico ico-chart ico--success ps-i"></view>
          </view>
          <view class="ps-k">总训练次数</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 访客登录入口已上移到 Hero 身份行（见 .p-avatar / .p-nick-guest），
       此处不再单开引导卡：Hero 已有头像+昵称位，再给一张卡属重复占位。 -->

  <!-- ============== ② 我的数据（健康概览 + 解读 + 目标） ============== -->
  <view class="card p-card">
    <view class="p-head">
      <view class="p-head-t">
        <view class="p-chip"><view class="ico ico-chart ico--ink p-chip-i"></view></view>
        <text>我的数据</text>
      </view>
      <view class="p-head-a" bindtap="goSettings">编辑<text class="p-ar">›</text></view>
    </view>

    <view class="dtile-grid">
      <view class="dtile">
        <view class="dtile-ic dtile-ic-w"><view class="ico ico-scale ico--ink dtile-i"></view></view>
        <view class="dtile-b">
          <view class="dtile-v">{{health.weight}}<text class="dtile-u" wx:if="{{health.weight !== '未记录'}}">kg</text></view>
          <view class="dtile-k">当前体重</view>
          <view class="dtile-x {{weightDelta.tone}}" wx:if="{{weightDelta.show}}">{{weightDelta.text}}</view>
        </view>
      </view>

      <view class="dtile">
        <view class="dtile-ic dtile-ic-h"><view class="ico ico-user ico--ink dtile-i"></view></view>
        <view class="dtile-b">
          <view class="dtile-v">{{health.height}}<text class="dtile-u" wx:if="{{health.height !== '未设置'}}">cm</text></view>
          <view class="dtile-k">身高</view>
        </view>
      </view>

      <view class="dtile">
        <view class="dtile-ic dtile-ic-b"><text class="dtile-bmi">BMI</text></view>
        <view class="dtile-b">
          <view class="dtile-v">{{health.bmi}}</view>
          <view class="dtile-k">BMI 指数</view>
          <view class="dtile-x {{health.bmiTone}}" wx:if="{{health.bmiLabel}}">{{health.bmiLabel}}</view>
        </view>
      </view>

      <view class="dtile">
        <view class="dtile-ic dtile-ic-g"><view class="ico ico-target ico--ink dtile-i"></view></view>
        <view class="dtile-b">
          <view class="dtile-v">{{health.goal}}</view>
          <view class="dtile-k">当前目标</view>
        </view>
      </view>
    </view>

    <!-- BMI 区间解读（无体重/身高不渲染） -->
    <view class="p-ins" wx:if="{{bmi.show}}">
      <view class="p-ins-title">BMI 解读</view>
      <view class="bmi-bar">
        <view class="bmi-mark" style="{{bmi.markStyle}}"></view>
      </view>
      <view class="bmi-axis">
        <text>偏瘦</text><text>正常</text><text>超重</text><text>肥胖</text>
      </view>
    </view>

    <!-- 目标体重：起点 → 目标 + 进度（需体重 + 目标体重） -->
    <view class="p-ins" wx:if="{{goal.show}}">
      <view class="p-ins-title">目标体重</view>
      <view class="goal-row">
        <view class="goal-line">
          <text class="goal-now">{{goal.from}}<text class="goal-unit">kg</text></text>
          <text class="goal-arrow">→</text>
          <text class="goal-target">{{goal.to}}<text class="goal-unit">kg</text></text>
        </view>
        <view class="p-pill" wx:if="{{!goal.done}}">还差 {{goal.remain}} kg</view>
        <view class="p-pill" wx:else>已{{goal.verb}} {{goal.done}} kg</view>
      </view>
      <view class="goal-track"><view class="goal-fill" style="{{goal.fillStyle}}"></view></view>
      <view class="goal-hint">距离目标还需 {{goal.remain}}kg · 建议每周{{goal.verb}}重 0.5-1kg</view>
    </view>

    <!-- 空态引导：资料缺失时给出出口（而非一片「--」） -->
    <view class="guide-empty" wx:if="{{!hasProfile}}">
      <view class="ge-title">完善资料，解锁热量推荐</view>
      <view class="ge-sub">身高体重 · 目标 · 活动量（约 30 秒）</view>
      <view class="ge-btn" bindtap="goSettings">去完善</view>
    </view>
  </view>

  <!-- ============== ③ 我的训练（今日训练计划 + 训练维度小计） ============== -->
  <view class="card p-card">
    <view class="p-head">
      <view class="p-head-t">
        <view class="p-chip"><view class="ico ico-dumbbell ico--ink p-chip-i"></view></view>
        <text>我的训练</text>
      </view>
      <view class="p-head-a" bindtap="goHistory">查看全部<text class="p-ar">›</text></view>
    </view>

    <!-- 首行 = 今日训练计划（口径与首页「今日推荐」同源，见 utils/todayPlan.js）：
         今日未完成 → 点按开始训练；今日已完成 → 点按看这一场的复盘。
         注意 WXML 的 bindtap 不支持 Mustache 动态事件名，故统一走 onTkTap 在 JS 内按 mode 分支。 -->
    <view class="tk" wx:if="{{train.show}}" bindtap="onTkTap"
          aria-label="{{train.mode === 'done' ? '查看今日训练复盘' : '开始今日训练'}}">
      <view class="tk-thumb">
        <view class="ico ico-dumbbell ico--success tk-thumb-i"></view>
      </view>
      <view class="tk-b">
        <view class="tk-tag {{train.mode}}" wx:if="{{train.tag}}">{{train.tag}}</view>
        <view class="tk-name">{{train.title}}</view>
        <view class="tk-meta">{{train.meta}}</view>
      </view>
      <view class="tk-go"><view class="ico ico-arrowright ico--ink tk-go-i"></view></view>
    </view>

    <!-- 今天既没安排、也没练过：给出口而不是空区块（文案与首页「今日推荐」的空态一致） -->
    <view class="tk-empty" wx:else bindtap="goPlan" aria-label="去计划页安排训练">
      <view class="ico ico-dumbbell ico--muted tk-empty-i"></view>
      <view class="tk-empty-t">今天还没安排训练</view>
      <view class="tk-empty-s">去计划页导入一套开始吧</view>
    </view>

    <!-- 训练维度小计：与顶部「累计三连」不重复（那里是天数/连续/总次数，这里是本月/本周/时长/容量）。
         本周用 X/Y 形式给出「完成度」，Y 取周目标口径（计划 daysPerWeek > 个人设置 > 3）。 -->
    <view class="tk-stats">
      <view class="tks-item">
        <view class="tks-v">{{totals.month}}</view>
        <view class="tks-k">本月训练</view>
      </view>
      <view class="tks-item">
        <view class="tks-v">{{totals.week}}<text class="tks-u">/{{totals.weekTarget}}</text></view>
        <view class="tks-k">本周训练</view>
      </view>
      <view class="tks-item">
        <view class="tks-v">{{totals.dur}}</view>
        <view class="tks-k">累计时长</view>
      </view>
      <view class="tks-item">
        <view class="tks-v">{{totals.vol}}</view>
        <view class="tks-k">累计容量</view>
      </view>
    </view>
  </view>

  <!-- ============== ④ 偏好（设计稿：无卡头，直接两行） ============== -->
  <view class="card p-card">
    <view class="menu">
      <view class="mi">
        <view class="ico ico-moon ico--ink mi-i"></view>
        <view class="mi-t">深色主题</view>
        <switch class="mi-sw" checked="{{darkMode}}" bindchange="onToggleTheme" color="#C8FF00" />
      </view>
      <view class="mi" bindtap="tapReminder">
        <view class="ico ico-clock ico--ink mi-i"></view>
        <view class="mi-t">今日未训练提醒</view>
        <view class="mi-note">{{reminderOn ? '已开启 · 未练时提示' : '未开启'}}</view>
        <text class="mi-ar">›</text>
      </view>
    </view>
  </view>

  <!-- ============== ⑤ 关于与数据（设计稿：同为无卡头行列表） ============== -->
  <view class="card p-card">
    <view class="menu">
      <!-- 账号兜底入口：Hero 在首屏，滚到底部的人（或没注意到头像可点的人）也能找到登录 -->
      <view class="mi" bindtap="tapAccount">
        <view class="ico ico-user ico--ink mi-i"></view>
        <view class="mi-t">登录 / 账号</view>
        <view class="mi-note">{{loggedIn ? (nickname || '已登录') : '未登录'}}</view>
        <text class="mi-ar">›</text>
      </view>
      <view class="mi" bindtap="openDataMgr">
        <view class="ico ico-settings ico--ink mi-i"></view>
        <view class="mi-t">数据管理</view>
        <text class="mi-ar">›</text>
      </view>
      <view class="mi" bindtap="goPrivacy">
        <view class="ico ico-info ico--ink mi-i"></view>
        <view class="mi-t">隐私政策</view>
        <text class="mi-ar">›</text>
      </view>
      <view class="mi" bindtap="tapAbout">
        <view class="ico ico-heart ico--ink mi-i"></view>
        <view class="mi-t">关于我们</view>
        <view class="mi-note">v{{version}}</view>
        <text class="mi-ar">›</text>
      </view>
      <view class="mi danger" wx:if="{{loggedIn}}" bindtap="logout">
        <view class="ico ico-back ico--ink mi-i"></view>
        <view class="mi-t">退出登录</view>
      </view>
    </view>
  </view>

  <!-- 媒体署名：Gym visual 授权要求署名必须可见，故留在页脚而不是折进「关于我们」弹窗 -->
  <view class="attribution">
    <text>动作演示媒体 © Gym visual · gymvisual.com</text>
  </view>

  <view class="bottom-gap" />

  <!-- 数据管理面板（底部弹出：导出 / 导入 / 清除） -->
  <view class="dm-mask" wx:if="{{showDataMgr}}" bindtap="closeDataMgr">
    <view class="dm-sheet" catchtap="stopTap">
      <view class="dm-head">
        <text class="dm-title">数据管理</text>
        <view class="dm-close" bindtap="closeDataMgr">✕</view>
      </view>
      <view class="dm-list">
        <view class="dm-item" bindtap="exportData"><text class="dm-t">导出训练数据</text><text class="dm-ar">›</text></view>
        <view class="dm-item" bindtap="importData"><text class="dm-t">导入训练数据</text><text class="dm-ar">›</text></view>
        <view class="dm-item danger" bindtap="clearLocalData"><text class="dm-t">清除本机数据</text><text class="dm-ar">›</text></view>
      </view>
      <view class="dm-hint">导出可生成备份文件，换设备后通过导入恢复全部数据</view>
    </view>
  </view>

  <!-- 导出：转发文件面板（shareFileMessage 必须在用户 TAP 回调中调用） -->
  <view class="dm-mask" wx:if="{{showExportShare}}" bindtap="closeExportShare">
    <view class="dm-sheet export-share-sheet" catchtap="stopTap">
      <view class="dm-head">
        <text class="dm-title">备份已生成</text>
        <view class="dm-close" bindtap="closeExportShare">✕</view>
      </view>
      <view class="export-share-body">
        <view class="export-share-name">hilife-backup.txt</view>
        <view class="export-share-hint">点击下方按钮将备份文件发送给好友或文件传输助手</view>
        <button class="export-share-btn" bindtap="doShareFile">转发文件</button>
      </view>
    </view>
  </view>
</view>
