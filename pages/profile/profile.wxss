/* pages/profile/profile.wxss —— 四组结构：①账户主卡 ②我的数据（带解读）③偏好 ④关于与数据
   底色统一走 --n-50 暖白（旧「青绿→桃色」竖渐变已弃用）。
   深色主题：底部 .page.theme-dark 块重定义变量，整棵子树自动跟随。 */

.page {
  width: 100vw;
  min-height: 100vh;
  padding: 0 0 calc(138rpx + env(safe-area-inset-bottom));
  background: var(--n-50);
}

/* ══════════════ ① 账户主卡（视觉重心） ══════════════ */
.hero-card {
  position: relative;
  overflow: hidden;
  margin: 24rpx 32rpx 0;
  padding: 36rpx 32rpx 30rpx;
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  box-shadow: var(--shadow-card);
  color: var(--text);
}
/* 右上角品牌光晕：让主卡在纯白卡面中有「身份感」，不抢内容 */
.hero-card::after {
  content: '';
  position: absolute; right: -70rpx; top: -90rpx;
  width: 280rpx; height: 280rpx; border-radius: 50%;
  background: radial-gradient(circle, var(--primary-tint) 0%, rgba(255, 255, 255, 0) 70%);
  pointer-events: none;
}

.hc-top { position: relative; z-index: 1; display: flex; align-items: center; gap: 24rpx; }
.avatar-btn {
  width: 112rpx; height: 112rpx; border-radius: 50%; overflow: hidden; flex: 0 0 auto;
  padding: 0; margin: 0; border: none; background: transparent; line-height: 1;
  box-shadow: 0 0 0 3rpx var(--primary);
}
.avatar-btn:active { opacity: .85; }
.avatar-img { width: 112rpx; height: 112rpx; border-radius: 50%; display: block; }
.hc-top .av {
  width: 112rpx; height: 112rpx; border-radius: 50%;
  background: var(--primary-tint); color: var(--primary-text);
  font-size: var(--fs-display); font-weight: 800;
  display: flex; align-items: center; justify-content: center;
}
.hc-meta { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.nick-input {
  width: 100%; height: 56rpx; padding: 0; border: none;
  background: transparent; color: var(--text);
  font-size: var(--fs-title); font-weight: 700; line-height: 56rpx;
}
.hc-sub { display: flex; align-items: center; font-size: var(--fs-caption); color: var(--text-sub); }
.hc-badge {
  display: inline-block; margin-right: 12rpx; padding: 5rpx 16rpx;
  border-radius: var(--r-pill); background: var(--primary); color: #0A0A0A;
  font-size: var(--fs-caption); font-weight: 800; line-height: 1.2;
}
.hc-gear {
  flex: 0 0 auto; width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--bg);
  display: flex; align-items: center; justify-content: center;
}
.hc-gear:active { opacity: .7; }

/* 数据三连：训练天数 / 累计时长 / 累计容量 */
.hc-stats {
  position: relative; z-index: 1;
  display: flex; margin-top: 28rpx; padding-top: 26rpx;
  border-top: 1rpx solid var(--line);
}
.hs-item { position: relative; flex: 1; text-align: center; }
.hs-item:not(:first-child)::before {
  content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  width: 1rpx; height: 44rpx; background: var(--line);
}
.hs-v { font-family: var(--f-en); font-size: var(--fs-title); font-weight: 800; color: var(--text); line-height: 1.1; }
.hs-u { margin-left: 4rpx; font-size: var(--fs-caption); font-weight: 600; color: var(--text-weak); }
.hs-k { margin-top: 8rpx; font-size: var(--fs-caption); color: var(--text-weak); }

/* 访客态：登录引导 */
.guest-head { position: relative; z-index: 1; display: flex; align-items: center; gap: 22rpx; }
.guest-av {
  flex: 0 0 auto; width: 96rpx; height: 96rpx; border-radius: 50%;
  background: var(--primary-tint);
  display: flex; align-items: center; justify-content: center;
}
.guest-text { flex: 1; min-width: 0; }
.guest-title { font-size: var(--fs-head); font-weight: 800; color: var(--text); }
.guest-sub { margin-top: 6rpx; font-size: var(--fs-caption); color: var(--text-sub); }
.login-btn {
  position: relative; z-index: 1;
  width: 100%; height: 88rpx; line-height: 88rpx; margin: 26rpx 0 0; padding: 0;
  border: none; border-radius: var(--r-pill);
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #0A0A0A; font-size: var(--fs-head); font-weight: 700;
  box-shadow: var(--shadow-mint);
}
.login-btn::after { border: none; }
.guest-tags { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 22rpx; }
.gt {
  padding: 7rpx 18rpx; border-radius: var(--r-pill);
  background: var(--bg); color: var(--text-sub);
  font-size: var(--fs-caption); font-weight: 600;
}

/* ══════════════ 通用：分区卡 ══════════════ */
.card.sec-card { margin-top: 24rpx; padding: 28rpx 28rpx 24rpx; }
.sec-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.sec-title {
  display: flex; align-items: center; gap: 12rpx;
  font-size: var(--fs-head); font-weight: 800; color: var(--text);
}
.sec-act {
  padding: 7rpx 20rpx; border-radius: var(--r-pill);
  background: var(--primary-tint); color: var(--primary-text);
  font-size: var(--fs-label); font-weight: 700;
}
.sec-act:active { opacity: .7; }

/* ══════════════ ② 我的数据：四格概览 ══════════════ */
.health-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.hg-item {
  display: flex; align-items: center; gap: 18rpx;
  padding: 22rpx 20rpx;
  background: var(--bg); border: 1rpx solid var(--glass-border);
  border-radius: 24rpx;
}
.hg-ic {
  flex: 0 0 auto; width: 72rpx; height: 72rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-label); font-weight: 800; line-height: 1;
}
/* 三个彩底磁贴用品牌/语义洗色；BMI 无专属图标，用品牌荧光绿实底 + 墨字做最强对比 */
.hg-ic-goal { background: linear-gradient(135deg, #F6FFDC, #E6FFA8); }
.hg-ic-scale { background: linear-gradient(135deg, #EEF4FF, #D9E7FF); }
.hg-ic-user { background: linear-gradient(135deg, #FFF2E7, #FFE1C9); }
.hg-ic-bmi { background: var(--primary); color: #0A0A0A; }
.hg-body { display: flex; flex-direction: column; min-width: 0; }
.hg-v { font-size: var(--fs-title); font-weight: 800; color: var(--text); line-height: 1.15; }
.hg-u { margin-left: 4rpx; font-size: var(--fs-caption); font-weight: 600; color: var(--text-sub); }
.hg-k { margin-top: 4rpx; font-size: var(--fs-caption); color: var(--text-sub); }

/* 解读块（BMI / 距目标共用外壳） */
.insight {
  margin-top: 20rpx; padding: 22rpx 24rpx;
  background: var(--bg); border-radius: var(--r-m);
}
.ins-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.ins-title { font-size: var(--fs-label); font-weight: 700; color: var(--text-sub); }
.ins-chip {
  padding: 7rpx 16rpx; border-radius: var(--r-pill);
  background: var(--card); color: var(--text);
  font-size: var(--fs-caption); font-weight: 700; line-height: 1.2;
}
.ins-chip.brand { background: var(--primary); color: #0A0A0A; }

/* BMI 刻度条：15–35 映射 0–100%，四档分界 17.5% / 45% / 65% */
.bmi-bar {
  position: relative; height: 16rpx; border-radius: var(--r-pill);
  background: linear-gradient(90deg,
    #8FCBFF 0 17.5%, #7BD97F 17.5% 45%, #FFC24B 45% 65%, #FF8A80 65% 100%);
}
.bmi-mark {
  position: absolute; top: 50%; width: 26rpx; height: 26rpx; border-radius: 50%;
  background: var(--card); border: 5rpx solid var(--text);
  transform: translate(-50%, -50%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .20);
}
.bmi-axis { position: relative; height: 30rpx; margin-top: 12rpx; }
.bmi-axis text {
  position: absolute; transform: translateX(-50%); white-space: nowrap;
  font-size: var(--fs-caption); color: var(--text-weak);
}
.bmi-axis text:nth-child(1) { left: 9%; }
.bmi-axis text:nth-child(2) { left: 31%; }
.bmi-axis text:nth-child(3) { left: 55%; }
.bmi-axis text:nth-child(4) { left: 82%; }

/* 距目标：起点 → 目标 + 进度条 */
.goal-line { display: flex; align-items: baseline; gap: 14rpx; margin-bottom: 16rpx; }
.goal-now { font-family: var(--f-en); font-size: var(--fs-section); font-weight: 800; color: var(--text); }
.goal-arrow { font-size: var(--fs-body); color: var(--text-weak); }
.goal-target { font-family: var(--f-en); font-size: var(--fs-section); font-weight: 800; color: var(--primary-text); }
.goal-unit { margin-left: 4rpx; font-size: var(--fs-caption); font-weight: 600; color: var(--text-weak); }
.goal-track { height: 16rpx; border-radius: var(--r-pill); background: var(--n-200); overflow: hidden; }
.goal-fill {
  height: 100%; border-radius: var(--r-pill);
  background: linear-gradient(90deg, var(--primary-light), var(--primary));
  transition: width .5s var(--ease-out);
}
.goal-hint { margin-top: 14rpx; font-size: var(--fs-caption); color: var(--text-sub); }

/* 空态引导：资料缺失时给出口，而不是一排「--」 */
.guide-empty {
  margin-top: 20rpx; padding: 26rpx 24rpx;
  border-radius: var(--r-m);
  background: var(--primary-tint);
  border: 1rpx dashed rgba(124, 184, 0, .35);
}
.ge-title { font-size: var(--fs-body); font-weight: 700; color: var(--primary-text); }
.ge-sub { margin-top: 6rpx; font-size: var(--fs-caption); color: var(--text-sub); }
.ge-btn {
  display: inline-block; margin-top: 18rpx; padding: 0 32rpx;
  height: 64rpx; line-height: 64rpx; border-radius: var(--r-pill);
  background: var(--primary); color: #0A0A0A;
  font-size: var(--fs-label); font-weight: 800;
}
.ge-btn:active { opacity: .85; }

/* ══════════════ ③④ 菜单（偏好 / 关于与数据） ══════════════ */
.menu { margin-top: 4rpx; }
.menu .mi { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 4rpx; }
.menu .mi:not(:last-child) { border-bottom: 1rpx solid var(--line); }
.menu .mi-ic {
  flex: 0 0 auto; width: 64rpx; height: 64rpx; border-radius: 18rpx;
  background: var(--bg);
  display: flex; align-items: center; justify-content: center;
}
.menu .mi-t { flex: 1; font-size: var(--fs-body); font-weight: 600; color: var(--text); }
.menu .mi-note { font-size: var(--fs-label); color: var(--text-weak); }
.menu .mi-ar { font-size: var(--fs-head); line-height: 1; color: var(--text-weak); }
.menu .mi-sw { flex: 0 0 auto; transform: scale(.82); transform-origin: right center; }
.menu .mi.danger .mi-t { color: var(--error); }
.menu .mi.danger .mi-ic { background: rgba(242, 84, 91, .10); }
.menu .mi.danger .ico--ink { background-color: var(--error); }

/* 媒体署名 */
.attribution {
  padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  text-align: center; font-size: var(--fs-caption); color: var(--text-weak); line-height: 1.6;
}
.attribution text { display: block; }
.bottom-gap { height: 20rpx; }

/* ══════════════ 数据管理弹层（导出 / 导入 / 清除） ══════════════ */
.dm-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 3000;
  background: rgba(15, 23, 42, .45);
  display: flex; align-items: flex-end;
}
/* 底部预留 custom-tab-bar 高度（88rpx 内容 + 安全区），否则独立渲染的 tabBar 会浮在弹层之上遮住底部按钮/提示。
   微信 custom-tab-bar 不在页面 z-index 堆叠内，页面内 fixed 遮罩无法盖住它，只能靠预留空间避让。 */
/* 弹层底必须用 var(--card)：硬编码 #fff 在深色模式下是白底配白字（--text:#FFFFFF）＝隐形 */
.dm-sheet {
  width: 100%; background: var(--card); border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(98rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -10rpx 40rpx rgba(15, 23, 42, .2);
  animation: hist-up .26s ease;
}
.dm-head { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 32rpx 12rpx; }
.dm-title { font-size: var(--fs-title); font-weight: 800; color: var(--text); }
.dm-close {
  width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--bg); color: var(--text-sub);
  font-size: var(--fs-head); display: flex; align-items: center; justify-content: center;
}
.dm-close:active { opacity: .6; }
.dm-list { padding: 4rpx 0; }
.dm-item { display: flex; align-items: center; justify-content: space-between; padding: 30rpx 32rpx; border-top: 1rpx solid var(--line); }
.dm-t { font-size: var(--fs-head); font-weight: 600; color: var(--text); }
/* 用 --text-weak 而非 --line-strong：后者在深色下仅 rgba(255,255,255,.20)，箭头几乎看不见 */
.dm-ar { color: var(--text-weak); font-size: var(--fs-title); }
.dm-item.danger .dm-t { color: #F2545B; }
.dm-hint { padding: 24rpx 48rpx 0; text-align: center; font-size: var(--fs-caption); color: var(--text-weak); line-height: 1.5; }
@keyframes hist-up { from { transform: translateY(100%); } to { transform: translateY(0); } }

/* 导出转发面板 */
.export-share-sheet { text-align: center; }
.export-share-body { padding: 20rpx 40rpx 30rpx; }
.export-share-icon { font-size: var(--fs-hero-lg); margin-bottom: 16rpx; }
.export-share-name { display: block; margin-bottom: 8rpx; font-size: var(--fs-body); font-weight: 700; color: var(--text); }
.export-share-hint { display: block; margin-bottom: 32rpx; font-size: var(--fs-label); color: var(--text-sub); line-height: 1.5; }
.export-share-btn {
  width: 100%; height: 88rpx; margin-bottom: 18rpx; padding: 0; border: none;
  display: flex; align-items: center; justify-content: center;
  border-radius: 20rpx; background: var(--primary); color: #0A0A0A;
  font-size: var(--fs-head); font-weight: 700;
}
.export-share-btn::after { border: none; }

/* ══════════════════════════════════════════════════════════════
   深色主题覆盖（.page.theme-dark）
   —— 由本页「深色主题」开关切换，utils/theme.js 持久化到 Storage。
   手法同 pages/home/home.wxss：重定义 CSS 变量让整棵子树自动翻转，
   仅对本页硬编码颜色（彩底磁贴、品牌光晕）做单独覆盖。
   ══════════════════════════════════════════════════════════════ */
.page.theme-dark {
  --n-50:  #0A0A0A;
  --n-100: #1E1E1E;
  --n-200: rgba(255, 255, 255, 0.10);
  --n-500: rgba(255, 255, 255, 0.42);
  --n-600: rgba(255, 255, 255, 0.55);
  --n-700: rgba(255, 255, 255, 0.75);
  --n-900: #FFFFFF;

  --text:        #FFFFFF;
  --text-sub:    rgba(255, 255, 255, 0.70);
  --text-weak:   rgba(255, 255, 255, 0.45);
  --line:        rgba(255, 255, 255, 0.10);
  --line-strong: rgba(255, 255, 255, 0.20);

  --card: #161616;
  --bg:   rgba(255, 255, 255, 0.06);

  /* 绿色文字：浅色用的深橄榄绿在黑底上只有 3.8:1，翻成品牌亮绿 */
  --primary-text: #C8FF00;
  /* 浅绿底（#F2FFD6）在暗色下必须一起翻，否则亮绿字压浅绿底会糊成一片 */
  --primary-tint: rgba(200, 255, 0, 0.12);

  background: #0A0A0A;
  color: var(--text);
}

/* 图标：.ico--ink 默认深墨，黑底不可见 → 转白 */
.page.theme-dark .ico--ink { background-color: #FFFFFF; }

/* 卡片阴影去掉（暗色下无意义） */
.page.theme-dark .card,
.page.theme-dark .hero-card { box-shadow: none; }

/* 主卡光晕：浅色用极浅绿底，暗色换成低透亮绿，避免黑底上一块脏灰 */
.page.theme-dark .hero-card::after {
  background: radial-gradient(circle, rgba(200, 255, 0, .16) 0%, rgba(0, 0, 0, 0) 70%);
}

/* 彩底磁贴：浅色是亮彩渐变，暗色改用语义色淡底，避免在黑底上发灰 */
.page.theme-dark .hg-ic-goal { background: rgba(200, 255, 0, .16); }
.page.theme-dark .hg-ic-scale { background: rgba(62, 139, 255, .20); }
.page.theme-dark .hg-ic-user { background: rgba(255, 149, 0, .18); }
/* .hg-ic-bmi 用 var(--primary) 实底 + 墨字，双主题通用，无需覆盖 */

/* 登录按钮：浅色是荧光绿渐变，暗色翻成纯品牌绿（渐变收尾色在黑底上发浑） */
.page.theme-dark .login-btn { background: var(--primary); color: #0A0A0A; }
/* 危险行图标：.ico--ink 的暗色覆盖优先度更高，此处显式拉回红色 */
.page.theme-dark .menu .mi.danger .ico--ink { background-color: var(--error); }
