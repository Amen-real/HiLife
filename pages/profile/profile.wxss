/* pages/profile/profile.wxss —— 对齐「我的」页设计稿
   结构：① Hero（背景图铺顶）② 我的数据 ③ 我的训练 ④ 偏好 ⑤ 关于与数据
   底色统一走 --n-50 暖白；深色主题：底部 .page.theme-dark 块重定义变量，整棵子树自动跟随。

   两处硬约束（踩过坑，勿改）：
   · custom-tab-bar 是框架级固定层，页面内 z-index 压不住它 → 底部必须留白避让（见 .page padding-bottom）。
   · 亮绿底（--primary #C8FF00）上的字形一律 #0A0A0A；该色深浅主题通用，故不进 dark 覆盖。
     但 .ico--ink 在 dark 下会翻白，压在亮绿底上就糊了 → 见文末 .p-chip/.tk-go 的显式拉回。 */

.page {
  width: 100vw;
  min-height: 100vh;
  padding: 0 0 calc(150rpx + env(safe-area-inset-bottom));
  background: var(--n-50);
  /* Hero 底部渐隐的起始色：与 --n-50 同色但全透明，避免用 transparent 时被渲染成灰带 */
  --hero-fade: rgba(247, 247, 245, 0);
}

/* ══════════════ ① HERO：背景图铺顶 + 悬浮标题/头像 ══════════════ */
/* min-height 取与背景图等高（852×560 按 750rpx 宽折算 ≈ 493rpx），
   内容自然铺在图上；内容更高时 Hero 自行增高，图下方由渐隐收口。 */
.p-hero { position: relative; min-height: 494rpx; }

.p-hero-bg {
  position: absolute; top: 0; left: 0;
  width: 100%; display: block; z-index: 0;
  pointer-events: none;
}

/* 底部渐隐：背景图底色 #F5F6F3 与页面底色 --n-50 差几档，硬切有可见接缝 */
.p-hero-fade {
  position: absolute; left: 0; right: 0; bottom: 0; height: 160rpx;
  background: linear-gradient(180deg, var(--hero-fade), var(--n-50));
  pointer-events: none;
}

.p-hero-body { position: relative; z-index: 1; }
/* 状态栏占位（父容器 .p-hero-body 目前是块级流，不会被压缩 —— 显式钉死是防后人把它
   挪进 flex 容器；food-scan 就是这么出事故的，见该页 .status-spacer 注释）。 */
.p-sb { width: 100%; flex: 0 0 auto; }

/* 顶部大标题行：行高由 navRowStyle 注入（= 导航带，按微信胶囊实测算，见 utils/navMetrics.js）。
   44px 只是注入前的兜底典型值。两条硬约束少一条就白算：
     · box-sizing: border-box —— 否则行内 height 是内容盒高，加 padding 后总高 ≠ 导航带；
     · 竖向 padding 必须为 0 —— 内容居中靠 align-items:center，留 padding 会把「我的」挤偏。
   历史坑（2026-10-12）：原为 `padding: 18rpx 36rpx 0` 手调摆位，偏胶囊中线 ~4px。
   字形本体在下层 .p-title（60rpx 设计稿字号不动），本行只负责把它送进胶囊那条中线。 */
.p-nav {
  display: flex; flex-direction: row; align-items: center;
  flex: 0 0 auto;
  height: 44px; box-sizing: border-box;
  padding: 0 36rpx;
}

.p-title {
  font-size: 60rpx; font-weight: 800; line-height: 1.15;
  color: var(--text); letter-spacing: -0.5rpx;
}

/* 头像行：头像 + 昵称/副标题 */
.p-id { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 36rpx 0; }
.p-avatar {
  position: relative;
  flex: 0 0 auto; width: 112rpx; height: 112rpx; border-radius: 50%;
  /* 不裁切：未登录时右上角要挂一枚加号角标，overflow:hidden 会把它切掉。
     圆形外观改由 .p-avatar-img / .p-avatar-txt 各自 border-radius 保证，视觉与裁切前完全一致。 */
  overflow: visible; background: var(--card);
  /* 浅绿描边圈：用 box-shadow 而非 border，避免与圆角裁切打架 */
  box-shadow: 0 0 0 6rpx rgba(200, 255, 0, .55);
}
.p-avatar:active { opacity: .85; }
.p-avatar-img { width: 112rpx; height: 112rpx; display: block; border-radius: 50%; }
.p-avatar-txt {
  width: 112rpx; height: 112rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--primary-tint); color: var(--primary-text);
  font-size: var(--fs-display); font-weight: 800;
}
/* 未登录角标：亮绿实底 + 墨色加号（字形颜色在文末 dark 块显式拉回） */
.p-avatar-add {
  position: absolute; right: -4rpx; bottom: -4rpx;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: var(--primary); border: 4rpx solid var(--card);
  display: flex; align-items: center; justify-content: center;
}
.p-avatar-add-i { width: 22rpx; height: 22rpx; }
.p-id-meta { flex: 1; min-width: 0; }
.p-nick-row { display: flex; align-items: center; gap: 12rpx; }
/* 受控 input：实时回显由 onNicknameInput 负责，宽度靠 flex 撑，不设固定 width 以免光标跳动 */
.p-nick {
  flex: 1; min-width: 0; height: 52rpx; padding: 0; border: none;
  background: transparent; color: var(--text);
  font-size: 38rpx; font-weight: 800; line-height: 52rpx;
}
.p-pen { flex: 0 0 auto; width: 28rpx; height: 28rpx; }
/* 未登录时昵称位换成「点击登录」文本（不是 input）：沿用 .p-nick 的字号/字重，只换颜色以示可点 */
.p-nick-guest { color: var(--primary-text); }
.p-id-ar { flex: 0 0 auto; width: 28rpx; height: 28rpx; }
.p-sub { margin-top: 8rpx; font-size: var(--fs-label); color: var(--text-sub); }

/* 累计三连：浮在背景图上，与下方卡片同宽（左右 36rpx） */
.p-stats {
  display: flex; margin: 30rpx 36rpx 0; padding: 26rpx 0;
  background: var(--card); border: 1rpx solid var(--line);
  border-radius: var(--r-l); box-shadow: var(--shadow-card);
}
.ps-item { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.ps-item:not(:first-child)::before {
  content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  width: 1rpx; height: 48rpx; background: var(--line);
}
.ps-num-row { display: flex; align-items: center; gap: 8rpx; }
.ps-v { font-family: var(--f-en); font-size: 46rpx; font-weight: 800; line-height: 1; color: var(--text); }
.ps-i { width: 26rpx; height: 26rpx; }
.ps-k { font-size: var(--fs-label); color: var(--text-sub); }

/* ══════════════ 通用：分区卡 + 卡头 ══════════════ */
.card.p-card { margin: 24rpx 36rpx 0; padding: 28rpx 28rpx 24rpx; }
.p-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.p-head-t {
  display: flex; align-items: center; gap: 14rpx;
  font-size: var(--fs-head); font-weight: 800; color: var(--text);
}
/* 卡头绿色方块图标：亮绿实底 + 墨色字形，双主题通用（字形颜色见文末 dark 覆盖） */
.p-chip {
  flex: 0 0 auto; width: 44rpx; height: 44rpx; border-radius: 14rpx;
  background: var(--primary);
  display: flex; align-items: center; justify-content: center;
}
.p-chip-i { width: 26rpx; height: 26rpx; }
.p-head-a {
  display: flex; align-items: center; gap: 4rpx;
  padding: 6rpx 4rpx; font-size: var(--fs-label); color: var(--text-sub);
}
.p-head-a:active { opacity: .6; }
.p-ar { font-size: 30rpx; line-height: 1; color: var(--text-weak); }

/* ══════════════ ② 我的数据：四格磁贴 ══════════════ */
.dtile-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.dtile {
  display: flex; align-items: center; gap: 16rpx;
  padding: 22rpx 18rpx;
  background: var(--bg); border-radius: 24rpx;
}
.dtile-ic {
  flex: 0 0 auto; width: 72rpx; height: 72rpx; border-radius: 50%;
  background: var(--card);
  display: flex; align-items: center; justify-content: center;
  /* 字形色必须随主题走：底色是 --card（浅色白 / 深色 #161616）。
     曾经这里写死 #0A0A0A，深色下变成墨字压近黑底 1.09:1 ≈ 隐形。 */
  font-size: 22rpx; font-weight: 800; line-height: 1; color: var(--text);
}
.dtile-i { width: 36rpx; height: 36rpx; }
/* 磁贴底色按语义洗色：体重蓝 / 身高橙 / 目标浅绿 / BMI 品牌绿实底 */
.dtile-ic-w { background: linear-gradient(135deg, #EEF4FF, #D9E7FF); }
.dtile-ic-h { background: linear-gradient(135deg, #FFF2E7, #FFE1C9); }
.dtile-ic-g { background: linear-gradient(135deg, #F6FFDC, #E6FFA8); }
.dtile-ic-b { background: var(--primary); color: var(--primary-ink); }
/* 亮绿实底上的字形必须拉回墨色：--primary 深浅主题通用，而 .dtile-ic 的基线字色会随主题翻转
   （深色下是白），白压亮绿≈1.6:1 等于隐形 —— 所以墨色在这里就地给定。 */
.dtile-bmi { font-size: 20rpx; letter-spacing: -0.5rpx; }
.dtile-b { flex: 1; min-width: 0; }
.dtile-v { font-family: var(--f-en); font-size: var(--fs-section); font-weight: 800; line-height: 1.15; color: var(--text); }
.dtile-u { margin-left: 4rpx; font-size: var(--fs-label); font-weight: 600; color: var(--text-sub); }
.dtile-k { margin-top: 4rpx; font-size: var(--fs-caption); color: var(--text-sub); }
/* 第三行状态（体重变化 / BMI 分档）：tone 由 JS 给，默认中性不上色 */
.dtile-x { margin-top: 4rpx; font-size: var(--fs-caption); font-weight: 700; color: var(--text-sub); }
.dtile-x.good { color: var(--success); }
.dtile-x.low  { color: var(--accent-deep); }
.dtile-x.bad  { color: var(--error); }

/* 解读块（BMI / 目标体重共用外壳） */
.p-ins { margin-top: 20rpx; padding: 22rpx 24rpx; background: var(--bg); border-radius: var(--r-m); }
.p-ins-title { margin-bottom: 16rpx; font-size: var(--fs-label); font-weight: 700; color: var(--text-sub); }

/* BMI 刻度条：显示区间 15–35 映射 0–100%，四档分界 17.5% / 45% / 65% */
.bmi-bar {
  position: relative; height: 16rpx; border-radius: var(--r-pill);
  background: linear-gradient(90deg,
    #8FCBFF 0 17.5%, #7BD97F 17.5% 45%, #FFC24B 45% 65%, #FF8A80 65% 100%);
}
.bmi-mark {
  position: absolute; top: 50%; width: 26rpx; height: 26rpx; border-radius: 50%;
  background: var(--card); border: 5rpx solid var(--text);
  transform: translate(-50%, -50%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .20);
}
.bmi-axis { position: relative; height: 30rpx; margin-top: 12rpx; }
.bmi-axis text {
  position: absolute; transform: translateX(-50%); white-space: nowrap;
  font-size: var(--fs-caption); color: var(--text-weak);
}
.bmi-axis text:nth-child(1) { left: 9%; }
.bmi-axis text:nth-child(2) { left: 31%; }
.bmi-axis text:nth-child(3) { left: 55%; }
.bmi-axis text:nth-child(4) { left: 82%; }

/* 目标体重：起点 → 目标 + 右侧差额胶囊 */
.goal-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.goal-line { display: flex; align-items: baseline; gap: 14rpx; min-width: 0; }
.goal-now { font-family: var(--f-en); font-size: var(--fs-section); font-weight: 800; color: var(--text); }
.goal-arrow { font-size: var(--fs-body); color: var(--text-weak); }
.goal-target { font-family: var(--f-en); font-size: var(--fs-section); font-weight: 800; color: var(--primary-text); }
.goal-unit { margin-left: 4rpx; font-size: var(--fs-caption); font-weight: 600; color: var(--text-weak); }
.p-pill {
  flex: 0 0 auto; padding: 8rpx 18rpx; border-radius: var(--r-pill);
  background: var(--primary); color: #0A0A0A;
  font-size: var(--fs-caption); font-weight: 800; line-height: 1.2;
}
.goal-track { height: 16rpx; border-radius: var(--r-pill); background: var(--n-200); overflow: hidden; }
.goal-fill {
  height: 100%; border-radius: var(--r-pill);
  background: linear-gradient(90deg, var(--primary-light), var(--primary));
  transition: width .5s var(--ease-out);
}
.goal-hint { margin-top: 14rpx; font-size: var(--fs-caption); color: var(--text-sub); }

/* 空态引导：资料缺失时给出口，而不是一排「--」 */
.guide-empty {
  margin-top: 20rpx; padding: 26rpx 24rpx;
  border-radius: var(--r-m);
  background: var(--primary-tint);
  border: 1rpx dashed rgba(124, 184, 0, .35);
}
.ge-title { font-size: var(--fs-body); font-weight: 700; color: var(--primary-text); }
.ge-sub { margin-top: 6rpx; font-size: var(--fs-caption); color: var(--text-sub); }
.ge-btn {
  display: inline-block; margin-top: 18rpx; padding: 0 32rpx;
  height: 64rpx; line-height: 64rpx; border-radius: var(--r-pill);
  background: var(--primary); color: #0A0A0A;
  font-size: var(--fs-label); font-weight: 800;
}
.ge-btn:active { opacity: .85; }

/* ══════════════ ③ 我的训练：最近一场 + 维度小计 ══════════════ */
.tk {
  display: flex; align-items: center; gap: 22rpx;
  padding: 22rpx 20rpx;
  background: var(--bg); border-radius: var(--r-m);
}
.tk:active { opacity: .8; }
/* 训练日志不落 image 字段，动作图只在内置动作库里（500KB+，懒加载不入本页）→ 用品牌图标占位 */
.tk-thumb {
  flex: 0 0 auto; width: 132rpx; height: 132rpx; border-radius: 20rpx;
  background: var(--primary-tint);
  display: flex; align-items: center; justify-content: center;
}
.tk-thumb-i { width: 60rpx; height: 60rpx; }
.tk-b { flex: 1; min-width: 0; }
.tk-tag {
  display: inline-block; margin-bottom: 8rpx; padding: 3rpx 14rpx;
  border-radius: 10rpx; background: var(--primary); color: #0A0A0A;
  font-size: var(--fs-mini); font-weight: 800; line-height: 1.6;
}
/* 标签样式由 class 后缀（= train.mode）切换：「今日」用基准样式（亮绿实底），
   「已完成」退成浅绿底 + 绿字 —— 亮绿实底留给需要催促的未完成态。
   --primary-tint / --primary-text 都会跟主题翻转，所以这里不用进深色拉回名单。 */
.tk-tag.done { background: var(--primary-tint); color: var(--primary-text); }
.tk-name {
  font-size: var(--fs-head); font-weight: 800; color: var(--text);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.tk-meta { margin-top: 8rpx; font-size: var(--fs-caption); color: var(--text-sub); }
.tk-go {
  flex: 0 0 auto; width: 72rpx; height: 72rpx; border-radius: 50%;
  background: var(--primary);
  display: flex; align-items: center; justify-content: center;
}
.tk-go-i { width: 32rpx; height: 32rpx; }

.tk-empty { padding: 30rpx 20rpx; background: var(--bg); border-radius: var(--r-m); text-align: center; }
.tk-empty:active { opacity: .8; }
.tk-empty-i { width: 52rpx; height: 52rpx; margin-bottom: 12rpx; }
.tk-empty-t { font-size: var(--fs-body); font-weight: 700; color: var(--text); }
.tk-empty-s { margin-top: 6rpx; font-size: var(--fs-caption); color: var(--text-sub); }

.tk-stats { display: flex; margin-top: 22rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); }
.tks-item { position: relative; flex: 1; text-align: center; }
.tks-item:not(:first-child)::before {
  content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  width: 1rpx; height: 44rpx; background: var(--line);
}
.tks-v { font-family: var(--f-en); font-size: var(--fs-title); font-weight: 800; line-height: 1.1; color: var(--text); }
.tks-u { margin-left: 2rpx; font-size: var(--fs-caption); font-weight: 600; color: var(--text-weak); }
.tks-k { margin-top: 8rpx; font-size: var(--fs-caption); color: var(--text-weak); }

/* ══════════════ ④⑤ 菜单（偏好 / 关于与数据） ══════════════ */
.menu { margin-top: 4rpx; }
.menu .mi { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 4rpx; }
.menu .mi:not(:last-child) { border-bottom: 1rpx solid var(--line); }
.menu .mi-i { flex: 0 0 auto; width: 38rpx; height: 38rpx; }
.menu .mi-t { flex: 1; font-size: var(--fs-body); font-weight: 600; color: var(--text); }
.menu .mi-note { font-size: var(--fs-label); color: var(--text-weak); }
.menu .mi-ar { font-size: 32rpx; line-height: 1; color: var(--text-weak); }
.menu .mi-sw { flex: 0 0 auto; transform: scale(.82); transform-origin: right center; }
.menu .mi.danger .mi-t { color: var(--error); }
.menu .mi.danger .ico--ink { background-color: var(--error); }

/* 媒体署名 */
.attribution {
  padding: 28rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  text-align: center; font-size: var(--fs-caption); color: var(--text-weak); line-height: 1.6;
}
.attribution text { display: block; }

/* 备案号展示位：紧跟在署名之后，同为页脚常驻内容。
   字号与署名一致（--fs-caption），但**字色必须用 --n-700 而不是 --text-weak**：
   本仓铁律「小字一律 --n-700」—— 对比度门禁不把祖先底色纳入候选，
   --text-weak(#A0A0A0) 压在 --n-50 上只有 ≈2.3:1，看着像「有内容」其实读不清。
   这是合规展示项，读不清等于没展示。 */
.icp {
  padding: 0 36rpx 24rpx;
  text-align: center; font-size: var(--fs-caption); color: var(--n-700); line-height: 1.6;
}
.icp text { display: block; }
/* 「工信部备案查询 ›」是这一块的可点提示，用品牌绿文字色（--primary-text：浅色 5.6:1 / 深色翻亮绿） */
.icp .icp-q { margin-top: 4rpx; color: var(--primary-text); }
.icp:active { opacity: .7; }
.bottom-gap { height: 20rpx; }

/* ══════════════ 数据管理弹层（导出 / 导入 / 清除） ══════════════ */
.dm-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 3000;
  background: rgba(15, 23, 42, .45);
  display: flex; align-items: flex-end;
}
/* 底部预留 custom-tab-bar 高度（88rpx 内容 + 安全区），否则独立渲染的 tabBar 会浮在弹层之上遮住底部按钮/提示。
   微信 custom-tab-bar 不在页面 z-index 堆叠内，页面内 fixed 遮罩无法盖住它，只能靠预留空间避让。 */
/* 弹层底必须用 var(--card)：硬编码 #fff 在深色模式下是白底配白字（--text:#FFFFFF）＝隐形 */
.dm-sheet {
  width: 100%; background: var(--card); border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(98rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -10rpx 40rpx rgba(15, 23, 42, .2);
  animation: hist-up .26s ease;
}
.dm-head { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 32rpx 12rpx; }
.dm-title { font-size: var(--fs-title); font-weight: 800; color: var(--text); }
.dm-close {
  width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--bg); color: var(--text-sub);
  font-size: var(--fs-head); display: flex; align-items: center; justify-content: center;
}
.dm-close:active { opacity: .6; }
.dm-list { padding: 4rpx 0; }
.dm-item { display: flex; align-items: center; justify-content: space-between; padding: 30rpx 32rpx; border-top: 1rpx solid var(--line); }
.dm-t { font-size: var(--fs-head); font-weight: 600; color: var(--text); }
/* 用 --text-weak 而非 --line-strong：后者在深色下仅 rgba(255,255,255,.20)，箭头几乎看不见 */
.dm-ar { color: var(--text-weak); font-size: var(--fs-title); }
.dm-item.danger .dm-t { color: #F2545B; }
.dm-hint { padding: 24rpx 48rpx 0; text-align: center; font-size: var(--fs-caption); color: var(--text-weak); line-height: 1.5; }
@keyframes hist-up { from { transform: translateY(100%); } to { transform: translateY(0); } }

/* 导出转发面板 */
.export-share-sheet { text-align: center; }
.export-share-body { padding: 20rpx 40rpx 30rpx; }
.export-share-name { display: block; margin-bottom: 8rpx; font-size: var(--fs-body); font-weight: 700; color: var(--text); }
.export-share-hint { display: block; margin-bottom: 32rpx; font-size: var(--fs-label); color: var(--text-sub); line-height: 1.5; }
.export-share-btn {
  width: 100%; height: 88rpx; margin-bottom: 18rpx; padding: 0; border: none;
  display: flex; align-items: center; justify-content: center;
  border-radius: 20rpx; background: var(--primary); color: #0A0A0A;
  font-size: var(--fs-head); font-weight: 700;
}
.export-share-btn::after { border: none; }

/* ══════════════════════════════════════════════════════════════
   深色主题覆盖（.page.theme-dark）
   —— 由本页「深色主题」开关切换，utils/theme.js 持久化到 Storage。
   手法同 pages/home/home.wxss：重定义 CSS 变量让整棵子树自动翻转，
   仅对本页硬编码颜色（彩底磁贴、亮绿底上的墨字）做单独覆盖；
   Hero 底图不在这里处理 —— 明暗两张图由 JS 换 src（见 profile.js 的 bgOf）。
   ══════════════════════════════════════════════════════════════ */
.page.theme-dark {
  --n-50:  #0A0A0A;
  --n-100: #1E1E1E;
  --n-200: rgba(255, 255, 255, 0.10);
  --n-500: rgba(255, 255, 255, 0.42);
  --n-600: rgba(255, 255, 255, 0.55);
  --n-700: rgba(255, 255, 255, 0.75);
  --n-900: #FFFFFF;

  --text:        #FFFFFF;
  --text-sub:    rgba(255, 255, 255, 0.70);
  --text-weak:   rgba(255, 255, 255, 0.45);
  --line:        rgba(255, 255, 255, 0.10);
  --line-strong: rgba(255, 255, 255, 0.20);

  --card: #161616;
  --bg:   rgba(255, 255, 255, 0.06);

  /* 绿色文字：浅色用的深橄榄绿在黑底上只有 3.8:1，翻成品牌亮绿 */
  --primary-text: #C8FF00;
  /* 浅绿底（#F2FFD6）在暗色下必须一起翻，否则亮绿字压浅绿底会糊成一片 */
  --primary-tint: rgba(200, 255, 0, 0.12);
  --hero-fade: rgba(10, 10, 10, 0);

  background: #0A0A0A;
  color: var(--text);
}

/* Hero 底图：深色主题**不撤图**，改用另一张黑底版（static/my-bg-dark.jpg，由 JS 跟 theme 换 src）。
   两张同几何尺寸（852×560），所以这里无需任何尺寸覆盖 —— 一旦谁给 .p-hero-bg 加了尺寸/隐藏规则，
   切主题就会跳版，故该不变式已固化为 verify-profile.cjs 的 C7/C12 断言。 */

/* 图标：.ico--ink 默认深墨，黑底不可见 → 转白 */
.page.theme-dark .ico--ink { background-color: #FFFFFF; }

/* 亮绿实底上的字形必须拉回墨色：--primary 深浅主题通用，不会跟着翻，
   而上面的 .ico--ink 覆盖把字形翻成了白 —— 白压亮绿≈1.6:1，等于隐形。 */
.page.theme-dark .p-chip .ico--ink,
.page.theme-dark .p-avatar-add .ico--ink,
.page.theme-dark .tk-go .ico--ink { background-color: #0A0A0A; }

/* 卡片阴影去掉（暗色下无意义） */
.page.theme-dark .card,
.page.theme-dark .p-stats { box-shadow: none; }

/* 彩底磁贴：浅色是亮彩渐变，暗色改用语义色淡底，避免在黑底上发灰。
   .dtile-ic-b 用 var(--primary) 实底 + 墨字，双主题通用，无需覆盖。 */
.page.theme-dark .dtile-ic-w { background: rgba(62, 139, 255, .20); }
.page.theme-dark .dtile-ic-h { background: rgba(255, 149, 0, .18); }
.page.theme-dark .dtile-ic-g { background: rgba(200, 255, 0, .16); }

/* 状态色：--success(#6F9F00) 压黑底仅 3.5:1、--accent-deep 更暗 → 深色下换成亮一档的同义色 */
.page.theme-dark .dtile-x.good { color: var(--primary-text); }
.page.theme-dark .dtile-x.low  { color: var(--warning); }

/* 危险行图标：.ico--ink 的暗色覆盖优先度更高，此处显式拉回红色 */
.page.theme-dark .menu .mi.danger .ico--ink { background-color: var(--error); }
