/* pages/settings/settings.wxss */
.page { padding: 24rpx 0 60rpx; }
.card { padding: 8rpx 32rpx; }

.form-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 0; border-bottom: 1rpx solid var(--line);
}
.form-row.no-border { border-bottom: none; }
.form-label { font-size: var(--fs-head); }
/* 绿字铁律：--primary(#C8FF00) 在暖白底上仅约 1.1:1 等于隐形，
   一律改用 --primary-text（浅底 #4C7300 ~5:1；深色块翻为 #C8FF00） */
.form-value { font-size: var(--fs-body); color: var(--primary-text); display: flex; align-items: center; }
.arrow { color: var(--text-weak); margin-left: 6rpx; }
.form-input { text-align: right; font-size: var(--fs-body); color: var(--text); }

.save-btn { margin-top: 40rpx; }
.tip { text-align: center; color: var(--text-weak); font-size: var(--fs-label); margin: 24rpx 32rpx; }

/* ══════════════════════════════════════════════════════════════
   深色主题覆盖（.page.theme-dark）—— 手法同 home.wxss：重定义 CSS 变量
   本页样式全部走 var()，无硬编码色需单独覆盖
   ══════════════════════════════════════════════════════════════ */
.page.theme-dark {
  --n-50:  #0A0A0A;
  --n-100: #1E1E1E;
  --n-200: rgba(255, 255, 255, 0.10);
  --n-300: rgba(255, 255, 255, 0.16);
  --n-400: rgba(255, 255, 255, 0.30);
  --n-500: rgba(255, 255, 255, 0.42);
  --n-600: rgba(255, 255, 255, 0.55);
  --n-700: rgba(255, 255, 255, 0.75);
  --n-800: rgba(255, 255, 255, 0.88);
  --n-900: #FFFFFF;

  --text:        #FFFFFF;
  --text-sub:    rgba(255, 255, 255, 0.70);
  --text-weak:   rgba(255, 255, 255, 0.45);
  --line:        rgba(255, 255, 255, 0.10);
  --line-strong: rgba(255, 255, 255, 0.20);

  --card:      #161616;
  --white:     #161616;
  --card-gray: #1E1E1E;
  --bg:        rgba(255, 255, 255, 0.06);

  --success: #C8FF00;
  /* 绿字：浅色的深橄榄绿在黑底上只有 3.8:1，翻成品牌亮绿 */
  --primary-text: #C8FF00;

  background: var(--n-50);
  color: var(--text);
}
.page.theme-dark .card { box-shadow: none; }
