/* pages/settings/settings.wxss */
.page { padding: 24rpx 0 60rpx; }
.card { padding: 8rpx 32rpx; }

.form-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 0; border-bottom: 1rpx solid var(--line);
}
.form-row.no-border { border-bottom: none; }
.form-label { font-size: 30rpx; }
.form-value { font-size: 28rpx; color: var(--primary); display: flex; align-items: center; }
.arrow { color: var(--text-weak); margin-left: 6rpx; }
.form-input { text-align: right; font-size: 28rpx; color: var(--text); }

.save-btn { margin-top: 40rpx; }
.tip { text-align: center; color: var(--text-weak); font-size: 24rpx; margin: 24rpx 32rpx; }
