<!-- pages/settings/settings.wxml -->
<view class="page">
  <view class="card">
    <view class="form-row">
      <text class="form-label">性别</text>
      <picker mode="selector" range="{{genders}}" value="{{genderIndex}}" bindchange="pickGender">
        <view class="form-value">{{gender || '未设置'}}<text class="arrow"> ›</text></view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">当前目标</text>
      <picker mode="selector" range="{{goals}}" value="{{goalIndex}}" bindchange="pickGoal">
        <view class="form-value">{{goal}}<text class="arrow"> ›</text></view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">目标体重 (kg)</text>
      <input class="form-input" type="digit" placeholder="如 65" value="{{targetWeight}}" bindinput="onTarget" />
    </view>
    <view class="form-row no-border">
      <text class="form-label">身高 (cm)</text>
      <input class="form-input" type="digit" placeholder="如 175" value="{{height}}" bindinput="onHeight" />
    </view>
  </view>

  <button class="btn-primary save-btn" bindtap="save">保存</button>
  <view class="tip">保存后，首页目标进度与建议页营养目标会自动更新。</view>
</view>
