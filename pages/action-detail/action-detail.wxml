<!-- pages/action-detail/action-detail.wxml —— 对齐 04-action.html（HiLiLife 设计系统） -->
<view class="page {{theme}}" wx:if="{{act}}">
  <nav-bar title="动作详情" show-back="{{true}}" />

  <!-- ============== TITLE BLOCK ============== -->
  <view class="title-block">
    <view class="h1">{{act.nameZh || act.name}}</view>
    <view class="en" wx:if="{{act.name && act.name !== (act.nameZh || act.name)}}">{{act.name}}</view>
    <view class="tags">
      <text class="tag" wx:for="{{tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- ============== HERO ============== -->
  <view class="hero" bindtap="onHeroTap" role="img" aria-label="动作演示">
    <!-- 单层 aspectFit 即可「直接铺满」：数据集 GIF 背景为恒定纯白(12 帧四角实测 255,255,255)，
         Hero 底也用恒定纯白 ⇒ 留边与图底融为一体，无黑边、无模糊、无变形、人物完整。
         ⚠️ 不能用 var(--white)（深色主题翻成 #161616 会重新露出留边）。 -->
    <image wx:if="{{heroSrc}}" class="hero-img" src="{{heroSrc}}" mode="aspectFit" lazy-load />
    <view wx:else class="hero-emoji">{{act.emoji}}</view>
    <view wx:if="{{heroSrc}}" class="play" aria-hidden="true"><view class="ico ico-play ico--ink" style="width:40rpx;height:40rpx"></view></view>
    <view wx:if="{{heroSrc}}" class="badge"><view class="dot"></view><text>{{heroBadge}}</text></view>
  </view>

  <!-- ============== 动作要点 ============== -->
  <view class="section" wx:if="{{steps.length}}">
    <view class="h2">动作要点</view>
    <view class="tips">
      <view class="tip" wx:for="{{steps}}" wx:key="index">
        <view class="num-circle">{{index + 1}}</view>
        <text class="tip-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- ============== 主要肌肉 ============== -->
  <view class="section">
    <view class="h2">主要肌肉</view>
    <view class="bodymap">
      <view class="bm-cell">
        <canvas type="2d" id="bodyFront" class="bm-canvas"></canvas>
        <text class="bm-label">正面<text class="en">Front</text></text>
      </view>
      <view class="bm-cell">
        <canvas type="2d" id="bodyBack" class="bm-canvas"></canvas>
        <text class="bm-label">背面<text class="en">Back</text></text>
      </view>
    </view>
    <view class="muscles">
      <view class="muscle" wx:if="{{muscles.front.length}}">
        <view class="m-head">正面<text class="en">Front</text></view>
        <view class="m-tags">
          <text class="m-tag {{m.primary ? 'primary' : ''}}" wx:for="{{muscles.front}}" wx:for-item="m" wx:key="name">{{m.name}}</text>
        </view>
      </view>
      <view class="muscle" wx:if="{{muscles.back.length}}">
        <view class="m-head">背面<text class="en">Back</text></view>
        <view class="m-tags">
          <text class="m-tag {{m.primary ? 'primary' : ''}}" wx:for="{{muscles.back}}" wx:for-item="m" wx:key="name">{{m.name}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ============== 肌群当前状态（数据来自 utils/muscleStatus.js 唯一真源） ==============
       ⚠️ 为什么用文字芯片而不是给解剖图上三色：
         ① 人体图相邻肌群边界细、底色是浅灰(#E2E6EA)，实测任意两个「有色」态之间的
            对比度只有 1.06~1.34，远低于 WCAG 1.4.11 对图形元素的 3:1 —— 这是载体限制，
            不是调色能解决的；
         ② 图上仍按原样高亮「本动作练哪里」，三态信息由下面的芯片承载，
            文字色/底色已逐对验算过（浅深两套主题均 ≥4.5:1，见 verify-muscle-status）。
         ⚠️ chips 为空 = 21 天内这些肌群没练过，此时不编造状态（不显示任何芯片）。
  -->
  <view class="section" wx:if="{{hasStatus}}">
    <view class="row-head">
      <view class="h2">当前状态</view>
      <text class="more">近 21 天</text>
    </view>
    <view class="status-sum">{{statusSummary}}</view>
    <view class="status-chips" wx:if="{{statusChips.length}}">
      <text class="st-chip st-{{item.state}}" wx:for="{{statusChips}}" wx:key="slug">{{item.name}} · {{item.label}}</text>
    </view>
    <view class="status-hint">{{statusHint}}</view>
  </view>

  <!-- ============== 历史记录 ============== -->
  <view class="section">
    <view class="row-head">
      <view class="h2">历史记录</view>
      <text class="more">最近 5 次</text>
    </view>
    <view class="history" wx:if="{{history.length}}">
      <view class="h-row" wx:for="{{history}}" wx:key="date">
        <text class="date">{{item.date}}</text>
        <text class="num">{{item.sets}}<text class="unit">组</text></text>
        <text class="num">{{item.reps}}<text class="unit">次</text></text>
        <text class="num">{{item.weight}}<text class="unit">kg</text></text>
      </view>
    </view>
    <view wx:else class="empty-hist">还没有该动作的训练记录</view>
  </view>

  <view class="bottom-gap"></view>

  <!-- 底部固定栏：加入今日训练（保留业务功能） -->
  <view class="btn-row">
    <view class="btn-primary add-today" bindtap="addToToday">加入今日训练</view>
  </view>

  <!-- 放大覆盖层：点击 Hero 弹出半透明全屏（GIF 用 image 标签渲染，自动循环播放） -->
  <view class="video-mask" wx:if="{{showVideoOverlay}}" bindtap="closeVideoOverlay">
    <image class="video-mask-player" src="{{heroSrc}}" mode="aspectFit" />
    <view class="video-mask-close" bindtap="closeVideoOverlay">✕</view>
  </view>

</view>
<view wx:else class="empty">未找到动作信息</view>
