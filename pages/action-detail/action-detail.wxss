/* pages/action-detail/action-detail.wxss */
.page { padding-bottom: 160rpx; }

.hero {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
}
.hero-img { width: 100%; height: 100%; border-radius: 24rpx; }
/* 仅有视频时：去掉卡片内边距，并用绝对定位让视频填满整个 hero，黑背景被视频完全覆盖，消除"大片黑边" */
.hero--video { background: #000; padding: 0; }
.hero--video .hero-img { position: absolute; left: 0; top: 0; }
.hero-emoji { font-size: 180rpx; }
.gif-badge {
  position: absolute; right: 20rpx; bottom: 20rpx;
  background: rgba(0,0,0,0.55); color: #fff; font-size: 22rpx;
  padding: 6rpx 16rpx; border-radius: 999rpx;
}

.d-name { font-size: 40rpx; font-weight: 700; }
.d-tags { margin: 18rpx 0 0; display: flex; flex-wrap: wrap; gap: 8rpx; }
.d-desc { font-size: 28rpx; color: var(--text-sub); line-height: 1.7; }
.attr { margin-top: 16rpx; font-size: 22rpx; color: #9aa0a6; }

.step { display: flex; align-items: flex-start; gap: 20rpx; margin-bottom: 22rpx; }
.step-no {
  flex: 0 0 auto; width: 48rpx; height: 48rpx; border-radius: 50%;
  background: var(--primary-light); color: var(--primary); font-weight: 700;
  display: flex; align-items: center; justify-content: center; font-size: 26rpx;
}
.step-text { flex: 1; font-size: 28rpx; line-height: 1.7; }

.btn-row {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--glass-strong); border-top: 1rpx solid var(--glass-border);
  backdrop-filter: blur(20rpx); -webkit-backdrop-filter: blur(20rpx);
  display: flex; align-items: center; gap: 20rpx;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
}
.fav-btn {
  flex: 1; height: 88rpx; border-radius: 16rpx;
  background: #fff; border: 2rpx solid var(--primary); color: var(--primary);
  font-weight: 700; display: flex; align-items: center; justify-content: center; font-size: 28rpx;
}
.fav-btn.on { background: #ffeceb; color: #ff4d4f; border-color: #ffd6d6; }
.add-today { flex: 2; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.add-today:active { opacity: 0.85; }

/* 视频放大按钮：盖在原生 video 之上，必须用 cover-view（普通 view 盖不住原生组件） */
.zoom-btn {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  color: #fff;
  font-size: 40rpx;
  background-color: rgba(0, 0, 0, 0.45);
  border-radius: 50%;
}

/* 视频放大覆盖层（半透明全屏，内部放大 video） */
.video-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.video-mask-player {
  width: 92vw;
  height: 92vw;
  border-radius: 16rpx;
  background-color: #000;
}
/* 关闭按钮同样用 cover-view，才能压在原生 video 之上 */
.video-mask-close {
  position: absolute;
  right: 48rpx;
  top: 48rpx;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  color: #fff;
  font-size: 44rpx;
  background-color: rgba(255, 255, 255, 0.22);
  border-radius: 50%;
}
