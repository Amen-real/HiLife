/* pages/action-detail/action-detail.wxss —— 对齐 04-action.html（HiLiLife 设计系统） */
.page {
  padding-bottom: 200rpx;
  min-height: 100vh;
  background: var(--n-50);
}

/* ============== TITLE BLOCK ============== */
.title-block {
  padding: 23rpx 31rpx 23rpx;
  background: var(--n-50);
}
.title-block .h1 {
  font-size: 46rpx; font-weight: 800; letter-spacing: -0.02em;
  color: var(--n-900); line-height: 1.2;
}
.title-block .en {
  font-family: var(--f-en);
  font-size: 25rpx; font-weight: 500; color: var(--n-600);
  margin-top: 4rpx; letter-spacing: -0.005em;
}
.title-block .tags {
  display: flex; gap: 12rpx; margin-top: 19rpx; flex-wrap: wrap;
}
.title-block .tag {
  display: inline-flex; align-items: center;
  height: 46rpx; padding: 0 19rpx;
  background: var(--primary-tint);
  color: var(--success-text);
  border-radius: var(--r-s);
  font-size: 21rpx; font-weight: 700; letter-spacing: 0;
}

/* ============== HERO ============== */
.hero {
  margin: 15rpx 31rpx 31rpx;
  position: relative;
  border-radius: var(--r-l);
  overflow: hidden;
  /* 恒定纯白，与 GIF 恒定白底融为一体（aspectFit 留边不可见 = 视觉满幅）。
     ⚠️ 字面色：--white 深色主题会翻转，重新露出留边；配 --line 同值的恒定描边 + 6% 阴影
     让白卡在 --n-50 页底与深色主题下都有边界。 */
  background: #FFFFFF;
  border: 1rpx solid #E8E8E4;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  aspect-ratio: 16 / 9;
  cursor: pointer;
}
.hero-img { width: 100%; height: 100%; display: block; }
.hero-emoji {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 200rpx;
}
.hero .play {
  position: absolute; left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  width: 123rpx; height: 123rpx; border-radius: 50%;
  background: var(--white);
  display: grid; place-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.35);
  /* hero 恒白卡后白圆需边界：白描边(为深底设计)换恒定浅灰线 */
  border: 1rpx solid #E8E8E4;
}
.hero .badge {
  position: absolute; left: 23rpx; bottom: 23rpx;
  display: inline-flex; align-items: center; gap: 12rpx;
  padding: 12rpx 19rpx;
  background: rgba(10,10,10,0.7);
  /* 深色下 --white 会翻成 #161616（它是「卡面」token），压在这块恒定深色遮罩上只有 1.05:1。
     这枚徽章永远叠在动作演示图 + 深色 scrim 上，与主题无关，故用字面白。
     2026-10-15 起 hero 是恒白卡 ⇒ scrim 0.7（白字压白底 ≈6.4:1）。 */
  color: #FFFFFF;
  font-family: var(--f-en);
  font-size: 21rpx; font-weight: 700; letter-spacing: 0.04em;
  border-radius: var(--r-pill);
}
.hero .badge .dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--primary);
}

/* ============== SECTION 通用 ============== */
.section { padding: 15rpx 31rpx 31rpx; }
.section .h2 {
  font-size: 29rpx; font-weight: 800; letter-spacing: -0.01em;
  color: var(--n-900);
  margin: 0 8rpx 23rpx;
}
.section .row-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 23rpx; }
.section .row-head .h2 { margin: 0; }
.section .row-head .more {
  font-size: 23rpx; font-weight: 600; color: var(--n-600); letter-spacing: 0;
}

/* ============== 动作要点 ============== */
.tips { display: flex; flex-direction: column; gap: 12rpx; }
.tip {
  display: flex; align-items: center; gap: 19rpx;
  padding: 17rpx 27rpx;
  background: var(--white);
  border-radius: var(--r-m);
  box-shadow: var(--shadow-card);
  font-size: 27rpx; font-weight: 600; color: var(--n-900);
}
.tip .num-circle {
  width: 46rpx; height: 46rpx; flex: none;
  border-radius: 50%;
  background: var(--primary);
  display: grid; place-items: center;
  font-family: var(--f-en);
  font-size: 25rpx; font-weight: 800;
  color: var(--primary-ink);
  font-variant-numeric: tabular-nums;
}
.tip .tip-text { flex: 1; }

/* ============== 主要肌肉（参考 Lzheng 设计：以命名肌群为主，主肌高亮） ============== */
.bodymap { display: flex; gap: 19rpx; margin: 0 8rpx 27rpx; }
.bodymap .bm-cell {
  flex: 1;
  background: var(--white);
  border-radius: var(--r-l);
  box-shadow: var(--shadow-card);
  padding: 19rpx 12rpx 12rpx;
  display: flex; flex-direction: column; align-items: center;
}
.bodymap .bm-canvas {
  width: 100%; height: 440rpx; display: block;
}
.bodymap .bm-label {
  margin-top: 8rpx;
  font-size: 23rpx; font-weight: 800; color: var(--n-700);
  display: flex; align-items: baseline; gap: 6rpx;
}
.bodymap .bm-label .en {
  font-family: var(--f-en);
  font-size: 19rpx; font-weight: 500; color: var(--n-500);
}
.muscles { display: grid; grid-template-columns: 1fr 1fr; gap: 23rpx; }
.muscle {
  background: var(--white);
  border-radius: var(--r-l);
  box-shadow: var(--shadow-card);
  padding: 27rpx 23rpx;
  display: flex; flex-direction: column;
}
.muscle .m-head {
  font-size: 25rpx; font-weight: 800;
  color: var(--n-900);
  margin-bottom: 19rpx; letter-spacing: -0.01em;
  display: flex; align-items: baseline; gap: 8rpx;
}
.muscle .m-head .en {
  font-family: var(--f-en);
  font-size: 21rpx; font-weight: 500;
  color: var(--n-600); letter-spacing: 0;
}
.muscle .m-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.muscle .m-tag {
  display: inline-flex; align-items: center;
  height: 54rpx; padding: 0 23rpx;
  border-radius: var(--r-pill);
  background: var(--card-gray);
  color: var(--n-700);
  font-size: 23rpx; font-weight: 600;
}
.muscle .m-tag.primary {
  background: var(--primary);
  color: var(--primary-ink);
  font-weight: 800;
}

/* ============== 当前状态（三态文字芯片） ==============
   ⚠️ 配色纪律（本页实测结论，改色前先读）：
     解剖图底色是浅灰 #E2E6EA，任何两个「有色」态的填充互相只有 1.06~1.34:1，
     远达不到 WCAG 1.4.11 对图形元素的 3:1 ⇒ 图上不做三色编码，三态一律走文字芯片。
   ⚠️ 下面 3 组「底 + 字」均已逐对验算，浅色侧 6.00~16.74:1、深色侧 5.43~8.33:1，
     全部 ≥4.5:1（AA 正文）。改任何一处都必须重算，且**底与字必须成对翻**
     （见文件末尾 .page.theme-dark 内同名变量）。
   ⚠️ trained 用品牌亮绿底 + #0A0A0A 字：亮绿是全库唯一不随主题翻转的颜色，
     与 MEMORY.md 的「亮绿实底字恒 #0A0A0A」一致。 */
.status-sum {
  font-size: 25rpx; font-weight: 600;
  color: var(--n-800);
  margin-bottom: 19rpx;
}
.status-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.status-hint {
  font-size: 23rpx;
  color: var(--n-600);
  margin-top: 19rpx;
}
.st-chip {
  display: inline-flex; align-items: center;
  height: 54rpx; padding: 0 23rpx;
  border-radius: var(--r-pill);
  font-size: 23rpx; font-weight: 600;
}
/* 语义色做成 token：页面不就地定义色值，只消费变量 */
.st-fatigued { background: var(--st-fatigued-bg); color: var(--st-fatigued-ink); }
.st-trained  { background: var(--st-trained-bg);  color: var(--st-trained-ink); font-weight: 800; }
.st-detrained{ background: var(--st-detrained-bg);color: var(--st-detrained-ink); }

/* ============== 历史记录 ============== */
.history {
  background: var(--white);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.history .h-row {
  display: grid;
  grid-template-columns: 1.4fr 0.8fr 0.8fr 1fr;
  align-items: center;
  padding: 27rpx 27rpx;
  font-size: 27rpx; font-weight: 600;
  color: var(--n-900);
  border-top: 1rpx solid var(--n-100);
}
.history .h-row:first-child { border-top: none; }
.history .h-row .date {
  font-family: var(--f-en);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.005em;
  color: var(--n-700);
}
.history .h-row .num {
  font-family: var(--f-en);
  font-variant-numeric: tabular-nums;
  font-weight: 700; color: var(--n-900);
}
.history .h-row .unit {
  font-family: var(--f-en);
  font-size: 21rpx; color: var(--n-500); font-weight: 600; margin-left: 6rpx;
}
.empty-hist {
  text-align: center; color: var(--n-500);
  font-size: 27rpx; padding: 60rpx 0;
}

/* ============== 底部固定栏 ============== */
.bottom-gap { height: 24rpx; }
.btn-row {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--white);
  border-top: 1rpx solid var(--n-200);
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.06);
  z-index: 1000;
}
.btn-primary.add-today {
  height: 88rpx; display: flex; align-items: center; justify-content: center;
  background: var(--primary); color: var(--primary-ink);
  border-radius: var(--r-m); font-size: 31rpx; font-weight: 700;
  box-shadow: var(--shadow-mint);
}
.btn-primary.add-today:active { opacity: 0.85; }

/* ============== 放大覆盖层 ============== */
.video-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.9);
  z-index: 1000;
  display: flex; align-items: center; justify-content: center;
}
.video-mask-player {
  width: 92vw; height: 92vw;
  border-radius: var(--r-m); background-color: #000;
}
/* @contrast-ok: 压在 .video-mask（恒定 rgba(0,0,0,.9) 全屏遮罩）上，与主题无关；
   白字压其上 ≈ 17:1，静态推算因找不到遮罩祖先而误用页面底色。 */
.video-mask-close {
  position: absolute; right: 48rpx; top: 48rpx;
  width: 76rpx; height: 76rpx; line-height: 76rpx; text-align: center;
  color: #fff; font-size: 40rpx;
  background-color: rgba(255,255,255,0.22); border-radius: 50%;
}

/* ============== 空态 ============== */
.empty { padding: 120rpx 32rpx; text-align: center; color: var(--n-500); font-size: 31rpx; }

/* ══════════════════════════════════════════════════════════════
   深色主题覆盖（.page.theme-dark）—— 手法同 home.wxss：重定义 CSS 变量
   ══════════════════════════════════════════════════════════════ */
.page.theme-dark {
  --n-50:  #0A0A0A;
  --n-100: #1E1E1E;
  --n-200: rgba(255, 255, 255, 0.10);
  --n-300: rgba(255, 255, 255, 0.16);
  --n-400: rgba(255, 255, 255, 0.30);
  --n-500: rgba(255, 255, 255, 0.42);
  --n-600: rgba(255, 255, 255, 0.55);
  --n-700: rgba(255, 255, 255, 0.75);
  --n-800: rgba(255, 255, 255, 0.88);
  --n-900: #FFFFFF;

  --text:        #FFFFFF;
  --text-sub:    rgba(255, 255, 255, 0.70);
  --text-weak:   rgba(255, 255, 255, 0.45);
  --line:        rgba(255, 255, 255, 0.10);
  --line-strong: rgba(255, 255, 255, 0.20);

  --card:      #161616;
  --white:     #161616;
  --card-gray: #1E1E1E;
  --bg:        rgba(255, 255, 255, 0.06);

  --success: #C8FF00;
  /* 语义绿「文字」档：浅色侧是 --success-text(#4C7300)，这里必须同步提亮，
     否则深色下会退回根值 #4C7300 压深绿底 = 2.85:1。同 --danger-text 的规矩。 */
  --success-text: #C8FF00;
  /* 浅色值 token 必须跟着翻，否则深色下会「半边翻、半边不翻」而糊掉：
     本页 .title-block .tag 是 --primary-tint 底 + --success-text 字。
     --success-text 上面已翻成 #C8FF00（亮绿），若 --primary-tint 不翻仍是 #F2FFD6（极浅绿），
     就成了亮绿字压浅绿底 —— 实测仅 1.13:1，几乎看不见。
     补上这行后底变 #2B3213（≈深墨绿），对比度回到 11.32:1。
     教训：**成对的 token 必须成对翻**，只翻字侧比不翻更糟。 */
  --primary-tint: rgba(200, 255, 0, 0.12);

  /* 肌群三态色：深色侧提亮为「深底 + 亮字」。
     ⚠️ 下面每一组都必须与 app.wxss 里的浅色侧**成对**翻转（--st-*-bg 与 --st-*--ink 同翻），
        只翻字侧或只翻底侧都会变成深底深字 / 浅底浅字。
     实测深色侧：fatigued 8.33:1 · trained 5.43:1 · detrained 6.42:1，均 ≥4.5:1。
     ⚠️ --st-trained-bg 例外：品牌亮绿是全库唯一不随主题翻转的颜色（绿底字恒 #0A0A0A），
        所以深色侧 bg 保持 #C8FF00、ink 保持 #0A0A0A —— 这一对**不需要翻**。 */
  --st-fatigued-bg:  #5A2415;   --st-fatigued-ink:  #FFC8B0;
  --st-detrained-bg: #0C447C;   --st-detrained-ink: #B5D4F4;

  background: var(--n-50);
  color: var(--text);
}
.page.theme-dark .card { box-shadow: none; }
