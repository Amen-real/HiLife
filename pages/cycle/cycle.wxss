/* pages/cycle/cycle.wxss —— 周期规划页（Phase 2） */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-deep) 0%, var(--primary) 12%, var(--primary-tint) 38%, #FFF1E8 100%);
  padding: 0 0 24rpx;
  box-sizing: border-box;
}
.bottom-gap { height: 48rpx; }

/* 顶栏 */
.topbar {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 28rpx 32rpx 16rpx;
}
.tb-title { font-size: var(--fs-section); font-weight: 800; color: #0A0A0A; }
/* 副标题压在页面顶部亮绿渐变（--primary-deep → --primary → --primary-tint）上，
   白字对比度不足 1.2:1 几乎不可见 → 改半透明深墨，最亮处仍有 5.4:1 */
.tb-sub { font-size: var(--fs-caption); color: rgba(10, 10, 10, 0.62); }

/* 当前周期进度 */
.prog {
  margin: 8rpx 32rpx 8rpx;
  padding: 28rpx 28rpx 20rpx;
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
  border-radius: 32rpx;
  box-shadow: var(--shadow-card);
}
.prog-top { display: flex; align-items: center; justify-content: space-between; }
.prog-name { font-size: var(--fs-title); font-weight: 800; color: var(--text); }
.prog-week { font-size: var(--fs-body); font-weight: 700; color: var(--primary-text); }
.prog-phase { margin-top: 12rpx; display: flex; flex-direction: column; gap: 4rpx; }
.prog-phase-label { font-size: var(--fs-body); font-weight: 700; color: var(--primary-text); }
.prog-phase-intent { font-size: var(--fs-caption); color: var(--text-sub); line-height: 1.5; }
.prog-rx { display: flex; gap: 12rpx; margin-top: 20rpx; }
.prog-rx-item {
  flex: 1;
  background: var(--bg);
  border-radius: 18rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}
.prog-rx-v { font-size: var(--fs-title); font-weight: 800; color: var(--text); font-feature-settings: "tnum"; }
.prog-rx-k { font-size: var(--fs-caption); color: var(--text-weak); margin-top: 4rpx; }
.prog-go {
  margin-top: 20rpx;
  text-align: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--primary-text);
  background: var(--primary-tint);
  border-radius: 18rpx;
  padding: 18rpx 0;
}

/* 模板区标题 */
.rec-head { padding: 24rpx 32rpx 8rpx; }
.rec-title { font-size: var(--fs-head); font-weight: 800; color: var(--text); }
.rec-sub { font-size: var(--fs-caption); color: var(--text-sub); margin-top: 4rpx; }

/* 周期卡片 */
.cyc-card {
  margin: 16rpx 32rpx;
  padding: 28rpx 28rpx 24rpx;
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
  border-radius: 32rpx;
  box-shadow: var(--shadow-card);
}
.cyc-name { font-size: var(--fs-title); font-weight: 800; color: var(--text); }
.cyc-tags { display: flex; gap: 12rpx; margin-top: 12rpx; }
.cyc-tag {
  font-size: var(--fs-caption);
  color: var(--primary-text);
  background: var(--primary-tint);
  border: 1rpx solid rgba(46, 207, 176, 0.30);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.cyc-desc {
  font-size: var(--fs-body);
  color: var(--text-sub);
  line-height: 1.6;
  margin-top: 16rpx;
}

/* 阶段时间轴 */
.cyc-phases {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  overflow-x: auto;
}
.cyc-phase {
  flex: 1 0 auto;
  min-width: 150rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: var(--bg);
  border-radius: 18rpx;
  padding: 16rpx;
}
.cyc-phase-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: var(--primary); margin-top: 8rpx; flex-shrink: 0;
}
.cyc-phase-label { font-size: var(--fs-body); font-weight: 700; color: var(--text); }
.cyc-phase-week { font-size: var(--fs-caption); color: var(--text-weak); margin-top: 4rpx; }

/* 处方 RPE 走势 */
.cyc-spark { margin-top: 20rpx; }
.cyc-spark-label { font-size: var(--fs-caption); color: var(--text-weak); }
.cyc-spark-bars {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  height: 120rpx;
  margin-top: 10rpx;
}
.cyc-spark-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}
.cyc-spark-bar {
  width: 60%;
  background: linear-gradient(180deg, var(--primary), var(--primary-deep));
  border-radius: 8rpx 8rpx 0 0;
  min-height: 6rpx;
}
.cyc-spark-val {
  font-size: var(--fs-mini);
  color: var(--text-weak);
  margin-top: 6rpx;
  font-feature-settings: "tnum";
}

/* 导入按钮 */
.cyc-import {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  background: var(--primary);
  color: #0A0A0A;
  font-size: var(--fs-head);
  font-weight: 700;
  box-shadow: var(--shadow-mint);
}
.cyc-import::after { border: none; }
.cyc-import-press { opacity: 0.85; }
