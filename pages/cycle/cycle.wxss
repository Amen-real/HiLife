/* pages/cycle/cycle.wxss —— 周期规划页（Phase 2） */
.page {
  min-height: 100vh;
  background: var(--n-50);          /* 暖白底，与全站一致；旧「青绿→桃色」竖渐变已弃用 */
  padding: 0 0 24rpx;
  box-sizing: border-box;
  /* 品牌绿描边：浅色用深绿 alpha，深色块内翻成亮绿 alpha（否则深色下发暗浑浊） */
  --tag-line: rgba(124, 184, 0, 0.30);
}
.bottom-gap { height: 48rpx; }

/* 顶栏 */
.topbar {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 28rpx 32rpx 16rpx;
}
/* 必须走 var(--text)：旧版页面底是亮绿渐变，才敢硬编码 #0A0A0A；
   现在浅色底是暖白、深色底是 #0A0A0A，硬编码黑字会让深色模式整条标题黑底黑字不可见 */
.tb-title { font-size: var(--fs-section); font-weight: 800; color: var(--text); }
.tb-sub { font-size: var(--fs-caption); color: var(--text-sub); }

/* 当前周期进度 */
.prog {
  margin: 8rpx 32rpx 8rpx;
  padding: 28rpx 28rpx 20rpx;
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
  border-radius: 32rpx;
  box-shadow: var(--shadow-card);
}
.prog-top { display: flex; align-items: center; justify-content: space-between; }
.prog-name { font-size: var(--fs-title); font-weight: 800; color: var(--text); }
.prog-week { font-size: var(--fs-body); font-weight: 700; color: var(--primary-text); }
.prog-phase { margin-top: 12rpx; display: flex; flex-direction: column; gap: 4rpx; }
.prog-phase-label { font-size: var(--fs-body); font-weight: 700; color: var(--primary-text); }
.prog-phase-intent { font-size: var(--fs-caption); color: var(--text-sub); line-height: 1.5; }
.prog-rx { display: flex; gap: 12rpx; margin-top: 20rpx; }
.prog-rx-item {
  flex: 1;
  background: var(--bg);
  border-radius: 18rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}
.prog-rx-v { font-size: var(--fs-title); font-weight: 800; color: var(--text); font-feature-settings: "tnum"; }
.prog-rx-k { font-size: var(--fs-caption); color: var(--text-weak); margin-top: 4rpx; }
.prog-go {
  margin-top: 20rpx;
  text-align: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--primary-text);
  background: var(--primary-tint);
  border-radius: 18rpx;
  padding: 18rpx 0;
}

/* 模板区标题 */
.rec-head { padding: 24rpx 32rpx 8rpx; }
.rec-title { font-size: var(--fs-head); font-weight: 800; color: var(--text); }
.rec-sub { font-size: var(--fs-caption); color: var(--text-sub); margin-top: 4rpx; }

/* 周期卡片 */
.cyc-card {
  margin: 16rpx 32rpx;
  padding: 28rpx 28rpx 24rpx;
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
  border-radius: 32rpx;
  box-shadow: var(--shadow-card);
}
.cyc-name { font-size: var(--fs-title); font-weight: 800; color: var(--text); }
.cyc-tags { display: flex; gap: 12rpx; margin-top: 12rpx; }
.cyc-tag {
  font-size: var(--fs-caption);
  color: var(--primary-text);
  background: var(--primary-tint);
  border: 1rpx solid var(--tag-line);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.cyc-desc {
  font-size: var(--fs-body);
  color: var(--text-sub);
  line-height: 1.6;
  margin-top: 16rpx;
}

/* 阶段时间轴 */
.cyc-phases {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  overflow-x: auto;
}
.cyc-phase {
  flex: 1 0 auto;
  min-width: 150rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: var(--bg);
  border-radius: 18rpx;
  padding: 16rpx;
}
.cyc-phase-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: var(--primary); margin-top: 8rpx; flex-shrink: 0;
}
.cyc-phase-label { font-size: var(--fs-body); font-weight: 700; color: var(--text); }
.cyc-phase-week { font-size: var(--fs-caption); color: var(--text-weak); margin-top: 4rpx; }

/* 处方 RPE 走势 */
.cyc-spark { margin-top: 20rpx; }
.cyc-spark-label { font-size: var(--fs-caption); color: var(--text-weak); }
.cyc-spark-bars {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  height: 120rpx;
  margin-top: 10rpx;
}
.cyc-spark-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}
.cyc-spark-bar {
  width: 60%;
  background: linear-gradient(180deg, var(--primary), var(--primary-deep));
  border-radius: 8rpx 8rpx 0 0;
  min-height: 6rpx;
}
.cyc-spark-val {
  font-size: var(--fs-mini);
  color: var(--text-weak);
  margin-top: 6rpx;
  font-feature-settings: "tnum";
}

/* 导入按钮 */
.cyc-import {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  background: var(--primary);
  color: #0A0A0A;
  font-size: var(--fs-head);
  font-weight: 700;
  box-shadow: var(--shadow-mint);
}
.cyc-import::after { border: none; }
.cyc-import-press { opacity: 0.85; }

/* ══════════════════════════════════════════════════════════════
   深色主题覆盖（.page.theme-dark）—— 手法同 home.wxss：重定义 CSS 变量
   ══════════════════════════════════════════════════════════════ */
.page.theme-dark {
  --n-50:  #0A0A0A;
  --n-100: #1E1E1E;
  --n-200: rgba(255, 255, 255, 0.10);
  --n-300: rgba(255, 255, 255, 0.16);
  --n-400: rgba(255, 255, 255, 0.30);
  --n-500: rgba(255, 255, 255, 0.42);
  --n-600: rgba(255, 255, 255, 0.55);
  --n-700: rgba(255, 255, 255, 0.75);
  --n-800: rgba(255, 255, 255, 0.88);
  --n-900: #FFFFFF;

  --text:        #FFFFFF;
  --text-sub:    rgba(255, 255, 255, 0.70);
  --text-weak:   rgba(255, 255, 255, 0.45);
  --line:        rgba(255, 255, 255, 0.10);
  --line-strong: rgba(255, 255, 255, 0.20);

  --card:      #161616;
  --white:     #161616;
  --card-gray: #1E1E1E;
  --bg:        rgba(255, 255, 255, 0.06);

  --success: #C8FF00;

  /* 绿色文字：浅色用的深橄榄绿在黑底上只有 3.8:1，翻成品牌亮绿 */
  --primary-text: #C8FF00;
  /* 浅绿底（#F2FFD6）必须一起翻，否则亮绿字压浅绿底会糊成一片 */
  --primary-tint: rgba(200, 255, 0, 0.12);
  /* 标签描边同步翻成亮绿 */
  --tag-line: rgba(200, 255, 0, 0.30);

  background: var(--n-50);
  color: var(--text);
}
.page.theme-dark .card { box-shadow: none; }
