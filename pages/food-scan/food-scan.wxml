<!-- pages/food-scan/food-scan.wxml —— 拍照识别（对齐 08-拍照识别 / 09-食物识别结果） -->
<view class="page {{theme}} {{view === 'result' ? 'page-result' : 'page-dark'}}">

  <!-- ============== 取景态（08）：live camera + cover-view 覆盖层 ============== -->
  <block wx:if="{{view === 'camera'}}">
    <camera wx:if="{{!camError}}" class="cam" device-position="back" flash="{{flash ? 'torch' : 'off'}}" binderror="onCamError">
      <!-- 顶部：返回 + 闪光灯。⚠️ 这一行**必须**吃 navInsetStyle：
           闪光灯靠右，而它正好落在微信系统胶囊（「··· ⊙」）那一格 ——
           不让位就是两者重叠，闪光灯被系统胶囊截走触摸、完全点不到。
           注：本行用的是 cover-view（camera 是原生组件），cover-view 支持 style。 -->
      <cover-view class="cam-top" style="{{navInsetStyle}}">
        <cover-view class="cam-top-btn" bindtap="goBack">‹</cover-view>
        <cover-view class="cam-flash {{flash ? 'on' : ''}}" bindtap="toggleFlash">⚡</cover-view>
      </cover-view>

      <cover-view class="cam-hint">请将食物置于取景框内</cover-view>

      <!-- 底部：相册 / 快门 / 识别历史 -->
      <cover-view class="cam-bar">
        <cover-view class="side-btn" bindtap="pickAlbum">
          <cover-view class="side-ico">相册</cover-view>
        </cover-view>
        <cover-view class="shutter" bindtap="takePhoto">
          <cover-view class="shutter-core"></cover-view>
        </cover-view>
        <cover-view class="side-btn" bindtap="openHistory">
          <cover-view class="side-ico">历史</cover-view>
        </cover-view>
      </cover-view>
    </camera>

    <!-- 相机不可用（权限被拒等）：引导去设置 / 相册兜底 -->
    <view wx:else class="cam-error">
      <view class="ce-title">相机不可用</view>
      <view class="ce-sub">需要相机权限才能拍照识别食物</view>
      <view class="ce-btns">
        <view class="ce-btn ghost" bindtap="openSetting">去开启权限</view>
        <view class="ce-btn primary" bindtap="pickAlbum">从相册选图</view>
      </view>
    </view>
  </block>

  <!-- ============== 识别中 ============== -->
  <!-- 这一页的三件事：① 转圈证明程序活着；② anSec/anTip 每秒更新，证明**它在推进**；
       ③ 一个「取消」出口 —— 轮询窗口最长 70s，没有出口就是把用户困住，
       而慢速档文案里写着「可以返回后手动填写热量」，那就成了一句实现不了的承诺。 -->
  <view wx:elif="{{view === 'analyzing'}}" class="analyzing">
    <view class="an-ring"></view>
    <view class="an-text">AI 识别中…</view>
    <view class="an-sub">{{anTip}}</view>
    <view class="an-sec" wx:if="{{anSec >= 3}}">已等待 {{anSec}} 秒</view>
    <view class="an-cancel" bindtap="cancelAnalyze">取消</view>
  </view>

  <!-- ============== 识别历史 ============== -->
  <view wx:elif="{{view === 'history'}}" class="hist">
    <view class="status-spacer" style="{{statusBarStyle}}"></view>
    <!-- ⚠️ navInsetStyle 见 utils/navMetrics.js：本行「清空」靠右，必须给系统胶囊让位 -->
    <view class="h-nav" style="{{navInsetStyle}}">
      <view class="h-back" bindtap="goBack"><view class="ico ico-arrowleft ico--ink" style="width:40rpx;height:40rpx"></view></view>
      <view class="h-title">识别历史</view>
      <view class="h-clear" bindtap="clearHistory" wx:if="{{history.length}}">清空</view>
    </view>
    <scroll-view scroll-y class="h-scroll">
      <view class="h-item" wx:for="{{history}}" wx:key="ts" data-idx="{{index}}" bindtap="onPickHistory">
        <view class="h-info">
          <view class="h-name">{{item.name}}</view>
          <view class="h-meta">置信度 {{item.conf || '—'}}</view>
        </view>
        <view class="h-kcal">{{item.kcal == null ? '—' : item.kcal}} <text class="h-unit">kcal</text></view>
      </view>
      <view wx:if="{{!history.length}}" class="h-empty">还没有识别记录，拍一张试试</view>
    </scroll-view>
  </view>

  <!-- ============== 识别结果（09） ============== -->
  <view wx:elif="{{view === 'result'}}" class="result">
    <view class="status-spacer" style="{{statusBarStyle}}"></view>
    <!-- ⚠️ navInsetStyle 见 utils/navMetrics.js：本行「完成」靠右，必须给系统胶囊让位。
         漏掉这一处 = 用户点「完成」时点到微信的「··· ⊙」（2026-09-29 真机复现）。 -->
    <view class="r-nav" style="{{navInsetStyle}}">
      <view class="r-back" bindtap="backToCamera"><view class="ico ico-arrowleft ico--ink" style="width:40rpx;height:40rpx"></view></view>
      <view class="r-done" bindtap="saveAndExit">完成</view>
    </view>

    <scroll-view scroll-y class="r-scroll">
      <view class="r-title" bindtap="editName">
        <text>{{photo.name}}</text>
        <text class="r-title-tag" wx:if="{{photo.canEdit}}">改</text>
      </view>
      <view class="r-conf">
        <text>识别置信度: {{photo.confText}}</text>
        <text class="r-badge" wx:if="{{photo.reused}}">已套用你的修正值</text>
        <text class="r-badge" wx:if="{{photo.edited}}">已修正</text>
      </view>

      <!-- A3 低置信度引导：主动说「这个数不可信」，而不是让用户自己去猜。
           紧挨着置信度那一行 —— 它解释的就是上面那个数。 -->
      <view class="r-alert" wx:if="{{photo.lowConf}}">
        <text class="r-alert-t">置信度偏低，下面的数值可能不准</text>
        <text class="r-alert-s" bindtap="gotoManualHint">怎么手动录入 ›</text>
      </view>

      <!-- 食物照片 -->
      <view class="r-photo-card">
        <image wx:if="{{photo.img}}" class="r-photo" src="{{photo.img}}" mode="aspectFill" />
        <view wx:else class="r-photo-ph">历史记录不保留原图</view>
      </view>

      <!-- 营养成分（估算）—— A3：每一行都可点改 -->
      <view class="r-card">
        <view class="r-card-head">
          <text class="r-card-title">营养成分（估算）</text>
          <text class="r-unit" wx:if="{{photo.weight}}">单位（每份{{photo.weight}}g）</text>
        </view>
        <view class="r-hint" wx:if="{{photo.canEdit}}">点任意数值即可修改 · 改过就会被记住，下次同款自动带出</view>
        <!-- ⚠️ 本行的事件名必须**静态**。若把事件名写成 Mustache 动态串，
             整串会被当成字面量事件名 → 点击静默无反应且不报错。
             可否编辑一律由 JS 内的 canEdit 判断。
             注：守卫 verify-event-binding.cjs 是**逐字扫源码**的，
             所以这里刻意不把那个动态写法本身写出来 —— 否则连注释都会被判违规。 -->
        <view class="r-nutri">
          <view class="r-nutri-row" wx:for="{{photo.nutri}}" wx:key="k"
                data-field="{{item.k}}" bindtap="editNum"
                hover-class="{{photo.canEdit ? 'r-nutri-hover' : 'none'}}">
            <view class="dot {{item.dot}}"></view>
            <text class="r-n-name">{{item.label}}</text>
            <view class="r-n-right">
              <text class="r-n-val {{photo.canEdit ? 'can-edit' : ''}}">{{item.val == null ? '—' : item.val}} {{item.unit}}</text>
              <text class="r-n-tag" wx:if="{{photo.canEdit}}">改</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 包含食物 -->
      <view class="r-card" wx:if="{{photo.items.length}}">
        <view class="r-card-head"><text class="r-card-title">包含食物</text></view>
        <view class="r-food" wx:for="{{photo.items}}" wx:key="name">
          <view class="r-food-name">{{item.name}}</view>
          <view class="r-food-weight">{{item.weight}}</view>
        </view>
      </view>

      <view class="r-note">⚠ 识别结果仅供参考，请以实际为准</view>
      <!-- 知识库状态：不给它一个位置，「纠正被记住了」这件事就是不可见的魔法 -->
      <view class="r-kb" wx:if="{{kbSize}}">本地知识库已记 {{kbSize}} 条 · 本周省下 {{kbSaved}} 次 AI 识别</view>
      <view class="r-bottom-gap"></view>
    </scroll-view>

    <!-- 底部操作：重新识别 / 加入记录 -->
    <view class="r-foot">
      <view class="r-btn ghost" bindtap="backToCamera">重新识别</view>
      <view class="r-btn primary" bindtap="saveAndExit">加入记录</view>
    </view>
  </view>
</view>
