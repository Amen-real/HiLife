/* pages/food-scan/food-scan.wxss —— 拍照识别（对齐 08-拍照识别 / 09-食物识别结果 设计稿） */

.page { min-height: 100vh; position: relative; }
.page-dark { background: #0A0A0A; }
.page-result { background: var(--n-50); }
/* 状态栏占位。⚠️ flex 子项默认 flex-shrink:1 —— 本页它是落在 .result / .hist
   （display:flex; flex-direction:column）里的，容器一旦溢出，这 44px 会被压缩成 ~0，
   顶部「返回 / 完成」直接钻进手机状态栏里，**连点都点不到**（状态栏区域归系统，
   触摸事件根本不下发给 WebView）。2026-09-29 真机复现。
   ⇒ 必须显式钉死不可压缩。
   对照：home 的 .page-body / profile 的 .p-hero-body 都只是普通块级流，
   占位块天然不会被压 —— 那条路径只是「恰好安全」，不是本题的解法。 */
.status-spacer { width: 100%; flex: 0 0 auto; }

/* ==================== 取景态（08） ====================
   ⚠️ camera 是原生组件，覆盖物全部用 cover-view：
   只支持基础样式（定位/尺寸/背景色/边框/圆角/文字），不支持 transform /
   伪元素 / mask 图标 / 渐变，图标用文字字形或纯 CSS 圆环。 */
.cam { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }

/* ⚠️ 本行**必须**吃 camRowStyle（见 utils/navMetrics.js），它同时管两件事：
   ① 横向 —— 闪光灯靠右，正落在微信系统胶囊（「··· ⊙」更多/关闭）那一格。
      胶囊是微信自己渲染的：不进布局树、不参与 flex、z-index 压不住 —— 不让位就是
      「闪光灯压在胶囊上」，触摸被系统截走 ⇒ 按钮完全点不到。2026-09-29 真机复现。
   ② 纵向 —— 本行是 <camera> 上的**绝对定位覆盖层**，脱离文档流，
      `top` 与 `height` 都得自己带（这也是它与 .r-nav / .h-nav 唯一的形态差别）。
   下面这组是 **onLoad 注入前的兜底值**（44px 是微信自定义导航的典型值，不是真值），真值由 camRowStyle 覆盖。
   ⚠️ 配套两条硬约束，少一条就白算：
     · `box-sizing: border-box` —— 否则行内 `height` 是**内容盒**高，加上 padding 后总高 ≠ 导航带；
     · **竖向 padding 必须为 0** —— 内容居中靠 `align-items: center`，留 padding 会把内容挤偏。
   历史坑（2026-09-29 真机）：这里原来是 `padding: 90rpx 36rpx 0` —— 手调常量摆位，
   390×47 机型上内容中线 65.5px、胶囊中线 69px ⇒ 按钮**偏上 3.5px**，一眼看出没对齐。 */
.cam-top {
  position: absolute; top: 44px; left: 0; right: 0;
  height: 44px; box-sizing: border-box;
  padding: 0 36rpx;
  display: flex; flex-direction: row; align-items: center; justify-content: space-between;
}
/* @contrast-ok: 纸底是 <camera> 实时取景画面（非页面/卡片底色），静态推算会把白字压白纸判成 1:1。
   实际是「半透明白胶囊 + 白字形压在取景画面上」，业界相机 UI 的标准做法。 */
.cam-top-btn {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background-color: rgba(255,255,255,0.14);
  color: #FFFFFF; font-size: 52rpx; line-height: 66rpx; text-align: center;
}
/* @contrast-ok: 同上，压在取景画面上；未点亮态本就该是弱化字形。 */
.cam-flash {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background-color: rgba(255,255,255,0.14);
  color: rgba(255,255,255,0.55); font-size: 36rpx; text-align: center; line-height: 72rpx;
}
.cam-flash.on { background-color: #C8FF00; color: #0A0A0A; }

.cam-hint {
  position: absolute; left: 0; right: 0; top: 22vh;
  margin-top: 660rpx;
  text-align: center; color: rgba(255,255,255,0.85);
  font-size: 26rpx; letter-spacing: 0.05em;
}

/* 底部操作：相册 / 快门 / 识别历史 */
.cam-bar {
  position: absolute; left: 0; right: 0; bottom: 150rpx;
  padding: 0 110rpx;
  display: flex; flex-direction: row; align-items: center; justify-content: space-between;
}
.side-btn {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background-color: rgba(255,255,255,0.16);
}
.side-ico {
  width: 96rpx; height: 96rpx; line-height: 96rpx; text-align: center;
  color: #FFFFFF; font-size: 24rpx;
}
.shutter {
  width: 150rpx; height: 150rpx; border-radius: 50%;
  border: 8rpx solid #FFFFFF;
  display: flex; align-items: center; justify-content: center;
}
.shutter-core { width: 112rpx; height: 112rpx; border-radius: 50%; background-color: #C8FF00; }
.cam-bar-labels {
  position: absolute; left: 0; right: 0; bottom: 96rpx;
  padding: 0 110rpx;
  display: flex; flex-direction: row; align-items: center; justify-content: space-between;
}
.side-label {
  width: 96rpx; text-align: center;
  color: rgba(255,255,255,0.75); font-size: 22rpx;
}
.side-label.mid { width: 150rpx; }

/* 相机不可用兜底 */
.cam-error {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: #0A0A0A;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 0 64rpx;
}
.ce-title { color: #FFFFFF; font-size: 36rpx; font-weight: 700; }
.ce-sub { color: rgba(255,255,255,0.55); font-size: 26rpx; margin-top: 14rpx; }
.ce-btns { display: flex; flex-direction: row; gap: 24rpx; margin-top: 56rpx; }
.ce-btn { height: 80rpx; line-height: 80rpx; padding: 0 40rpx; border-radius: 999rpx; font-size: 28rpx; font-weight: 600; }
.ce-btn.ghost { border: 2rpx solid rgba(255,255,255,0.35); color: #FFFFFF; }
.ce-btn.primary { background: #C8FF00; color: #0A0A0A; }

/* ==================== 识别中 ==================== */
.analyzing {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: #0A0A0A;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.an-ring {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  border: 8rpx solid rgba(200,255,0,0.2); border-top-color: #C8FF00;
  animation: an-spin 0.9s linear infinite;
}
@keyframes an-spin { to { transform: rotate(360deg); } }
.an-text { color: #FFFFFF; font-size: 32rpx; font-weight: 700; margin-top: 36rpx; }
.an-sub { color: rgba(255,255,255,0.5); font-size: 24rpx; margin-top: 12rpx; }
/* 已等待秒数。**3s 之后才出现**：模型常在 3s 内就出结果，
   一上来就顶着「已等待 1 秒」等于把正常速度说成慢。
   本页背景是写死的 #0A0A0A（不随主题翻转），所以白透明度即最终色：
   rgba(255,255,255,.52) ≈ #898989，对 #0A0A0A ≈ 5.7:1，过 AA。 */
.an-sec {
  color: rgba(255,255,255,0.52); font-size: 22rpx; margin-top: 10rpx;
  font-variant-numeric: tabular-nums;   /* 数字等宽，秒数跳动时不会左右抖 */
}
/* 出口。rgba(255,255,255,.60) ≈ #9C9C9C，对 #0A0A0A ≈ 7.3:1；边框只是装饰（非文本）。 */
.an-cancel {
  margin-top: 56rpx; padding: 16rpx 48rpx; border-radius: 999rpx;
  border: 2rpx solid rgba(255,255,255,0.24);
  color: rgba(255,255,255,0.60); font-size: 26rpx;
}

/* ==================== 识别历史 ==================== */
.hist {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: #0A0A0A;
  display: flex; flex-direction: column;
}
/* 导航行同样不许被压缩：它是全屏唯一的返回出口（同 training-review 的
   .sc-cancel「绝不许被挤掉」）。
   行高由 navRowStyle 注入 = 导航带 = 2×(胶囊上沿 − 状态栏) + 胶囊高 ⇒ **与胶囊同心**
   （返回/清空必须和胶囊在同一条中线上，用户 2026-09-29 真机报的就是这条没对上）。
   44px 是注入前的兜底典型值。⚠️ 同样要求 `box-sizing:border-box` + 竖向 padding 归零。
   代价：行高被钉死成导航带（比原来含 16rpx 上下 padding 的 ~50px 略矮），
   且 padding-right 变大 ⇒ .h-title 的 flex:1 可分配宽度变小、标题视觉中心略左移。
   两者都是**必须付的**：换来的是这一行与胶囊对齐、且「清空」真的点得到。 */
.h-nav {
  display: flex; flex-direction: row; align-items: center;
  flex: 0 0 auto;
  height: 44px; box-sizing: border-box;
  padding: 0 32rpx;
}
.h-back {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: rgba(255,255,255,0.12);
  display: flex; align-items: center; justify-content: center;
}
.h-back .ico-arrowleft { background-color: #FFFFFF; }
.h-title { flex: 1; text-align: center; color: #FFFFFF; font-size: 34rpx; font-weight: 700; }
.h-clear { color: rgba(255,255,255,0.6); font-size: 26rpx; padding: 8rpx 0 8rpx 24rpx; }
/* scroll-view 作为纵向 flex 子项时必须能收缩 —— min-height:0 是这条约束的开关。
   不加的后果（2026-09-29 真机）：它按**内容**高度撑开、顶破 .result，
   溢出的负空间由可压缩的兄弟（状态栏占位、导航行）按「shrink × 内容尺寸」分摊，
   于是顶部被压到状态栏里；同时因为自身高度 == 内容高度，**内部滚动也失效**，
   结果卡片的底部内容根本滚不到。
   这与 workout.wxss 的 .repl-body（flex:1; min-height:0）是同一套写法。 */
.h-scroll { flex: 1; min-height: 0; padding: 8rpx 32rpx 60rpx; box-sizing: border-box; }
.h-item {
  display: flex; flex-direction: row; align-items: center; justify-content: space-between;
  background: rgba(255,255,255,0.07); border-radius: 24rpx;
  padding: 26rpx 30rpx; margin-bottom: 18rpx;
}
.h-name { color: #FFFFFF; font-size: 30rpx; font-weight: 600; }
.h-meta { color: rgba(255,255,255,0.45); font-size: 22rpx; margin-top: 8rpx; }
.h-kcal { color: #C8FF00; font-size: 34rpx; font-weight: 800; }
.h-unit { color: rgba(255,255,255,0.45); font-size: 22rpx; font-weight: 400; }
.h-empty { color: rgba(255,255,255,0.4); text-align: center; padding: 120rpx 0; font-size: 26rpx; }

/* ==================== 识别结果（09，浅色） ==================== */
.result {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: var(--n-50);
  display: flex; flex-direction: column;
}
/* 行高 + 右侧内缩由 navRowStyle 注入（见 .h-nav 与 .cam-top 的说明，两条约束同样适用：
   `box-sizing:border-box` + 竖向 padding 归零；44px 是注入前的兜底典型值）。
   本行无居中标题，所以让位与钉高都只有收益、没有 .h-nav 那点标题偏移的代价。 */
.r-nav {
  display: flex; flex-direction: row; align-items: center; justify-content: space-between;
  flex: 0 0 auto;          /* 见 .h-nav 说明 */
  height: 44px; box-sizing: border-box;
  padding: 0 32rpx;
}
.r-back {
  width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--n-100);
  display: flex; align-items: center; justify-content: center;
}
.r-back .ico-arrowleft { background-color: var(--n-700); }
/* 「完成」——本行靠右控件，胶囊让位的受益者。「返回」在左侧，不受影响
   （胶囊只贴右，左侧无系统遮挡）。 */
.r-done {
  height: 60rpx; line-height: 60rpx; padding: 0 32rpx;
  background: var(--primary); color: #0A0A0A;
  border-radius: 999rpx; font-size: 26rpx; font-weight: 700;
}
/* 见 .h-scroll 的说明（同一条约束，别漏改这一个）。 */
.r-scroll { flex: 1; min-height: 0; padding: 0 32rpx; box-sizing: border-box; }
.r-title { font-size: 44rpx; font-weight: 800; color: var(--n-900); letter-spacing: -0.01em; line-height: 1.25; }
.r-conf { color: var(--text-weak); font-size: 24rpx; margin-top: 10rpx; }

.r-photo-card {
  margin-top: 26rpx; height: 420rpx; border-radius: 32rpx; overflow: hidden;
  background: var(--n-100);
}
.r-photo { width: 100%; height: 100%; }
.r-photo-ph {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-weak); font-size: 26rpx;
}

.r-card {
  margin-top: 26rpx; background: var(--card);
  border: 1rpx solid var(--n-200); border-radius: 28rpx; padding: 28rpx 30rpx;
}
.r-card-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.r-card-title { font-size: 30rpx; font-weight: 800; color: var(--n-900); }
.r-unit { font-size: 22rpx; color: var(--text-weak); }

.r-nutri { margin-top: 10rpx; }
.r-nutri-row {
  display: flex; flex-direction: row; align-items: center;
  /* 左右各 16rpx 内缩 + 负外边距：视觉不变，但 hover 底色有地方铺开 */
  padding: 18rpx 16rpx; margin: 0 -16rpx; border-radius: 16rpx;
}
.r-nutri-hover { background: var(--n-200); }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 18rpx; }
.dot-kcal { background: #B7E600; }
.dot-pro { background: #FF9500; }
.dot-carb { background: #34C759; }
.dot-fat { background: #F2545B; }
.r-n-name { flex: 1; font-size: 28rpx; color: var(--n-700); }
.r-n-right { display: flex; flex-direction: row; align-items: center; }
.r-n-val { font-size: 30rpx; font-weight: 800; color: var(--n-900); font-feature-settings: "tnum"; }
/* 「这里能点」的线索：数值下加虚线底。纯装饰，不承担信息 */
.r-n-val.can-edit { border-bottom: 2rpx dashed var(--n-300); padding-bottom: 2rpx; }

/* ── A3：结果纠错 ───────────────────────────────────────────── */
/* 「改」标（标题旁 / 每行数值旁）。底色 --n-200 + 字色 --n-700：
   浅 #E8E8E4/#444 7.9:1，深 rgba(255,255,255,.10)/rgba(255,255,255,.75) ≈7.6:1，两侧都过 AA。
   ⚠️ 刻意不用 --primary-tint + --primary-text：那对是浅色专属 token，
      必须在本页 .page.theme-dark 里成对翻转才不出事 —— 为一个小方标不值得多背一处翻转头。 */
.r-n-tag {
  margin-left: 12rpx; padding: 2rpx 12rpx; border-radius: 8rpx;
  font-size: 22rpx; font-weight: 700;
  background: var(--n-200); color: var(--n-700);
}
.r-title-tag, .r-badge {
  margin-left: 14rpx; padding: 2rpx 14rpx; border-radius: 8rpx;
  font-size: 22rpx; font-weight: 700;
  background: var(--n-200); color: var(--n-700);
}
.r-hint { margin-top: 12rpx; font-size: 22rpx; color: var(--n-700); }

/* 低置信度提示。浅琥珀底 + --accent-ink 字（浅 6.1:1），
   深色底由文件底部 .page.theme-dark 换成深琥珀 + 提亮字色（8.9:1），两侧都过 AA。
   ⚠️ --accent-ink 根值 #A8380A 压深底只有 2.8:1 —— 它是「语义深字 token」，
      深色侧必须由**本页**提亮，不能指望它自己翻（见 app.wxss 的口径）。 */
.r-alert {
  margin-top: 20rpx; padding: 20rpx 24rpx;
  background: #FFF6E8; border: 2rpx solid #FFE0B2; border-radius: 20rpx;
}
.r-alert-t { display: block; font-size: 26rpx; font-weight: 700; color: var(--accent-ink); }
.r-alert-s { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--accent-ink); text-decoration: underline; }

.r-food {
  display: flex; flex-direction: row; align-items: center; justify-content: space-between;
  padding: 18rpx 0;
}
.r-food-name { font-size: 28rpx; color: var(--n-700); }
.r-food-weight { font-size: 28rpx; font-weight: 700; color: var(--n-900); font-feature-settings: "tnum"; }

.r-note { color: var(--text-weak); font-size: 22rpx; text-align: center; margin-top: 28rpx; }
/* A3：知识库状态。不给它一个位置，「纠正被记住了」就是不可见的魔法。
   用 --n-700 而不是 --text-weak —— 后者（#A0A0A0）压 --n-50 只有 2.44:1，小字读不出来
   （该 token 的门禁盲区已单独记录，见交付文档）。 */
.r-kb { color: var(--n-700); font-size: 22rpx; text-align: center; margin-top: 10rpx; }
.r-bottom-gap { height: 200rpx; }

.r-foot {
  position: absolute; left: 0; right: 0; bottom: 0;
  display: flex; flex-direction: row; gap: 24rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(247, 247, 245, 0.96);
  border-top: 1rpx solid var(--n-200);
}
.r-btn { flex: 1; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 999rpx; font-size: 30rpx; font-weight: 700; }
.r-btn.ghost { background: var(--n-100); color: var(--n-900); }
.r-btn.primary { background: var(--primary); color: #0A0A0A; }

/* ══════════════════════════════════════════════════════════════
   深色主题覆盖（.page.theme-dark）—— 手法同 home.wxss：重定义 CSS 变量
   取景态（.page-dark）本就是原生暗色设计，与主题无关；主题类主要驱动结果/历史态翻转
   ══════════════════════════════════════════════════════════════ */
.page.theme-dark {
  --n-50:  #0A0A0A;
  --n-100: #1E1E1E;
  --n-200: rgba(255, 255, 255, 0.10);
  --n-300: rgba(255, 255, 255, 0.16);
  --n-400: rgba(255, 255, 255, 0.30);
  --n-500: rgba(255, 255, 255, 0.42);
  --n-600: rgba(255, 255, 255, 0.55);
  --n-700: rgba(255, 255, 255, 0.75);
  --n-800: rgba(255, 255, 255, 0.88);
  --n-900: #FFFFFF;

  --text:        #FFFFFF;
  --text-sub:    rgba(255, 255, 255, 0.70);
  --text-weak:   rgba(255, 255, 255, 0.45);
  --line:        rgba(255, 255, 255, 0.10);
  --line-strong: rgba(255, 255, 255, 0.20);

  --card:      #161616;
  --white:     #161616;
  --card-gray: #1E1E1E;
  --bg:        rgba(255, 255, 255, 0.06);

  --success: #C8FF00;
  /* A3：语义深字 token 的深色提亮。--accent-ink 根值 #A8380A 压深底只有 2.8:1，
     而它**不会**随主题自动翻（不是「浅色面 token」）⇒ 用它的页面必须自己提亮。
     同口径：橙 → #FFC08A（与 app.wxss 的 --accent-ink 语义轴一致）。 */
  --accent-ink: #FFC08A;

  background: var(--n-50);
  color: var(--text);
}
.page.theme-dark .card { box-shadow: none; }
/* A3：低置信度提示的深色底。浅琥珀 #FFF6E8 在深色下会变成一块刺眼白卡
   （且卡内字色已提亮为 #FFC08A，白底上只剩 1.6:1）⇒ 必须换深琥珀。 */
.page.theme-dark .r-alert {
  background: rgba(255, 149, 0, 0.14);
  border-color: rgba(255, 149, 0, 0.30);
}
