/* pages/home/home.wxss —— 对齐 01-home.html（HiLiLife 设计系统）
   主题：浅色为默认样式；深色覆盖统一写在文件末尾 `.page.theme-dark` 下（由「我的 → 主题」开关切换）。 */

.page {
  padding: 0 0 calc(128rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: var(--n-50);
}

/* ============== HERO（顶部问候，纯文字，无 appbar / 无卡片背景） ============== */
.hero {
  position: relative;
  padding: 36rpx 32rpx 12rpx;
}
.hero-text {
  position: relative;
}
.hero-greet {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--n-900);            /* 浅色深字 / 深色白字，自动跟主题翻转 */
  letter-spacing: -0.02em;
  line-height: 58rpx;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  font-weight: 500;
  color: var(--n-600);            /* 次级灰，浅深主题均清晰 */
  letter-spacing: 0.01em;
}

/* ============== 通用 chevron（右箭头，CSS 绘制，无图片依赖） ============== */
.chev {
  width: 14rpx; height: 14rpx;
  border-top: 4rpx solid var(--n-500);
  border-right: 4rpx solid var(--n-500);
  transform: rotate(45deg);
  box-sizing: border-box;
}

/* ============== 1+2 打卡合并卡 ============== */
.checkin-group { padding: 0; overflow: hidden; }
.checkin {
  padding: 31rpx 35rpx;
  display: flex; align-items: center; gap: 27rpx;
  background: var(--card-gray);
}
.checkin .meta { flex: 1 1 auto; min-width: 0; }
.checkin .label { font-size: 23rpx; font-weight: 600; color: var(--n-600); }
.checkin .val {
  margin-top: 12rpx;
  font-family: var(--f-en, sans-serif);
  font-size: 42rpx; font-weight: 700; line-height: 54rpx;
  letter-spacing: -0.02em;
  color: var(--n-900);
  display: flex; align-items: baseline; gap: 8rpx;
}
.checkin .val .x { font-size: 35rpx; color: var(--n-500); font-weight: 600; }
.checkin .val .total { font-size: 27rpx; color: var(--n-600); font-weight: 500; margin-left: 4rpx; }

/* 进度环（复用全局 .ring，显式尺寸） */
.checkin .ring { --size: 146rpx; --w: 15rpx; }

.stats {
  display: flex;
  border-top: 1rpx solid var(--n-200);
  padding: 27rpx 0;
  background: var(--white);
}
.stat {
  flex: 1;
  padding: 0 31rpx;
  display: flex; align-items: center; justify-content: space-between;
  gap: 8rpx;
}
.stat + .stat { border-left: 1rpx solid var(--n-200); }
.stat .label { font-size: 23rpx; color: var(--n-600); font-weight: 500; }
.stat .val {
  margin-top: 6rpx;
  font-family: var(--f-en, sans-serif);
  font-size: 42rpx; font-weight: 800; line-height: 54rpx;
  letter-spacing: -0.02em;
  color: var(--n-900);
  display: flex; align-items: baseline; gap: 4rpx;
}
.stat .val .unit { font-size: 23rpx; color: var(--n-500); font-weight: 600; margin-left: 4rpx; }
.stat .ic {
  width: 62rpx; height: 62rpx; border-radius: 19rpx;
  display: grid; place-items: center;
  flex: none;
  background: #FFF1D6;
}

/* ============== 区块标题（左内缩 32rpx 与卡片左缘对齐） ============== */
.section { padding: 0; margin: 0; }
.section-label {
  font-size: 29rpx; font-weight: 800; letter-spacing: -0.01em;
  color: var(--n-900);
  margin: 0 32rpx 20rpx;
}
.section-label.with-arrow {
  display: flex; align-items: center; justify-content: space-between;
}
.sec-arrow {
  width: 46rpx; height: 46rpx;
  display: grid; place-items: center;
  border-radius: 50%;
}

/* ============== 3 今日建议 ============== */
.suggest {
  padding: 27rpx 31rpx;
  display: flex; align-items: center; gap: 27rpx;
  background: var(--card-gray);
}
.suggest .photo {
  width: 92rpx; height: 92rpx; border-radius: 23rpx;
  background: var(--n-100);
  display: grid; place-items: center;
  flex: none;
}
.suggest .body { flex: 1 1 auto; min-width: 0; }
.suggest .body .t1 {
  font-size: 29rpx; font-weight: 700; color: var(--n-900);
  letter-spacing: -0.01em;
}
.suggest .body .t2 {
  margin-top: 8rpx;
  font-size: 23rpx; color: var(--n-600); font-weight: 500;
}
.suggest .chev { flex: none; margin-right: 4rpx; }

/* 绿色 CTA「开始训练」（浅深两色通用品牌强调） */
.suggest .cta {
  flex: none;
  background: #C8FF00;
  color: #0A0A0A;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
  display: flex; align-items: center; gap: 6rpx;
  box-shadow: 0 6rpx 18rpx rgba(200, 255, 0, 0.28);
}
.suggest .cta .arr {
  width: 10rpx; height: 10rpx;
  border-top: 3rpx solid #0A0A0A;
  border-right: 3rpx solid #0A0A0A;
  transform: rotate(45deg);
}

/* ============== 4 今日饮食 ============== */
.diet { padding: 27rpx 31rpx; }
.diet .top {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 23rpx;
}
.diet .top .num {
  font-family: var(--f-en, sans-serif);
  font-size: 42rpx; font-weight: 800; letter-spacing: -0.02em;
  line-height: 54rpx;
  color: var(--n-900);
  display: flex; align-items: baseline; gap: 8rpx;
}
.diet .top .num .target { font-size: 27rpx; color: var(--n-600); font-weight: 500; }
.diet .top .pct {
  font-family: var(--f-en, sans-serif);
  font-size: 42rpx; font-weight: 800;
  color: var(--n-900);
  letter-spacing: -0.02em;
}
.diet .progress {
  height: 12rpx; border-radius: 999rpx;
  background: var(--n-200);
  overflow: hidden;
  margin-bottom: 27rpx;
}
.diet .progress .fill {
  display: block; height: 100%;
  background: linear-gradient(90deg, #0A0A0A 0%, #2A3310 50%, #A6C24A 100%);
  border-radius: 999rpx;
  transition: width 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}
.diet .nut {
  display: flex;
}
.diet .nut .col {
  flex: 1;
  padding: 0 8rpx;
  border-right: 1rpx solid var(--n-200);
}
.diet .nut .col:last-child { border-right: none; }
.diet .nut .col.fat-col {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12rpx;
}
.diet .nut .col .name {
  font-size: 23rpx; color: var(--n-600); font-weight: 500;
}
.diet .nut .col .v {
  margin-top: 8rpx;
  font-family: var(--f-en, sans-serif);
  font-size: 25rpx; font-weight: 700; color: var(--n-900);
  letter-spacing: -0.01em;
  line-height: 36rpx;
}
.diet .nut .col .v .unit { font-size: 21rpx; color: var(--n-500); font-weight: 600; margin-left: 4rpx; }
.diet .nut .col .v.carb,
.diet .nut .col .v.carb .unit { color: var(--success); }
.diet .nut .col .v.fat,
.diet .nut .col .v.fat .unit { color: var(--orange); }
.diet .nut .nut-arrow {
  width: 46rpx; height: 46rpx; flex: none;
  display: grid; place-items: center;
  border-radius: 50%;
}

/* ============== 5 体重趋势 ============== */
.weight {
  padding: 31rpx 35rpx;
  display: flex; align-items: center; gap: 31rpx;
}
.weight .meta { flex: 1 1 auto; min-width: 0; }
.weight .meta .num {
  font-family: var(--f-en, sans-serif);
  font-size: 54rpx; font-weight: 800; line-height: 65rpx;
  letter-spacing: -0.03em;
  color: var(--n-900);
  display: flex; align-items: baseline; gap: 4rpx;
}
.weight .meta .num .unit { font-size: 27rpx; color: var(--n-600); font-weight: 600; margin-left: 8rpx; }
.weight .meta .delta {
  margin-top: 4rpx;
  display: inline-flex; align-items: center; gap: 4rpx;
  font-family: var(--f-en, sans-serif); font-size: 23rpx;
  color: var(--success); font-weight: 700;
}
.weight .meta .delta.up { color: var(--accent); }
.weight .meta .delta .arr { font-size: 20rpx; }
.weight .chart { flex: 1 1 auto; min-width: 0; }
.spark-canvas { width: 100%; height: 123rpx; display: block; }

.bottom-gap { height: 20rpx; }

/* ══════════════════════════════════════════════════════════════
   深色主题覆盖（.page.theme-dark）
   —— 由「我的 → 深色主题」开关切换，utils/theme.js 持久化到 Storage。

   核心手法：**重定义 CSS 变量**，而不是逐条覆盖属性。
   上面所有浅色样式用的都是 var(--n-900) / var(--card) / var(--line) 这类变量，
   只要在 .page.theme-dark 上把它们重定义成暗色值，整棵子树自动翻转——
   CSS 自定义属性会向下继承，连 .card（来自 app.wxss）等后代也一并生效。
   只有「硬编码颜色」和「需要换色的强调元素」才需要下面单独覆盖。

   → 新增页面支持深色的成本 ≈ 根节点挂 class + 复制这段变量重定义。
   ══════════════════════════════════════════════════════════════ */

.page.theme-dark {
  /* —— 中性灰阶反转（暖白 → 暖黑）—— */
  --n-50:  #0A0A0A;                    /* 页面底 */
  --n-100: #1E1E1E;                    /* 内嵌面 */
  --n-200: rgba(255, 255, 255, 0.10);  /* 分隔线 / 边框 */
  --n-300: rgba(255, 255, 255, 0.16);
  --n-400: rgba(255, 255, 255, 0.30);
  --n-500: rgba(255, 255, 255, 0.42);  /* 弱化文字 / chevron */
  --n-600: rgba(255, 255, 255, 0.55);  /* 次级标签 */
  --n-700: rgba(255, 255, 255, 0.75);
  --n-900: #FFFFFF;                    /* 主文字 / 主数字 */

  /* —— 语义色 —— */
  --text:        #FFFFFF;
  --text-sub:    rgba(255, 255, 255, 0.70);
  --text-weak:   rgba(255, 255, 255, 0.45);
  --line:        rgba(255, 255, 255, 0.10);
  --line-strong: rgba(255, 255, 255, 0.20);

  /* —— 表面 —— */
  --card:      #161616;                /* 主卡（app.wxss .card 自动跟着变） */
  --white:     #161616;                /* 浅色里当卡面的 --white 也转暗 */
  --card-gray: #1E1E1E;                /* 打卡 / 建议卡的浅灰底 */
  --bg:        rgba(255, 255, 255, 0.06);

  /* 成功色在暗底上太暗（#6F9F00），提亮到品牌绿：碳水量 / 体重降幅更醒目 */
  --success: #C8FF00;

  background: var(--n-50);
  color: var(--text);
}

/* —— 以下为「硬编码颜色」或「需要换色的强调元素」的单独覆盖 —— */

/* 图标：.ico--ink 默认深墨，黑底不可见 → 转白 */
.page.theme-dark .ico--ink { background-color: #FFFFFF; }

/* 卡片阴影：暗色下黑色阴影无意义，去掉 */
.page.theme-dark .card { box-shadow: none; }

/* 打卡火焰图标块：浅色是硬编码 #FFF1D6（橙调），暗色改用品牌绿淡底 */
.page.theme-dark .stat .ic { background: rgba(200, 255, 0, 0.12); }

/* 进度环：conic 轨道转半透白、进度用品牌绿、中心白字 */
.page.theme-dark .checkin .ring {
  background: conic-gradient(
    rgba(200, 255, 0, 0.20) 0%,
    #C8FF00 calc(var(--pct) * 1%),
    rgba(255, 255, 255, 0.08) calc(var(--pct) * 1%) 100%
  );
}
.page.theme-dark .checkin .ring::before { background: var(--card); }
.page.theme-dark .checkin .ring .ring-span { color: #FFFFFF; }

/* 饮食进度条填充：浅色是暗墨渐变（黑底上会整条消失），暗色改用亮绿 + 光晕 */
.page.theme-dark .diet .progress .fill {
  background: #C8FF00;
  box-shadow: 0 0 10rpx rgba(200, 255, 0, 0.5);
}
/* 完成百分比：暗色下点亮成品牌绿（对齐参考图） */
.page.theme-dark .diet .top .pct { color: #C8FF00; }

/* 脂肪量：浅色 --orange #FF9500 在黑底偏暗，提亮一档 */
.page.theme-dark .diet .nut .col .v.fat,
.page.theme-dark .diet .nut .col .v.fat .unit { color: #FFB340; }

/* —— 偏好降级：尊重系统减弱动效 —— */
@media (prefers-reduced-motion: reduce) {
  .diet .progress .fill { transition: none; }
}
