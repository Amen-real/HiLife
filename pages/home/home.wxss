/* pages/home/home.wxss —— 对齐 01-home.html（HiLiLife 设计系统）
   主题：浅色为默认样式；深色覆盖统一写在文件末尾 `.page.theme-dark` 下（由「我的 → 主题」开关切换）。 */

.page {
  padding: 0 0 calc(128rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: var(--n-50);
  position: relative;
}

/* ============== 背景图（人物铺满顶部，自定义导航栏下盖住原生标题） ============== */
.hero-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  display: block;
  z-index: 0;
  pointer-events: none;
}
.page-body {
  position: relative;
  z-index: 1;
}
/* 状态栏占位。父容器 .page-body 目前只是块级流，理论上压不到它 ——
   但仍显式钉死：占位一旦被压没，顶部就成了状态栏下面的死区。
   同页 food-scan 的 .status-spacer 就是被 flex 压成 ~0 才出的事故（2026-09-29）。 */
.status-bar-spacer { width: 100%; flex: 0 0 auto; }
.hero-top { padding: 14rpx 38rpx 4rpx; }
.brand-name {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--n-900);
  letter-spacing: -0.01em;
}

/* ============== HERO（顶部问候，纯文字，无 appbar / 无卡片背景） ============== */
.hero {
  position: relative;
  padding: 12rpx 32rpx 12rpx;
}
.hero-text {
  position: relative;
  top: 20rpx;             /* 整体下移：与品牌行拉开间距（relative 不影响下方卡片布局） */
}
.hero-greet {
  display: flex;
  flex-direction: column;          /* 问候语 / 用户名 两行纵向排列 */
  gap: 4rpx;
  font-size: 46rpx;
  font-weight: 800;
  color: var(--n-900);            /* 浅色深字 / 深色白字，自动跟主题翻转 */
  letter-spacing: -0.02em;
  line-height: 58rpx;
}
.hero-greet .greet-line { line-height: 58rpx; }
.hero-greet .user-line {
  line-height: 58rpx;
  color: var(--n-900);
}
.hero-sub {
  margin-top: 20rpx;               /* 较此前 10rpx 再下移，与问候区拉开更多呼吸位 */
  font-size: 25rpx;
  font-weight: 500;
  color: var(--n-600);            /* 次级灰，浅深主题均清晰 */
  letter-spacing: 0.01em;
}

/* ============== 通用 chevron（右箭头，CSS 绘制，无图片依赖） ============== */
.chev {
  width: 14rpx; height: 14rpx;
  border-top: 4rpx solid var(--n-500);
  border-right: 4rpx solid var(--n-500);
  transform: rotate(45deg);
  box-sizing: border-box;
}

/* ============== 1+2 打卡合并卡（卡内含右侧进度环，对齐参考图） ==============
   结构：.section.checkin-section > .card.checkin-group (flex 行) > [.checkin-main, .ring-wrap]
   - .checkin-main  左 60%（flex 1.8，今日打卡进度 + 健身天数/连续打卡）
   - .ring-wrap     右 40%（flex 1.2，进度环，写在卡片内部右侧）
   - .section.checkin-section margin-top:144rpx 把卡片整体再下移，露出更多背景图人物手臂
*/
.section.checkin-section {
  margin: 50rpx 0 24rpx;  /* 顶部 50rpx（较最初 144rpx 累计上移 94rpx，整组卡片随之整体上移）；底部 24rpx = 全页标准区块间距（由 .card 的 margin 决定） */
  padding: 0 32rpx;
}
.checkin-group {
  display: flex;           /* 卡内：左文字块 + 右进度环 两列 */
  align-items: center;     /* 环垂直居中于文字块 */
  position: relative;      /* 定位锚点：火焰图标绝对定位到右下角 */
  width: 500rpx;          /* 卡片固定宽 500rpx（卡内左 60%≈300rpx 文字 + 右 40%≈200rpx 环区） */
  min-height: 272rpx;     /* 卡片再加高：内容垂直居中，上下留出更多呼吸位 */
  padding: 0;
  overflow: hidden;
  margin: 0;               /* 覆盖 .card 默认 24rpx 32rpx，外边距由父 section 控 */
  border: none;            /* 去掉 1rpx 边框：透明角处不再残留边框弧线；卡片靠 box-shadow 定义边缘，圆角保留 */
  /* 右上角柔化透明：背景图从卡角平滑透出（不用硬挖角/mask，避免生切感）。
     透明核心 30rpx、到 150rpx 渐变为实色卡底；配合卡片自身 border-radius 圆角，
     边框呈平滑弧线、不显突兀。位于 .ring-wrap 顶部空白区，不碰进度环（环顶距卡顶≈84rpx）。 */
  background: radial-gradient(circle at 100% 0, transparent 0, transparent 55rpx, var(--card) 220rpx);
}
.checkin-main {
  flex: 1.8 1 0;           /* 左列：1.8/(1.8+1.2)=60% ≈300rpx */
  min-width: 0;
}
.ring-wrap {
  flex: 1.2 1 0;           /* 右列（环区）：40% ≈200rpx，环 144rpx 左右各留 ≈28rpx */
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center; /* 环在卡内右侧空间居中 */
}
.checkin {
  padding: 18rpx 24rpx;
  /* 灰色背景已去除，与卡片白底融为一体；环已移入 .ring-wrap（卡内右侧），本块只保留内文垂直布局 */
}
.checkin .label {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 24rpx; font-weight: 800; color: var(--n-900);
}
.dot-green {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  background-color: var(--primary);
  flex: none;
}
.checkin .val {
  margin-top: 6rpx;
  font-family: var(--f-en, sans-serif);
  font-size: 40rpx; font-weight: 700; line-height: 48rpx;
  letter-spacing: -0.02em;
  color: var(--n-900);
  display: flex; align-items: baseline; gap: 6rpx;
}
.checkin .val .x { font-size: 30rpx; color: var(--n-900); font-weight: 600; }
.checkin .val .total { font-size: 30rpx; color: var(--n-900); font-weight: 700; }
.checkin .val .total-label { font-size: 25rpx; color: var(--n-600); font-weight: 500; margin-left: 4rpx; }

/* 进度环（独立于卡片右侧）：覆盖全局 .ring 的 --size=146 + .ring-span=36rpx */
.ring-wrap .ring { --size: 144rpx; --w: 14rpx; }
.ring-wrap .ring > .ring-span { font-size: 30rpx; }

.stats {
  display: flex;
  margin-top: 12rpx;       /* 整体下移一点：与上方 .checkin 拉开间距 */
  border-top: 1rpx solid var(--n-200);
  padding: 14rpx 0;
  background: var(--white);
}
.stat {
  flex: 1;
  padding: 0 16rpx;
  display: flex; align-items: center; justify-content: space-between;
  gap: 8rpx;
}
.stat + .stat { border-left: 1rpx solid var(--n-200); }
.stat .label {
  display: flex; align-items: center; justify-content: center; gap: 4rpx; white-space: nowrap;
  font-size: 23rpx; color: var(--n-600); font-weight: 500;
}
/* 标签前缀图标（日历/闪电）：复用全局 styles/icons.wxss 的 .ico-*（mask 方案、URL 编码、可跟随主题），此处仅覆盖尺寸与颜色 */
.stat .label .ico {
  width: 18rpx; height: 18rpx;
  background-color: var(--n-600);
  flex: none;
}
.stat .val {
  margin-top: 3rpx;
  font-family: var(--f-en, sans-serif);
  font-size: 36rpx; font-weight: 800; line-height: 44rpx;
  letter-spacing: -0.02em;
  color: var(--n-900);
  display: flex; align-items: baseline; justify-content: center; gap: 4rpx;
}
.stat .val .unit { font-size: 20rpx; color: var(--n-500); font-weight: 600; margin-left: 4rpx; }

/* ============== 区块标题（左内缩 32rpx 与卡片左缘对齐） ============== */
.section { padding: 0; margin: 0; }
.section-label {
  font-size: 29rpx; font-weight: 800; letter-spacing: -0.01em;
  color: var(--n-900);
  margin: 0 32rpx 20rpx;
}
.section-label.with-arrow {
  display: flex; align-items: center; justify-content: space-between;
}
.sec-arrow {
  width: 46rpx; height: 46rpx;
  display: grid; place-items: center;
  border-radius: 50%;
}

/* ============== 3 今日建议 ============== */
.suggest {
  padding: 27rpx 31rpx;
  display: flex; align-items: center; gap: 27rpx;
  background: var(--card-gray);
}
/* 图标芯片：底不能再是 --n-100 —— 它压在 --card-gray 卡上只差 2/255，等于没有底
   （用户反馈「.photo 背景是透明的」）；深色下 --n-100(#1E1E1E) 与 --card-gray(#1E1E1E) 更是完全同色。
   改用同页 .diet-side .add-circle 那套「品牌芯片」语言：极浅绿实底 + 亮绿描边。
   两侧一并成立：
     浅色 = #F2FFD6 底 + #C8FF00 描边 + 墨色图标（图标对比度 18.9:1）
     深色 = rgba(200,255,0,.12) 压 #1E1E1E ≈ #32391A + #C8FF00 描边 + 白图标（12.1:1）
   芯片与卡底的可辨度：浅色 Δ21/255、深色 Δ27/255（旧值 3/255 与 0/255 —— 深色下完全同色）
   描边是关键：它让「芯片」在两种主题下都有确定边界，不依赖底色与卡底的微小差值。 */
.suggest .photo {
  width: 92rpx; height: 92rpx; border-radius: 23rpx;
  background: var(--primary-tint);
  border: 3rpx solid var(--primary);
  display: grid; place-items: center;
  flex: none;
}
.suggest .body { flex: 1 1 auto; min-width: 0; }
.suggest .body .t1 {
  font-size: 29rpx; font-weight: 700; color: var(--n-900);
  letter-spacing: -0.01em;
}
.suggest .body .t2 {
  margin-top: 8rpx;
  font-size: 23rpx; color: var(--n-600); font-weight: 500;
}
.suggest .chev { flex: none; margin-right: 4rpx; }

/* 绿色 CTA「开始训练」（浅深两色通用品牌强调） */
.suggest .cta {
  flex: none;
  background: #C8FF00;
  color: #0A0A0A;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
  display: flex; align-items: center; gap: 6rpx;
  box-shadow: 0 6rpx 18rpx rgba(200, 255, 0, 0.28);
}
.suggest .cta .arr {
  width: 10rpx; height: 10rpx;
  border-top: 3rpx solid #0A0A0A;
  border-right: 3rpx solid #0A0A0A;
  transform: rotate(45deg);
}

/* ============== 3.5 今日未训练提醒条 ============== */
/* 为什么是「条」不是「卡」：它紧跟在「今日推荐」卡下面，若再做一张同款卡，
   两张卡会糊成一块、也没有主次。这里改用品牌浅绿底 + 左侧亮绿竖条的提示条，
   横向内缩与卡片一致（32rpx），视觉上属于上一张卡的下挂说明。
   不用整块亮绿底：面积一大就晃眼，且亮绿上必须配 #0A0A0A 字（对比度铁律）。
   CTA 用文字链而非第二个绿色胶囊 —— 上方卡片已有一个「开始训练」胶囊，
   再来一个就是纯重复；文字链既能点又不会抢主 CTA。
   两主题都靠「左竖条 + 底色差」立住，不依赖任何单一差值。 */
.remind {
  margin: 0 32rpx 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: var(--primary-tint);
  border-left: 7rpx solid var(--primary);
  display: flex; align-items: center; gap: 18rpx;
}
.remind-i { flex: none; width: 34rpx; height: 34rpx; }
.remind-txt { flex: 1 1 auto; min-width: 0; }
.remind-t1 {
  font-size: 27rpx; font-weight: 700; color: var(--n-900);
  letter-spacing: -0.01em;
}
.remind-t2 {
  margin-top: 6rpx;
  font-size: 22rpx; color: var(--n-600); font-weight: 500;
}
.remind-cta {
  flex: none;
  display: flex; align-items: center; gap: 4rpx;
  font-size: 24rpx; font-weight: 700;
  color: var(--primary-text);
}
.remind-cta::after {
  content: '';
  width: 10rpx; height: 10rpx;
  border-top: 3rpx solid var(--primary-text);
  border-right: 3rpx solid var(--primary-text);
  transform: rotate(45deg);
}
/* 关闭：只静音今天。命中区做够 48rpx（图标仍 26rpx），避免误触也避免点不到 */
.remind-x {
  flex: none;
  width: 48rpx; height: 48rpx;
  display: grid; place-items: center;
}
.remind-x .ico { width: 26rpx; height: 26rpx; background-color: var(--n-500); }

/* ============== 4 今日饮食 ============== */
/* 标题前缀：绿竖条 + 右侧「查看详情」文字 + 标准 chev 箭头（复用 .section-label.with-arrow 的 flex 布局，箭头与「体重趋势」同款） */
.section-label .label-left {
  display: flex; align-items: center;
}
.section-label .label-bar {
  width: 7rpx; height: 30rpx;
  background-color: var(--primary);
  border-radius: 4rpx;
  margin-right: 12rpx;
  flex: none;
}
.section-label .label-link {
  display: flex; align-items: center; gap: 6rpx;
  font-size: 23rpx; font-weight: 500; color: var(--n-600);
}

.diet {
  padding: 24rpx 28rpx;
  display: flex; align-items: stretch;
  gap: 16rpx;
}
.diet-main { flex: 1 1 auto; min-width: 0; }
.diet-side {
  flex: none; width: 170rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border-left: 1rpx solid var(--n-200);
  padding-left: 18rpx;
}

.diet .top { margin-bottom: 12rpx; }
.diet .top .num {
  display: flex; align-items: baseline; gap: 4rpx;
  color: var(--n-600);
}
.diet .top .num .big {
  font-family: var(--f-en, sans-serif);
  font-size: 42rpx; font-weight: 800; color: var(--n-900);
  letter-spacing: -0.02em; line-height: 50rpx;
}
.diet .top .num .target { font-size: 24rpx; color: var(--n-600); font-weight: 500; }
/* 摄入进度百分比：放在 .num 同一行最右（pct 百分比 + 标签并排，margin-left:auto 推右） */
.diet .top .num .pct-block {
  display: flex; align-items: baseline; gap: 6rpx;
  margin-left: auto;
}
.diet .top .num .pct {
  font-family: var(--f-en, sans-serif);
  font-size: 28rpx; font-weight: 800; color: var(--n-900);
  letter-spacing: -0.02em;
}
.diet .top .num .pct-label {
  font-size: 20rpx; color: var(--n-600); font-weight: 500;
}

.diet .progress {
  height: 10rpx; border-radius: 999rpx;
  background: var(--n-200);
  overflow: hidden;
  margin-bottom: 20rpx;
}
.diet .progress .fill {
  display: block; height: 100%;
  background: var(--primary);
  border-radius: 999rpx;
  transition: width 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}

.diet .nut { display: flex; }
.diet .nut .col {
  flex: 1;
  padding: 0 6rpx;
  border-right: 1rpx solid var(--n-200);
}
.diet .nut .col:first-child { padding-left: 0; }
.diet .nut .col:last-child { border-right: none; padding-right: 0; }

.diet .nut .col .name {
  display: flex; align-items: center; gap: 6rpx;
  font-size: 21rpx; color: var(--n-600); font-weight: 500;
}
.diet .nut .col .name .dot {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  flex: none;
}
.dot-protein { background: #C8FF00; }
.dot-carb     { background: #4A90E2; }
.dot-fat      { background: #FF9500; }

.diet .nut .col .v {
  margin-top: 4rpx;
  font-family: var(--f-en, sans-serif);
  font-size: 24rpx; font-weight: 700; color: var(--n-900);
  letter-spacing: -0.01em; line-height: 32rpx;
}
.diet .nut .col .v .unit { font-size: 20rpx; color: var(--n-500); font-weight: 600; margin-left: 2rpx; }

.diet .nut .col .bar {
  margin-top: 6rpx;
  height: 10rpx; border-radius: 999rpx;
  background: var(--n-200);
  overflow: hidden;
}
.diet .nut .col .bar-fill {
  display: block; height: 100%;
  border-radius: 999rpx;
  transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
.bar-protein { background: #C8FF00; }
.bar-carb     { background: #4A90E2; }
.bar-fat      { background: #FF9500; }

/* 右侧：添加饮食（摄入进度已移到 .diet-main .top .num 下） */
.diet-side .add-meal {
  display: flex; flex-direction: column; align-items: center;
  padding-top: 12rpx;
}
.diet-side .add-circle {
  width: 110rpx; height: 110rpx;
  border-radius: 50%;
  background: #ECF7C8;
  display: grid; place-items: center;
  position: relative;
  border: 2rpx solid #C8FF00;
}
.diet-side .add-circle .ico-foodbowl {
  width: 54rpx; height: 54rpx;
  background-color: #2A3310;
}
.diet-side .add-btn {
  position: absolute;
  right: -8rpx; bottom: -8rpx;
  width: 42rpx; height: 42rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #0A0A0A;
  font-size: 30rpx; font-weight: 700;
  display: grid; place-items: center;
  line-height: 1;
  box-shadow: 0 4rpx 10rpx rgba(200, 255, 0, 0.35);
}
.diet-side .add-text {
  margin-top: 12rpx;
  font-size: 24rpx; color: var(--n-600); font-weight: 500;
}

/* ============== 5 体重趋势 ============== */
.weight {
  padding: 31rpx 35rpx;
  display: flex; align-items: center; gap: 31rpx;
}
.weight .meta {
  flex: 1 1 0; min-width: 0;
  border-right: 1rpx solid var(--n-200);
  padding-right: 24rpx;
}
.weight .meta .num {
  font-family: var(--f-en, sans-serif);
  font-size: 54rpx; font-weight: 800; line-height: 65rpx;
  letter-spacing: -0.03em;
  color: var(--n-900);
  display: flex; align-items: baseline; gap: 4rpx;
}
.weight .meta .num .unit { font-size: 27rpx; color: var(--n-600); font-weight: 600; margin-left: 8rpx; }
.weight .meta .delta {
  margin-top: 4rpx;
  display: inline-flex; align-items: center; gap: 4rpx;
  font-family: var(--f-en, sans-serif); font-size: 23rpx;
  color: var(--success); font-weight: 700;
}
.weight .meta .delta.up { color: var(--accent); }
.weight .meta .delta .arr { font-size: 20rpx; }
.weight .chart { flex: 3 1 0; min-width: 0; }
.spark-canvas { width: 100%; height: 123rpx; display: block; }

.bottom-gap { height: 20rpx; }

/* ══════════════════════════════════════════════════════════════
   深色主题覆盖（.page.theme-dark）
   —— 由「我的 → 深色主题」开关切换，utils/theme.js 持久化到 Storage。

   核心手法：**重定义 CSS 变量**，而不是逐条覆盖属性。
   上面所有浅色样式用的都是 var(--n-900) / var(--card) / var(--line) 这类变量，
   只要在 .page.theme-dark 上把它们重定义成暗色值，整棵子树自动翻转——
   CSS 自定义属性会向下继承，连 .card（来自 app.wxss）等后代也一并生效。
   只有「硬编码颜色」和「需要换色的强调元素」才需要下面单独覆盖。

   → 新增页面支持深色的成本 ≈ 根节点挂 class + 复制这段变量重定义。
   ══════════════════════════════════════════════════════════════ */

.page.theme-dark {
  /* —— 中性灰阶反转（暖白 → 暖黑）—— */
  --n-50:  #0A0A0A;                    /* 页面底 */
  --n-100: #1E1E1E;                    /* 内嵌面 */
  --n-200: rgba(255, 255, 255, 0.10);  /* 分隔线 / 边框 */
  --n-300: rgba(255, 255, 255, 0.16);
  --n-400: rgba(255, 255, 255, 0.30);
  --n-500: rgba(255, 255, 255, 0.42);  /* 弱化文字 / chevron */
  --n-600: rgba(255, 255, 255, 0.55);  /* 次级标签 */
  --n-700: rgba(255, 255, 255, 0.75);
  --n-900: #FFFFFF;                    /* 主文字 / 主数字 */

  /* —— 语义色 —— */
  --text:        #FFFFFF;
  --text-sub:    rgba(255, 255, 255, 0.70);
  --text-weak:   rgba(255, 255, 255, 0.45);
  --line:        rgba(255, 255, 255, 0.10);
  --line-strong: rgba(255, 255, 255, 0.20);

  /* —— 表面 —— */
  --card:      #161616;                /* 主卡（app.wxss .card 自动跟着变） */
  --white:     #161616;                /* 浅色里当卡面的 --white 也转暗 */
  --card-gray: #1E1E1E;                /* 打卡 / 建议卡的浅灰底 */
  --bg:        rgba(255, 255, 255, 0.06);

  /* 浅色值 token 必须跟着翻：根选择器上的 --primary-tint = #F2FFD6（极浅绿），
     它**不随主题自动翻转**，不在这里重定义的话深色下会糊出一块浅绿底。
     注意：本注释不要写花括号 —— 静态守卫用朴素正则切规则，注释里的花括号会打乱解析。 */
  --primary-tint: rgba(200, 255, 0, 0.12);
  /* 绿色「文字」token 同理不会自动翻：app.wxss 的根值是 #4C7300（为浅底/浅绿底选的深绿），
     直接压在深色块上几乎看不见。深色下翻成亮绿（与 profile.wxss 的做法一致）。
     提醒条的「开始训练」文字链用的就是它 —— 新引入一个浅色 token 就必须同时补这里。 */
  --primary-text: #C8FF00;

  /* 成功色在暗底上太暗（#6F9F00），提亮到品牌绿：碳水量 / 体重降幅更醒目 */
  --success: #C8FF00;

  background: var(--n-50);
  color: var(--text);
}

/* —— 以下为「硬编码颜色」或「需要换色的强调元素」的单独覆盖 —— */

/* 图标：.ico--ink 默认深墨，黑底不可见 → 转白 */
.page.theme-dark .ico--ink { background-color: #FFFFFF; }

/* 卡片阴影：暗色下黑色阴影无意义，去掉 */
.page.theme-dark .card { box-shadow: none; }

/* 打卡火焰图标块：浅色是硬编码 #FFF1D6（橙调），暗色改用品牌绿淡底 */

/* 进度环：conic 轨道转半透白、进度用品牌绿、中心白字 */
.page.theme-dark .ring-wrap .ring {
  background: conic-gradient(
    rgba(200, 255, 0, 0.20) 0%,
    #C8FF00 calc(var(--pct) * 1%),
    rgba(255, 255, 255, 0.08) calc(var(--pct) * 1%) 100%
  );
}
.page.theme-dark .ring-wrap .ring::before { background: var(--card); }
.page.theme-dark .ring-wrap .ring .ring-span { color: #FFFFFF; }

/* 饮食进度条填充：浅色是暗墨渐变（黑底上会整条消失），暗色改用亮绿 + 光晕 */
.page.theme-dark .diet .progress .fill {
  background: #C8FF00;
  box-shadow: 0 0 10rpx rgba(200, 255, 0, 0.5);
}
/* 完成百分比：暗色下点亮成品牌绿（对齐参考图） */
.page.theme-dark .diet .top .num .pct { color: #C8FF00; }

/* 添加饮食圆形按钮：浅色淡绿底（#ECF7C8）在暗底过于刺眼，暗色改用深绿底 + 品牌绿描边，图标翻绿 */
.page.theme-dark .diet-side .add-circle {
  background: #1E2A0A;
  border-color: #C8FF00;
}
.page.theme-dark .diet-side .add-circle .ico-foodbowl {
  background-color: #C8FF00;
}

/* —— 偏好降级：尊重系统减弱动效 —— */
@media (prefers-reduced-motion: reduce) {
  .diet .progress .fill { transition: none; }
}
