/* pages/home/home.wxss —— 对齐 ui-redesign-preview.html v2 */
.page {
  padding: 0 0 calc(130rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-deep) 0%, var(--primary) 14%, var(--primary-tint) 40%, #FFF1E8 100%);
}

/* 渐变 hero —— 透明叠在「状态栏→桃色」连续渐变上（自上而下无断缝） */
.hero-grad {
  margin: 0;
  padding: 28rpx 32rpx 12rpx;
  position: relative;
  color: #fff;
}
.hero-grad .hi { font-size: 26rpx; color: rgba(255,255,255,.92); font-weight: 600; text-shadow: 0 1rpx 4rpx rgba(13,59,48,.30); }
.hero-grad .name { font-size: 40rpx; font-weight: 800; color: #fff; margin-top: 8rpx; letter-spacing: -1rpx; text-shadow: 0 1rpx 4rpx rgba(13,59,48,.30); }
.hero-grad .date { font-size: 22rpx; color: rgba(255,255,255,.82); margin-top: 12rpx; text-shadow: 0 1rpx 4rpx rgba(13,59,48,.24); }

/* 状态卡（浮在 hero 上） */
.status-card { padding: 28rpx 32rpx; }
.sc-head { display: flex; align-items: flex-end; justify-content: space-between; }
.sc-title { font-size: 30rpx; font-weight: 700; color: var(--text); }
.sc-pct { font-size: 44rpx; font-weight: 800; color: var(--primary); font-feature-settings: "tnum" 1; line-height: 1; }
.sc-pct-sign { font-size: 24rpx; font-weight: 600; margin-left: 2rpx; }

/* 百分比进度条 */
.pbar {
  position: relative; height: 16rpx; border-radius: 999rpx;
  background: var(--bg); margin-top: 18rpx; overflow: hidden;
}
.pbar-fill {
  height: 100%; border-radius: 999rpx;
  background: linear-gradient(90deg, var(--primary-light), var(--primary-deep));
  transition: width .4s ease;
}
.sc-tip { font-size: 24rpx; color: var(--text-sub); margin-top: 14rpx; }

/* 今日三项打卡（体重 / 训练 / 饮食） */
.checkins { display: flex; margin-top: 24rpx; gap: 16rpx; }
.checkin {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  padding: 18rpx 8rpx 16rpx; border-radius: 18rpx; background: var(--bg);
  border: 1rpx solid transparent; transition: all .15s; position: relative;
}
.checkin .ci-ico {
  position: relative; width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #fff; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(31,35,41,.06);
}
.checkin .ci-emoji { font-size: 38rpx; line-height: 1; }
.checkin .ci-check {
  position: absolute; right: -4rpx; bottom: -4rpx;
  width: 30rpx; height: 30rpx; border-radius: 50%;
  background: var(--primary); color: #fff; font-size: 20rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  border: 3rpx solid #fff; box-shadow: 0 2rpx 4rpx rgba(46,207,176,.4);
}
.checkin .ci-name { font-size: 26rpx; font-weight: 700; color: var(--text); }
.checkin .ci-state { font-size: 20rpx; color: var(--text-weak); }
.checkin.on { background: var(--primary-light); border-color: var(--primary); }
.checkin.on .ci-state { color: var(--primary-deep); font-weight: 700; }

/* 快捷磁贴：对齐 Glass UI 参考（长方形卡片、图标左 / 文字右） */
/* 「快捷开始」区块与上方「今日打卡」浮卡拉开间距，避免标题紧贴、整体偏上不居中 */
.section.quick-sec { margin-top: 40rpx; }
.quick .qtxt { flex: 1; min-width: 0; }
.quick .qt { text-align: left; }
.quick .qs { text-align: left; }

/* 记录日历 */
.cal-head { display: flex; align-items: center; justify-content: space-between; }
/* 本周迷你日历（对齐参考：周一~周日，今日绿底，记录日珊瑚点） */
.wk { display: flex; gap: 8rpx; margin-top: 18rpx; }
.wk-d { flex: 1; display: flex; flex-direction: column; align-items: center; }
.wk-wd { font-size: 20rpx; color: var(--text-weak); font-weight: 600; }
.wk-box {
  position: relative; width: 72rpx; height: 80rpx; margin-top: 8rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 600; color: var(--text);
  background: var(--bg); border: 1rpx solid var(--line); border-radius: 18rpx;
}
.wk-d.today .wk-box { background: var(--primary); color: #fff; border-color: var(--primary); }
.wk-dot { position: absolute; bottom: 9rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--accent); }
.wk-d.today .wk-dot { background: #fff; }
/* 日历弹窗 */
.cal-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: 1000;
  display: flex; align-items: center; justify-content: center;
  padding: 0 56rpx;
}
.cal-modal { width: 84%; max-height: 86vh; overflow-y: auto; -webkit-overflow-scrolling: touch; background: #fff; border-radius: 24rpx; padding: 24rpx 20rpx 18rpx; box-sizing: border-box; }
.cal-modal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.cal-nav {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  background: var(--bg); color: var(--text); font-size: 36rpx;
  display: flex; align-items: center; justify-content: center; line-height: 1;
}
.cal-title { font-size: 28rpx; font-weight: 700; }
.cal-week { display: flex; margin-bottom: 6rpx; }
.cal-wk { width: 14.28%; text-align: center; font-size: 20rpx; color: var(--text-weak); }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell { width: 14.28%; height: 70rpx; display: flex; align-items: center; justify-content: center; }
.cal-cell.empty { visibility: hidden; }
.cal-day {
  font-size: 25rpx; color: var(--text);
  width: 50rpx; height: 50rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; box-sizing: border-box;
}
.cal-cell.rec .cal-day { background: var(--primary); color: #fff; }
.cal-cell.today .cal-day { color: var(--primary); font-weight: 700; box-shadow: inset 0 0 0 2rpx var(--primary); }
.cal-cell.sel .cal-day { box-shadow: 0 0 0 4rpx var(--primary-deep); }
.cal-tip { margin-top: 12rpx; text-align: center; font-size: 20rpx; color: var(--text-weak); }

/* 弹窗内联训练详情 */
.cdi { margin-top: 18rpx; border-top: 1rpx solid var(--line); padding-top: 18rpx; }
.cdi-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.cdi-date { font-size: 28rpx; font-weight: 700; color: var(--text); }
.cdi-back { font-size: 24rpx; color: var(--primary); background: var(--primary-light); border-radius: 999rpx; padding: 6rpx 20rpx; }
.cdi-overview { display: flex; gap: 12rpx; margin-bottom: 18rpx; }
.cdi-ov { flex: 1; background: var(--bg); border-radius: 14rpx; padding: 16rpx 8rpx; text-align: center; }
.cdi-num { font-size: 30rpx; font-weight: 800; color: var(--primary); font-feature-settings: "tnum" 1; }
.cdi-cap { font-size: 20rpx; color: var(--text-sub); margin-top: 4rpx; }
.cdi-act { background: var(--bg); border-radius: 16rpx; padding: 16rpx; margin-bottom: 14rpx; }
.cdi-act-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.cdi-act-name { font-size: 28rpx; font-weight: 700; }
.cdi-act-sets { font-size: 24rpx; color: var(--primary-deep); }
.cdi-set-row { display: flex; align-items: center; padding: 8rpx 0; font-size: 22rpx; border-bottom: 1rpx solid var(--line); }
.cdi-set-row.cdi-th { color: var(--text-weak); font-weight: 600; border-bottom: 1rpx solid var(--line); }
.cdi-idx { width: 18%; text-align: center; color: var(--text-sub); }
.cdi-col { flex: 1; text-align: center; color: var(--text); }
.cdi-time { width: 22%; text-align: center; color: var(--text-sub); }
.cdi-time.rest { color: var(--text-weak); }

.bottom-gap { height: 20rpx; }

/* 今日训练计划：动作卡片（对齐参考 .plan-item：缩略图 + 名称 + 元信息 + 进度条 + 状态标签） */
.plan-item { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 28rpx; margin: 0 0 16rpx; position: relative; }
.pi-thumb {
  width: 76rpx; height: 76rpx; border-radius: 18rpx; flex: 0 0 auto;
  background: var(--primary-light); display: flex; align-items: center; justify-content: center; font-size: 40rpx;
  position: relative; overflow: hidden;
}
.pi-emoji { line-height: 1; }
.pi-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.pi-body { flex: 1; min-width: 0; }
.pi-name { font-size: 30rpx; font-weight: 700; color: var(--text); }
.pi-meta { font-size: 22rpx; color: var(--text-weak); margin-top: 6rpx; }
.bar { height: 12rpx; border-radius: 999rpx; background: var(--bg); margin-top: 14rpx; overflow: hidden; }
.bar i, .bar-i { display: block; height: 100%; background: var(--primary); border-radius: 999rpx; }
.plan-item .tag { flex: 0 0 auto; margin-right: 0; }
.plan-item.on { background: var(--primary-light); }
.plan-btn-sm { flex: 0 0 auto; padding: 0 28rpx; height: 64rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; }
