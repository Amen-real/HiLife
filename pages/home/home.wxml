<!-- pages/home/home.wxml —— 对齐 01-home.html（HiLiLife 设计系统）
     根节点 theme-light / theme-dark 由「我的 → 主题」开关控制（见 utils/theme.js） -->
<view class="page {{theme}}">

  <!-- ============== 顶部问候（纯文字，无 appbar / 无卡片背景） ============== -->
  <view class="hero">
    <view class="hero-text">
      <view class="hero-greet">{{greeting}}，{{nickname}}</view>
      <view class="hero-sub">{{sub}}</view>
    </view>
  </view>

  <!-- ============== 1+2 今日打卡进度 + 健身天数/连续打卡（合并一卡） ============== -->
  <view class="card checkin-group">
    <view class="checkin">
      <view class="meta">
        <view class="label">今日打卡进度</view>
        <view class="val">
          <text>{{checkin.done}}</text>
          <text class="x">/</text>
          <text class="total">{{checkin.total}} 项已完成</text>
        </view>
      </view>
      <view class="ring" style="--pct: {{checkin.pct}}" role="img" aria-label="完成度 {{checkin.pct}}%">
        <text class="ring-span">{{checkin.pct}}%</text>
      </view>
    </view>

    <view class="stats">
      <view class="stat">
        <view class="meta">
          <view class="label">健身天数</view>
          <view class="val">{{fitnessDays}}<text class="unit">天</text></view>
        </view>
      </view>
      <view class="stat">
        <view class="meta">
          <view class="label">连续打卡</view>
          <view class="val">{{streak}}<text class="unit">天</text></view>
        </view>
        <view class="ic flame">
          <view class="ico ico-flame ico--primary" style="width:34rpx;height:34rpx"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- ============== 3 今日建议（绿色 CTA「开始训练」） ============== -->  <view class="section">
    <view class="section-label">今日建议</view>
    <view class="card suggest">
      <view class="photo">
        <view class="ico ico-train ico--primary" style="width:42rpx;height:42rpx"></view>
      </view>
      <view class="body">
        <view class="t1">{{suggest.title}}</view>
        <view class="t2">{{suggest.sub}}</view>
      </view>
      <view class="cta" bindtap="startPlan" hover-class="btn-hover" role="button" aria-label="开始训练">
        开始训练<view class="arr"></view>
      </view>
    </view>
  </view>

  <!-- ============== 4 今日饮食 ============== -->
  <view class="section">
    <view class="section-label">今日饮食</view>
    <view class="card diet">
      <view class="top">
        <view class="num">{{diet.intake}}<text class="target">/ {{diet.target}} kcal</text></view>
        <view class="pct">{{diet.pct}}%</view>
      </view>
      <view class="progress">
        <view class="fill" style="{{fillStyle}}"></view>
      </view>
      <view class="nut">
        <view class="col">
          <view class="name">蛋白质</view>
          <view class="v">{{diet.protein.now}}<text class="unit">/ {{diet.protein.goal}}g</text></view>
        </view>
        <view class="col">
          <view class="name">碳水</view>
          <view class="v carb">{{diet.carb.now}}<text class="unit">/ {{diet.carb.goal}}g</text></view>
        </view>
        <view class="col fat-col">
          <view class="meta">
            <view class="name">脂肪</view>
            <view class="v fat">{{diet.fat.now}}<text class="unit">/ {{diet.fat.goal}}g</text></view>
          </view>
          <view class="nut-arrow" bindtap="goDiet" hover-class="btn-hover">
            <view class="chev"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ============== 5 体重趋势 ============== -->
  <view class="section">
    <view class="section-label with-arrow">
      <text>体重趋势</text>
      <view class="sec-arrow" bindtap="goWeight" hover-class="btn-hover" aria-label="查看体重趋势详情">
        <view class="chev"></view>
      </view>
    </view>
    <view class="card weight" bindtap="goWeight" hover-class="btn-hover">
      <view class="meta">
        <view class="num">{{weight.current}}<text class="unit">kg</text></view>
        <view class="delta {{weight.down ? 'down' : 'up'}}">
          <text class="arr">{{weight.down ? '▼' : '▲'}}</text>
          <text>{{weight.delta}} kg</text>
        </view>
      </view>
      <view class="chart">
        <canvas type="2d" id="weightSpark" class="spark-canvas"></canvas>
      </view>
    </view>
  </view>

  <view class="bottom-gap"></view>
</view>
