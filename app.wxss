@import "./styles/icons.wxss";

/* app.wxss —— 全局样式 · HiLiLife 设计系统（Light · 暖白底 + 品牌荧光绿 #C8FF00）
   迁移说明：去掉原「薄荷 Teal 玻璃拟态」与渐变背景，统一为 HiLife 浅色体系。
   为兼容尚未迁移的页面，旧 token 名（--primary / --accent / --glass 等）保留并映射到新体系。 */

page {
  /* —— 品牌 & 中性色（来源: Design.md） —— */
  --primary: #C8FF00;          /* 品牌荧光黄绿 */
  --primary-deep: #7CB800;     /* 深绿（渐变收尾） */
  --primary-light: #E4FF6E;    /* 亮绿（渐变起笔） */
  --primary-tint: #F2FFD6;     /* 极浅绿底（标签/磁贴） */
  --primary-ink: #0A0A0A;      /* 深墨绿黑，浅底上对比度足够，用于关键数字 */
  --primary-text: #4C7300;     /* 绿色「文字」专用：--primary-deep(#7CB800) 作字在白/浅绿底仅 2.4:1，本值 5.6:1 达 AA。深色主题各页需翻成亮绿 */

  /* 辅助强调色（沿用旧 accent 体系，统一到橙/蓝/紫，不喧宾夺主） */
  --accent: #FF9500;           /* 能量橙（休息 / 脂肪 / PR） */
  --accent-deep: #E8652A;
  --accent-soft: #FFE7DA;
  --accent-tint: #FFF1E6;
  /* 橙色「文字」专用：压在 --accent-soft 上。原来的 #C2410C 只有 4.36:1（连 AA 都没到），
     本值 5.47:1。深色主题需配对翻转 —— 见各页 .page.theme-dark 里的 --accent-ink。 */
  --accent-ink: #A8380A;
  /* ============ 语义「深字」色：淡底 + 同色系字必须成对用 ============
     直接把 --error / --warning / --success 当字色压各自的淡底，会低到 1.7~3.4:1
     （--warning #FFB020 压 --warning-tint = 1.68:1，等于看不见）。
     浅色侧在这里给深一档的值；深色侧由各页 .page.theme-dark 提亮。
     原来只在 plan.wxss 里定义过 --danger-text，属于单页私有 —— 现已升为根 token 单源，
     各页请引用，不要再就地写一份。 */
  --danger-text:  #C4363B;     /* 红「文字」：压浅红淡底达 AA（--error #F2545B 仅 3.39:1） */
  --danger-solid: #C4363B;     /* 红「实底」配白字 5.33:1（恒定，不随主题翻转） */
  --info: #3E8BFF;
  --info-tint: #E6F0FF;
  --purple: #8B5CF6;
  --purple-tint: #F1E9FF;
  --gold: #F5B544;
  --orange: #FF9500;           /* 脂肪橙 */

  /* 中性灰阶（暖调，对齐 Design.md --n-*） */
  --n-950: #0A0A0A;
  --n-900: #111111;
  --n-700: #444444;
  --n-600: #707070;
  --n-500: #A0A0A0;
  --n-400: #C7C7C2;
  --n-300: #D9D9D5;
  --n-200: #E8E8E4;           /* 边框线 */
  --n-100: #F1F1EE;
  --n-50:  #F7F7F5;           /* 页面暖白底 */
  --white: #FFFFFF;
  --card-gray: #EFEFEB;       /* 浅灰卡底（打卡/建议卡） */

  --text: #0A0A0A;
  --text-sub: #444444;
  --text-weak: #A0A0A0;
  --line: #E8E8E4;
  --line-strong: #D9D9D5;

  /* Semantic */
  --success: #6F9F00;         /* 碳水绿 / 活跃态 */
  --warning: #FFB020;
  --warning-tint: #FFF4E0;
  --error: #F2545B;
  --warn: #FF9500;

  /* —— 表面（替代原玻璃） —— */
  --card: #FFFFFF;                                      /* 主卡 */
  --bg: #F1F1EE;                                        /* 内嵌面 / 胶囊 */
  --bg-muted: #F1F1EE;
  --sk-base: #E8E8E4;
  --sk-hi:   #F4F4F1;
  --glass: #FFFFFF;                                     /* 通用卡面（去玻璃） */
  --glass-strong: #FFFFFF;
  --glass-border: #E8E8E4;

  /* —— 字体比例 Type Scale（rpx） —— */
  --fs-caption:  20rpx;
  --fs-label:   24rpx;
  --fs-body:    28rpx;
  --fs-head:    32rpx;
  --fs-title:   36rpx;
  --fs-section: 40rpx;
  --fs-page:    44rpx;
  --fs-display: 52rpx;
  --fs-hero:    72rpx;
  --fs-hero-lg: 80rpx;
  --fs-mega:   120rpx;
  --fs-giant:  180rpx;
  --fs-mini:    20rpx;

  /* Radius */
  --r-s: 16rpx;
  --r-m: 24rpx;
  --r-l: 32rpx;
  --r-pill: 999rpx;

  /* 字体：中文用 PingFang SC，拉丁/数字用系统无衬线（近似设计稿 Inter 观感） */
  --f-zh: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, -apple-system, sans-serif;
  --f-en: "SF Pro Display", "Helvetica Neue", system-ui, -apple-system, "PingFang SC", sans-serif;

  /* Elevation */
  --shadow-sm: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 16rpx 44rpx rgba(0, 0, 0, 0.12);
  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-mint: 0 12rpx 30rpx rgba(124, 184, 0, 0.30);   /* 品牌绿光晕 */
  --shadow-coral: 0 10rpx 24rpx rgba(255, 149, 0, 0.24);
  --shadow-brand: var(--shadow-mint);
  --shadow-xs: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);

  --ease-out: cubic-bezier(0.22, 0.8, 0.28, 1);
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);

  /* 页面根背景：暖白底（去掉原青绿→桃色渐变） */
  background: var(--n-50);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: var(--fs-body);
  line-height: 1.5;
}

view, text, button, input, scroll-view, navigator { box-sizing: border-box; }

/* ============ 卡片（白底 + 细边框 + 轻阴影） ============ */
.card {
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  box-shadow: var(--shadow-card);
  padding: 32rpx;
  margin: 24rpx 32rpx;
}
.card-elevated { box-shadow: var(--shadow-md); }

/* 区块标题 */
.section-title {
  font-size: var(--fs-head); font-weight: 700; color: var(--n-900);
  margin: 0 0 24rpx;
  display: flex; align-items: center; gap: 12rpx;
}
.section-title .more { margin-left: auto; font-size: var(--fs-label); font-weight: 500; color: var(--text-weak); }

/* 英文小标 */
.section-sub {
  font-size: var(--fs-caption); font-weight: 600; letter-spacing: 2rpx;
  color: var(--text-weak); margin-bottom: 16rpx;
}

/* 主按钮（品牌荧光绿底 + 深墨字） */
.btn-primary {
  background: var(--primary);
  color: #0A0A0A;
  border-radius: 28rpx;
  font-size: var(--fs-head);
  font-weight: 700;
  border: none;
  line-height: 2.6;
  box-shadow: var(--shadow-mint);
}
.btn-primary::after { border: none; }

/* 次按钮 */
.btn-secondary {
  background: var(--n-100);
  color: var(--n-700);
  border-radius: 28rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  border: none;
  line-height: 2.4;
}
.btn-secondary::after { border: none; }

/* 圆形图标按钮 */
.icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--white);
  color: var(--n-700);
  font-size: var(--fs-page);
  line-height: 64rpx;
  text-align: center;
  padding: 0;
  border: 1rpx solid var(--n-200);
  box-shadow: var(--shadow-xs);
}
.icon-btn::after { border: none; }
.icon-btn.ghost {
  background: var(--n-100);
  color: var(--n-700);
}

/* 文字链接箭头 */
.link-arrow {
  color: var(--text-sub);
  font-size: var(--fs-body);
  display: inline-flex;
  align-items: center;
}
.link-arrow .arrow { margin-left: 6rpx; color: var(--text-weak); }

/* 空状态 */
.empty {
  text-align: center;
  color: var(--text-weak);
  font-size: var(--fs-body);
  padding: 48rpx 0;
}

/* 通用标签 */
.tag {
  display: inline-flex; align-items: center;
  font-size: var(--fs-caption); font-weight: 500; color: var(--text-sub);
  background: var(--bg); border-radius: 999rpx;
  padding: 6rpx 16rpx; margin-right: 12rpx; line-height: 1.4;
}
.tag-primary { color: #2a3d00; background: var(--primary); font-weight: 700; }
.tag-accent { color: var(--accent-deep); background: var(--accent-tint); }

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ============================================================
   共享布局（与设计系统对齐）
   ============================================================ */
.container { padding: 0 32rpx; }
.section { padding: 0 32rpx; margin-bottom: 48rpx; }

/* —— 完成度环（conic-gradient + 内灰圆，对齐 01-home.html） —— */
.ring {
  --size: 146rpx; --w: 15rpx; --pct: 0;
  width: var(--size); height: var(--size);
  border-radius: 50%;
  background: conic-gradient(
    #E4FF6E 0%,
    #C8FF00 calc(var(--pct) * 0.5%),
    #7CB800 calc(var(--pct) * 1%),
    var(--n-200) calc(var(--pct) * 1%) 100%
  );
  display: grid; place-items: center;
  position: relative;
  flex: none;
}
.ring::before {
  content: ""; position: absolute; inset: var(--w);
  background: var(--card-gray); border-radius: 50%;
}
.ring > .ring-span {
  position: relative; z-index: 1;
  font-family: var(--f-en, sans-serif);
  font-size: 36rpx; font-weight: 800; letter-spacing: -0.02em;
  color: var(--n-900);
  font-variant-numeric: tabular-nums;
}

/* —— 列表行 —— */
.row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx 0; border-bottom: 1rpx solid var(--line);
}
.row:last-child { border-bottom: none; }
.row .r-ico { font-size: var(--fs-section); }
.row .r-main { flex: 1; }
.row .r-title { font-size: var(--fs-body); font-weight: 600; color: var(--text); }
.row .r-sub { font-size: var(--fs-caption); color: var(--text-weak); margin-top: 4rpx; }
.row .r-arrow { color: var(--text-weak); font-size: var(--fs-body); }

/* —— 分段控件 —— */
.segment {
  display: inline-flex; background: var(--bg); border-radius: 999rpx; padding: 6rpx;
}
.segment .seg {
  padding: 12rpx 24rpx; font-size: var(--fs-label); color: var(--text-sub);
  border-radius: 999rpx; font-weight: 500;
}
.segment .seg.on { background: var(--white); color: var(--n-900); font-weight: 700; box-shadow: var(--shadow-xs); }

/* —— 统计块 —— */
.stat-row { display: flex; gap: 16rpx; margin-top: 8rpx; }
.stat {
  flex: 1; text-align: center; padding: 20rpx 8rpx;
  border-left: 1rpx solid var(--line);
}
.stat:first-child { border-left: none; }
.stat .v { font-size: var(--fs-title); font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; }
.stat .v.primary { color: var(--success); }
.stat .v.accent { color: var(--accent); }
.stat .k { font-size: var(--fs-caption); color: var(--text-sub); margin-top: 6rpx; }

/* —— 快捷磁贴 —— */
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; }
.quick {
  background: var(--card); border: 1rpx solid var(--n-200);
  border-radius: 32rpx; padding: 24rpx 26rpx;
  display: flex; flex-direction: row; align-items: center; gap: 20rpx;
  box-shadow: var(--shadow-card);
}
.quick .ic {
  width: 64rpx; height: 64rpx; border-radius: 18rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-size: var(--fs-title);
}
.quick .ic.g { background: var(--primary-tint); }
.quick .ic.o { background: var(--accent-tint); }
.quick .ic.b { background: var(--info-tint); }
.quick .ic.p { background: var(--purple-tint); }
.quick .qtxt { flex: 1; min-width: 0; }
.quick .qt { font-size: var(--fs-head); font-weight: 700; color: var(--text); text-align: left; }
.quick .qs { font-size: var(--fs-caption); color: var(--text-weak); margin-top: 4rpx; text-align: left; }

/* —— 媒体署名 —— */
.attribution {
  text-align: center; font-size: var(--fs-caption); color: var(--text-weak);
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  line-height: 1.6;
}

/* —— 按钮按压反馈 —— */
.btn-hover { opacity: 0.9; transform: translateY(1rpx); }

/* —— 平板适配 —— */
@media (min-width: 768px) {
  .container, .section, .card, .float-card, .remind { max-width: 720rpx; margin-left: auto; margin-right: auto; }
  .card { margin-left: auto; margin-right: auto; }
}

/* —— 骨架屏 shimmer —— */
.sk {
  background: linear-gradient(90deg, var(--sk-base) 25%, var(--sk-hi) 37%, var(--sk-base) 63%);
  background-size: 400% 100%;
  animation: sk-shimmer 1.4s ease infinite;
  border-radius: 8rpx;
}
@keyframes sk-shimmer {
  0%   { background-position: 150% 0; }
  100% { background-position: -50% 0; }
}
@media (prefers-reduced-motion: reduce) {
  .sk { animation: none; }
}
