/* app.wxss —— 全局样式与玻璃拟态设计变量（Glass UI · 薄荷 Teal 色系） */

page {
  /* —— 玻璃拟态 · 薄荷 Teal 主色 —— */
  --primary: #2ECFB0;        /* 薄荷 Teal 主色 */
  --primary-deep: #1AA885;   /* 深 Teal */
  --primary-light: #3EDECA;  /* 亮 Teal（渐变起笔） */
  --primary-tint: #E5FBF5;   /* 极浅 Teal 底 */

  /* Accent —— 珊瑚橙（能量型数据：休息 / 卡路里 / PR） */
  --accent: #FF7A3D;
  --accent-deep: #E8652A;
  --accent-soft: #FFE7DA;
  --accent-tint: #FFE7DA;

  /* 辅助强调色 */
  --info: #3E8BFF;
  --info-tint: #E6F0FF;
  --purple: #8B5CF6;
  --purple-tint: #F1E9FF;
  --gold: #F5B544;

  /* Neutral —— 冷调灰阶 */
  --text: #1E293B;
  --text-sub: #475569;
  --text-weak: #94A3B8;
  --line: #E2E8F0;
  --line-strong: #CBD5E1;

  /* Semantic */
  --success: #16C784;
  --warning: #F5A524;
  --error: #F2545B;
  --warn: #FF7A3D; /* 兼容旧引用 */

  /* —— 玻璃表面 —— */
  --card: rgba(255, 255, 255, 0.78);        /* 玻璃主卡 */
  --bg: rgba(255, 255, 255, 0.55);          /* 玻璃内嵌面 / 胶囊 */
  --glass: rgba(255, 255, 255, 0.72);       /* 通用玻璃 */
  --glass-strong: rgba(255, 255, 255, 0.88);
  --glass-border: rgba(255, 255, 255, 0.85);

  /* Elevation */
  --shadow-sm: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
  --shadow-md: 0 10rpx 30rpx rgba(15, 23, 42, 0.08);
  --shadow-lg: 0 16rpx 44rpx rgba(15, 23, 42, 0.12);
  --shadow-card: 0 10rpx 30rpx rgba(15, 23, 42, 0.08);
  --shadow-mint: 0 12rpx 30rpx rgba(46, 207, 176, 0.30);   /* 薄荷光晕 */
  --shadow-coral: 0 10rpx 24rpx rgba(255, 122, 61, 0.32);   /* 珊瑚光晕 */
  --shadow-brand: var(--shadow-mint);
  --shadow-xs: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);

  /* 动效曲线 */
  --ease-out: cubic-bezier(0.22, 0.8, 0.28, 1);
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);

  /* 页面根背景：并入「顶部青绿→底部桃色」竖直渐变体系（与各页 .page 同款，端点对齐 app.json 的 backgroundColorTop/Bottom，消除 overscroll 接缝） */
  background: linear-gradient(180deg, var(--primary-deep) 0%, var(--primary) 14%, var(--primary-tint) 40%, #FFF1E8 100%);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, button, input, scroll-view, navigator { box-sizing: border-box; }

/* ============ 玻璃卡 ============ */
.card {
  background: var(--glass);
  border: 1rpx solid var(--glass-border);
  border-radius: 40rpx;
  box-shadow: var(--shadow-card);
  padding: 32rpx;
  margin: 24rpx 32rpx;
}
.card-elevated { box-shadow: var(--shadow-md); }

/* 区块标题 */
.section-title {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--text-sub);
  font-weight: 600;
  margin: 8rpx 4rpx 16rpx;
  text-transform: uppercase;
}

/* 主按钮（玻璃拟态：Teal 渐变 + 薄荷光晕） */
.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #fff;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 2.6;
  box-shadow: var(--shadow-mint);
}
.btn-primary::after { border: none; }

/* 次按钮 */
.btn-secondary {
  background: var(--primary-tint);
  color: var(--primary-deep);
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  line-height: 2.4;
}
.btn-secondary::after { border: none; }

/* 圆形图标按钮 */
.icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 44rpx;
  line-height: 64rpx;
  text-align: center;
  padding: 0;
  border: none;
  box-shadow: var(--shadow-mint);
}
.icon-btn::after { border: none; }
.icon-btn.ghost {
  background: var(--primary-tint);
  color: var(--primary);
}

/* 文字链接箭头 */
.link-arrow {
  color: var(--text-sub);
  font-size: 26rpx;
  display: inline-flex;
  align-items: center;
}
.link-arrow .arrow { margin-left: 6rpx; color: var(--text-weak); }

/* 空状态 */
.empty {
  text-align: center;
  color: var(--text-weak);
  font-size: 26rpx;
  padding: 48rpx 0;
}

/* 通用标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  color: var(--text-sub);
  background: var(--bg);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 8rpx;
}
.tag-primary {
  color: var(--primary-deep);
  background: var(--primary-tint);
}

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ============================================================
   设计系统增强（玻璃拟态 · 与 HiLife-Glass-UI 原型对齐）
   渐变 hero + 状态环 + 彩色快捷磁贴 + 统一留白/圆角/胶囊标签
   ============================================================ */

/* —— 页面统一容器：左右 32rpx 安全边距，区块间 48rpx —— */
.container { padding: 0 32rpx; }
.section { padding: 0 32rpx; margin-bottom: 48rpx; }
.section-title {
  font-size: 30rpx; font-weight: 700; color: var(--text);
  margin: 0 0 20rpx;
  display: flex; align-items: center; gap: 12rpx;
}
.section-title .more { margin-left: auto; font-size: 24rpx; font-weight: 500; color: var(--text-weak); }
/* 英文小标（如 DAILY STATUS · 今日状态） */
.section-sub {
  font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx;
  color: var(--text-weak); text-transform: uppercase; margin-bottom: 18rpx;
}

/* —— 渐变 hero 头（破全白单调，承载问候/品牌） —— */
.hero-header {
  background: linear-gradient(155deg, var(--primary), var(--primary-deep));
  padding: 40rpx 32rpx 56rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 14rpx 30rpx rgba(46, 207, 176, 0.28);
}
.hero-header::after {
  content: ''; position: absolute; right: -30rpx; top: -30rpx;
  width: 150rpx; height: 150rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}
.hero-header .hh-greet { font-size: 40rpx; font-weight: 800; letter-spacing: -1rpx; }
.hero-header .hh-sub { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.hero-header .hh-logo {
  width: 84rpx; height: 84rpx; border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 800; margin-bottom: 20rpx;
}

/* —— 浮在 hero 上的状态卡（负边距制造层级） —— */
.float-card {
  margin: 0 32rpx;
  position: relative;
  z-index: 2;
}

/* —— 完成度环（conic-gradient + 内白圆，沿用 home.js 的 ringStyle） —— */
.ring {
  width: 200rpx; height: 200rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  position: relative;
}
.ring::after {
  content: ''; position: absolute; inset: 18rpx;
  background: var(--glass-strong); border-radius: 50%;
}
.ring-inner { position: relative; z-index: 1; text-align: center; }
.ring-pct { font-size: 52rpx; font-weight: 800; color: var(--primary); line-height: 1.1; font-feature-settings: "tnum" 1; }
.ring-label { font-size: 22rpx; color: var(--text-sub); margin-top: 4rpx; }

/* —— 彩色快捷磁贴（2×2，上图下文） —— */
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; }
.quick {
  background: var(--glass); border: 1rpx solid var(--glass-border);
  border-radius: 32rpx; padding: 24rpx 26rpx;
  display: flex; flex-direction: row; align-items: center; gap: 20rpx;
  box-shadow: var(--shadow-card);
}
.quick .ic {
  width: 64rpx; height: 64rpx; border-radius: 18rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-size: 34rpx;
}
.quick .ic.g { background: var(--primary-tint); }
.quick .ic.o { background: var(--accent-tint); }
.quick .ic.b { background: var(--info-tint); }
.quick .ic.p { background: var(--purple-tint); }
.quick .qtxt { flex: 1; min-width: 0; }
.quick .qt { font-size: 30rpx; font-weight: 700; color: var(--text); }
.quick .qs { font-size: 22rpx; color: var(--text-weak); margin-top: 4rpx; }

/* —— 通用统计块（白卡内轻量分区，避免卡中卡） —— */
.stat-row { display: flex; gap: 16rpx; margin-top: 8rpx; }
.stat {
  flex: 1; text-align: center; padding: 20rpx 8rpx;
  border-left: 1rpx solid var(--line);
}
.stat:first-child { border-left: none; }
.stat .v { font-size: 34rpx; font-weight: 800; color: var(--text); font-feature-settings: "tnum" 1; }
.stat .v.primary { color: var(--primary); }
.stat .v.accent { color: var(--accent); }
.stat .k { font-size: 22rpx; color: var(--text-sub); margin-top: 6rpx; }

/* —— 胶囊标签（999rpx 圆角） —— */
.tag {
  display: inline-flex; align-items: center;
  font-size: 22rpx; font-weight: 500; color: var(--text-sub);
  background: var(--bg); border-radius: 999rpx;
  padding: 6rpx 18rpx; margin-right: 12rpx; line-height: 1.4;
}
.tag-primary { color: var(--primary-deep); background: var(--primary-tint); }
.tag-accent { color: var(--accent-deep); background: var(--accent-tint); }

/* —— 按钮按压反馈（统一） —— */
.btn-hover { opacity: 0.9; transform: translateY(1rpx); }

/* —— 分段控件（7/30/90/全部 等） —— */
.segment {
  display: inline-flex; background: var(--bg); border-radius: 999rpx; padding: 6rpx;
}
.segment .seg {
  padding: 10rpx 28rpx; font-size: 24rpx; color: var(--text-sub);
  border-radius: 999rpx; font-weight: 500;
}
.segment .seg.on { background: var(--glass-strong); color: var(--primary); font-weight: 700; box-shadow: var(--shadow-sm); }

/* —— 列表行（通用：左图标/标题 + 右箭头） —— */
.row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 28rpx 0; border-bottom: 1rpx solid var(--line);
}
.row:last-child { border-bottom: none; }
.row .r-ico { font-size: 40rpx; }
.row .r-main { flex: 1; }
.row .r-title { font-size: 28rpx; font-weight: 600; color: var(--text); }
.row .r-sub { font-size: 22rpx; color: var(--text-weak); margin-top: 4rpx; }
.row .r-arrow { color: var(--text-weak); font-size: 28rpx; }

/* —— 媒体署名（© Gym visual，固定保留） —— */
.attribution {
  text-align: center; font-size: 20rpx; color: var(--text-weak);
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  line-height: 1.6;
}
