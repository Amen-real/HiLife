/* components/training-review/training-review.wxss —— v2 两页结构
   全部走 var() token，随宿主页 .page.theme-dark 自动跟随深色；
   亮绿底文字一律 #0A0A0A（对比度铁律），chip 用 --primary-tint + --primary-text 配对 */
.page {
  width: 100vw; box-sizing: border-box;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

/* ===== 主体滚动 ===== */
.scroll {
  width: 100%; box-sizing: border-box;
  height: 100vh;
  overflow-x: hidden;
}
.body { padding: 24rpx 32rpx 120rpx; }

/* ===== 顶部 2 段 tab ===== */
.tabs {
  background: var(--n-200);
  border: 1rpx solid var(--n-300);
  border-radius: var(--r-pill);
  padding: 8rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 4rpx;
  margin-bottom: 24rpx;
}
.tab-item {
  background: transparent;
  height: 64rpx;
  border-radius: var(--r-pill);
  font-size: 26rpx; font-weight: 600;
  color: var(--n-600);
  display: flex; align-items: center; justify-content: center;
  font-family: inherit;
  transition: background 200ms, color 200ms, box-shadow 200ms;
}
.tab-item.on {
  background: var(--primary);
  color: #0A0A0A;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* ===== 一句话结论卡 ===== */
.verdict {
  background: var(--primary-tint, rgba(200, 255, 0, 0.16));
  border: 1rpx solid var(--primary);
  border-radius: var(--r-l);
  padding: 22rpx 28rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx; font-weight: 600; line-height: 1.55;
  color: var(--primary-text, #0A0A0A);
  letter-spacing: 0;
}

/* ===== 场次行：‹ 日期 · 动作/组数 › ===== */
.session-row {
  display: flex; align-items: center;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}
.s-arrow {
  flex: none;
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--card);
  border: 1rpx solid var(--n-200);
  font-size: 36rpx; font-weight: 600;
  color: var(--n-700);
}
.s-arrow.dis { color: var(--n-300); }
.s-arrow:active { background: var(--n-100); }
.s-mid { flex: 1; min-width: 0; text-align: center; }
.s-date {
  display: block;
  font-family: var(--f-en); font-size: 30rpx; font-weight: 700;
  color: var(--n-900); font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
}
.s-sub {
  display: block; margin-top: 2rpx;
  font-size: 22rpx; font-weight: 600;
  color: var(--n-500);
}

/* ===== 3 stat ===== */
.stats {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.stat {
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  padding: 20rpx 12rpx;
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
}
.stat .lab { font-size: 22rpx; font-weight: 600; color: var(--n-500); letter-spacing: 0.04em; }
.stat .val {
  font-family: var(--f-en); font-size: 40rpx; font-weight: 800;
  color: var(--n-900); font-variant-numeric: tabular-nums; letter-spacing: -0.02em;
  line-height: 1;
  display: inline-flex; align-items: baseline;
}
.stat .val .unit { font-size: 22rpx; font-weight: 700; color: var(--n-500); margin-left: 4rpx; }

/* ===== 区块标题 ===== */
.section-title {
  font-size: 30rpx; font-weight: 800; letter-spacing: -0.01em;
  color: var(--n-900);
  margin: 0 0 20rpx;
}

/* ===== 逐动作卡 ===== */
.pa-list { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 32rpx; }
.pa-card {
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  padding: 24rpx 28rpx;
}
.pa-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.pa-name { font-size: 28rpx; font-weight: 700; color: var(--n-900); letter-spacing: -0.01em; }
.pa-chip {
  flex: none;
  font-family: var(--f-en); font-size: 22rpx; font-weight: 700;
  font-variant-numeric: tabular-nums;
  border-radius: var(--r-pill);
  padding: 6rpx 18rpx;
}
.pa-chip.up { color: var(--success); background: rgba(111, 159, 0, 0.10); }
.pa-chip.down { color: #D8483B; background: rgba(216, 72, 59, 0.10); }
.pa-chip.flat { color: var(--n-500); background: var(--n-100); }
.pa-line {
  display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx;
  margin-top: 12rpx;
}
.pa-best {
  font-family: var(--f-en); font-size: 26rpx; font-weight: 700;
  color: var(--n-900); font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
}
.pa-meta {
  font-family: var(--f-en); font-size: 22rpx; font-weight: 600;
  color: var(--n-500); font-variant-numeric: tabular-nums;
}
.pa-plan {
  margin-top: 10rpx;
  font-size: 22rpx; font-weight: 600; line-height: 1.5;
  color: var(--primary-text, #4C7300);
}
.pa-card .pa-plan { color: var(--primary-text); }

/* ===== 训练感受 ===== */
.feel-card {
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  padding: 8rpx 28rpx;
  margin-bottom: 32rpx;
}
.feel-row { padding: 20rpx 0; border-bottom: 1rpx solid var(--n-100); }
.feel-row:last-child { border-bottom: none; }
.feel-name {
  font-size: 24rpx; font-weight: 700; color: var(--n-900);
  margin-bottom: 4rpx;
}
.feel-note { display: block; font-size: 24rpx; font-weight: 400; color: var(--n-600); line-height: 1.55; }

/* ===== 空状态 ===== */
.placeholder {
  padding: 96rpx 0 120rpx;
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  text-align: center;
}
.ph-tit { font-size: 30rpx; font-weight: 800; color: var(--n-800); letter-spacing: -0.01em; }
.ph-hint { font-size: 24rpx; font-weight: 500; color: var(--n-400); }
/* 空态出口：亮绿底必配深字（对比度铁律） */
.ph-cta {
  margin-top: 32rpx;
  padding: 18rpx 46rpx;
  border-radius: var(--r-pill);
  background: var(--primary);
  color: #0A0A0A;
  font-size: 26rpx; font-weight: 800; letter-spacing: 0.02em;
}
.ph-cta:active { opacity: 0.86; }

/* ===== 进步趋势：周完成度 ===== */
.wk-head {
  display: flex; align-items: center; gap: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  padding: 28rpx;
  margin-bottom: 32rpx;
}
.wk-ring {
  flex: none;
  width: 140rpx; height: 140rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.wk-ring-center {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: var(--card);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.wk-pct { font-family: var(--f-en); font-size: 32rpx; font-weight: 800; color: var(--n-900); line-height: 1; }
.wk-pct-u { font-size: 20rpx; font-weight: 700; }
.wk-pct-lab { font-size: 18rpx; font-weight: 600; color: var(--n-500); margin-top: 4rpx; }
.wk-meta { flex: 1; min-width: 0; }
.wk-meta-row { margin-bottom: 14rpx; }
.wk-mv { font-family: var(--f-en); font-size: 32rpx; font-weight: 800; color: var(--n-900); font-variant-numeric: tabular-nums; line-height: 1.2; }
.wk-mu { font-size: 22rpx; font-weight: 600; color: var(--n-500); }
.wk-ml { font-size: 22rpx; font-weight: 600; color: var(--n-500); margin-top: 2rpx; }
.wk-target {
  display: flex; align-items: center; gap: 10rpx;
  margin-top: 4rpx;
}
.wk-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--primary); }
.wk-target-txt { font-size: 24rpx; font-weight: 600; color: var(--n-700); }
.wk-edit {
  font-size: 20rpx; font-weight: 700; color: var(--primary-text, #4C7300);
  background: var(--primary-tint, rgba(200, 255, 0, 0.16));
  border-radius: var(--r-pill);
  padding: 4rpx 14rpx;
}
/* 目标由计划（daysPerWeek）决定时不可就地修改，退成中性标签 */
.wk-target.locked .wk-edit { color: var(--n-600); background: var(--card-gray); }

/* ===== 关键动作卡 ===== */
.ka-card {
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}
.ka-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.ka-name { font-size: 28rpx; font-weight: 700; color: var(--n-900); letter-spacing: -0.01em; }
.ka-bars {
  display: flex; align-items: flex-end; gap: 8rpx;
  height: 88rpx;
  margin: 18rpx 0 12rpx;
}
.ka-bar {
  flex: 1; min-width: 0;
  background: var(--n-300);
  border-radius: 6rpx 6rpx 0 0;
}
.ka-bar.hot { background: var(--primary); }
.ka-foot { display: flex; align-items: baseline; gap: 12rpx; }
.ka-txt {
  font-family: var(--f-en); font-size: 22rpx; font-weight: 600;
  color: var(--n-500); font-variant-numeric: tabular-nums;
}
.ka-txt.hot { color: var(--n-900); font-weight: 700; }
.ka-arrow { font-size: 22rpx; color: var(--n-400); }

.guide-link {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  margin: 4rpx 0 32rpx;
  padding: 18rpx 0;
  font-size: 24rpx; font-weight: 600;
  color: var(--primary-text, #4C7300);
}
.guide-link::before { content: ''; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--primary); }

.wk-empty {
  padding: 40rpx 8rpx;
  font-size: 24rpx; font-weight: 500;
  color: var(--n-500);
  margin-bottom: 32rpx;
}

/* ===== 近 6 周努力度 ===== */
.wk-weeks {
  display: grid; grid-template-columns: repeat(6, 1fr);
  gap: 12rpx;
  align-items: end;
  margin-bottom: 32rpx;
}
.wk-w-col { display: flex; flex-direction: column; align-items: center; }
.wk-w-track {
  width: 100%; height: 160rpx;
  display: flex; align-items: flex-end;
}
.wk-w-bar {
  width: 100%;
  border-radius: 8rpx 8rpx 0 0;
  display: flex; align-items: flex-start; justify-content: center;
}
.wk-w-bar.on { background: var(--primary); min-height: 8rpx; }
.wk-w-bar.off { background: var(--n-200); height: 8rpx; }
.wk-w-val {
  font-family: var(--f-en); font-size: 20rpx; font-weight: 700;
  color: #0A0A0A;
  padding-top: 6rpx;
}
.wk-w-lab { font-size: 20rpx; font-weight: 600; color: var(--n-500); margin-top: 10rpx; }

.bottom-gap { height: 40rpx; }
