/* components/training-review/training-review.wxss —— v2 两页结构
   全部走 var() token，随宿主页 .page.theme-dark 自动跟随深色；
   亮绿底文字一律 #0A0A0A（对比度铁律），chip 用 --primary-tint + --primary-text 配对 */
.page {
  width: 100vw; box-sizing: border-box;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

/* ===== 主体滚动 ===== */
.scroll {
  width: 100%; box-sizing: border-box;
  height: 100vh;
  overflow-x: hidden;
}
.body { padding: 24rpx 32rpx 120rpx; }

/* ===== 顶部 2 段 tab ===== */
.tabs {
  background: var(--n-200);
  border: 1rpx solid var(--n-300);
  border-radius: var(--r-pill);
  padding: 8rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 4rpx;
  margin-bottom: 24rpx;
}
.tab-item {
  background: transparent;
  height: 64rpx;
  border-radius: var(--r-pill);
  font-size: 26rpx; font-weight: 600;
  color: var(--n-600);
  display: flex; align-items: center; justify-content: center;
  font-family: inherit;
  transition: background 200ms, color 200ms, box-shadow 200ms;
}
.tab-item.on {
  background: var(--primary);
  color: #0A0A0A;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* ===== 一句话结论卡 ===== */
.verdict {
  background: var(--primary-tint, rgba(200, 255, 0, 0.16));
  border: 1rpx solid var(--primary);
  border-radius: var(--r-l);
  padding: 22rpx 28rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx; font-weight: 600; line-height: 1.55;
  color: var(--primary-text, #0A0A0A);
  letter-spacing: 0;
}

/* ===== 场次行：‹ 日期 · 动作/组数 › ===== */
.session-row {
  display: flex; align-items: center;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}
.s-arrow {
  flex: none;
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--card);
  border: 1rpx solid var(--n-200);
  font-size: 36rpx; font-weight: 600;
  color: var(--n-700);
}
.s-arrow.dis { color: var(--n-300); }
.s-arrow:active { background: var(--n-100); }
.s-mid { flex: 1; min-width: 0; text-align: center; }
.s-date {
  display: block;
  font-family: var(--f-en); font-size: 30rpx; font-weight: 700;
  color: var(--n-900); font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
}
.s-sub {
  display: block; margin-top: 2rpx;
  font-size: 22rpx; font-weight: 600;
  color: var(--n-500);
}

/* ===== 3 stat ===== */
.stats {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.stat {
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  padding: 20rpx 12rpx;
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
}
.stat .lab { font-size: 22rpx; font-weight: 600; color: var(--n-500); letter-spacing: 0.04em; }
.stat .val {
  font-family: var(--f-en); font-size: 40rpx; font-weight: 800;
  color: var(--n-900); font-variant-numeric: tabular-nums; letter-spacing: -0.02em;
  line-height: 1;
  display: inline-flex; align-items: baseline;
}
.stat .val .unit { font-size: 22rpx; font-weight: 700; color: var(--n-500); margin-left: 4rpx; }

/* ===== 区块标题 ===== */
.section-title {
  font-size: 30rpx; font-weight: 800; letter-spacing: -0.01em;
  color: var(--n-900);
  margin: 0 0 20rpx;
}

/* ===== 逐动作卡 ===== */
.pa-list { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 32rpx; }
.pa-card {
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  padding: 24rpx 28rpx;
}
.pa-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.pa-name { font-size: 28rpx; font-weight: 700; color: var(--n-900); letter-spacing: -0.01em; }
.pa-chip {
  flex: none;
  font-family: var(--f-en); font-size: 22rpx; font-weight: 700;
  font-variant-numeric: tabular-nums;
  border-radius: var(--r-pill);
  padding: 6rpx 18rpx;
}
.pa-chip.up { color: var(--success-text); background: rgba(111, 159, 0, 0.10); }
.pa-chip.down { color: var(--danger-text); background: rgba(216, 72, 59, 0.10); }
.pa-chip.flat { color: var(--n-700); background: var(--n-100); }
.pa-line {
  display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx;
  margin-top: 12rpx;
}
.pa-best {
  font-family: var(--f-en); font-size: 26rpx; font-weight: 700;
  color: var(--n-900); font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
}
.pa-meta {
  font-family: var(--f-en); font-size: 22rpx; font-weight: 600;
  color: var(--n-500); font-variant-numeric: tabular-nums;
}
.pa-plan {
  margin-top: 10rpx;
  font-size: 22rpx; font-weight: 600; line-height: 1.5;
  color: var(--primary-text, #4C7300);
}
.pa-card .pa-plan { color: var(--primary-text); }

/* ===== 训练感受 ===== */
.feel-card {
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  padding: 8rpx 28rpx;
  margin-bottom: 32rpx;
}
.feel-row { padding: 20rpx 0; border-bottom: 1rpx solid var(--n-100); }
.feel-row:last-child { border-bottom: none; }
.feel-name {
  font-size: 24rpx; font-weight: 700; color: var(--n-900);
  margin-bottom: 4rpx;
}
.feel-note { display: block; font-size: 24rpx; font-weight: 400; color: var(--n-600); line-height: 1.55; }

/* ===== 空状态 ===== */
.placeholder {
  padding: 96rpx 0 120rpx;
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  text-align: center;
}
.ph-tit { font-size: 30rpx; font-weight: 800; color: var(--n-800); letter-spacing: -0.01em; }
.ph-hint { font-size: 24rpx; font-weight: 500; color: var(--n-400); }
/* 空态出口：亮绿底必配深字（对比度铁律） */
.ph-cta {
  margin-top: 32rpx;
  padding: 18rpx 46rpx;
  border-radius: var(--r-pill);
  background: var(--primary);
  color: #0A0A0A;
  font-size: 26rpx; font-weight: 800; letter-spacing: 0.02em;
}
.ph-cta:active { opacity: 0.86; }

/* ===== 关键动作卡 ===== */
.ka-card {
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}
.ka-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.ka-name { font-size: 28rpx; font-weight: 700; color: var(--n-900); letter-spacing: -0.01em; }
.ka-bars {
  display: flex; align-items: flex-end; gap: 8rpx;
  height: 88rpx;
  margin: 18rpx 0 12rpx;
}
.ka-bar {
  flex: 1; min-width: 0;
  background: var(--n-300);
  border-radius: 6rpx 6rpx 0 0;
}
.ka-bar.hot { background: var(--primary); }
.ka-foot { display: flex; align-items: baseline; gap: 12rpx; }
.ka-txt {
  font-family: var(--f-en); font-size: 22rpx; font-weight: 600;
  color: var(--n-500); font-variant-numeric: tabular-nums;
}
.ka-txt.hot { color: var(--n-900); font-weight: 700; }
.ka-arrow { font-size: 22rpx; color: var(--n-400); }
/* 卡片底部的「训练量 1440 → 1680 kg」：解释上面 chip 的 +x% 是怎么来的 */
.ka-cap {
  margin-top: 6rpx;
  font-family: var(--f-en); font-size: 22rpx; font-weight: 600;
  color: var(--n-500); font-variant-numeric: tabular-nums;
}

/* ===== 个人纪录 ===== */
.pr-card {
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}
.pr-sum { font-size: 24rpx; font-weight: 600; color: var(--n-700); margin-bottom: 6rpx; }
.pr-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--n-100);
}
.pr-row:last-child { border-bottom: none; }
.pr-name { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 27rpx; font-weight: 600; color: var(--n-900); }
.pr-val { flex: none; font-family: var(--f-en); font-size: 26rpx; font-weight: 700; color: var(--n-900); font-variant-numeric: tabular-nums; }
/* 亮绿底 → 文字一律 #0A0A0A（对比度铁律） */
.pr-new { flex: none; font-size: 20rpx; font-weight: 700; color: #0A0A0A; background: var(--primary); border-radius: 999rpx; padding: 4rpx 12rpx; }
.pr-date { flex: none; width: 76rpx; text-align: right; font-family: var(--f-en); font-size: 22rpx; color: var(--n-400); font-variant-numeric: tabular-nums; }

.guide-link {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  margin: 4rpx 0 32rpx;
  padding: 18rpx 0;
  font-size: 24rpx; font-weight: 600;
  color: var(--primary-text, #4C7300);
}
.guide-link::before { content: ''; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--primary); }

.wk-empty {
  padding: 40rpx 8rpx;
  font-size: 24rpx; font-weight: 500;
  color: var(--n-500);
  margin-bottom: 32rpx;
}

/* ===== 近 6 周训练量 ===== */
.wk-weeks {
  display: grid; grid-template-columns: repeat(6, 1fr);
  gap: 12rpx;
  align-items: end;
  margin-bottom: 32rpx;
}
.wk-w-col { display: flex; flex-direction: column; align-items: center; }
.wk-w-track {
  width: 100%; height: 160rpx;
  display: flex; align-items: flex-end;
}
.wk-w-bar {
  width: 100%;
  border-radius: 8rpx 8rpx 0 0;
  display: flex; align-items: flex-start; justify-content: center;
}
.wk-w-bar.on { background: var(--primary); min-height: 8rpx; }
.wk-w-bar.off { background: var(--n-200); height: 8rpx; }
.wk-w-val {
  font-family: var(--f-en); font-size: 20rpx; font-weight: 700;
  color: #0A0A0A;
  padding-top: 6rpx;
}
.wk-w-lab { font-size: 20rpx; font-weight: 600; color: var(--n-500); margin-top: 10rpx; }

/* ===== 下次训练建议（可回填计划） ===== */
.sg-card {
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-l);
  padding: 8rpx 28rpx 24rpx;
  margin-bottom: 32rpx;
}
.sg-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--n-100);
}
.sg-row:last-child { border-bottom: none; }
.sg-top { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.sg-name { font-size: 28rpx; font-weight: 700; color: var(--n-900); letter-spacing: -0.01em; }
.sg-from {
  font-family: var(--f-en); font-size: 22rpx; font-weight: 600;
  color: var(--n-500); font-variant-numeric: tabular-nums;
}
.sg-mid { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; }
.sg-arrow { font-family: var(--f-en); font-size: 24rpx; font-weight: 700; color: var(--n-400); }
/* 减载（降重）行：↓ 用 --accent-deep 标出（浅底 3.3:1 / 深底 5.7:1，字形非正文，达 3:1 图形阈值） */
.sg-row.dl .sg-arrow { color: var(--accent-deep); }
.sg-inp {
  width: 132rpx; height: 60rpx; box-sizing: border-box;
  background: var(--n-100);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-m);
  padding: 0 16rpx;
  font-family: var(--f-en); font-size: 28rpx; font-weight: 700;
  color: var(--n-900); font-variant-numeric: tabular-nums;
  text-align: center;
}
.sg-inp.wide { width: 168rpx; }
.sg-unit { font-size: 24rpx; font-weight: 600; color: var(--n-600); }
.sg-flat { font-size: 26rpx; font-weight: 700; color: var(--n-500); }
.sg-reason { margin-top: 10rpx; font-size: 22rpx; font-weight: 600; color: var(--primary-text, #4C7300); }
.sg-actions {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  margin-top: 24rpx; padding-top: 24rpx;
  border-top: 1rpx solid var(--n-100);
}
/* 亮绿底必配深字（对比度铁律） */
.sg-apply {
  width: 100%; box-sizing: border-box; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-pill);
  background: var(--primary);
  color: #0A0A0A;
  font-size: 28rpx; font-weight: 800; letter-spacing: 0.02em;
}
.sg-apply:active { opacity: 0.86; }
/* @contrast-ok: disabled 控件 —— WCAG 1.4.3 明确豁免失效控件，弱化字形是刻意的可用性信号。 */
.sg-apply.dis { background: var(--n-200); color: var(--n-400); }
.sg-tip { font-size: 20rpx; font-weight: 500; color: var(--n-400); }

.bottom-gap { height: 40rpx; }

/* ===== 关键动作：标题行入口 + 选择弹层（自动前 3 ↔ 自选） ===== */
.ka-title { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.ka-title .section-title { margin: 0; flex: 1 1 auto; min-width: 0; }
.ka-pick {
  flex: none; font-size: 20rpx; font-weight: 700;
  color: var(--primary-text);
  background: var(--primary-tint);
  border-radius: var(--r-pill);
  padding: 6rpx 16rpx;
}
.ka-pick:active { opacity: 0.7; }

/* 遮罩 z-index 必须高于 nav-bar（fixed z-999），否则底部抽屉被导航栏压住 */
.ka-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex; align-items: flex-end;
  z-index: 2000;
  animation: ka-fade 0.18s ease;
}
.ka-sheet {
  width: 100%; box-sizing: border-box;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -10rpx 40rpx rgba(15, 23, 42, 0.2);
  animation: ka-up 0.26s ease;
}
.ka-sheet-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.ka-sheet-tit { font-size: 32rpx; font-weight: 800; color: var(--n-900); letter-spacing: -0.01em; }
.ka-sheet-cnt {
  font-family: var(--f-en); font-size: 22rpx; font-weight: 700;
  color: var(--n-400); font-variant-numeric: tabular-nums;
}
.ka-sheet-sub { display: block; font-size: 22rpx; font-weight: 500; color: var(--n-400); margin: 8rpx 0 20rpx; }
/* scroll-view 必须给明确高度（禁 flex:1），否则真机不滚动 */
.ka-sheet-list { height: 52vh; }
/* 宿主页带自定义 tabBar（数据 tab）时，抽屉底部再让出底栏高度：
   自定义 tabBar 是框架级固定层（z-index 1000），页面弹层压不住它，只能靠 let 出空间避让 */
.ka-mask.with-tab .ka-sheet { padding-bottom: calc(88rpx + 44rpx + env(safe-area-inset-bottom)); }
.ka-sheet-gap { height: 16rpx; }
.ka-opt {
  display: flex; align-items: center; gap: 20rpx;
  padding: 22rpx 24rpx; margin-bottom: 12rpx;
  background: var(--n-50);
  border: 1rpx solid transparent;
  border-radius: var(--r-m);
}
.ka-opt.on { border-color: var(--primary); background: var(--primary-tint); }
.ka-opt-main { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.ka-opt-name {
  font-size: 27rpx; font-weight: 700; color: var(--n-900);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.ka-opt-meta { font-family: var(--f-en); font-size: 21rpx; color: var(--n-400); font-variant-numeric: tabular-nums; }
.ka-opt-box {
  flex: none; width: 44rpx; height: 44rpx; box-sizing: border-box;
  border: 2rpx solid var(--n-300); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.ka-opt-box.on { background: var(--primary); border-color: var(--primary); }
/* 亮绿底 → 勾号一律 #0A0A0A（对比度铁律） */
.ka-opt-tick { font-size: 26rpx; font-weight: 800; color: #0A0A0A; line-height: 1; }
.ka-sheet-foot { display: flex; gap: 20rpx; margin-top: 20rpx; }
.ka-sheet-btn {
  flex: 1; height: 88rpx; border-radius: var(--r-m);
  display: flex; align-items: center; justify-content: center;
  font-size: 29rpx; font-weight: 700;
}
.ka-sheet-btn.ghost { background: var(--n-100); color: var(--n-700); }
/* 主按钮亮绿底 → 文字 #0A0A0A */
.ka-sheet-btn.main { background: var(--primary); color: #0A0A0A; }
.ka-sheet-btn:active { opacity: 0.86; }

@keyframes ka-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes ka-up { from { transform: translateY(40rpx); } to { transform: translateY(0); } }

/* ===== 分享卡入口（B2）===== */
.sc-entry {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  height: 88rpx;
  margin: -12rpx 0 32rpx;
  background: var(--card);
  border: 1rpx solid var(--n-200);
  border-radius: var(--r-pill);
}
.sc-entry:active { background: var(--n-100); }
.sc-entry-dot { flex: none; width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--primary); }
.sc-entry-txt { font-size: 27rpx; font-weight: 700; color: var(--n-900); letter-spacing: 0.01em; }

/* ===== 分享卡预览弹层（底部抽屉）=====
   遮罩 z-index 与 ka-mask 同档（2000，高于 nav-bar 的 999）。
   面板是底部抽屉：预览图在上、开关在中、通道在下，总高控制在 100vh 内——
   「控制在 100vh 内」由 .sc-sheet 的 max-height **兜住**，不是靠算出来的经验值：
   预览图高度是设备相关的（小屏 50vh 会更大占比），哪天加一行文案就可能把
   「取消」推出屏幕，只剩点遮罩一条退路。
   文字一律 --n-700 / --n-900：不用 --n-500（#A0A0A0）—— 它压浅底只有 2.6:1，见报告 P2-9。
   底部留 env(safe-area-inset-bottom)，避免「取消」压到 iPhone 的横条；
   宿主页有自定义 tabBar 时另加 .with-tab 让出底栏（tabBar 是框架级固定层，压不住）。 */
.sc-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.62);
  display: flex; align-items: flex-end; justify-content: center;
  z-index: 2000;
  animation: sc-fade 0.18s ease;
}
.sc-sheet {
  width: 750rpx; box-sizing: border-box;
  background: var(--n-50);
  border-radius: 40rpx 40rpx 0 0;
  padding: 28rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex; flex-direction: column; gap: 20rpx;
  animation: sc-up 0.22s ease;
  /* 抽屉高度上限：顶部留 96rpx，遮罩仍可见（否则用户会以为弹层卡住、无法点空白关闭）。
     内容超出时**只压缩预览图** —— .sc-preview 是这里唯一的 `flex-shrink: 1` 项，
     开关 / 通道 / 说明 / 取消统统 flex-shrink:0，保证「取消」按钮永远在屏幕内。 */
  max-height: calc(100vh - 96rpx);
}
/* 宿主页带自定义 tabBar（组件同时挂在「数据」tab）时，抽屉底部再让出底栏高度。
   自定义 tabBar 是框架级固定层：页面里 z-index 调到 2000 也压不住，只能避让。
   与 .ka-mask.with-tab 同源，两处都要有 —— 少一处就有一处按钮被底栏盖住。 */
.sc-sheet.with-tab { padding-bottom: calc(88rpx + 44rpx + env(safe-area-inset-bottom)); }
.sc-preview {
  height: 50vh; min-height: 220rpx;
  flex: 0 1 auto;                              /* 唯一的可压缩项，下限 220rpx */
  border-radius: 24rpx; overflow: hidden;
  background: var(--n-100);
  display: flex; align-items: center; justify-content: center;
}
.sc-busy {
  height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 600;
  color: var(--n-700);
}
.sc-img { width: 100%; height: 100%; }
/* 说明文字不参与压缩：它被压窄就会多折一行，反而更容易把「取消」顶出去 */
.sc-tip { font-size: 20rpx; font-weight: 500; line-height: 1.6; color: var(--n-700); flex-shrink: 0; }

/* 三个开关：未选中 = 中性胶囊；选中 = 亮绿实底。
   亮绿底上的字必须写死 #0A0A0A，**不能**用 var(--n-900) ——
   --primary 是全库唯一不随主题翻转的色，而 --n-900 在深色下会翻成白色，
   白压亮绿只有 1.6:1（铁律）。 */
.sc-switches { display: flex; gap: 16rpx; flex-shrink: 0; }
.sc-sw {
  flex: 1; height: 76rpx; border-radius: var(--r-pill);
  display: flex; align-items: center; justify-content: center;
  background: var(--n-100); color: var(--n-900);
  font-size: 24rpx; font-weight: 700;
}
.sc-sw.on { background: var(--primary); color: #0A0A0A; }
.sc-sw:active { opacity: 0.82; }

/* 两条分享通道：圆形图标 + 文字，对齐设计稿。
   图标一律「亮绿圆 + 深色字形」—— 同一个合法色对，深色主题下也成立。
   只有两条时用居中 + 固定列宽：若沿用 flex:1 平摊，两个图标会分别贴在 1/4 与 3/4 处，
   中间空出近 240rpx，看起来像少了第三项。 */
.sc-channels { display: flex; justify-content: center; gap: 140rpx; flex-shrink: 0; }
.sc-ch { width: 200rpx; display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.sc-ch:active { opacity: 0.7; }
.sc-ch-ico {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: var(--primary);
  display: flex; align-items: center; justify-content: center;
}
.sc-ch-glyph { width: 46rpx; height: 46rpx; background-color: #0A0A0A; }
.sc-ch-tx { font-size: 22rpx; font-weight: 600; color: var(--n-700); }

.sc-cancel {
  height: 88rpx; border-radius: var(--r-pill);
  flex-shrink: 0;                              /* 全屏最后一个可点元素，绝不许被挤掉 */
  display: flex; align-items: center; justify-content: center;
  background: var(--card); color: var(--n-900);
  font-size: 28rpx; font-weight: 700;
}
.sc-cancel:active { opacity: 0.86; }

/* 画布只用于出图，摆在视口外：不参与布局、不遮挡；出图后立即由 wx:if 摘除。
   显式给 CSS 尺寸是为了保证节点有真实布局尺寸（display:none 会让它取不到尺寸），
   真正的出图尺寸由 JS 设的 canvas.width/height 决定（恒 750×H）。 */
.sc-canvas { position: fixed; left: -2000px; top: 0; width: 375px; height: 550px; }

@keyframes sc-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes sc-up { from { transform: translateY(60rpx); opacity: 0.4; } to { transform: translateY(0); opacity: 1; } }

/* 通道图标（mask 方案，与 styles/icons.wxss 同一套编码约定）。
   为什么在本组件内重复定义、而不复用全局 .ico-* ：
   本组件（含弹层）的**每一个** class 都在本文件里定义（已核对：tr.wxml 里 0 个类来自 app.wxss），
   从不依赖 app.wxss 的类穿透进自定义组件 —— 赌错的话图标会**静默不渲染**，
   是这类 bug 里最难发现的一种。与 custom-tab-bar 的处理方式一致。 */
.sc-ch-glyph {
  -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
  -webkit-mask-position: center; mask-position: center;
  -webkit-mask-size: contain; mask-size: contain;
}
