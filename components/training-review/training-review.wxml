<!-- components/training-review/training-review.wxml —— v2 两页结构：本次训练（默认）/ 进步趋势
     设计原则：只回答三个问题——这次练得怎么样 / 最近趋势如何 / 下次怎么练 -->
<view class="page">

  <scroll-view class="scroll" scroll-y>
    <view class="body">

      <!-- ===== 顶部 2 段 tab ===== -->
      <view class="tabs" role="tablist">
        <view class="tab-item {{tab==='single'?'on':''}}" data-tab="single" bindtap="switchTab" role="tab">本次训练</view>
        <view class="tab-item {{tab==='trend'?'on':''}}" data-tab="trend" bindtap="switchTab" role="tab">进步趋势</view>
      </view>

      <!-- =============== 本次训练（默认） =============== -->
      <block wx:if="{{tab==='single'}}">

        <!-- 空状态：给一个能往下走的出口，而不是只报「空」 -->
        <view wx:if="{{empty}}" class="placeholder">
          <view class="ph-tit">还没有训练记录</view>
          <view class="ph-hint">完成一次训练后，这里会自动生成复盘</view>
          <view class="ph-cta" bindtap="goTrain">去训练</view>
        </view>

        <block wx:else>
          <!-- 一句话结论卡 -->
          <view class="verdict">{{verdict}}</view>

          <!-- 场次行：日期 + 动作/组数 + 历史场次切换 -->
          <view class="session-row">
            <view class="s-arrow {{selIdx >= logsCount - 1 ? 'dis' : ''}}" data-dir="older" bindtap="selSession" aria-label="上一场">‹</view>
            <view class="s-mid">
              <text class="s-date">{{sessionDate}}</text>
              <text class="s-sub">{{sessionSub}}</text>
            </view>
            <view class="s-arrow {{selIdx <= 0 ? 'dis' : ''}}" data-dir="newer" bindtap="selSession" aria-label="下一场">›</view>
          </view>

          <!-- 3 stat：时长 / 训练量 / 平均吃力 -->
          <view class="stats">
            <view class="stat">
              <text class="lab">时长</text>
              <text class="val">{{stats.duration}}</text>
            </view>
            <view class="stat">
              <text class="lab">训练量</text>
              <text class="val">{{stats.volume}}<text class="unit">kg</text></text>
            </view>
            <view class="stat">
              <text class="lab">平均吃力</text>
              <text class="val">{{stats.effort}}</text>
            </view>
          </view>

          <!-- 逐动作表现：最好一组 + 比上次 + 内联下次建议 -->
          <view class="section-title">逐动作表现</view>
          <view class="pa-list">
            <view class="pa-card" wx:for="{{perAction}}" wx:key="key">
              <view class="pa-head">
                <text class="pa-name">{{item.name}}</text>
                <text class="pa-chip {{item.chip.cls}}">{{item.chip.text}}</text>
              </view>
              <view class="pa-line">
                <text class="pa-best">最好一组 {{item.best}}</text>
                <text class="pa-meta">{{item.setsMeta}} · 吃力 {{item.rpeTxt}}</text>
              </view>
              <view class="pa-plan">{{item.plan}}</view>
            </view>
          </view>

          <!-- 本次训练感受（聚合动作级备注，无则不渲染） -->
          <block wx:if="{{feelings.length}}">
            <view class="section-title">训练感受</view>
            <view class="feel-card">
              <view class="feel-row" wx:for="{{feelings}}" wx:key="key">
                <text class="feel-name">{{item.name}}</text>
                <text class="feel-note">{{item.note}}</text>
              </view>
            </view>
          </block>
        </block>

      </block>

      <!-- =============== 进步趋势 =============== -->
      <block wx:elif="{{tab==='trend'}}">

        <!-- 周完成度 + 本周概况 -->
        <view class="wk-head">
          <view class="wk-ring" style="{{weekly.compStyle}}" aria-label="周完成度 {{weekly.completion}}%">
            <view class="wk-ring-center">
              <view class="wk-pct">{{weekly.completion}}<text class="wk-pct-u">%</text></view>
              <view class="wk-pct-lab">周完成度</view>
            </view>
          </view>
          <view class="wk-meta">
            <view class="wk-meta-row">
              <view class="wk-mv">{{weekly.trainDays}}<text class="wk-mu"> / {{weekly.weeklyTarget}} 次</text></view>
              <view class="wk-ml">本周训练天数</view>
            </view>
            <view class="wk-meta-row">
              <view class="wk-mv">{{weekly.avgRpe || '—'}}</view>
              <view class="wk-ml">本周平均吃力</view>
            </view>
            <view class="wk-target {{weekly.fromPlan ? 'locked' : ''}}" bindtap="editWeeklyTarget">
              <text class="wk-dot"></text>
              <text class="wk-target-txt">目标 {{weekly.weeklyTarget}} 次 / 周</text>
              <text class="wk-edit">{{weekly.fromPlan ? '由计划决定' : '改'}}</text>
            </view>
          </view>
        </view>

        <!-- 关键动作：自动取场次最多的前 3 个，最好一组跨场趋势 -->
        <view class="section-title">关键动作 · 最好成绩</view>
        <block wx:if="{{keyActions.length}}">
          <view class="ka-card" wx:for="{{keyActions}}" wx:key="key">
            <view class="ka-head">
              <text class="ka-name">{{item.name}}</text>
              <text class="pa-chip {{item.chip.cls}}">{{item.chip.text}}</text>
            </view>
            <view class="ka-bars">
              <view class="ka-bar {{item2.hot ? 'hot' : ''}}" wx:for="{{item.bars}}" wx:for-item="item2" wx:key="key" style="{{item2.style}}"></view>
            </view>
            <view class="ka-foot">
              <text class="ka-txt">{{item.firstDate}} {{item.firstTxt}}</text>
              <text class="ka-arrow">→</text>
              <text class="ka-txt hot">{{item.lastDate}} {{item.lastTxt}}</text>
            </view>
          </view>
          <view class="guide-link" bindtap="openEffortGuide">吃力程度怎么选？</view>
        </block>
        <view wx:else class="wk-empty">还没有动作记录，完成一次训练后这里展示进步趋势</view>

        <!-- 近 6 周努力度 -->
        <view class="section-title">努力度 · 近 6 周</view>
        <view class="wk-weeks">
          <view class="wk-w-col" wx:for="{{weeks}}" wx:key="key">
            <view class="wk-w-track">
              <view class="wk-w-bar {{item.has ? 'on' : 'off'}}" style="{{item.barStyle}}">
                <text class="wk-w-val">{{item.has ? item.rpe : ''}}</text>
              </view>
            </view>
            <text class="wk-w-lab">{{item.label}}</text>
          </view>
        </view>

      </block>

      <view class="bottom-gap" />
    </view>
  </scroll-view>
</view>
