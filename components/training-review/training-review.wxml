<!-- components/training-review/training-review.wxml —— v2 两页结构：本次训练（默认）/ 进步趋势
     设计原则：只回答三个问题——这次练得怎么样 / 最近趋势如何 / 下次怎么练 -->
<view class="page">

  <scroll-view class="scroll" scroll-y>
    <view class="body">

      <!-- ===== 顶部 2 段 tab ===== -->
      <view class="tabs" role="tablist">
        <view class="tab-item {{tab==='single'?'on':''}}" data-tab="single" bindtap="switchTab" role="tab">本次训练</view>
        <view class="tab-item {{tab==='trend'?'on':''}}" data-tab="trend" bindtap="switchTab" role="tab">进步趋势</view>
      </view>

      <!-- =============== 本次训练（默认） =============== -->
      <block wx:if="{{tab==='single'}}">

        <!-- 空状态：给一个能往下走的出口，而不是只报「空」 -->
        <view wx:if="{{empty}}" class="placeholder">
          <view class="ph-tit">还没有训练记录</view>
          <view class="ph-hint">完成一次训练后，这里会自动生成复盘</view>
          <view class="ph-cta" bindtap="goTrain">去训练</view>
        </view>

        <block wx:else>
          <!-- 一句话结论卡 -->
          <view class="verdict">{{verdict}}</view>

          <!-- 场次行：日期 + 动作/组数 + 历史场次切换 -->
          <view class="session-row">
            <view class="s-arrow {{selIdx >= logsCount - 1 ? 'dis' : ''}}" data-dir="older" bindtap="selSession" aria-label="上一场">‹</view>
            <view class="s-mid">
              <text class="s-date">{{sessionDate}}</text>
              <text class="s-sub">{{sessionSub}}</text>
            </view>
            <view class="s-arrow {{selIdx <= 0 ? 'dis' : ''}}" data-dir="newer" bindtap="selSession" aria-label="下一场">›</view>
          </view>

          <!-- 3 stat：时长 / 训练量 / 平均吃力 -->
          <view class="stats">
            <view class="stat">
              <text class="lab">时长</text>
              <text class="val">{{stats.duration}}</text>
            </view>
            <view class="stat">
              <text class="lab">训练量</text>
              <text class="val">{{stats.volume}}<text class="unit">kg</text></text>
            </view>
            <view class="stat">
              <text class="lab">平均吃力</text>
              <text class="val">{{stats.effort}}</text>
            </view>
          </view>

          <!-- 分享卡入口：把这场训练变成一张图片。个人主体做不了社交关系链，
               图片分享不受限，这是最现实的增长手段（B2） -->
          <view class="sc-entry" bindtap="openShareCard">
            <view class="sc-entry-dot"></view>
            <text class="sc-entry-txt">生成本场分享卡</text>
          </view>

          <!-- 逐动作表现：最好一组 + 比上次 + 内联下次建议 -->
          <view class="section-title">逐动作表现</view>
          <view class="pa-list">
            <view class="pa-card" wx:for="{{perAction}}" wx:key="key">
              <view class="pa-head">
                <text class="pa-name">{{item.name}}</text>
                <text class="pa-chip {{item.chip.cls}}">{{item.chip.text}}</text>
              </view>
              <view class="pa-line">
                <text class="pa-best">最好一组 {{item.best}}</text>
                <text class="pa-meta">{{item.setsMeta}} · 吃力 {{item.rpeTxt}}</text>
              </view>
              <view class="pa-plan">{{item.plan}}</view>
            </view>
          </view>

          <!-- 练完之后的肌群状态回放（B② 口径）
               ⚠️ 时间基准 = **该场次的结束时刻**，不是此刻。本页可以切到任意历史场次，
                  若用「此刻」当基准，用户看 3 天前那场时会看到之后几天练的肌群混进来。
               ⚠️ hasAfter 为false 时（无可点亮肌群 / 记录过旧 / 基准缺失）整块不渲染，
                  不显示任何占位文案 —— 缺数据就说缺数据，不编造。 -->
          <block wx:if="{{hasAfter}}">
            <view class="section-title">练完之后的肌群状态</view>
            <view class="af-card">
              <view class="af-sum">{{afterSummary}}</view>
              <view class="af-chips">
                <text class="af-chip af-{{item.state}}" wx:for="{{afterChips}}" wx:key="slug">{{item.name}} · {{item.label}}</text>
              </view>
              <view class="af-hint">{{afterHint}}</view>
            </view>
          </block>

          <!-- 下次训练建议：可一键回填计划（基线 = 计划目标 > 历史） -->
          <block wx:if="{{hasSuggest}}">
            <view class="section-title">下次训练建议</view>
            <view class="sg-card">
              <view class="sg-row {{item.deload ? 'dl' : ''}}" wx:for="{{suggest}}" wx:key="key">
                <view class="sg-top">
                  <text class="sg-name">{{item.name}}</text>
                  <text class="sg-from">{{item.fromTxt}}</text>
                </view>
                <view class="sg-mid">
                  <text class="sg-arrow">{{item.arrow}}</text>
                  <block wx:if="{{item.actionable}}">
                    <block wx:if="{{item.hasW}}">
                      <input class="sg-inp" type="digit" value="{{item.draftW}}" data-key="{{item.key}}" bindinput="onSugW" />
                      <text class="sg-unit">kg ×</text>
                    </block>
                    <input class="sg-inp {{item.hasW ? '' : 'wide'}}" type="number" value="{{item.draftReps}}" data-key="{{item.key}}" bindinput="onSugReps" />
                    <text class="sg-unit">次</text>
                  </block>
                  <text wx:else class="sg-flat">{{item.toTxt}}</text>
                </view>
                <view class="sg-reason">{{item.reason}}</view>
              </view>
              <view class="sg-actions">
                <view class="sg-apply {{canApply ? '' : 'dis'}}" bindtap="applySuggestions">应用到计划</view>
                <text class="sg-tip">仅更新当前计划中匹配的动作，不影响其他计划</text>
              </view>
            </view>
          </block>

          <!-- 本次训练感受（聚合动作级备注，无则不渲染） -->
          <block wx:if="{{feelings.length}}">
            <view class="section-title">训练感受</view>
            <view class="feel-card">
              <view class="feel-row" wx:for="{{feelings}}" wx:key="key">
                <text class="feel-name">{{item.name}}</text>
                <text class="feel-note">{{item.note}}</text>
              </view>
            </view>
          </block>
        </block>

      </block>

      <!-- =============== 进步趋势 =============== -->
      <block wx:elif="{{tab==='trend'}}">

        <block wx:if="{{trendReady}}">

        <!-- 个人纪录：先给结论——我最近破纪录了吗 -->
        <view class="section-title">个人纪录</view>
        <view class="pr-card">
          <view class="pr-sum">{{recordsSummary}}</view>
          <view class="pr-row" wx:for="{{records}}" wx:key="key">
            <text class="pr-name">{{item.name}}</text>
            <text class="pr-val">{{item.valTxt}}</text>
            <text wx:if="{{item.isNew}}" class="pr-new">新</text>
            <text class="pr-date">{{item.dateTxt}}</text>
          </view>
        </view>

        <!-- 近 6 周训练量：纵轴 = 周总容量（重量×次数），单调且有量级差，能读出进步 -->
        <view class="section-title">训练量 · 近 6 周</view>
        <view class="wk-weeks">
          <view class="wk-w-col" wx:for="{{weeks}}" wx:key="key">
            <view class="wk-w-track">
              <view class="wk-w-bar {{item.has ? 'on' : 'off'}}" style="{{item.barStyle}}">
                <text class="wk-w-val">{{item.volTxt}}</text>
              </view>
            </view>
            <text class="wk-w-lab">{{item.label}}</text>
          </view>
        </view>

        <!-- 关键动作：默认取场次最多的前 3；点右上角可改成自己关心的动作（最多 3 个） -->
        <view class="ka-title">
          <view class="section-title">关键动作 · 训练量趋势</view>
          <view class="ka-pick" bindtap="openKaSheet">{{kaCustom ? '自选 · 改' : '自动 · 改'}}</view>
        </view>
        <block wx:if="{{keyActions.length}}">
          <view class="ka-card" wx:for="{{keyActions}}" wx:key="key">
            <view class="ka-head">
              <text class="ka-name">{{item.name}}</text>
              <text class="pa-chip {{item.chip.cls}}">{{item.chip.text}}</text>
            </view>
            <view class="ka-bars">
              <view class="ka-bar {{item2.hot ? 'hot' : ''}}" wx:for="{{item.bars}}" wx:for-item="item2" wx:key="key" style="{{item2.style}}"></view>
            </view>
            <view class="ka-foot">
              <text class="ka-txt">{{item.firstDate}} {{item.firstTxt}}</text>
              <text class="ka-arrow">→</text>
              <text class="ka-txt hot">{{item.lastDate}} {{item.lastTxt}}</text>
            </view>
            <view class="ka-cap">训练量 {{item.firstCap}} → {{item.lastCap}} kg</view>
          </view>
          <view class="guide-link" bindtap="openEffortGuide">吃力程度怎么选？</view>
        </block>
        <view wx:else class="wk-empty">还没有动作记录，完成一次训练后这里展示进步趋势</view>

        </block>

        <!-- 场次不足：给一个成长钩子，而不是两张空图 -->
        <block wx:else>
          <view class="placeholder">
            <view class="ph-tit">趋势需要一点积累</view>
            <view class="ph-hint">再练 {{trendNeed}} 次，就能看到训练量与个人纪录的变化</view>
          </view>
        </block>

      </block>

      <view class="bottom-gap" />
    </view>
  </scroll-view>

  <!-- ===== 关键动作选择弹层：勾选即改，最多 3 个；一个都不勾 = 回到自动前 3 =====
       with-tab：宿主页有自定义 tabBar 时抽屉底部预留其高度，否则「恢复自动 / 完成」会被底栏盖住 -->
  <view wx:if="{{kaSheet}}" class="ka-mask {{kaTabSafe ? 'with-tab' : ''}}" bindtap="closeKaSheet">
    <view class="ka-sheet" catchtap="noop">
      <view class="ka-sheet-head">
        <text class="ka-sheet-tit">选关键动作</text>
        <text class="ka-sheet-cnt">已选 {{kaPickedCount}} / {{kaMax}}</text>
      </view>
      <text class="ka-sheet-sub">最多 3 个。一个都不选就回到自动推荐。</text>

      <scroll-view class="ka-sheet-list" scroll-y>
        <view class="ka-opt {{item.checked ? 'on' : ''}}" wx:for="{{pickOptions}}" wx:key="key"
              data-key="{{item.key}}" bindtap="toggleKaPick">
          <view class="ka-opt-main">
            <text class="ka-opt-name">{{item.name}}</text>
            <text class="ka-opt-meta">{{item.metaTxt}}</text>
          </view>
          <view class="ka-opt-box {{item.checked ? 'on' : ''}}">
            <text wx:if="{{item.checked}}" class="ka-opt-tick">✓</text>
          </view>
        </view>
        <view class="ka-sheet-gap" />
      </scroll-view>

      <view class="ka-sheet-foot">
        <view class="ka-sheet-btn ghost" bindtap="resetKaPicks">恢复自动</view>
        <view class="ka-sheet-btn main" bindtap="saveKaPicks">完成</view>
      </view>
    </view>
  </view>

  <!-- ===== 分享卡预览弹层（底部抽屉，对齐设计稿）=====
       画布在视口外绘制（.sc-canvas），出图后立刻用 wx:if 摘掉，只留 <image> 展示：
       原生画布留在弹层里会压住内容，而 opacity:0 隐藏的原生组件在真机会泄漏。
       长按图片可直接调起原生菜单，是分享面板之外的第二条路径。
       三个开关都**真的重建卡片**（隐藏内容 / 合并同日 / 换样式），不是只改本地状态。

       两条通道（**两条，不是三条**）：
         ① 分享给朋友 → wx.showShareImageMenu，转发面板里本身就能直接发到朋友圈；
         ② 保存到相册 → 只落相册，不发请求。
       曾有的第三条「存相册发朋友圈」与 ② 的实现**逐行相同**（都是 saveImageToPhotosAlbum
       + 一句提示），唯一区别只是一段引导文案，而 ① 已经覆盖朋友圈 —— 真机确认后删除。
       通道数是**能力数**，不是「入口越多越好」：同一个能力开两个入口，用户会以为它们是两件事。

       with-tab：宿主页有自定义 tabBar（「数据」tab）时，抽屉底部必须预留底栏高度 ——
       自定义 tabBar 是框架级固定层，页面弹层 z-index 再高也压不住，只能避让。 -->
  <view wx:if="{{shareShow}}" class="sc-mask" bindtap="closeShare">
    <view class="sc-sheet {{scTabSafe ? 'with-tab' : ''}}" catchtap="noop">

      <view class="sc-preview">
        <view wx:if="{{shareBusy}}" class="sc-busy">正在生成分享卡…</view>
        <image wx:elif="{{shareImg}}" class="sc-img" src="{{shareImg}}" mode="aspectFit" show-menu-by-longpress></image>
      </view>

      <view class="sc-switches">
        <view class="sc-sw {{shareHide ? 'on' : ''}}" data-k="hide" bindtap="toggleShareOpt">隐藏训练内容</view>
        <view class="sc-sw {{shareMerge ? 'on' : ''}}" data-k="merge" bindtap="toggleShareOpt">合并当天</view>
        <view class="sc-sw" bindtap="cycleShareStyle">样式 · {{shareStyleName}}</view>
      </view>

      <view class="sc-channels">
        <view class="sc-ch" bindtap="shareShareCard">
          <view class="sc-ch-ico"><view class="sc-ch-glyph ico-sharefriend-sc"></view></view>
          <text class="sc-ch-tx">分享给朋友</text>
        </view>
        <view class="sc-ch" bindtap="saveShareCard">
          <view class="sc-ch-ico"><view class="sc-ch-glyph ico-albumdown-sc"></view></view>
          <text class="sc-ch-tx">保存到相册</text>
        </view>
      </view>

      <text class="sc-tip">「合并当天」把同一天的多场训练合成一张；「隐藏训练内容」只保留肌群与数据，不出现动作和重量。点「分享给朋友」，在转发面板里可直接发到朋友圈。</text>

      <view class="sc-cancel" bindtap="closeShare">取消</view>
    </view>
    <canvas wx:if="{{!shareImg}}" type="2d" id="shareCanvas" class="sc-canvas"></canvas>
  </view>
</view>
