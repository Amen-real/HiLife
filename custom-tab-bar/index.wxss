/* custom-tab-bar/index.wxss —— HiLiLife 底栏
   浅色为默认；深色覆盖统一写在文件末尾 `.tab-bar.theme-dark` 下（由「我的 → 主题」开关切换）。
   ⚠️ 隔离组件：不继承 app.wxss 的 CSS 变量，所有 var(--*) 必须带硬编码 fallback。 */

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 内容区固定 88rpx，安全区额外叠加在底部，避免内容被压缩溢出 */
  height: 88rpx;
  padding-bottom: calc(env(safe-area-inset-bottom));
  box-sizing: content-box;
  /* 兜底色：custom-tab-bar 为隔离组件，不会继承 app.wxss 的 CSS 变量；若 var 解析失败也保证可见 */
  background: rgba(255, 255, 255, 0.96);
  background: var(--glass-strong, rgba(255, 255, 255, 0.96));
  border-top: 1rpx solid var(--glass-border, #E8E8E4);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  z-index: 1000;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-weak, #A0A0A0);
  transition: color 0.15s ease;
}

.tab-icon {
  width: 56rpx;          /* 紧凑圆形 chip 区（原 72rpx 偏高的主因） */
  height: 56rpx;
  margin-bottom: 4rpx;
  opacity: 0.6;          /* 非选中：图标淡灰 */
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease, opacity 0.15s ease;
}
/* Tab 图标：自包含 mask 方案（隔离组件不继承全局 .ico-*, 此处内联 5 个图标） */
.tab-icon .ico {
  width: 34rpx;          /* 图标随 chip 等比缩小（原 44rpx） */
  height: 34rpx;
  background-color: var(--text-weak, #A0A0A0);
  -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
  -webkit-mask-position: center; mask-position: center;
  -webkit-mask-size: contain; mask-size: contain;
}
