/* 选中态：绿色圆形 chip 上的图标转深墨色（07-diet .item.on .ic） */
.tab-bar-item.active .tab-icon .ico { background-color: var(--text, #0A0A0A); }

.tab-text {
  font-size: var(--fs-caption, 20rpx);
  line-height: 1.2;
}

.tab-bar-item.active {
  color: var(--text, #0A0A0A);   /* 07-diet：选中态文字也为深色 ink，而非绿色 */
}

.tab-bar-item.active .tab-icon {
  opacity: 1;
  background: var(--primary, #C8FF00);   /* 07-diet 绿色圆形 chip 背景 */
  border-radius: 50%;                     /* 圆形 */
  transition: background 0.15s ease;
}

/* 全局训练计时悬浮药丸（参考图「训练最小化」方案）：固定深色卡，双主题下观感一致；
   fixed + 自管拖拽（left/top 由 JS 内联 style 注入，px），松手贴左/右边缘。 */
.wo-pill {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 2000;
  width: 220rpx;
  height: 84rpx;
  border-radius: 999rpx;
  background: #161616;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.40);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 0 20rpx;
  box-sizing: border-box;
}
.wo-pill-txt { display: flex; flex-direction: column; }
.wo-pill-label {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 1rpx;
  line-height: 1.3;
}
.wo-pill.running .wo-pill-label { color: rgba(200, 255, 0, 0.75); }
.wo-pill-clock {
  font-family: var(--f-en, sans-serif);
  font-size: 28rpx;
  font-weight: 700;
  color: #C8FF00;
  line-height: 1.2;
  font-feature-settings: "tnum";
}
.wo-pill-back {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(200, 255, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.wo-pill-arrow { color: #C8FF00; font-size: 22rpx; line-height: 1; }

/* ══════════════════════════════════════════════════════════════
   深色主题覆盖（.tab-bar.theme-dark）
   特异性 0,2,0 > 上方 .tab-bar 的 0,1,0，自然赢。
   ══════════════════════════════════════════════════════════════ */
.tab-bar.theme-dark {
  background: #0A0A0A;
  border-top-color: rgba(255, 255, 255, 0.06);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.45);
}
.tab-bar.theme-dark .tab-bar-item { color: rgba(255, 255, 255, 0.45); }
.tab-bar.theme-dark .tab-icon .ico { background-color: rgba(255, 255, 255, 0.7); }
/* 选中：白字 + 品牌绿圆形 chip（图标仍为深墨） */
.tab-bar.theme-dark .tab-bar-item.active { color: #FFFFFF; }
.tab-bar.theme-dark .tab-bar-item.active .tab-icon {
  background: #C8FF00;
  box-shadow: 0 4rpx 14rpx rgba(200, 255, 0, 0.35);
}
/* 训练计时悬浮药丸：固定深色设计，深色主题无需覆盖 */
