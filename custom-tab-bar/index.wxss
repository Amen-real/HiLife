/* 选中态：绿色圆形 chip 上的图标转深墨色（07-diet .item.on .ic） */
.tab-bar-item.active .tab-icon .ico { background-color: var(--text, #0A0A0A); }

.tab-text {
  font-size: var(--fs-caption, 20rpx);
  line-height: 1.2;
}

.tab-bar-item.active {
  color: var(--text, #0A0A0A);   /* 07-diet：选中态文字也为深色 ink，而非绿色 */
}

.tab-bar-item.active .tab-icon {
  opacity: 1;
  background: var(--primary, #C8FF00);   /* 07-diet 绿色圆形 chip 背景 */
  border-radius: 50%;                     /* 圆形 */
  transition: background 0.15s ease;
}

/* 全局训练计时悬浮窗：可拖拽容器。覆盖全屏但 pointer-events:none，不挡住页面与底部 tab；
   仅内部 movable-view 接收点击/拖拽（pointer-events:auto）。 */
.wo-float-area {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 2000;
  pointer-events: none;
}
.wo-float {
  pointer-events: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #C8FF00;
  background: linear-gradient(155deg, var(--primary-light, #E4FF6E), var(--primary-deep, #7CB800));
  border: 4rpx solid #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.28);
}
.wo-float.running {
  background: #7CB800;
  background: linear-gradient(155deg, var(--primary-deep, #7CB800), #4E7A00);
  border-color: rgba(255, 255, 255, 0.95);
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.34);
}
.wo-float-ico { font-size: var(--fs-head, 32rpx); line-height: 1; color: #fff; text-shadow: 0 1rpx 3rpx rgba(15, 23, 42, 0.30); }
.wo-float-clock {
  font-size: var(--fs-title, 36rpx);
  font-weight: 800;
  color: #fff;
  font-feature-settings: "tnum";
  line-height: 1.1;
  margin: 2rpx 0;
  text-shadow: 0 1rpx 4rpx rgba(15, 23, 42, 0.35);
}
.wo-float-tip {
  font-size: var(--fs-caption, 20rpx);
  color: rgba(255, 255, 255, 0.95);
  line-height: 1;
  text-shadow: 0 1rpx 3rpx rgba(15, 23, 42, 0.30);
}

/* ══════════════════════════════════════════════════════════════
   深色主题覆盖（.tab-bar.theme-dark）
   特异性 0,2,0 > 上方 .tab-bar 的 0,1,0，自然赢。
   ══════════════════════════════════════════════════════════════ */
.tab-bar.theme-dark {
  background: #0A0A0A;
  border-top-color: rgba(255, 255, 255, 0.06);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.45);
}
.tab-bar.theme-dark .tab-bar-item { color: rgba(255, 255, 255, 0.45); }
.tab-bar.theme-dark .tab-icon .ico { background-color: rgba(255, 255, 255, 0.7); }
/* 选中：白字 + 品牌绿圆形 chip（图标仍为深墨） */
.tab-bar.theme-dark .tab-bar-item.active { color: #FFFFFF; }
.tab-bar.theme-dark .tab-bar-item.active .tab-icon {
  background: #C8FF00;
  box-shadow: 0 4rpx 14rpx rgba(200, 255, 0, 0.35);
}
/* 训练计时悬浮药丸：白边在黑底上过跳 → 改深墨边，文字同步转深墨（绿色底上更清晰）
   ⚠️ wo-float 挂在 .wo-float-area 下（与 .tab-bar 平级），故用 .wo-float-area.theme-dark 选择器 */
.wo-float-area.theme-dark .wo-float {
  border-color: #0A0A0A;
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.5);
}
.wo-float-area.theme-dark .wo-float-ico,
.wo-float-area.theme-dark .wo-float-clock { color: #0A0A0A; text-shadow: none; }
.wo-float-area.theme-dark .wo-float-tip { color: #0A0A0A; text-shadow: none; }
