<!-- custom-tab-bar/index.wxml
     theme-light / theme-dark 由各 tab 页 onShow 通过 getTabBar().setData({ theme }) 注入 -->
<view class="tab-bar {{theme}}">
  <view
    wx:for="{{list}}"
    wx:key="text"
    class="tab-bar-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon"><view class="ico ico-{{item.icon}}"></view></view>
    <view class="tab-text">{{item.text}}</view>
  </view>
</view>

<!-- 全局训练计时悬浮药丸：训练中页最小化/离开后仍可在 tab 页显示，点击返回/恢复训练。
     参考图「训练最小化」方案：深色胶囊 = 「训练进行中」小标 + 荧光绿大字计时 + 圆形 ← 展开钮。
     fixed + 自管 touch 拖拽（不用 movable-view：x/y 应用时机真机不可控），松手贴左/右边缘。 -->
<view wx:if="{{showWo}}"
      class="wo-pill {{woRunning ? 'running' : ''}}"
      style="{{woStyle}}"
      bindtouchstart="onWoTouchStart"
      catchtouchmove="onWoTouchMove"
      bindtouchend="onWoTouchEnd"
      bindtap="openWorkout">
  <view class="wo-pill-txt">
    <text class="wo-pill-label">训练进行中</text>
    <text class="wo-pill-clock">{{woClock}}</text>
  </view>
  <view class="wo-pill-back"><text class="wo-pill-arrow">←</text></view>
</view>
